# ─────────────────────────────────────────────────────────────────────────────
# Internal Caddy — plain HTTP on 8080, published to the host on 127.0.0.1:8200.
# The HOST Caddy terminates TLS and reverse-proxies to us. No TLS here.
# ─────────────────────────────────────────────────────────────────────────────

:8080 {
	encode gzip zstd

	# ── the astrology daemon ─────────────────────────────────────────────────
	#
	# Routed straight through by Caddy rather than proxied in Python: no extra
	# hop, and it keeps the two programs at arm's length over plain HTTP, which
	# is precisely what holds the AGPL boundary (see ADR 0001). The daemon is a
	# separate program in a separate stack, reached over plain HTTP on a shared
	# docker network. Sharing a network is not sharing a process.
	#
	# Its X-Source-* headers are preserved deliberately — the §13 source offer
	# has to survive the hop, or the site is serving AGPL output while hiding
	# where the source is.
	handle /api/astro/* {
		uri strip_prefix /api/astro
		reverse_proxy shruti-astro:8000 {
			header_up X-Real-IP {http.request.header.X-Real-IP}
			header_up X-Forwarded-For {http.request.header.X-Forwarded-For}
			header_up X-Forwarded-Proto {http.request.header.X-Forwarded-Proto}
		}
	}

	# ── API ──────────────────────────────────────────────────────────────────
	handle /api/* {
		reverse_proxy backend:8000 {
			header_up X-Real-IP {http.request.header.X-Real-IP}
			header_up X-Forwarded-For {http.request.header.X-Forwarded-For}
			header_up X-Forwarded-Proto {http.request.header.X-Forwarded-Proto}
		}
	}

	# ── Uploaded art / media ─────────────────────────────────────────────────
	handle /media/* {
		root * /srv
		file_server
		header Cache-Control "public, max-age=604800"
	}

	# ── Horoscope authoring, server-rendered ────────────────────────────────
	#
	# The design specifies a React SPA for the admin and that SPA does not
	# exist yet — /srv/admin is empty, so the handler below serves nothing.
	# The horoscope editor is needed before the shell it belongs in, so it is
	# an Astro page and this route reaches it. It sits ABOVE the SPA handler
	# because /admin* would otherwise swallow it.
	#
	# Delete this block when the SPA exists and the editor moves into it.
	handle /admin/horoscopes* {
		reverse_proxy site:4321 {
			header_up X-Real-IP {http.request.header.X-Real-IP}
			header_up X-Forwarded-For {http.request.header.X-Forwarded-For}
			header_up X-Forwarded-Proto {http.request.header.X-Forwarded-Proto}
		}
		header {
			Cache-Control "no-store"
			X-Robots-Tag "noindex, nofollow"
		}
	}

	# ── Admin SPA — where you edit pages and swap art in without a deploy ────
	handle /admin* {
		root * /srv/admin
		try_files {path} /index.html
		file_server
		header {
			Cache-Control "no-store"
			X-Robots-Tag "noindex, nofollow"
		}
	}

	# ── Everything else: the Astro site (SSR) ────────────────────────────────
	#
	# The site service is parked behind the "web" compose profile until the
	# Astro build exists. Until then this returns an honest placeholder rather
	# than a proxy error to a container that is deliberately absent — a 502
	# reads as "broken", and this is not broken, it is unbuilt.
	handle {
		@site_up `{env.SHRUTI_WEB_ENABLED} == "1"`
		handle @site_up {
			reverse_proxy site:4321 {
				header_up X-Real-IP {http.request.header.X-Real-IP}
				header_up X-Forwarded-For {http.request.header.X-Forwarded-For}
				header_up X-Forwarded-Proto {http.request.header.X-Forwarded-Proto}
			}
		}
		handle {
			respond `shrutivtuber.com

The API is running. The site is not built yet.
Try /api/health
` 200
		}
	}

	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	log {
		output stdout
		format console
	}
}

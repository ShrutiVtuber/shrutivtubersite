# ─────────────────────────────────────────────────────────────────────────────
# Internal Caddy — plain HTTP on 8080, published to the host on 127.0.0.1:8200.
# The HOST Caddy terminates TLS and reverse-proxies to us. No TLS here.
# ─────────────────────────────────────────────────────────────────────────────

:8080 {
	encode gzip zstd

	# ── the astrology daemon ─────────────────────────────────────────────────
	#
	# Routed straight through by Caddy rather than proxied in Python: no extra
	# hop, and it keeps the two programs at arm's length over plain HTTP, which
	# is precisely what holds the AGPL boundary (see ADR 0001). The daemon is a
	# separate program in a separate stack, reached over plain HTTP on a shared
	# docker network. Sharing a network is not sharing a process.
	#
	# Its X-Source-* headers are preserved deliberately — the §13 source offer
	# has to survive the hop, or the site is serving AGPL output while hiding
	# where the source is.
	handle /api/astro/* {
		uri strip_prefix /api/astro
		reverse_proxy shruti-astro:8000 {
			header_up X-Real-IP {http.request.header.X-Real-IP}
			header_up X-Forwarded-For {http.request.header.X-Forwarded-For}
			header_up X-Forwarded-Proto {http.request.header.X-Forwarded-Proto}
		}
	}

	# ── API ──────────────────────────────────────────────────────────────────
	handle /api/* {
		reverse_proxy backend:8000 {
			header_up X-Real-IP {http.request.header.X-Real-IP}
			header_up X-Forwarded-For {http.request.header.X-Forwarded-For}
			header_up X-Forwarded-Proto {http.request.header.X-Forwarded-Proto}
		}
	}

	# ── /journal ─────────────────────────────────────────────────────────────
	#
	# NOT served from disk. The agent writes BeeRanked's pages into the volume,
	# and Astro reads them there and renders their CONTENT inside the site's own
	# layout — so the section gets the real SiteHeader and SiteFooter, the live
	# badge and the session state included, rather than a static copy of them
	# that drifts every time the nav changes.
	#
	# Rebetichord boots its React bundle to achieve the same thing. Astro
	# already renders on the server, so there is nothing to boot.
	#
	# The redirect stays here rather than in the app: Caddy's `/journal/*` also
	# matches the bare `/journal`, and letting the proxy see a stripped path was
	# what served a 200 with an empty body.
	redir /journal /journal/ 301

	# ── Uploaded art / media ─────────────────────────────────────────────────
	handle /media/* {
		root * /srv
		file_server
		header Cache-Control "public, max-age=604800"
	}

	# ── Admin ───────────────────────────────────────────────────────────────
	#
	# Server-rendered by Astro rather than a separate React SPA. The design
	# specified an SPA; nothing was ever built at /srv/admin, so the old
	# handler here served a 404 to anyone who typed /admin. Building it as
	# Astro pages means one stack, one build, one set of components and the
	# same tokens, and it works without JavaScript — which for a CMS someone
	# operates from a phone in a hotel is worth more than an SPA.
	handle /admin* {
		reverse_proxy site:4321 {
			header_up X-Real-IP {http.request.header.X-Real-IP}
			header_up X-Forwarded-For {http.request.header.X-Forwarded-For}
			header_up X-Forwarded-Proto {http.request.header.X-Forwarded-Proto}
		}
		header {
			Cache-Control "no-store"
			X-Robots-Tag "noindex, nofollow"
			# Nothing here may be framed. The admin has one-click destructive
			# controls, and a transparent iframe over a "Delete" button is the
			# whole clickjacking attack — cheap to close, and there is no
			# legitimate reason to embed a CMS in another page.
			Content-Security-Policy "frame-ancestors 'none'"
		}
	}


	# ── Everything else: the Astro site (SSR) ────────────────────────────────
	#
	# The site service is parked behind the "web" compose profile until the
	# Astro build exists. Until then this returns an honest placeholder rather
	# than a proxy error to a container that is deliberately absent — a 502
	# reads as "broken", and this is not broken, it is unbuilt.
	handle {
		@site_up `{env.SHRUTI_WEB_ENABLED} == "1"`
		handle @site_up {
			reverse_proxy site:4321 {
				header_up X-Real-IP {http.request.header.X-Real-IP}
				header_up X-Forwarded-For {http.request.header.X-Forwarded-For}
				header_up X-Forwarded-Proto {http.request.header.X-Forwarded-Proto}
			}
		}
		handle {
			respond `shrutivtuber.com

The API is running. The site is not built yet.
Try /api/health
` 200
		}
	}

	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		# The site is not framed either. Someone else's page wrapping the
		# natal-chart form would be collecting birth data under this site's
		# privacy promises while not being this site.
		X-Frame-Options "SAMEORIGIN"
		# Browser features this site never uses. Denying them means a third
		# party that somehow got script in cannot quietly ask for them either.
		#
		# `payment` is deliberately NOT on this list. Stripe is coming to
		# /support, and Apple Pay and Google Pay go through the Payment Request
		# API — denying it here would make those buttons silently fail to
		# appear, which is close to undiagnosable. Add `payment=(self
		# "https://js.stripe.com")` when Stripe lands rather than a blanket
		# deny that has to be reversed.
		#
		# `interest-cohort` is NOT on this list either, and its absence is the
		# fix rather than an omission. It opted out of FLoC, Chrome abandoned
		# FLoC, and the token is now simply unrecognised — so every page load
		# logged "Unrecognized feature: interest-cohort" in the console. A
		# header that errors is worse than no header: it trains whoever is
		# looking to ignore console noise on this site.
		Permissions-Policy "camera=(), microphone=(), geolocation=(self), usb=()"
		# HSTS is set by the HOST Caddy, which is the one that terminates TLS.
		# Setting it here as well would send it over the plain-HTTP hop, where
		# it means nothing and only invites confusion about who owns it.
		-Server
	}

	log {
		output stdout
		format console
	}
}

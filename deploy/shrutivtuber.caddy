# shrutivtuber.com — VTuber site production deploy
# Drop-in for /etc/caddy/Caddyfile.d/ (imported by /etc/caddy/Caddyfile).
# Reverse-proxies to this stack's internal Caddy on 127.0.0.1:8200.
#
# Port map on agent-house:
#   8090  daskalos      8190  theourgia      8200  shrutivtuber (this)      8210  astropractise
#
# Requires CLOUDFLARE_API_TOKEN_SHRUTI in /etc/caddy/caddy.env — a token
# scoped Zone:DNS:Edit on the shrutivtuber.com zone, matching the per-tenant
# token convention already used by theourgia.
#
# Install:
#   sudo install -m 644 deploy/shrutivtuber.caddy /etc/caddy/Caddyfile.d/
#   sudo caddy-reload

shrutivtuber.com {
    encode gzip zstd

    tls {
        dns cloudflare {env.CLOUDFLARE_API_TOKEN_SHRUTI}
        # certmagic verifies the _acme-challenge TXT has propagated before
        # telling Let's Encrypt to check. Hetzner's recursive resolvers would
        # not return authoritative nameservers for this freshly-delegated zone
        # ("could not determine authoritative nameservers"), so point the
        # propagation check at public resolvers instead.
        resolvers 1.1.1.1 8.8.8.8
        propagation_timeout 5m
    }

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "interest-cohort=()"
        # form-action names Stripe on purpose, and removing it breaks paying.
        #
        # Buying, supporting and managing a subscription are all a POST to this
        # site answered with a redirect to Stripe. `form-action` governs the
        # WHOLE redirect chain after a form submission, not just where the form
        # points — so with 'self' alone the browser blocks the redirect after
        # the session has already been created. The server logs a clean 303,
        # Stripe logs a created session, and the buyer sees a page that did
        # nothing. curl cannot reproduce it: curl does not implement CSP.
        #
        # 'unsafe-inline' covers the no-flash theme script and design-system
        # inline styles. img-src allows data: for inlined marks. YouTube/Twitch
        # embeds need frame-src; drop those entries if embeds are removed.
        #
        # `frame-src 'self'` is for /admin/preview, which embeds the real page
        # so she can edit the words with the page in front of her. Note the two
        # directives are opposites and easy to confuse: `frame-ancestors` is
        # who may embed US, `frame-src` is what WE may embed. Fixing only the
        # first left the preview blocked with a message naming the second.
        Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self'; frame-src 'self' https://www.youtube-nocookie.com https://player.twitch.tv; base-uri 'self'; form-action 'self' https://checkout.stripe.com https://billing.stripe.com; frame-ancestors 'self'"
        -Server
    }

    # The admin is the one thing that must never be framed — it has one-click
    # destructive controls, and a transparent iframe over "Delete" is the whole
    # clickjacking attack.
    #
    # It needs saying here rather than in the internal Caddyfile: this proxy
    # SETS the header on the way out, replacing whatever the inner one said, so
    # the admin's own 'none' never reached a browser. Checked with curl — one
    # CSP header on /admin, and it was this one.
    #
    # Everything else is 'self' so /admin/preview can frame the real page. That
    # is a narrowing from 'none', not an opening: another site still cannot
    # frame anything here, and a page that could frame this one would already
    # have to be served from this origin.
    # The embed widget is the ONE path other sites may frame, and that is the
    # whole point of it: another astrologer putting the wheel in their own post
    # is the best inbound link this project has. Safe here because the page has
    # no authority to borrow — no session, no cookie, nothing to click, nothing
    # that acts on a reader's behalf. Everything else stays 'self' and the
    # admin stays 'none'; this is a hole punched in one wall, not a door left
    # open.
    @embed path /embed /embed/*
    header @embed >Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; base-uri 'self'; form-action 'none'; frame-ancestors *"

    @admin path /admin /admin/*
    header @admin >Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self'; frame-src 'self' https://www.youtube-nocookie.com https://player.twitch.tv; base-uri 'self'; form-action 'self' https://checkout.stripe.com https://billing.stripe.com; frame-ancestors 'none'"

    reverse_proxy 127.0.0.1:8200 {
        flush_interval -1
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
        transport http {
            versions 1.1 2
        }
    }

    log {
        output stderr
        format console
    }
}

www.shrutivtuber.com {
    tls {
        dns cloudflare {env.CLOUDFLARE_API_TOKEN_SHRUTI}
        resolvers 1.1.1.1 8.8.8.8
        propagation_timeout 5m
    }
    redir https://shrutivtuber.com{uri} permanent
}

# ─────────────────────────────────────────────────────────────────────────────
# /journal — BeeRanked
#
# Preferred: mount at the Cloudflare edge so requests never reach this box.
# Nothing goes here in that case.
#
# Origin fallback: insert INSIDE the shrutivtuber.com block ABOVE the
# catch-all reverse_proxy —
#
#     handle /journal* {
#         reverse_proxy https://<beeranked-host> {
#             header_up Host <beeranked-host>
#         }
#     }
# ─────────────────────────────────────────────────────────────────────────────

---
/* The shell every page sits in: chrome, tokens, and the head.
 *
 * Live status is fetched here rather than per page, because the badge appears
 * in the header on every surface. It is fetched server-side like everything
 * else — nothing about the backends reaches the browser.
 */
import "../styles/global.css";
import "../styles/site.css";
import SiteHeader from "../components/chrome/SiteHeader.astro";
import SiteFooter from "../components/chrome/SiteFooter.astro";
import CookieNotice from "../components/brand/CookieNotice.astro";
import Beacon from "../components/insight/Beacon.astro";
import HoldingNotice from "../components/chrome/HoldingNotice.astro";
import { site, type LiveStatus, type LinkGroups, PATHS } from "../lib/api";
import { badgeFrom } from "../lib/live";
import type { SocialLink } from "../components/brand/SocialLinkRow.astro";

interface Props {
  title: string;
  description?: string;
  /** Set on pages that carry their own <main> wrapper or a full-bleed hero. */
  bare?: boolean;
  /** Kept out of search results — the admin, and anything behind sign-in. */
  noindex?: boolean;
}
const { title, description = "", bare = false, noindex = false } = Astro.props;
const siteUrl = import.meta.env.SHRUTI_SITE_URL ?? "https://shrutivtuber.com";

const [live, links] = await Promise.all([
  site<LiveStatus>(PATHS.live),
  site<LinkGroups>(PATHS.links),
]);
const badge = badgeFrom(live);


/* Only what the admin has marked visible reaches the footer. LinkedIn is
   hidden deliberately and that is a content decision, not a layout one — the
   footer renders whatever comes back and nothing more. */
const socials: SocialLink[] = Object.values(links?.groups ?? {})
  .flat()
  .map((l) => ({ platform: l.platform, href: l.url, label: l.label }));

/* Who this is, in a form a search engine can read.
 *
 * Only /videos carried any structured data. Without a Person on the home page
 * nothing outside the site knows that "Shruti" the name and the Twitch
 * channel and the GitHub account are one person — so the profiles compete in
 * search results instead of reinforcing each other, and a knowledge panel
 * cannot be built at all. `sameAs` is the claim that ties them together, and
 * it is the single highest-value tag a creator site can carry.
 *
 * Emitted only on the home page. Repeating a Person on every page says the
 * same thing forty times and dilutes which URL is the canonical one for it. */
const isHome = Astro.url.pathname === "/";
const jsonLd = isHome
  ? {
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "WebSite",
          "@id": `${siteUrl}/#website`,
          url: siteUrl,
          name: "Shruti",
          description:
            "Instruments for magickal and astrological practice — an ephemeris, " +
            "four calendars, planetary hours and letter-reckoning.",
          inLanguage: "en",
          publisher: { "@id": `${siteUrl}/#person` },
        },
        {
          "@type": "Person",
          "@id": `${siteUrl}/#person`,
          name: "Shruti",
          alternateName: "Soror Eu. A.",
          url: siteUrl,
          description:
            "VTuber and engineer building open-source instruments for magickal " +
            "and astrological practice, live on stream.",
          /* The links the admin has marked visible, and no others. A sameAs
             pointing at a profile she has hidden would out it. */
          sameAs: socials.map((l) => l.href).filter(Boolean),
        },
      ],
    }
  : null;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={new URL(Astro.url.pathname, siteUrl).href} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    {/* A crescent rather than the wordmark: at sixteen pixels a wordmark is a
        smudge, and the brief forbids inventing a seal. Transparent, so it
        reads on a light tab bar and a dark one. */}
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <meta name="theme-color" content="#121829" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#F8F6F3" media="(prefers-color-scheme: light)" />

    {/* Without these a shared link is a bare URL with no image — which for a
        site whose audience finds it through Discord and Bluesky is most of
        the first impression. The card is built from the real wordmark and the
        design's own cloud plate; nothing about it is invented. */}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Shruti" />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={new URL(Astro.url.pathname, siteUrl).href} />
    <meta property="og:image" content={new URL("/social-card.png", siteUrl).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Shruti — instruments for magick, astrology and divination" />
    <meta name="twitter:card" content="summary_large_image" />

    {/* Runs before any stylesheet so a stored dark preference never flashes
        white. Inlined on purpose — it cannot wait for a module to load. */}
    <script is:inline src="/first-paint.js"></script>
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    {/* Only when the operator is past the gate — see the component. */}
    {Astro.locals.bypassingHolding && <HoldingNotice />}
    <SiteHeader live={badge} />
    {bare ? <slot /> : <main id="main" class="site-main"><slot /></main>}
    <SiteFooter socials={socials} />
    <CookieNotice />
    <Beacon />
  </body>
</html>

<style is:global>
  body { margin: 0; background: var(--surface-page); color: var(--ink); }
  .skip-link {
    position: absolute;
    left: -9999px;
    top: 0;
    z-index: 100;
  }
  .skip-link:focus {
    left: var(--space-4);
    top: var(--space-4);
    background: var(--surface-card);
    color: var(--ink);
    border: var(--border-w) solid var(--line-strong);
    border-radius: var(--radius-sm);
    padding: 10px 16px;
    font: 500 var(--text-sm) / 1 var(--font-body);
  }
</style>

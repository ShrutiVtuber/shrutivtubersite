---
/* The admin shell.
 *
 * Server-rendered rather than a React SPA, and the reasoning is in the
 * Caddyfile: one stack, one build, the same components and tokens, and it
 * works with scripting off — which for a CMS operated from a phone in a hotel
 * is worth more than an SPA.
 *
 * Functional over beautiful, per the design, but on the same tokens.
 */
import "../styles/global.css";
import "../styles/site.css";
import { copy } from "../lib/copy";

/* Every word here, editable from the admin. The defaults below are what
   it was written with and what still renders if nothing was changed. */
const say = await copy("component:AdminLayout");

interface Props {
  title: string;
  /** The sign-in page, which has no nav and no sign-out. */
  open?: boolean;
}
const { title, open = false } = Astro.props;

/* Authentication is enforced in `src/middleware.ts`, not here. A redirect
   returned from a layout fires after the response has begun streaming, so it
   throws instead of redirecting and the visitor gets a 200 carrying "Internal
   server error". By the time this renders, the session is already verified. */

const NAV: [string, string][] = [
  ["/admin", "Overview"],
  ["/admin/blocks", "Page blocks"],
  ["/admin/preview", "Pages"],
  ["/admin/copy", "Words"],
  ["/admin/horoscopes", "Horoscopes"],
  ["/admin/media", "Media"],
  ["/admin/inbox", "Inbox"],
  ["/admin/community", "Community"],
  ["/admin/offers", "Offers"],
  ["/admin/counters", "Stream"],
  ["/admin/newsletter", "Letter"],
  ["/admin/insight", "Use"],
  ["/admin/settings", "Settings"],
];
const here = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} — admin</title>
    <meta name="robots" content={say("text.1", "noindex, nofollow")} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#121829" />
    <script is:inline src="/first-paint.js"></script>
  </head>
  <body class="admin-body">
    <header class="admin-bar">
      <div class="page bar-inner">
        <a class="admin-brand" href="/admin">{say("text.5", "Shruti")} <span>{say("text.2", "admin")}</span></a>
        {
          !open && (
            <nav class="admin-nav" aria-label={say("text.6", "Admin")}>
              {
                NAV.map(([href, label]) => (
                  <a href={href} aria-current={here === href ? "page" : undefined}>{label}</a>
                ))
              }
            </nav>
          )
        }
        <div class="bar-side">
          <a class="view-site" href="/">{say("text.3", "View site ↗")}</a>
          {
            !open && (
              <form method="POST" action="/admin/signout" class="signout">
                <button type="submit">{say("text.4", "Sign out")}</button>
              </form>
            )
          }
        </div>
      </div>
    </header>
    <main class="admin-main page"><slot /></main>
  </body>
</html>

<style is:global>
  .admin-body { margin: 0; background: var(--surface-page); color: var(--ink); }
  .admin-bar {
    border-bottom: var(--border-w) solid var(--line);
    background: var(--surface-card);
    position: sticky;
    top: 0;
    z-index: 40;
  }
  .bar-inner { display: flex; align-items: center; gap: var(--space-4); min-height: 56px; flex-wrap: wrap; }
  .admin-brand {
    font: 500 20px var(--font-display); color: var(--ink); text-decoration: none; flex: none;
  }
  .admin-brand span {
    font: 600 var(--text-micro) var(--font-body); letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase; color: var(--ink-faint);
  }
  .admin-nav { display: flex; gap: 2px; flex-wrap: wrap; }
  .admin-nav a {
    font: 500 var(--text-sm) var(--font-body); color: var(--ink-soft); text-decoration: none;
    padding: 8px 12px; border-radius: var(--radius-sm); min-height: 40px;
    display: inline-flex; align-items: center;
  }
  .admin-nav a:hover { color: var(--ink); background: var(--surface-veil); }
  .admin-nav a[aria-current="page"] { color: var(--accent); background: var(--accent-wash); }
  .bar-side { margin-left: auto; display: flex; gap: var(--space-3); align-items: center; }
  .view-site, .signout button {
    font: 500 var(--text-xs) var(--font-body); color: var(--ink-soft); text-decoration: none;
    background: none; border: 0; cursor: pointer; padding: 8px;
  }
  .view-site:hover, .signout button:hover { color: var(--accent); }
  .admin-main { padding: var(--space-6) 0 var(--space-9); display: grid; gap: var(--space-5); }

  .adm-h { font: 600 var(--text-h2) var(--font-display); color: var(--ink); margin: 0; }
  .adm-card {
    background: var(--surface-card); border: var(--border-w) solid var(--line);
    border-radius: var(--radius-md); padding: var(--space-4); display: grid; gap: 12px;
  }
  .adm-note { font: 400 var(--text-sm) / 1.7 var(--font-body); color: var(--ink-soft); margin: 0; max-width: 70ch; }
  .adm-ok { font: 400 var(--text-sm) var(--font-body); color: var(--accent); margin: 0; }
  .adm-bad { font: 400 var(--text-sm) var(--font-body); color: var(--live); margin: 0; max-width: 70ch; }
  .adm-lbl {
    font: 600 var(--text-micro) var(--font-body); letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase; color: var(--ink-faint);
  }
  .adm-input, .adm-select, .adm-area {
    font: 400 var(--text-sm) var(--font-body); color: var(--ink); background: var(--surface-page);
    border: var(--border-w) solid var(--line); border-radius: var(--radius-sm);
    padding: 8px 10px; min-height: 40px; width: 100%; box-sizing: border-box;
  }
  .adm-area { font-family: var(--font-display); font-size: var(--text-body); line-height: var(--leading-body); resize: vertical; }
</style>

---
/* The Swara Studio admin (README_v2 §9; artboards D1-D6): its own shell,
 * apart from the site admin, for the operator only. The sidebar is the
 * Studio's places; "Site admin" leads back to the rest. Pages check the
 * session themselves and send anyone else to the admin sign-in.
 */
import "../styles/global.css";
import "../styles/site.css";
import "../styles/carnatic.css";
import "../styles/carnatic-course.css";
import { DEFAULTS } from "../lib/carnatic/prefs";

interface Props { title: string; counts?: Record<string, number> }
const { title, counts = {} } = Astro.props;
const here = Astro.url.pathname;
const NAV: [string, string, string][] = [
  ["/carnatic/studio/lessons", "Lessons", "lessons"], ["/carnatic/studio/exercises", "Exercises", "exercises"],
  ["/carnatic/studio/recordings", "Recordings", "recordings"], ["/carnatic/studio/moderation", "Moderation", "moderation"],
  ["/carnatic/studio/glossary", "Glossary", "glossary"], ["/carnatic/admin", "Review: names and facts", "review"],
];
const boot = { lang: "en", signedIn: false, supporter: false, partsPerSong: null, settings: DEFAULTS, settingsUpdatedAt: null };
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · Swara Studio admin</title>
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <script is:inline src="/first-paint.js"></script>
  </head>
  <body class="st-body">
    <aside class="sa-side">
      <a class="sa-brand" href="/carnatic/studio/lessons"><span>Swara Studio</span><small>Admin · Shruti</small></a>
      <nav class="sa-nav" aria-label="Swara Studio admin">
        {NAV.map(([href, label, key]) => <a href={href} aria-current={here.startsWith(href) ? "page" : undefined}>{label}{counts[key] !== undefined && <small>{counts[key]}</small>}</a>)}
      </nav>
      <a class="sa-back" href="/admin">‹ Site admin</a>
    </aside>
    <main class="sa-main" id="main"><slot /></main>
    <script type="application/json" id="swara-boot" set:html={JSON.stringify(boot)} />
  </body>
</html>

---
/* Home — ported from the design bundle's `ui_kits/site/Home.jsx`.
 *
 * The reference carries authored sample data. This renders the real thing and,
 * where there is nothing real yet, the DESIGNED EMPTY STATE rather than the
 * sample rows. Inventing three plausible videos to fill a grid would be
 * exactly the failure the brief's press-kit warning is about.
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/brand/Hero.astro";
import SectionHeader from "../components/brand/SectionHeader.astro";
import LiveBadge from "../components/brand/LiveBadge.astro";
import SocialLinkRow from "../components/brand/SocialLinkRow.astro";
import Button from "../components/forms/Button.astro";
import ProjectCard from "../components/cards/ProjectCard.astro";
import ScheduleItem from "../components/tables/ScheduleItem.astro";
import SignPicker from "../components/navigation/SignPicker.astro";
import { site, type LiveStatus, type LinkGroups, type Project, PATHS } from "../lib/api";
import { badgeFrom } from "../lib/live";
import type { SocialLink } from "../components/brand/SocialLinkRow.astro";

interface ScheduleRow {
  title: string;
  startsAt: string;
  durationMinutes: number | null;
  platform: string | null;
  url: string | null;
  notesMd: string | null;
}

interface HoroscopeIndex {
  covers: string;
  readings: { sign: string; published: boolean; bodyMd: string }[];
}

const [live, links, projects, schedule, horoscopes] = await Promise.all([
  site<LiveStatus>(PATHS.live),
  site<LinkGroups>(PATHS.links),
  site<Project[]>(PATHS.projects),
  site<ScheduleRow[]>(PATHS.schedule),
  site<HoroscopeIndex>("/api/horoscopes?period=monthly"),
]);

/* Only teased when there is something to read. A sign picker leading to twelve
   empty pages is worse than no teaser. */
const readings = horoscopes?.readings ?? [];
const anyReading = readings.some((r) => r.published);
const monthName = (() => {
  const m = /^(\d{4})-(\d{2})$/.exec(horoscopes?.covers ?? "");
  if (!m) return "";
  return new Date(Date.UTC(Number(m[1]), Number(m[2]) - 1, 1))
    .toLocaleDateString("en-GB", { month: "long", timeZone: "UTC" });
})();

const badge = badgeFrom(live);
const socials: SocialLink[] = Object.values(links?.groups ?? {})
  .flat()
  .map((l) => ({ platform: l.platform, href: l.url, label: l.label }));

const next = (schedule ?? [])[0] ?? null;

/* The avatar is a square painted image and Hero composes it as a framed plate
   on the horizon — that is what the bundle's asset notes say it is for. The
   art-absent path stays implemented and is what renders if this ever goes
   missing. Clouds are deliberately not layered in yet: the delivered PNG is
   6.5MB, and the readme is explicit that the sky is fully designed without
   it. Optimising that asset is a task, not a licence to ship it as-is. */
const AVATAR = "/brand/avatar-square.png";

/* Named by the question each one answers, not by what it is. "Pañcāṅga" means
   nothing to someone who has not met it; "the five limbs of the day, and when
   each ends" tells them whether they want it. */
const INSTRUMENTS = [
  {
    glyph: "☾", name: "Day at a glance", href: "/today", wide: true,
    answers: "What the sky is doing right now, where you are — luminaries, stations, the planetary hour, and today in four reckonings.",
  },
  {
    glyph: "☉", name: "Solar stations", href: "/tools/solar-stations",
    answers: "Sunrise, noon, sunset and midnight for a month ahead, exportable to your calendar.",
  },
  {
    glyph: "☾", name: "Lunar stations", href: "/tools/lunar-stations",
    answers: "Moonrise, culmination, moonset and nadir — with the phase beside them.",
  },
  {
    glyph: "☉", name: "Planetary hours", href: "/tools/planetary-hours",
    answers: "The day divided by its own light, so an hour is only sixty minutes twice a year.",
  },
  {
    glyph: "◐", name: "Pañcāṅga", href: "/tools/pancanga",
    answers: "The five limbs of the day, each with the moment it ends.",
  },
  {
    glyph: "☾", name: "Hindu calendar", href: "/tools/hindu-calendar",
    answers: "The lunisolar year, its months and its festivals — amānta or pūrṇimānta, your choice.",
  },
  {
    glyph: "☽", name: "Attic calendar", href: "/tools/attic-calendar",
    answers: "The month of Athens, opened at the noumenia and counted backwards through its last third.",
  },
  {
    glyph: "✶", name: "Natal chart", href: "/tools/natal-chart",
    answers: "A figure for a moment and a place, Hellenistic or Vedic — and honest about an unknown birth time.",
  },
  {
    glyph: "Σ", name: "Isopsephy", href: "/tools/isopsephy",
    answers: "Letter-reckoning in six scripts. Runs on your machine; nothing typed leaves it.",
  },
  {
    glyph: "●", name: "Sigil generator", href: "/tools/sigil-generator",
    answers: "Intent reduced and drawn, every step shown. Also on your machine only.",
  },
];
---

<BaseLayout
  title="Shruti — instruments for magick"
  description="Software for astrology, theurgy and divination — built live on stream from Athens."
>
  {/* Outside `.page` so the sky can reach both edges; the Hero puts its own
      words back into the column. */}
  <Hero
      bleed
      greeting="Welcome · Καλώς ήρθατε · स्वागत"
      title="I build instruments for magick."
      subtitle="Software for astrology, theurgy and divination — built live on stream from Athens."
      art={AVATAR}
      artAlt="Shruti"
    >
      <Fragment slot="actions">
        {
          badge.status === "live" ? (
            <Button variant="live" size="lg" href={badge.href ?? "/videos"}>Watch live</Button>
          ) : (
            <Button size="lg" href="/schedule">Next stream</Button>
          )
        }
        <Button variant="secondary" size="lg" href="/work">See the work</Button>
      </Fragment>
      <Fragment slot="footnote">
        <div class="hero-foot-row">
          <LiveBadge
            status={badge.status}
            title={badge.title}
            href={badge.href ?? "/videos"}
          />
          <SocialLinkRow links={socials} size={16} />
        </div>
      </Fragment>
  </Hero>

  {/* The instruments, above the fold's neighbours, because they are the reason
      to come back — a visitor who leaves without knowing these run here has
      missed the site. Each names what it answers rather than what it is. */}
  <section class="section page">
    <div class="section-head">
      <SectionHeader
        glyph="✶"
        eyebrow="Run them here"
        title="Instruments, in your browser"
        body="Working software for practice — no install, no account, and they answer for wherever you are."
      />
      <Button variant="ghost" href="/today">Day at a glance →</Button>
    </div>
    <div class="instruments">
      {
        INSTRUMENTS.map((i) => (
          <a class="instrument" href={i.href} data-wide={i.wide || undefined}>
            <span class="i-glyph t-glyph" aria-hidden="true">{i.glyph}</span>
            <span class="i-name">{i.name}</span>
            <span class="i-answers">{i.answers}</span>
            <span class="i-go" aria-hidden="true">→</span>
          </a>
        ))
      }
    </div>
  </section>

  {/* An INVITATION, not a teaser. The design's rule for the signed-out state
      is that the free half must be fully useful on its own — "if the page is a
      teaser for signing up, nobody signs up" — so this says what an account
      ADDS rather than what it withholds, and says out loud that everything
      above works without one. No lock, no blur, no count of what is missing. */}
  <section class="section page">
    <div class="account-invite">
      <div class="ai-words">
        <span class="t-eyebrow">A free account</span>
        <h2>Save a nativity, and the instruments start answering about you</h2>
        <p class="ai-lead">
          Everything above works without an account and always will. What an account changes is
          that the tools stop asking where and when, and start knowing.
        </p>
        <ul class="ai-list">
          <li>
            <span class="t-glyph" aria-hidden="true">✶</span>
            <span>
              <strong>Your chart, kept.</strong> Cast once and it is there — no re-typing a birth
              time and a city every time you want to look at it.
            </span>
          </li>
          <li>
            <span class="t-glyph" aria-hidden="true">☾</span>
            <span>
              <strong>Transits on Day at a glance.</strong> The one block on that page that needs
              to know where you were born. Nothing else does.
            </span>
          </li>
          <li>
            <span class="t-glyph" aria-hidden="true">☉</span>
            <span>
              <strong>Your place, remembered.</strong> Stations, sunrise and the pañcāṅga answer
              for where you actually are, without setting it each visit.
            </span>
          </li>
          <li>
            <span class="t-glyph" aria-hidden="true">◐</span>
            <span>
              <strong>Your sign first.</strong> The monthly reading opens on yours instead of
              twelve to choose from.
            </span>
          </li>
        </ul>
        <div class="ai-actions">
          <Button size="lg" href="/signup">Make an account</Button>
          <Button variant="ghost" href="/signin">Sign in</Button>
        </div>
        <p class="ai-quiet">
          Nothing public — no profile, no avatar, no follower count. Birth data is a separate,
          optional decision, and withdrawing it deletes it. Free, and staying that way.
        </p>
      </div>
    </div>
  </section>

  <section class="section page">
    <div class="section-head">
      <SectionHeader
        glyph="☾"
        eyebrow="Next on the almanac"
        title="Upcoming stream"
      />
      <Button variant="ghost" href="/schedule">Full schedule →</Button>
    </div>
    {
      next ? (
        <ScheduleItem
          title={next.title}
          startISO={next.startsAt}
          durationMin={next.durationMinutes ?? undefined}
          topic={next.platform ?? undefined}
          href={next.url ?? undefined}
        />
      ) : (
        /* Authored empty state, verbatim from the brief. Never fake liveness. */
        <p class="quiet-empty">
          The sky is quiet — nothing scheduled yet. Streams are announced on Discord first.
        </p>
      )
    }
  </section>

  {
    anyReading && (
      <section class="section page">
        <div class="section-head">
          <SectionHeader
            glyph="☾"
            eyebrow="Horoscopes"
            title={monthName ? `${monthName}, one per sign` : "This month, one per sign"}
            body="Twelve readings a month, written by hand and signed Soror Eu. A. Pick a sign — or save a nativity and yours comes up first."
          />
          <Button variant="ghost" href="/horoscopes">All twelve →</Button>
        </div>
        <SignPicker
          signs={readings.map((r) => ({ sign: r.sign, published: r.published }))}
          hrefFor={(s) => `/horoscopes/${s}/monthly`}
        />
      </section>
    )
  }

  <section class="section page">
    <div class="section-head">
      <SectionHeader
        glyph="✶"
        eyebrow="The work"
        title="A portfolio of instruments"
        body="The proof behind the brand: real software for real practice."
      />
      <Button variant="ghost" href="/work">About the work →</Button>
    </div>
    {
      projects && projects.length > 0 ? (
        <div class="grid-2">
          {projects.slice(0, 2).map((p) => (
            <ProjectCard
              name={p.name}
              tagline={p.tagline}
              status={(p.status as "active" | "maintained" | "archived") ?? "active"}
              repoHref={p.repoUrl || undefined}
              liveHref={p.siteUrl || undefined}
              screenshot={null}
            />
          ))}
        </div>
      ) : (
        <p class="quiet-empty">Nothing published here yet.</p>
      )
    }
  </section>
</BaseLayout>

<style>
  .hero-foot-row { display: flex; gap: 16px; align-items: center; flex-wrap: wrap; }

  .account-invite {
    background: var(--surface-card);
    border: var(--border-w) solid var(--line-strong);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-1);
    padding: clamp(20px, 4vw, var(--space-6));
  }
  .ai-words { display: grid; gap: 12px; max-width: 68ch; }
  .account-invite h2 {
    font: 600 var(--text-h2) var(--font-display);
    line-height: var(--leading-heading);
    color: var(--ink);
    margin: 0;
    text-wrap: balance;
  }
  .ai-lead { font: 400 var(--text-h4) / var(--leading-body) var(--font-display); color: var(--ink-soft); margin: 0; }
  .ai-list {
    list-style: none;
    margin: var(--space-3) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: var(--space-3) var(--space-5);
  }
  .ai-list li { display: flex; gap: 10px; align-items: baseline; }
  .ai-list .t-glyph { color: var(--rose); font: 400 1.1rem var(--font-display); flex: none; }
  .ai-list span:last-child { font: 400 var(--text-sm) / 1.6 var(--font-body); color: var(--ink-soft); }
  .ai-list strong { font-weight: 600; color: var(--ink); }
  .ai-actions { display: flex; gap: 10px; flex-wrap: wrap; align-items: center; margin-top: var(--space-3); }
  .ai-quiet { font: 400 var(--text-xs) / 1.6 var(--font-body); color: var(--ink-faint); margin: 0; max-width: 66ch; }

  .instruments {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: var(--space-3);
  }
  .instrument {
    position: relative;
    display: grid;
    grid-template-columns: auto 1fr auto;
    grid-template-areas: "glyph name go" "glyph answers answers";
    gap: 2px var(--space-3);
    align-items: baseline;
    padding: var(--space-4);
    background: var(--surface-card);
    border: var(--border-w) solid var(--line);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-1);
    text-decoration: none;
    transition:
      border-color var(--dur-1) var(--ease-out),
      box-shadow var(--dur-1) var(--ease-out);
  }
  /* Hover deepens and strengthens; it does not lift or scale. */
  .instrument:hover { border-color: var(--line-strong); box-shadow: var(--shadow-2); }
  .instrument:hover .i-name { color: var(--accent-hover); }
  .instrument:hover .i-go { color: var(--accent); transform: translateX(2px); }
  /* The one that answers the most gets the width, not a different colour. */
  .instrument[data-wide] { grid-column: 1 / -1; }
  .instrument[data-wide] .i-name { font-size: var(--text-h3); }
  .i-glyph { grid-area: glyph; font: 400 1.5rem var(--font-display); color: var(--rose); line-height: 1; }
  .i-name { grid-area: name; font: 600 var(--text-h4) var(--font-display); color: var(--ink); transition: color var(--dur-1) var(--ease-out); }
  .i-answers {
    grid-area: answers;
    font: 400 var(--text-sm) / 1.55 var(--font-body);
    color: var(--ink-soft);
    margin-top: 4px;
  }
  .i-go {
    grid-area: go;
    font: 400 var(--text-body) var(--font-body);
    color: var(--ink-faint);
    transition: color var(--dur-1) var(--ease-out), transform var(--dur-1) var(--ease-out);
  }
  .quiet-empty {
    font-family: var(--font-body);
    font-size: var(--text-body);
    line-height: var(--leading-body);
    color: var(--ink-soft);
    margin: 0;
    max-width: 52ch;
  }
</style>

---
/* Home — ported from the design bundle's `ui_kits/site/Home.jsx`.
 *
 * The reference carries authored sample data. This renders the real thing and,
 * where there is nothing real yet, the DESIGNED EMPTY STATE rather than the
 * sample rows. Inventing three plausible videos to fill a grid would be
 * exactly the failure the brief's press-kit warning is about.
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/brand/Hero.astro";
import SectionHeader from "../components/brand/SectionHeader.astro";
import SupportBand from "../components/blocks/SupportBand.astro";
import LiveBadge from "../components/brand/LiveBadge.astro";
import SocialLinkRow from "../components/brand/SocialLinkRow.astro";
import Button from "../components/forms/Button.astro";
import ProjectCard from "../components/cards/ProjectCard.astro";
import ScheduleItem from "../components/tables/ScheduleItem.astro";
import SignPicker from "../components/navigation/SignPicker.astro";
import SponsorRow from "../components/brand/SponsorRow.astro";
import PollCard from "../components/community/PollCard.astro";
import HappeningNow from "../components/community/HappeningNow.astro";
import SkyCard from "../components/counters/SkyCard.astro";
import SubscribeBlock from "../components/brand/SubscribeBlock.astro";
import { site, SITE_API, type LiveStatus, type LinkGroups, type Project, PATHS } from "../lib/api";
import { verifyCsrf } from "../lib/csrf";
import { instruments } from "../lib/instruments";
import { pageSections } from "../lib/content";
import { badgeFrom } from "../lib/live";
import { copy } from "../lib/copy";
import type { SocialLink } from "../components/brand/SocialLinkRow.astro";
import Copy from "../components/content/Copy.astro";

/* Every word on the landing page, editable. The defaults here are what it was
   written with and what still renders if nothing has been changed. */
const say = await copy("home");

/* ── the newsletter, on the landing page itself ───────────────────────────
 *
 * It was only at /newsletter and in a footer link, which meant the page most
 * people arrive on had nowhere to subscribe — the holding page had a form and
 * the real home page, the one that replaces it, did not. A campaign pointed at
 * the site would have started losing signups the day the holding page came
 * down, silently, and the number that went missing would never appear anywhere.
 *
 * Same component and same handler as /newsletter, deliberately: one flow, one
 * set of words, one place to change them. `action` is checked because a landing
 * page accumulates forms, and a handler that answers every POST is how one form
 * starts quietly consuming another's.
 */
let subscribeState: "idle" | "sent" = "idle";
let subscribeError = "";
let subscribeEmail = "";

if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  if (form.get("action") === "subscribe") {
    if (!verifyCsrf(Astro.cookies, form)) {
      subscribeError = say("subscribe.error.retry", "That did not send. Reload the page and try again.");
    } else {
      subscribeEmail = String(form.get("email") ?? "").trim();
      const consented = form.get("consent") === "1";
      if (!/^\S+@\S+\.\S+$/.test(subscribeEmail)) {
        subscribeError = say("subscribe.error.address", "That address doesn’t look complete.");
      } else if (!consented) {
        subscribeError = say("subscribe.error.consent", "The letter needs your agreement before it can be sent.");
      } else {
        const r = await fetch(`${SITE_API}/api/newsletter/subscribe`, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ email: subscribeEmail, consent: true }),
        });
        if (r.ok) subscribeState = "sent";
        else subscribeError = (await r.json().catch(() => null))?.detail
          ?? say("subscribe.error.failed", "That did not go through.");
      }
    }
  }
}

interface ScheduleRow {
  title: string;
  startsAt: string;
  durationMinutes: number | null;
  platform: string | null;
  url: string | null;
  notesMd: string | null;
}

interface HoroscopeIndex {
  covers: string;
  readings: { sign: string; published: boolean; bodyMd: string }[];
}

const [live, links, projects, horoscopes] = await Promise.all([
  site<LiveStatus>(PATHS.live),
  site<LinkGroups>(PATHS.links),
  site<Project[]>(PATHS.projects),
  site<HoroscopeIndex>("/api/horoscopes?period=monthly"),
]);

/* The two projects that lead the page.
 *
 * Chosen in the admin rather than taken from the top of the portfolio, because
 * say("text.what.should.stranger", "what should a stranger meet first") and "what order does the portfolio run
 * in" are different questions — and tying them together meant reordering all
 * of /work to change the front door.
 *
 * With nothing chosen it behaves as it always did and shows the first two, so
 * the section is never empty just because nobody has ticked anything yet.
 */
/* The invitation to support, and the prices it quotes. Both are fetched here
   rather than inside the band, because a component that fetches is a component
   that fetches again the next time somebody uses it. */
const [homeBlocks, billing] = await Promise.all([
  pageSections("home"),
  site<{ tiers: { amount: number | null; currency: string; interval: string }[] }>(
    "/api/billing/tiers",
  ),
]);
const swaraBlock = homeBlocks.find((b) => b.key === "support-cta") ?? null;

const featured = (projects ?? []).filter((p) => p.featured);
const leading = (featured.length > 0 ? featured : (projects ?? [])).slice(0, 2);

/* The SIGN PICKER waits for something to read — twelve links to twelve empty
   pages is worse than no picker. The SECTION does not: hiding it entirely
   meant that on the day the site went public, with nothing written yet, the
   homepage did not mention horoscopes at all and nobody could learn the
   feature existed. So the header always stands and the picker is what fills
   in, which is the same rule the rest of the site follows — an absent state
   is designed, not a deletion. */
const readings = horoscopes?.readings ?? [];
const anyReading = readings.some((r) => r.published);
const monthName = (() => {
  const m = /^(\d{4})-(\d{2})$/.exec(horoscopes?.covers ?? "");
  if (!m) return "";
  return new Date(Date.UTC(Number(m[1]), Number(m[2]) - 1, 1))
    .toLocaleDateString("en-GB", { month: "long", timeZone: "UTC" });
})();

const badge = badgeFrom(live);
const socials: SocialLink[] = Object.values(links?.groups ?? {})
  .flat()
  .map((l) => ({ platform: l.platform, href: l.url, label: l.label }));



/* The avatar is a square painted image and Hero composes it as a framed plate
   on the horizon — that is what the bundle's asset notes say it is for. The
   art-absent path stays implemented and is what renders if this ever goes
   missing. Clouds are deliberately not layered in yet: the delivered PNG is
   6.5MB, and the readme is explicit that the sky is fully designed without
   it. Optimising that asset is a task, not a licence to ship it as-is. */
const AVATAR = "/brand/avatar-square.png";

/* Named by the question each one answers, not by what it is. "Pañcāṅga" means
   nothing to someone who has not met it; "the five limbs of the day, and when
   each ends" tells them whether they want it. */
/* At most three — the API caps it, and drops any whose sponsorship has ended,
   so the loudest page on the site never thanks somebody who stopped months
   ago. */
const sponsors = (await site<any[]>("/api/content/sponsors/featured")) ?? [];
const room = await site<any>("/api/community/discord");

/* What the middleware decided, so the page and the gate cannot disagree. */
const sectionsLive: Record<string, boolean> = Astro.locals.sectionsLive ?? {};

/* The newest open poll, and only one. A live question is a reason to come
   back; a column of them is a survey. The community page has the rest. */
const openPoll = ((await site<any[]>("/api/community/polls/open")) ?? [])
  .find((p: any) => !p.closed) ?? null;

/* The nine instruments come from their rows — see lib/instruments.ts. The
   landing page's line for each is its own field, because a stranger skimming
   wants a different sentence from somebody already on the tool.

   "Day at a glance" is not one of them and is written here: it points at
   /today, which is a page rather than an instrument, and giving it a row would
   mean putting a card on /tools that leaves /tools. */
const TODAY = {
  glyph: "☾", name: "Day at a glance", href: "/today", wide: true,
  answers: say("text.what.doing.right", "What the sky is doing right now, where you are — luminaries, stations, the planetary hour, and today in four reckonings."),
};
const INSTRUMENTS = [
  TODAY,
  ...(await instruments()).map((i) => ({
    glyph: i.glyph, name: i.name, href: i.href, wide: false,
    answers: i.landingBlurb,
  })),
];
---

<BaseLayout
  title={say("meta.title", "Shruti — instruments for magick")}
  description={say("meta.description", "Software for astrology, theurgy and divination — built live on stream from Athens.")}
>
  {/* Outside `.page` so the sky can reach both edges; the Hero puts its own
      words back into the column. */}
  <Hero
      bleed
      greeting={say("text.8", "Welcome · Καλώς ήρθατε · स्वागत")}
      title={say("hero.title", "I build instruments for magick.")}
      subtitle={say("text.9", "Software for astrology, theurgy and divination — built live on stream from Athens.")}
      art={AVATAR}
      artWidth={512}
      artHeight={512}
      artAlt="Shruti"
    >
      <Fragment slot="actions">
        {
          badge.status === "live" ? (
            <Button variant="live" size="lg" href={badge.href ?? "/videos"}>Watch live</Button>
          ) : (
            <Button size="lg" href="/schedule">Next stream</Button>
          )
        }
        <Button variant="secondary" size="lg" href="/work">{say("text.6", "See the work")}</Button>
      </Fragment>
      <Fragment slot="footnote">
        <div class="hero-foot-row">
          <LiveBadge
            status={badge.status}
            title={badge.title}
            href={badge.href ?? "/videos"}
          />
          <SocialLinkRow links={socials} size={16} />
        </div>
      </Fragment>
  </Hero>

  <div class="page">
    <SupportBand block={swaraBlock} tiers={billing?.tiers ?? []} />
  </div>

  {/* What is happening, before the catalogue. Somebody arriving cold should
      learn whether she is on and where people are talking before being shown
      nine tools — the landing page is for interaction, support and community,
      and only then an overview of what the site does. */}
  <HappeningNow live={live} room={room} />

  {
    openPoll && (
      <section class="section page home-poll">
        {/* No "everything happening" link here: the band directly above this
            already carries one, and two identical links a few lines apart read
            as a mistake rather than as emphasis. */}
        <span class="t-eyebrow">Have a say</span>
        <PollCard poll={openPoll} />
      </section>
    )
  }

  {/* The instruments, above the fold's neighbours, because they are the reason
      to come back — a visitor who leaves without knowing these run here has
      missed the site. Each names what it answers rather than what it is. */}
  <section class="section page">
    <div class="section-head">
      <SectionHeader
        glyph="✶"
        eyebrow={say("text.3", "Run them here")}
        title={say("instruments.title", "Instruments, in your browser")}
        body={say("text.4", "Working software for practice — no install, no account, and they answer for wherever you are.")}
      />
      <Button variant="ghost" href="/today">{say("instruments.link", "Day at a glance →")}</Button>
    </div>
    {/* A working wheel, not a screenshot of one. The links below say what the
        instruments answer; this one is already answering, computed by her own
        ephemeris while the page loads. It is also the surface people will have
        just seen on the stream, which is the whole point of a web variant —
        somebody arriving from a clip finds the same instrument here. */}
    <div class="instrument-proof">
      <SkyCard level={3} />
      <div class="instruments">
      {
        INSTRUMENTS.map((i) => (
          <a class="instrument" href={i.href} data-wide={i.wide || undefined}>
            <span class="i-glyph t-glyph" aria-hidden="true">{i.glyph}</span>
            <span class="i-name">{i.name}</span>
            <span class="i-answers">{i.answers}</span>
            <span class="i-go" aria-hidden="true">→</span>
          </a>
        ))
      }
      </div>
    </div>
  </section>

  {/* After the instruments and before the account invitation: somebody who has
      just seen what the site does is the right person to read who pays for it,
      and it must not be the first thing anybody meets. */}

  <SponsorRow sponsors={sponsors} />

  {/* An INVITATION, not a teaser. The design's rule for the signed-out state
      is that the free half must be fully useful on its own — "if the page is a
      teaser for signing up, nobody signs up" — so this says what an account
      ADDS rather than what it withholds, and says out loud that everything
      above works without one. No lock, no blur, no count of what is missing. */}
  <section class="section page">
    <div class="account-invite">
      <div class="ai-words">
        <span class="t-eyebrow">{say("text.7", "A free account")}</span>
        <h2>{say("account.heading", "Save a nativity, and the instruments start answering about you")}</h2>
        <p class="ai-lead">{say("account.lede", "Everything above works without an account and always will. What an account changes is that the tools stop asking where and when, and start knowing.")}</p>
        <ul class="ai-list">
          <li>
            <span class="t-glyph" aria-hidden="true">✶</span>
            <span>
              <strong>{say("account.perk1.title", "Your chart, kept.")}</strong>{" "}
              {say("account.perk1.body", "Cast once and it is there — no re-typing a birth time and a city every time you want to look at it.")}
            </span>
          </li>
          <li>
            <span class="t-glyph" aria-hidden="true">☾</span>
            <span>
              <strong>{say("account.perk2.title", "Transits on Day at a glance.")}</strong>{" "}
              {say("account.perk2.body", "The one block on that page that needs to know where you were born. Nothing else does.")}
            </span>
          </li>
          <li>
            <span class="t-glyph" aria-hidden="true">☉</span>
            <span>
              <strong>{say("account.perk3.title", "Your place, remembered.")}</strong>{" "}
              {say("account.perk3.body", "Stations, sunrise and the pañcāṅga answer for where you actually are, without setting it each visit.")}
            </span>
          </li>
          <li>
            <span class="t-glyph" aria-hidden="true">◐</span>
            <span>
              <strong>{say("account.perk4.title", "Your sign first.")}</strong>{" "}
              {say("account.perk4.body", "The monthly reading opens on yours instead of twelve to choose from.")}
            </span>
          </li>
        </ul>
        <div class="ai-actions">
          <Button size="lg" href="/signup">{say("account.button", "Make an account")}</Button>
          <Button variant="ghost" href="/signin">Sign in</Button>
        </div>
        <p class="ai-quiet">{say("text.1", "Nothing public — no profile, no avatar, no follower count. Birth data is a separate, optional decision, and withdrawing it deletes it. Free, and staying that way.")}</p>
      </div>
    </div>
  </section>


  {
    /* Gone entirely while the section is unpublished. Hiding only the links
       would leave a heading promising twelve readings with no way to reach
       one, which reads as broken rather than as not-yet. */
    sectionsLive.horoscopes !== false && (
    <section class="section page">
      <div class="section-head">
        <SectionHeader
          glyph="☾"
          eyebrow="Horoscopes"
          title={monthName ? `${monthName}, one per sign` : "This month, one per sign"}
          body={say("text.5", "Twelve readings a month, written by hand and signed Soror Eu. A. Pick a sign — or save a nativity and yours comes up first.")}
        />
        <Button variant="ghost" href="/horoscopes">
          {anyReading ? "All twelve →" : "How they work →"}
        </Button>
      </div>
      {
        anyReading ? (
          <SignPicker
            signs={readings.map((r) => ({ sign: r.sign, published: r.published }))}
            hrefFor={(s) => `/horoscopes/${s}/monthly`}
          />
        ) : (
          /* No date promised. A month named here and missed reads as an
             abandoned site, which is a worse thing to say than "not yet". */
          <p class="horo-absent"><Copy text={say("text.2", "○ The first set is not up yet. When it is, twelve go up together — and every past month stays readable in [the archive](/horoscopes/archive) rather than being replaced.")} /></p>
        )
      }
    </section>
    )
  }

  <section class="section page">
    <div class="section-head">
      <SectionHeader
        glyph="✶"
        eyebrow="The work"
        title={say("work.title", "A portfolio of instruments")}
        body={say("work.body", "The proof behind the brand: real software for real practice.")}
      />
      <Button variant="ghost" href="/work">{say("work.link", "About the work →")}</Button>
    </div>
    {
      leading.length > 0 ? (
        <div class="grid-2">
          {leading.map((p) => (
            <ProjectCard
              name={p.name}
              tagline={p.tagline}
              status={(p.status as "active" | "maintained" | "archived") ?? "active"}
              repoHref={p.repoUrl || undefined}
              liveHref={p.siteUrl || undefined}
              screenshot={p.media ?? null}
            />
          ))}
        </div>
      ) : (
        <p class="quiet-empty">{say("journal.empty", "Nothing published here yet.")}</p>
      )
    }
  </section>

  {/* Last thing on the page, which is where somebody who read to the bottom is
      most likely to want it. The block carries its own consent wording and its
      own "check your email" state — see SubscribeBlock. */}
  <section class="section page" id="newsletter">
    <SubscribeBlock state={subscribeState} email={subscribeEmail} error={subscribeError} />
  </section>
</BaseLayout>

<style>
  .instrument-proof { display: grid; gap: 16px; }
  @media (min-width: 900px) {
    .instrument-proof { grid-template-columns: minmax(280px, 360px) 1fr; align-items: start; }
  }

  .horo-absent {
    font: 400 var(--text-body) / var(--leading-body) var(--font-body);
    color: var(--ink-faint); margin: 0; max-width: 62ch;
  }
  .horo-absent a { color: var(--accent); }

  .hero-foot-row { display: flex; gap: 16px; align-items: center; flex-wrap: wrap; }

  .account-invite {
    background: var(--surface-card);
    border: var(--border-w) solid var(--line-strong);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-1);
    padding: clamp(20px, 4vw, var(--space-6));
  }
  .ai-words { display: grid; gap: 12px; max-width: 68ch; }
  .account-invite h2 {
    font: 600 var(--text-h2) var(--font-display);
    line-height: var(--leading-heading);
    color: var(--ink);
    margin: 0;
    text-wrap: balance;
  }
  .ai-lead { font: 400 var(--text-h4) / var(--leading-body) var(--font-display); color: var(--ink-soft); margin: 0; }
  .ai-list {
    list-style: none;
    margin: var(--space-3) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: var(--space-3) var(--space-5);
  }
  .ai-list li { display: flex; gap: 10px; align-items: baseline; }
  .ai-list .t-glyph { color: var(--rose); font: 400 1.1rem var(--font-display); flex: none; }
  .ai-list span:last-child { font: 400 var(--text-sm) / 1.6 var(--font-body); color: var(--ink-soft); }
  .ai-list strong { font-weight: 600; color: var(--ink); }
  .ai-actions { display: flex; gap: 10px; flex-wrap: wrap; align-items: center; margin-top: var(--space-3); }
  .ai-quiet { font: 400 var(--text-xs) / 1.6 var(--font-body); color: var(--ink-faint); margin: 0; max-width: 66ch; }

  .instruments {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: var(--space-3);
  }
  .instrument {
    position: relative;
    display: grid;
    grid-template-columns: auto 1fr auto;
    grid-template-areas: "glyph name go" "glyph answers answers";
    gap: 2px var(--space-3);
    align-items: baseline;
    padding: var(--space-4);
    background: var(--surface-card);
    border: var(--border-w) solid var(--line);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-1);
    text-decoration: none;
    transition:
      border-color var(--dur-1) var(--ease-out),
      box-shadow var(--dur-1) var(--ease-out);
  }
  /* Hover deepens and strengthens; it does not lift or scale. */
  .instrument:hover { border-color: var(--line-strong); box-shadow: var(--shadow-2); }
  .instrument:hover .i-name { color: var(--accent-hover); }
  .instrument:hover .i-go { color: var(--accent); transform: translateX(2px); }
  /* The one that answers the most gets the width, not a different colour. */
  .instrument[data-wide] { grid-column: 1 / -1; }
  .instrument[data-wide] .i-name { font-size: var(--text-h3); }
  .i-glyph { grid-area: glyph; font: 400 1.5rem var(--font-display); color: var(--rose); line-height: 1; }
  .i-name { grid-area: name; font: 600 var(--text-h4) var(--font-display); color: var(--ink); transition: color var(--dur-1) var(--ease-out); }
  .i-answers {
    grid-area: answers;
    font: 400 var(--text-sm) / 1.55 var(--font-body);
    color: var(--ink-soft);
    margin-top: 4px;
  }
  .i-go {
    grid-area: go;
    font: 400 var(--text-body) var(--font-body);
    color: var(--ink-faint);
    transition: color var(--dur-1) var(--ease-out), transform var(--dur-1) var(--ease-out);
  }
  .quiet-empty {
    font-family: var(--font-body);
    font-size: var(--text-body);
    line-height: var(--leading-body);
    color: var(--ink-soft);
    margin: 0;
    max-width: 52ch;
  }

  .home-poll { display: grid; gap: var(--space-4); }
  .hp-head { display: flex; gap: var(--space-4); align-items: baseline; justify-content: space-between; flex-wrap: wrap; }
  .hp-all { font: 500 var(--text-sm) var(--font-body); color: var(--accent); text-decoration: none; }
  .hp-all:hover { text-decoration: underline; }
</style>

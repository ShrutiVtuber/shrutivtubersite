---
/* 404 — copy verbatim from `ui_kits/site/App.jsx`. In character, per the
   handoff: an error page is still the brand talking. */
import BaseLayout from "../layouts/BaseLayout.astro";
import Button from "../components/forms/Button.astro";
import { copy } from "../lib/copy";

/* Every word on this page, editable from the admin. The defaults below are
   what it was written with and what still renders if nothing was changed. */
const say = await copy("404");


/* Said explicitly, because this page is REWRITTEN to as well as routed to.
 * Astro sets 404 for an address that matches nothing, but a rewrite keeps the
 * status of the request it came from — so a section she has not published yet
 * would render this page with a 200. A 200 saying "not found" is a lie told to
 * a crawler as much as to a person, and it is how pages that do not exist end
 * up indexed. */
Astro.response.status = 404;
---

<BaseLayout title={say("text.1", "Not found — Shruti")} description={say("text.2", "This page is in another sky.")}>
  <div class="page err">
    <span class="err-glyph t-glyph" aria-hidden="true">☾</span>
    <h1>{say("this-page-is-in-another-.1", "This page is in another sky.")}</h1>
    <p>{say("this-page-is-in-another-.2", "The address may have moved when the site was rebuilt — the almanac below will get you home.")}</p>
    <div class="err-actions">
      <Button href="/">Back home</Button>
      <Button variant="secondary" href="/journal">{say("text.3", "Read the journal")}</Button>
    </div>
  </div>
</BaseLayout>

<style>
  .err {
    display: grid;
    justify-items: center;
    text-align: center;
    gap: 14px;
    padding: var(--space-9) var(--space-4);
  }
  .err-glyph { font-family: var(--font-display); font-size: 44px; color: var(--rose); line-height: 1; }
  .err h1 { font: 600 var(--text-h2) var(--font-display); color: var(--ink); margin: 0; }
  .err p { font: 400 var(--text-body) var(--font-body); color: var(--ink-soft); margin: 0; max-width: 40ch; }
  .err-actions { display: flex; gap: 10px; flex-wrap: wrap; justify-content: center; }
  .err-code { font: 400 var(--text-sm) var(--font-mono); color: var(--ink-soft); margin: 0; }
</style>

---
/* One click, no login, and THIS PAGE DOES NOT ARGUE.
 *
 * No survey, no "are you sure", no win-back offer. It mentions pause once,
 * because a pause keeps more people than an unsubscribe loses — and then it
 * stops.
 */
import BaseLayout from "../../layouts/BaseLayout.astro";
import SectionHeader from "../../components/brand/SectionHeader.astro";
import Button from "../../components/forms/Button.astro";
import { SITE_API } from "../../lib/api";
import { copy } from "../../lib/copy";
import Copy from "../../components/content/Copy.astro";

/* Every word here, editable from the admin. The defaults below are what
   it was written with and what still renders if nothing was changed. */
const say = await copy("newsletter/unsubscribed");


const token = Astro.url.searchParams.get("token") ?? "";
let ok = false;
let email = "";

if (token) {
  const r = await fetch(`${SITE_API}/api/newsletter/unsubscribe?token=${encodeURIComponent(token)}`);
  const body = await r.json().catch(() => null);
  if (r.ok) { ok = true; email = body.email; }
}
---

<BaseLayout title={say("text.1", "Unsubscribed — Shruti")} description={say("text.2", "You have been removed from the monthly letter.")} noindex>
  <div class="page out">
    <SectionHeader as="h1" glyph="○" eyebrow="Unsubscribed" title="Done" />
    <p class="body">
      {ok
        ? <Copy text={say("done.known", "**{email}** will not get the letter again.")} vars={{ email }} />
        : say("done.unknown", "That address will not get the letter again.")}
      {" "}{say("done.tail", "No further email, and nothing else needed from you.")}
    </p>
    {/* Mentioned once. Then it stops.
        
        The link's HREF carries a token, so the address is a value rather than
        something she would ever type. `{pause}` keeps the sentence whole and
        the token out of the admin. */}
    {
      ok && token && (
        <p class="body quiet">
          <Copy
            text={say("text.4", "If you only wanted a break rather than an ending, there is [a pause]({pause}). It deletes nothing.")}
            vars={{ pause: `/newsletter/preferences?token=${encodeURIComponent(token)}` }}
          />
        </p>
      )
    }
    <div class="actions"><Button variant="secondary" href="/">{say("text.3", "Back to the site")}</Button></div>
  </div>
</BaseLayout>

<style>
  .out { max-width: 600px; display: grid; gap: var(--space-3); }
  .body { font: 400 var(--text-body) / var(--leading-body) var(--font-body); color: var(--ink-soft); margin: 0; max-width: 62ch; }
  .quiet { color: var(--ink-faint); font-size: var(--text-sm); }
  .quiet a { color: var(--accent); }
  .actions { display: flex; gap: 10px; margin-top: var(--space-4); }
</style>

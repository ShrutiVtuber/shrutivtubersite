---
/* One archived issue, in full and public. */
import BaseLayout from "../../../layouts/BaseLayout.astro";
import SectionHeader from "../../../components/brand/SectionHeader.astro";
import Prose from "../../../components/content/Prose.astro";
import SubscribeBlock from "../../../components/brand/SubscribeBlock.astro";
import { site } from "../../../lib/api";
import { renderMarkdown } from "../../../lib/markdown";

const slug = String(Astro.params.slug ?? "");
interface Issue { slug: string; subject: string; letterMd: string; sentAt: string | null }
const issue = await site<Issue>(`/api/newsletter/archive/${encodeURIComponent(slug)}`);
if (!issue) return Astro.rewrite("/404");
const html = await renderMarkdown(issue.letterMd);
---

<BaseLayout title={`${issue.subject} — Shruti`} description={`An issue of the monthly letter, sent ${issue.sentAt?.slice(0, 10) ?? ""}.`}>
  <div class="page issue">
    <SectionHeader
      as="h1" glyph="⁂" eyebrow={issue.sentAt?.slice(0, 10) ?? "Archive"} title={issue.subject}
    />
    {/* The letter signs Shruti; the horoscope readings sign Soror Eu. A. */}
    <Prose html={html} byline="Shruti" />
    <div class="sub"><SubscribeBlock compact /></div>
    <p class="back"><a href="/newsletter">← Every issue</a></p>
  </div>
</BaseLayout>

<style>
  .issue { max-width: 720px; display: grid; gap: var(--space-5); }
  .sub { margin-top: var(--space-5); }
  .back { margin: 0; font: 400 var(--text-sm) var(--font-body); }
  .back a { color: var(--accent); text-decoration: none; }
</style>

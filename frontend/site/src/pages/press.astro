---
/* Press / media kit — ported from `ui_kits/site/Press.jsx`.
 *
 * THE WARNING IN THE BRIEF GOVERNS THIS PAGE. Audience figures are static
 * sample values with say("text.live.numbers.request", "live numbers on request") stated in the page, and nothing
 * is wired to an API. The client's reference case was an indie press kit that
 * rendered NINE ZEROES because its automation broke and nobody noticed — a
 * sponsor reading nine zeroes concludes the audience is zero.
 *
 * So: no figures are rendered here at all until real ones exist. If these are
 * ever wired to live APIs, the failure mode must HIDE THE BLOCK, never render
 * a zero.
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import Prose from "../components/content/Prose.astro";
import SectionFigure from "../components/blocks/SectionFigure.astro";
import SectionHeader from "../components/brand/SectionHeader.astro";
import Button from "../components/forms/Button.astro";
import EmptyState from "../components/feedback/EmptyState.astro";
import { pageSections } from "../lib/content";
import { copy } from "../lib/copy";
import Copy from "../components/content/Copy.astro";

/* Every word on this page, editable from the admin. The defaults below are
   what it was written with and what still renders if nothing was changed. */
const say = await copy("press");


const sections = await pageSections("press");
const intro = sections.find((s) => s.key === "intro");
const extra = sections.filter((s) => s.key !== "intro");
---

<BaseLayout title={say("text.1", "Press & media kit — Shruti")} description={say("text.2", "Press and media kit: brand-safety statement, logo and portrait pack, what Shruti will and will not cover, and the route for business enquiries.")}>
  <div class="page">
    <SectionHeader
      as="h1" glyph="☿" eyebrow="Press" title={intro?.title || "Media kit"}
      body={say("text.3", "Everything a collaborator or journalist needs, in one place.")}
    />

    <section class="press-block">
      <h2>{say("audience.1", "Audience")}</h2>
      {/* Deliberately no numbers. See the file header. */}
      <p class="press-note">
        <Copy text={say("audience.2", "Live numbers on request — [business@shrutivtuber.com](mailto:business@shrutivtuber.com). Figures are not published here because a stale or broken figure is worse than none.")} />
      </p>
    </section>

    <section class="press-block">
      <h2>{say("brand-safety.1", "Brand safety")}</h2>
      <p>{say("brand-safety.2", "Content is programming, astrology and magickal practice. No gambling, no crypto promotion, no political campaigning. Streams are bilingual English and Greek. Occult subject matter is treated as scholarship and practice, never as spectacle, and restricted material is named rather than detailed.")}</p>
    </section>

    <section class="press-block">
      <h2>{say("the-name.1", "The name")}</h2>
      <p>
        <Copy text={say("the-name.2", "**Shruti** — Shruti Swara — is the brand and the real name; use it for titles, credits and copy. *Soror Eu. A.* signs magickal writing only and is not a handle or a second logo. **Theourgia** is the software.")} />
      </p>
    </section>

    <section class="press-block">
      <h2>{say("assets.1", "Assets")}</h2>
      <EmptyState
        glyph="◐"
        title={say("text.4", "Asset pack not published yet")}
        body={say("text.5", "The wordmark, clear-space rules and hex codes are packaged on request until the download is ready.")}
      >
        <Button slot="action" variant="secondary" href="/contact">{say("text.6", "Request the pack")}</Button>
      </EmptyState>
    </section>
  </div>

    {/* Anything else the admin has put on this page. Only `intro` used to
        render, so a block added in the admin simply did not appear — which
        makes the editor feel broken rather than the page feel empty. */}
    {
      extra.length > 0 && (
        <div class="page-sections">
          {
            extra.map((s) => (
              <section class="page-section">
                {s.title && <h2>{s.title}</h2>}
                <SectionFigure media={s.media} title={s.title} />
                <Prose html={s.html} />
              </section>
            ))
          }
        </div>
      )
    }

</BaseLayout>

<style>
  .press-block { margin-top: var(--space-6); display: grid; gap: 10px; }
  .press-block h2 { font: 600 var(--text-h3) var(--font-display); color: var(--ink); margin: 0; }
  .press-block p {
    font: 400 var(--text-body) / var(--leading-body) var(--font-body);
    color: var(--ink-soft);
    margin: 0;
    max-width: 66ch;
  }
  .press-note { font-family: var(--font-body); }
  .press-block a { color: var(--accent); }

  .page-sections { display: grid; gap: var(--space-6); margin-top: var(--space-6); }
  .page-section { display: grid; gap: var(--space-3); }
  .page-section h2 { font: 600 var(--text-h3) var(--font-display); color: var(--ink); margin: 0; }
</style>

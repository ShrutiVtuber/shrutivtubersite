---
/* When can all of us actually be live at once?
 *
 * Built because the tool does not exist. The research looked for a VTuber
 * timezone-coordination tool and found none, and the closest thing anybody had
 * — kson-schedule.com, which aggregated across platforms with a timezone
 * selector — is dead with no DNS at all. The tooling died with the site, which
 * is its own argument for owning the stack.
 *
 * **Stateless on purpose.** Every participant is in the query string, so the
 * page has nothing to store, nothing to leak, and nothing to expire. Sharing
 * the plan is sharing the URL, and a link that still works in six months does
 * not depend on this site remembering anything about anybody.
 *
 * Server-rendered like everything else here: it works with scripting off, and
 * the whole grid is one page load.
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionHeader from "../components/brand/SectionHeader.astro";
import Button from "../components/forms/Button.astro";
import Prose from "../components/content/Prose.astro";
import { pageSections } from "../lib/content";
import ToolCta from "../components/brand/ToolCta.astro";
import CsrfField from "../components/forms/CsrfField.astro";
import { asReader, account } from "../lib/account";
import { verifyCsrf } from "../lib/csrf";
import { copy } from "../lib/copy";

/* Every word on this page, editable from the admin. The defaults below are
   what it was written with and what still renders if nothing was changed. */
const t = await copy("collab");


export const prerender = false;

const q = Astro.url.searchParams;

/* Saving a group is the ONE thing the URL cannot do for you — carry a set of
   people across devices — which is why it is the thing an account buys here.
   Everything else on this page works signed out and always will. */
const me = await account(Astro);
const signedIn = Boolean(me);
let saveNote = "";
let saveFailed = "";

/* Zones from the runtime rather than a bundled list, so the tool cannot drift
   out of date with the world's politics — the zone database changes several
   times a year and a hard-coded list would quietly go wrong. */
let ZONES: string[] = [];
try {
  ZONES = (Intl as any).supportedValuesOf?.("timeZone") ?? [];
} catch {
  ZONES = [];
}
if (ZONES.length === 0) ZONES = ["UTC", "Europe/Athens", "Europe/London", "America/New_York", "Asia/Tokyo"];

interface Person { name: string; zone: string; from: number; to: number }

/* Each participant is one `p` parameter: name|zone|from|to. Repeated rather
   than indexed, so adding somebody never renumbers anybody else's entry. */
const raw = q.getAll("p");
const people: Person[] = raw.slice(0, 12).map((entry, i) => {
  const [name = "", zone = "UTC", from = "16", to = "24"] = entry.split("|");
  const f = Number(from), t = Number(to);
  return {
    name: name.trim().slice(0, 40) || `Person ${i + 1}`,
    zone: ZONES.includes(zone) ? zone : "UTC",
    from: Number.isFinite(f) ? Math.min(23, Math.max(0, Math.trunc(f))) : 16,
    /* 24 means midnight at the end of the day, which is a real answer for a
       streamer and is not the same as 0. */
    to: Number.isFinite(t) ? Math.min(24, Math.max(1, Math.trunc(t))) : 24,
  };
});

/* The local hour a given UTC hour lands on, for one zone, on a fixed date.
   A date is needed because offsets move: half the world changes clocks and the
   answer for July is not the answer for January. */
const when = q.get("on") || new Date().toISOString().slice(0, 10);
const localHour = (zone: string, utcHour: number): { hour: number; day: number } => {
  const at = new Date(`${when}T${String(utcHour).padStart(2, "0")}:00:00Z`);
  const parts = new Intl.DateTimeFormat("en-GB", {
    timeZone: zone, hour: "2-digit", hour12: false, day: "2-digit",
  }).formatToParts(at);
  const hour = Number(parts.find((p) => p.type === "hour")?.value ?? "0");
  const day = Number(parts.find((p) => p.type === "day")?.value ?? "0");
  return { hour: hour % 24, day };
};

const suits = (p: Person, hour: number) =>
  p.to > p.from ? hour >= p.from && hour < p.to
                : hour >= p.from || hour < p.to;   // a window across midnight

/* One column per UTC hour: who it works for, and how many. */
const columns = Array.from({ length: 24 }, (_, utcHour) => {
  const cells = people.map((p) => {
    const { hour, day } = localHour(p.zone, utcHour);
    return { hour, day, ok: suits(p, hour) };
  });
  return { utcHour, cells, count: cells.filter((c) => c.ok).length };
});

/* The runs where everybody is available, longest first. A run is what people
   actually want — "18:00 to 21:00 UTC", not three separate green cells. */
const best: { start: number; end: number }[] = [];
if (people.length > 0) {
  let start: number | null = null;
  for (let h = 0; h <= 24; h++) {
    const all = h < 24 && columns[h].count === people.length;
    if (all && start === null) start = h;
    if (!all && start !== null) { best.push({ start, end: h }); start = null; }
  }
  best.sort((a, b) => (b.end - b.start) - (a.end - a.start));
}

if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  if (!verifyCsrf(Astro.cookies, form)) {
    saveFailed = "That did not save. Reload the page and try again.";
  } else if (form.get("action") === "save") {
    const r = await asReader(Astro, "/api/collab/groups", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({
        name: String(form.get("name") ?? ""),
        participants: people.map((p) => `${p.name}|${p.zone}|${p.from}|${p.to}`),
      }),
    });
    saveNote = r.ok ? "Kept. It is in your groups below." : "";
    if (!r.ok) saveFailed = r.body?.detail ?? "That could not be kept.";
  } else if (form.get("action") === "forget") {
    const r = await asReader(Astro, `/api/collab/groups/${form.get("id")}`, { method: "DELETE" });
    if (!r.ok) saveFailed = r.body?.detail ?? "That could not be removed.";
  }
}

const groups = signedIn
  ? ((await asReader(Astro, "/api/collab/groups")).body ?? [])
  : [];

/* A saved group is loaded by rebuilding the same link the page already reads,
   so there is exactly one way in and nothing to keep in step. */
const linkFor = (g: any) =>
  `/collab?${g.participants.map((x: string) => `p=${encodeURIComponent(x)}`).join("&")}`;

const shareUrl = `${Astro.url.origin}${Astro.url.pathname}${Astro.url.search}`;
const sections = await pageSections("collab");
const two = (n: number) => String(n).padStart(2, "0");
const encode = (p: Person) => `${p.name}|${p.zone}|${p.from}|${p.to}`;

/* A shortlist first: 400-odd zones in a datalist is technically complete and
   practically unusable, and the long list is still there underneath it. */
const COMMON = [
  "Europe/Athens", "Europe/London", "Europe/Berlin", "Europe/Lisbon",
  "America/New_York", "America/Chicago", "America/Denver", "America/Los_Angeles",
  "America/Sao_Paulo", "Asia/Tokyo", "Asia/Seoul", "Asia/Singapore",
  "Asia/Kolkata", "Australia/Sydney", "Pacific/Auckland", "UTC",
].filter((z) => ZONES.includes(z));
---

<BaseLayout
  title="Collab planner — Shruti"
  description="Find an hour that works for everybody, across any number of timezones. Free, no account, nothing stored — the whole plan lives in the link."
>
  <div class="page collab">
    <SectionHeader
      as="h1" glyph="☾" eyebrow="A tool for creators"
      title="When can all of us be live?"
      body="Put everybody in, get the hours that work for all of them, and send the link. Nothing is stored — the whole plan is in the address bar, so it still works in six months and there is no account to lose."
    />

    {groups.length > 0 && (
      <section class="cb-groups">
        <h2>{t("your-groups.1", "Your groups")}</h2>
        <ul>
          {groups.map((g: any) => (
            <li>
              <a href={linkFor(g)}>
                <span class="cb-gname">{g.name}</span>
                <span class="cb-gwho t-tabular">
                  {g.participants.map((x: string) => x.split("|")[0]).join(" · ")}
                </span>
              </a>
              <form method="POST">
                <CsrfField />
                <input type="hidden" name="action" value="forget" />
                <input type="hidden" name="id" value={g.id} />
                <button type="submit" aria-label={`Forget ${g.name}`}>Forget</button>
              </form>
            </li>
          ))}
        </ul>
      </section>
    )}

    <form method="GET" class="cb-form">
      <div class="cb-people">
        {[...people, null].map((p, i) => (
          <fieldset class="cb-person">
            <legend>{p ? p.name : "Add somebody"}</legend>
            <label>
              <span>Name</span>
              <input name={`n${i}`} maxlength="40" value={p?.name ?? ""} placeholder="Their handle" />
            </label>
            <label>
              <span>Timezone</span>
              <input name={`z${i}`} list="zones" value={p?.zone ?? ""} placeholder="Europe/Athens" />
            </label>
            <div class="cb-window">
              <label>
                <span>Streams from</span>
                <input name={`f${i}`} type="number" min="0" max="23" value={p?.from ?? 16} />
              </label>
              <label>
                <span>until</span>
                <input name={`t${i}`} type="number" min="1" max="24" value={p?.to ?? 24} />
              </label>
            </div>
          </fieldset>
        ))}
      </div>

      <datalist id="zones">
        {COMMON.map((z) => <option value={z} />)}
        {ZONES.filter((z) => !COMMON.includes(z)).map((z) => <option value={z} />)}
      </datalist>

      <div class="cb-actions">
        <label class="cb-date">
          <span>On</span>
          <input type="date" name="on" value={when} />
        </label>
        <Button type="submit">Work it out</Button>
        <p class="cb-fine">
          Their hours are in <strong>their own</strong> local time — “from 16 until 24”
          means four in the afternoon to midnight where they are.
        </p>
      </div>
    </form>

    {people.length > 0 && (
      <>
        <section class="cb-answer">
          <h2>{best.length > 0 ? "Everybody is free" : "No hour works for everybody"}</h2>
          {best.length > 0 ? (
            <ul class="cb-runs">
              {best.slice(0, 3).map((r) => (
                <li>
                  <span class="cb-run t-tabular">{two(r.start)}:00 – {two(r.end % 24)}:00 UTC</span>
                  <span class="cb-runlen">{r.end - r.start} {r.end - r.start === 1 ? "hour" : "hours"}</span>
                  <span class="cb-runlocal">
                    {people.map((p) => `${p.name} ${two(localHour(p.zone, r.start).hour)}:00`).join(" · ")}
                  </span>
                </li>
              ))}
            </ul>
          ) : (
            <p class="cb-none">
              The best any hour manages is{" "}
              <strong>{Math.max(...columns.map((c) => c.count))} of {people.length}</strong>.
              Widening one person's window by an hour is usually enough — the grid
              below shows who is the constraint.
            </p>
          )}
        </section>

        <section class="cb-gridwrap">
          <h2>{t("hour-by-hour.1", "Hour by hour")}</h2>
          <div class="cb-scroll">
            <table class="cb-grid">
              <thead>
                <tr>
                  <th scope="col">UTC</th>
                  {people.map((p) => <th scope="col">{p.name}</th>)}
                  <th scope="col">All</th>
                </tr>
              </thead>
              <tbody>
                {columns.map((c) => (
                  <tr data-all={c.count === people.length ? "" : undefined}>
                    <th scope="row" class="t-tabular">{two(c.utcHour)}:00</th>
                    {c.cells.map((cell) => (
                      <td class="t-tabular" data-ok={cell.ok ? "" : undefined}>
                        {two(cell.hour)}:00
                      </td>
                    ))}
                    <td class="t-tabular cb-count">{c.count}/{people.length}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          <p class="cb-fine">
            Computed for {when}, because offsets move — half the world changes
            its clocks and the answer for July is not the answer for January.
          </p>
        </section>

        <section class="cb-keep">
          {signedIn ? (
            <>
              <h2>{t("keep-this-group.1", "Keep this group")}</h2>
              <p class="cb-fine">{t("keep-this-group.2", "So you do not have to type them in again on another machine.")}</p>
              {saveNote && <p class="cb-ok">{saveNote}</p>}
              {saveFailed && <p class="cb-bad">{saveFailed}</p>}
              <form method="POST" class="cb-saveform">
                <CsrfField />
                <input type="hidden" name="action" value="save" />
                <input name="name" maxlength="80" placeholder="What to call it — “Tuesday crew”" />
                <Button type="submit">Keep it</Button>
              </form>
            </>
          ) : (
            <>
              <h2>{t("keep-this-group.3", "Keep this group")}</h2>
              <p class="cb-fine">
                <a href="/signin">Sign in</a> and this set of people stops being
                something you have to keep a tab open for — it will be here on
                your phone too. The planner itself never needs an account, and
                the link above works for everybody either way.
              </p>
            </>
          )}
        </section>

        <section class="cb-share">
          <h2>{t("send-it-to-them.1", "Send it to them")}</h2>
          <p class="cb-fine">{t("send-it-to-them.2", "The whole plan is in this link. Nothing about it is stored here.")}</p>
          <input class="cb-url" type="text" readonly value={shareUrl}
                 aria-label="A link to this plan" onclick="this.select()" />
        </section>
      </>
    )}

    <ToolCta />

    {sections.map((s) => (
      <section class="cb-said">
        {s.title && <h2>{s.title}</h2>}
        <Prose html={s.html} />
      </section>
    ))}
  </div>
</BaseLayout>

<script>
  /* The form posts n0/z0/f0/t0…; the URL wants one `p` per person. Done on
     submit so the address stays short and shareable. Without scripting the
     numbered fields still arrive and the page reads them below. */
  const form = document.querySelector<HTMLFormElement>(".cb-form");
  form?.addEventListener("submit", (e) => {
    e.preventDefault();
    const data = new FormData(form);
    const url = new URL(window.location.href);
    url.search = "";
    for (let i = 0; i < 13; i++) {
      const n = String(data.get(`n${i}`) ?? "").trim();
      const z = String(data.get(`z${i}`) ?? "").trim();
      if (!n && !z) continue;
      const f = String(data.get(`f${i}`) ?? "16");
      const t = String(data.get(`t${i}`) ?? "24");
      url.searchParams.append("p", `${n || `Person ${i + 1}`}|${z || "UTC"}|${f}|${t}`);
    }
    const on = String(data.get("on") ?? "");
    if (on) url.searchParams.set("on", on);
    window.location.href = url.toString();
  });
</script>

<style>
  .collab { display: grid; gap: var(--space-6); }
  .collab h2 { font: 600 var(--text-h3) var(--font-display); color: var(--ink); margin: 0; }
  .cb-fine { font: 400 var(--text-xs) / 1.65 var(--font-body); color: var(--ink-faint); margin: 0; max-width: 62ch; }

  .cb-form { display: grid; gap: var(--space-4); }
  .cb-people {
    display: grid; gap: var(--space-3);
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 240px), 1fr));
  }
  .cb-person {
    display: grid; gap: 8px; margin: 0;
    border: var(--border-w) solid var(--line); border-radius: var(--radius-md);
    background: var(--surface-card); padding: 12px 14px;
  }
  .cb-person legend {
    font: 600 var(--text-micro) var(--font-body); letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase; color: var(--ink-faint); padding: 0 4px;
  }
  .cb-person label, .cb-date { display: grid; gap: 4px; }
  .cb-person span, .cb-date span {
    font: 600 var(--text-micro) var(--font-body); color: var(--ink-faint);
  }
  .cb-window { display: grid; gap: 8px; grid-template-columns: 1fr 1fr; }
  .collab input {
    font: 400 var(--text-sm) var(--font-mono); color: var(--ink);
    background: var(--surface-page); border: var(--border-w) solid var(--line);
    border-radius: var(--radius-sm); padding: 8px 10px; min-height: 42px;
    width: 100%; box-sizing: border-box;
  }
  .cb-actions { display: flex; gap: 14px; align-items: end; flex-wrap: wrap; }
  .cb-date { flex: none; }

  .cb-answer { display: grid; gap: 12px; }
  .cb-runs { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; }
  .cb-runs li {
    display: grid; gap: 3px; padding: 13px 15px;
    background: var(--accent-wash); border: var(--border-w) solid var(--accent);
    border-radius: var(--radius-md);
  }
  .cb-run { font: 600 var(--text-h4) var(--font-mono); color: var(--ink); }
  .cb-runlen { font: 400 var(--text-xs) var(--font-mono); color: var(--accent); }
  .cb-runlocal { font: 400 var(--text-xs) / 1.6 var(--font-mono); color: var(--ink-soft); }
  .cb-none { font: 400 var(--text-sm) / 1.7 var(--font-body); color: var(--ink-soft); margin: 0; max-width: 62ch; }

  .cb-gridwrap { display: grid; gap: 12px; }
  .cb-scroll { overflow-x: auto; border: var(--border-w) solid var(--line); border-radius: var(--radius-md); }
  .cb-grid { border-collapse: collapse; width: 100%; font-size: var(--text-xs); }
  .cb-grid th, .cb-grid td {
    padding: 7px 11px; text-align: left; white-space: nowrap;
    border-bottom: var(--border-w) solid var(--line);
  }
  .cb-grid thead th {
    font: 600 var(--text-micro) var(--font-body); text-transform: uppercase;
    letter-spacing: var(--tracking-eyebrow); color: var(--ink-faint);
    background: var(--surface-inset);
  }
  .cb-grid tbody th { font: 400 var(--text-xs) var(--font-mono); color: var(--ink-faint); }
  .cb-grid td { color: var(--ink-faint); }
  .cb-grid td[data-ok] { color: var(--ink); background: var(--accent-wash); }
  .cb-grid tr[data-all] td, .cb-grid tr[data-all] th { background: var(--accent-wash); }
  .cb-grid tr[data-all] .cb-count { color: var(--accent); font-weight: 600; }
  .cb-grid tbody tr:last-child th, .cb-grid tbody tr:last-child td { border-bottom: none; }

  .cb-share, .cb-keep { display: grid; gap: 10px; }
  .cb-ok { font: 400 var(--text-sm) var(--font-body); color: var(--accent); margin: 0; }
  .cb-bad { font: 400 var(--text-sm) var(--font-body); color: var(--live); margin: 0; }
  .cb-saveform { display: flex; gap: 10px; flex-wrap: wrap; align-items: center; }
  .cb-saveform input { flex: 1 1 min(100%, 260px); }

  .cb-groups { display: grid; gap: 10px; }
  .cb-groups ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; }
  .cb-groups li {
    display: flex; gap: 12px; align-items: center; justify-content: space-between;
    background: var(--surface-card); border: var(--border-w) solid var(--line);
    border-radius: var(--radius-md); padding: 11px 14px;
  }
  .cb-groups a { display: grid; gap: 2px; text-decoration: none; min-width: 0; }
  .cb-gname { font: 600 var(--text-sm) var(--font-body); color: var(--ink); }
  .cb-gwho { font: 400 var(--text-micro) var(--font-mono); color: var(--ink-faint); }
  .cb-groups button {
    cursor: pointer; background: none; border: none; flex: none;
    font: 400 var(--text-micro) var(--font-body); color: var(--ink-faint);
  }
  .cb-groups button:hover { color: var(--live); }
  .cb-url {
    font: 400 var(--text-xs) var(--font-mono); color: var(--ink);
    background: var(--surface-inset); border: var(--border-w) solid var(--line);
    border-radius: var(--radius-sm); padding: 11px 12px; width: 100%; box-sizing: border-box;
  }
</style>

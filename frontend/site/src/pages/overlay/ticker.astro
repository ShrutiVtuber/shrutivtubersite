---
/* The supporters ticker — surface 3.
 *
 * A row of names along the bottom of the stream, and deliberately NOTHING
 * else. No amounts: this row is up for the whole session, and putting figures
 * beside names turns everyone who gave a little into a small number displayed
 * next to a bigger one, permanently. The counter bar carries the total, which
 * is the number that means anything.
 *
 * Its empty state is the one that had to be designed hardest — see below.
 */
import "../../styles/global.css";
import "../../styles/overlay.css";
import { SITE_API } from "../../lib/api";

export const prerender = false;

const token = Astro.url.searchParams.get("t") ?? "";

let data: any = null;
let unreachable = false;
if (token) {
  try {
    const r = await fetch(`${SITE_API}/api/overlay/ticker?t=${encodeURIComponent(token)}`);
    if (r.ok) data = await r.json();
  } catch {
    /* Held, never blanked. */
    unreachable = true;
  }
}

const motion = data?.motion ?? "reduced";
const skin = data?.appearance ?? "almanac";
const names: any[] = data?.names ?? [];

/* Handoff §8: the ticker does not say "no supporters yet". An empty state that
   advertises emptiness is worse than no row at all — it tells the room nobody
   has given, at exactly the moment that is most expensive to say. Her standing
   line about where support goes takes the space instead, so the row still
   earns its place on day one of a campaign. */
const standing = (data?.standing ?? "").trim();
const empty = names.length === 0;

/* Full marquees; Reduced and Still show the four most recent and count the
   rest. Both are complete — the second is not a degradation, it is the weaker
   machine, and it happens to be the more readable of the two. */
const SHOWN = 4;
const visible = motion === "full" ? names : names.slice(0, SHOWN);
const more = motion === "full" ? 0 : Math.max(0, names.length - SHOWN);
---

<html lang="en">
  <head><meta charset="utf-8" /><title>ticker</title>
    <meta name="robots" content="noindex, nofollow" /></head>
  <body>
    <div class="ov ov-ticker" data-skin={skin} data-motion={motion}>
      <div class="ov-plate row">
        <div class="lead">
          <span class="ov-eyebrow">{empty ? "Support" : "Thank you"}</span>
        </div>

        {empty ? (
          <p class="standing ov-oneline">
            {unreachable || !token
              ? "Overlay connected · pick a counter in the admin."
              : standing || "Support goes straight into the tools and the time."}
          </p>
        ) : (
          <div class="track" data-lap={motion === "full" ? "" : undefined}>
            <div class="lane">
              {visible.map((n: any) => (
                <span class="who" data-anon={n.anonymous ? "" : undefined}>{n.who}</span>
              ))}
              {more > 0 && <span class="more ov-fig">+{more} more</span>}
            </div>
            {/* A second identical lane, so the marquee wraps without a gap.
                Hidden from anything that reads the page, and never rendered at
                all when nothing is moving. */}
            {motion === "full" && (
              <div class="lane" aria-hidden="true">
                {visible.map((n: any) => (
                  <span class="who" data-anon={n.anonymous ? "" : undefined}>{n.who}</span>
                ))}
              </div>
            )}
          </div>
        )}
      </div>
    </div>

    <script>
      /* Nothing here ticks. A refetch every few minutes is what keeps the row
         current — new names arrive at human speed, and a per-second poll for a
         row of words would be the most wasteful thing in the whole set. */
      setInterval(() => window.location.reload(), 4 * 60 * 1000);
    </script>
  </body>
</html>

<style>
  /* Handoff §4: 1360 x 48, left 64, top 848. */
  .ov-ticker .row {
    position: absolute; left: 64px; top: 848px; width: 1360px; height: 48px;
    display: flex; align-items: stretch; padding: 0; overflow: hidden;
  }

  .lead {
    flex: none; display: grid; align-content: center; padding: 0 16px;
    border-right: 1px solid var(--dusk-line);
  }

  .standing {
    margin: 0; align-self: center; padding: 0 16px;
    font: 400 16px var(--font-display); color: var(--dusk-ink-soft);
  }

  .track { flex: 1; min-width: 0; display: flex; align-items: center; }
  .lane { display: flex; align-items: center; gap: 26px; padding: 0 16px; white-space: nowrap; }

  .who { font: 500 16px var(--font-display); color: var(--dusk-ink); }
  /* Anonymous is a state, not a name — italic says so without the row having
     to spend a word on it. */
  .who[data-anon] { font-style: italic; color: var(--dusk-ink-soft); }
  .more { font-size: 13px; color: var(--dusk-ink-faint); letter-spacing: .04em; }

  /* One lap is 34s (§11). Two identical lanes translate by exactly half the
     pair, so the seam lands where the first name begins and there is no gap
     and no jump. */
  .track[data-lap] { animation: lap 34s linear infinite; will-change: transform; }
  @keyframes lap {
    from { transform: translateX(0); }
    to   { transform: translateX(-50%); }
  }
  /* Still kills every animation globally; this makes the static row look
     deliberate rather than a marquee that stopped. */
  .ov[data-motion="still"] .track { animation: none; }
</style>

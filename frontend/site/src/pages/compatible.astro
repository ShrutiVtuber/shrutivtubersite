---
/* The front door for "are we compatible" — designed pass, per
 * `docs/design/HANDOFF_COMPATIBLE.md`.
 *
 * The loop this page exists to run: two people compare charts → they get an
 * image worth posting → they post it and tag each other → their audiences
 * click through → some of them make one. Its job is to make a stranger want to
 * do the thing in about eight seconds, and to make the result worth posting.
 *
 * The single most important decision, and the one the first version got wrong:
 * **the hero shows the output rather than describing the product.** A filled-in
 * share card is the hero object. The form is not the hero — asking somebody for
 * their birth time before showing them why is backwards.
 *
 * Everything is one submit. Casting, keeping and making the invitation happen
 * in a single request; do not add steps.
 *
 * ONE DELIBERATE DEPARTURE FROM THE HANDOFF, and it is flagged rather than
 * hidden. The design describes "seven testimonies" with bands at "0–1 of 7",
 * "2 of 7" and so on. The engine does not work that way: `core/synastry.py`
 * counts every degree-based contact and bands them by the RATIO of harmonious
 * to hard, with a minimum sample before the extreme bands are claimed. Shipping
 * the design's numbers over this engine would put a fixed denominator on the
 * page that nothing computes. The fixed rubric is arguably the better product —
 * it is more legible on a card and it makes the no-birth-time case elegant —
 * but adopting it changes every verdict already issued, so it is her call and
 * not a thing to slip in behind a design pass. Until then the plates say what
 * the engine actually does.
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import PlaceField from "../components/forms/PlaceField.astro";
import CsrfField from "../components/forms/CsrfField.astro";
import ConsentCheckbox from "../components/forms/ConsentCheckbox.astro";
import Button from "../components/forms/Button.astro";
import Prose from "../components/content/Prose.astro";
import SectionFigure from "../components/blocks/SectionFigure.astro";
import { pageSections } from "../lib/content";
import { site, SITE_URL } from "../lib/api";
import { asReader, account } from "../lib/account";
import { verifyCsrf } from "../lib/csrf";
import { copy } from "../lib/copy";

/* Every word on this page, editable from the admin. The defaults below are
   what it was written with and what still renders if nothing was changed. */
const t = await copy("compatible");


export const prerender = false;

/* Text presentation for the astronomical glyphs. Without U+FE0E a browser
   substitutes a colour-emoji font that ignores `color`, and the mark stops
   being type. There is no emoji anywhere on this site. */
const TEXT = "︎";
const MOON = `☾${TEXT}`;
const OPEN = `○${TEXT}`;
const SEALED = `●${TEXT}`;

let errors: string[] = [];
let made: { ownerToken: string; shareToken: string } | null = null;
let noTime = false;
let name = "";

const me = await account(Astro);
const signedIn = Boolean(me);

if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  noTime = form.get("unknownTime") === "1";
  name = String(form.get("label") ?? "").trim();

  if (!verifyCsrf(Astro.cookies, form)) {
    errors = ["That did not go through. Reload the page and try again."];
  } else {
    /* Server-side validation with the same messages the design gives the
       client, because the client's copy is not the one that has to be right. */
    const date = String(form.get("date") ?? "");
    const place = String(form.get("place") ?? "");
    if (!date) errors.push("A birth date is needed — without it there is no chart to cast.");
    if (!place) errors.push("A birth place is needed. Start typing a city and pick one from the list.");
    if (!signedIn && form.get("consent") !== "1") {
      errors.push("The consent below has to be ticked before a chart can be kept.");
    }

    if (errors.length === 0) {
      const r = await asReader(Astro, "/api/charts/start", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          birth_date: date,
          birth_time: noTime ? null : String(form.get("time") ?? ""),
          time_unknown: noTime || !String(form.get("time") ?? ""),
          place_name: place,
          lat: Number(form.get("lat") ?? 0),
          lon: Number(form.get("lon") ?? 0),
          label: name,
          consent: signedIn || form.get("consent") === "1",
        }),
      });
      if (r.ok && r.body?.shareToken) made = r.body;
      else errors.push(r.body?.detail ?? "That did not work. Nothing has been kept.");
    }
  }
}

const sections = await pageSections("compatible");
const designs = (await site<any[]>("/api/charts/card-designs")) ?? [];

const inviteUrl = made ? `${SITE_URL}/chart/invite/${made.shareToken}` : "";
const ownUrl = made ? `${SITE_URL}/chart/${made.ownerToken}` : "";
const who = name || "Someone";

const SUGGESTED =
  "Two birth charts, five possible answers, no percentages anywhere. " +
  "Compare with me and let's see which one we get ↓";

/* The hero card. Rose horizon reads on a white timeline and a black one, which
   is why the designer chose it — but the row is data, so fall back rather than
   hard-code a key that somebody may rename in the admin. */
const heroDesign = designs.find((d: any) => d.key === "rose-horizon") ?? designs[0];

/* The five bands, in the order the count rises.
 *
 * `share` is the harmonious share of contacts at which the engine actually
 * cuts — read straight off `core/synastry.py`. The design drew this as seven
 * filled-or-empty bars, which reads as "n of 7"; nothing computes a
 * denominator of seven, so it is drawn as the proportion instead. Same
 * graphic job — the rise across the row — without inventing a number. */
const BANDS = [
  {
    key: "contrary-to-sect", name: "Contrary to sect", share: 0.15,
    range: "under 30% harmonious",
    says: "Almost everything in contact is a hard aspect. The tradition would say the two charts are working against each other's grain.",
  },
  {
    key: "hard-going", name: "Hard going", share: 0.36,
    range: "30–42% harmonious",
    says: "Squares and oppositions carry most of the testimony. Not hostility — friction. The useful part is that friction is legible: you will be told exactly where it sits.",
  },
  {
    key: "mixed-testimony", name: "Mixed testimony", share: 0.5,
    range: "42–58% harmonious",
    says: "The witnesses disagree with each other. An astrologer counting this in a horary would say the question is not yet ripe — which is a real answer, and the most honest one here.",
  },
  {
    key: "well-aspected", name: "Well aspected", share: 0.64,
    range: "58–70% harmonious",
    says: "Trines and sextiles between the lights, and the malefics keeping out of it. The ordinary good case — and by some distance the most common one.",
  },
  {
    key: "same-sky", name: "Written in the same sky", share: 0.85,
    range: "70%+ · and at least eight contacts",
    says: "Overwhelmingly harmonious. It needs a real sample as well as a high share — two contacts that both happen to be trines is a small sample, not a verdict — so this band is genuinely uncommon.",
  },
];

const ALMANAC = [
  ["Prediction", "none offered — nothing here says what will happen"],
  ["Percentage", "never computed — a count, or nothing"],
  ["Authorities", "disagreeing since Ptolemy — ours is one reading of many"],
  ["Verdicts", "hand-written by me, not generated"],
  ["Engine", "Swiss Ephemeris · AGPL · source on request"],
];
---

<BaseLayout
  title="Are we compatible? — Shruti"
  description="Compare two birth charts and see what the tradition makes of the pair. Free, no account, about forty seconds — and it says what it cannot know."
  bare
>
  {/* id="main" is the skip link's target. The layout renders that
      link on every page; a page with its own <main> has to carry the
      anchor or the first thing a keyboard user presses does nothing. */}
  <main id="main" class="cx">

    {/* ── 1. Sky hero ─────────────────────────────────────────────────── */}
    <section class="sky cx-hero">
      <span class="sky-stars" aria-hidden="true"></span>
      <div class="cx-in cx-hero-grid">
        <div class="sky-veil cx-cap">
          <p class="t-eyebrow">{t("text.1", "Free · no account · about forty seconds")}</p>
          <h1>{t("see-what-the-sky-makes-o.1", "See what the sky makes of you two.")}</h1>
          <p class="cx-cycle">
            <span class="cx-cycle-lbl t-tabular">{t("see-what-the-sky-makes-o.2", "Five possible answers ·")}</span>{" "}
            <span class="cx-cycle-word" data-cycle>{BANDS[0].name}</span>
          </p>
          <p class="cx-sub">{t("see-what-the-sky-makes-o.3", "Two birth charts weighed against each other by rules older than the telescope — and an image worth posting at the end of it.")}</p>
          <div class="cx-cta">
            <Button size="lg" href="#start">{t("see-what-the-sky-makes-o.4", "Compare two charts")}</Button>
            <Button size="lg" variant="ghost" href="#answers">{t("see-what-the-sky-makes-o.5", "What the answers mean")}</Button>
          </div>
          <p class="cx-foot">{t("see-what-the-sky-makes-o.6", "Nothing kept but the two charts. Only the person on a face can put that face on a card.")}</p>
        </div>

        <figure class="cx-hero-card">
          <a href="#showcase">
            {heroDesign ? (
              <img src={`/api/charts/card-sample.png?design=${heroDesign.key}`}
                   width="1200" height="630" loading="eager"
                   alt={`An example share card in the ${heroDesign.name} design`} />
            ) : (
              <span class="cx-art-absent">{t("see-what-the-sky-makes-o.7", "The card is drawn when the first comparison is made.")}</span>
            )}
          </a>
          <figcaption>{t("see-what-the-sky-makes-o.8", "This is the thing you get. 1200×630, drawn on our own server, carrying its own disclaimer so it can travel without this page.")}</figcaption>
        </figure>
      </div>
      <span class="sky-horizon" aria-hidden="true"></span>
    </section>

    {/* ── 2. Start ────────────────────────────────────────────────────── */}
    <section class="cx-in cx-sec" id="start">
      <div class="cx-two">
        <div class="cx-explain">
          <p class="t-eyebrow">Your half of it</p>
          <h2>{t("one-submit-does-all-thre.1", "One submit does all three.")}</h2>
          <ol class="cx-roman">
            <li><span class="cx-num t-tabular">i</span><span>{t("one-submit-does-all-thre.2", "Casts your chart from the Swiss Ephemeris — the same engine as the natal instrument.")}</span></li>
            <li><span class="cx-num t-tabular">ii</span><span>{t("one-submit-does-all-thre.3", "Keeps it behind a link that only you have.")}</span></li>
            <li><span class="cx-num t-tabular">iii</span><span>{t("one-submit-does-all-thre.4", "Makes one invitation to hand to anybody. They fill in their half; the comparison appears for both of you.")}</span></li>
          </ol>

          <div class="cx-branch">
            <p class="t-eyebrow"><span class="t-glyph" aria-hidden="true">{MOON}</span> Without a time</p>
            <p class="cx-branch-lead">{t("one-submit-does-all-thre.5", "Then it says so, instead of guessing at it.")}</p>
            <p class="cx-branch-body">{t("one-submit-does-all-thre.6", "Four minutes of clock error is a whole degree of Ascendant, so a chart with no time has no angles at all — and every contact that needs one drops out of the count. The result names them rather than quietly leaving them off.")}</p>
            <div class="cx-plates">
              <p class="cx-plate cx-plate-good"><span>{t("one-submit-does-all-thre.7", "Sun, Moon, Mercury, Venus, Mars, Jupiter, Saturn")}</span><em>weighed</em></p>
              <p class="cx-plate cx-plate-no"><span>{t("one-submit-does-all-thre.8", "Ascendant and Midheaven")}</span><em>cannot be weighed</em></p>
            </div>
            <p class="cx-branch-foot">{t("one-submit-does-all-thre.9", "Find the time later and the chart takes it and recounts. Nothing has to be cast again.")}</p>
          </div>
        </div>

        <div class="cx-formwrap">
          {made ? (
            <div class="cx-done">
              <div class="cx-card">
                <p class="t-eyebrow cx-rose">{t("one-submit-does-all-thre.10", "Cast · kept · ready")}</p>
                <h3>{t("now-hand-it-to-somebody.1", "Now hand it to somebody.")}</h3>
                <p class="cx-done-line">
                  {noTime
                    ? `${who}'s chart is cast without a time, so the contacts that need an Ascendant are set aside and named on the result. It is kept behind the link below.`
                    : `${who}'s chart is cast and kept behind the link below. Nothing else was stored.`}
                </p>

                <p class="cx-lbl">{t("now-hand-it-to-somebody.2", "The invitation — send this out")}</p>
                <div class="cx-copyrow">
                  <input class="cx-code" type="text" readonly value={inviteUrl}
                         aria-label="Your invitation link" onclick="this.select()" />
                  <button type="button" class="cx-copy" data-copy={inviteUrl}>Copy link</button>
                </div>

                <div class="cx-share">
                  <a href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(SUGGESTED)}&url=${encodeURIComponent(inviteUrl)}`}
                     rel="noopener noreferrer" target="_blank">Post on X</a>
                  <a href={`https://bsky.app/intent/compose?text=${encodeURIComponent(`${SUGGESTED} ${inviteUrl}`)}`}
                     rel="noopener noreferrer" target="_blank">Post on Bluesky</a>
                  <a href={`/chart/invite/${made.shareToken}`}>{t("now-hand-it-to-somebody.3", "See what they will see →")}</a>
                </div>
                <p class="cx-fine">{t("now-hand-it-to-somebody.4", "Plain links, the way every other page here works — no SDK, no button script, no pixel. Nothing loads from those sites until you click.")}</p>

                <p class="cx-lbl">{t("now-hand-it-to-somebody.5", "Something to post with it")}</p>
                <div class="cx-copyrow">
                  <textarea class="cx-code" rows="3" aria-label="Suggested post text">{SUGGESTED}</textarea>
                  <button type="button" class="cx-copy" data-copy={SUGGESTED}>Copy text</button>
                </div>
                <p class="cx-fine">{t("now-hand-it-to-somebody.6", "Edit it. It is only a suggestion.")}</p>
              </div>

              <div class="cx-keep">
                <p class="t-eyebrow cx-rose">
                  <span class="t-glyph" aria-hidden="true">{SEALED}</span> Keep this one for yourself
                </p>
                <div class="cx-copyrow">
                  <input class="cx-code" type="text" readonly value={ownUrl}
                         aria-label="The link back to your own chart" onclick="this.select()" />
                  <button type="button" class="cx-copy cx-copy-rose" data-copy={ownUrl}>Copy link</button>
                </div>
                <p class="cx-keep-body">
                  This link is the <strong>only</strong> way back to your chart.
                  We never asked for your email, so there is nothing we could
                  send you if it goes missing — and no account to recover. Put
                  it where you keep things.
                </p>
                <p class="cx-keep-links">
                  <a href={ownUrl}>Open it now</a>
                  <a href={`data:text/plain;charset=utf-8,${encodeURIComponent(ownUrl)}`}
                     download="my-chart-link.txt">{t("now-hand-it-to-somebody.7", "Download it as a text file")}</a>
                  <a href="/signup">{t("now-hand-it-to-somebody.8", "Attach it to an account later")}</a>
                </p>
              </div>

              <p class="cx-again"><a href="/compatible">{t("now-hand-it-to-somebody.9", "Cast another chart")}</a></p>
            </div>
          ) : (
            <form method="POST" class="cx-card cx-form" novalidate>
              <CsrfField />

              {errors.length > 0 && (
                <div class="cx-errs" role="alert">
                  <p class="cx-errs-t">
                    {errors.length === 1 ? "One thing is missing" : `${errors.length} things are missing`}
                  </p>
                  <ul>{errors.map((e) => <li>{e}</li>)}</ul>
                </div>
              )}

              <label class="cx-field">
                <span class="cx-flabel">Name or handle <em class="cx-opt">optional</em></span>
                <input class="cx-input" name="label" maxlength="80" placeholder="Someone" value={name} />
                <span class="cx-help">{t("now-hand-it-to-somebody.10", "Whatever should sit under your face on the card. Leave it and you are “Someone”.")}</span>
              </label>

              <div class="cx-row">
                <label class="cx-field">
                  <span class="cx-flabel">Birth date <em class="cx-req">required</em></span>
                  <input class="cx-input" type="date" name="date" required />
                </label>
                <label class="cx-field" data-time-field hidden={noTime}>
                  <span class="cx-flabel">Birth time <em class="cx-opt">optional</em></span>
                  <input class="cx-input" type="time" name="time" />
                </label>
              </div>

              <label class="cx-check">
                <input type="checkbox" name="unknownTime" value="1" checked={noTime} data-no-time />
                <span>
                  I don’t know my birth time
                  <em>{t("now-hand-it-to-somebody.11", "The angles get left out of the count — and named.")}</em>
                </span>
              </label>

              <div class="cx-field">
                <span class="cx-flabel">Birth place <em class="cx-req">required</em></span>
                <PlaceField lat={37.9838} lon={23.7275} place="" />
                <span class="cx-help">{t("now-hand-it-to-somebody.12", "The gazetteer is on our own server; typing here reaches nobody else.")}</span>
              </div>

              {signedIn ? (
                <div class="cx-signed">
                  <p class="t-eyebrow">Signed in</p>
                  <p>{t("now-hand-it-to-somebody.13", "Your account already carries this consent.")}</p>
                  <p><a href="/account">{t("now-hand-it-to-somebody.14", "Review or withdraw")}</a></p>
                </div>
              ) : (
                <ConsentCheckbox
                  name="consent"
                  basis="consent"
                  required
                  label="I give Shruti my birth date, time and place so that this chart can be cast, kept behind my own link, and compared with charts I invite."
                  explanation="Used for nothing else: no profiling, no advertising, no sale, and nothing shared with anybody except the person you send your invitation to. Kept until you delete it — the delete button is on your chart page and it takes effect the same second."
                  wording="Never pre-ticked, never bundled with anything else."
                  error={errors.some((e) => e.includes("consent")) ? "This one is required." : undefined}
                />
              )}

              <div class="cx-submit">
                <Button size="lg" type="submit" data-track="compare:started">{t("now-hand-it-to-somebody.15", "Cast it and make an invitation")}</Button>
                <p class="cx-fine t-tabular">{t("now-hand-it-to-somebody.16", "One request. No account, no email, no confirmation step.")}</p>
              </div>
            </form>
          )}
        </div>
      </div>
    </section>

    {/* ── 3. Card showcase ────────────────────────────────────────────── */}
    <section class="cx-in cx-sec" id="showcase">
      <div class="cx-head">
        <div>
          <p class="t-eyebrow">The image you get</p>
          <h2>{t("pick-a-card-or-let-it-pi.1", "Pick a card, or let it pick one.")}</h2>
          <p class="cx-lead">{t("pick-a-card-or-let-it-pi.2", "Every comparison is drawn as an image on our own server. The designs are rows in a table — Shruti adds one and it appears here.")}</p>
        </div>
        <p class="cx-count t-tabular">
          {designs.length === 1 ? "1 design" : `${designs.length} designs`} · more get added
        </p>
      </div>

      <div class="cx-cards">
        {designs.map((d: any, i: number) => (
          <figure class="cx-cardfig" style={`--tilt:${[-0.7, 0.6, -0.5][i % 3]}deg`}>
            <img src={`/api/charts/card-sample.png?design=${d.key}`}
                 width="1200" height="630" loading="lazy"
                 alt={`An example share card in the ${d.name} design`} />
            <figcaption>
              <span class="cx-cardname">{d.name}</span>
              <span class="cx-cardtag t-tabular">{d.backdrop ? "backdrop" : i === 0 ? "default" : "flat"}</span>
              <span class="cx-cardnote">{d.blurb || "One of hers."}</span>
            </figcaption>
          </figure>
        ))}
        {designs.length === 0 && (
          <div class="sky cx-absent">
            <span class="sky-stars" aria-hidden="true"></span>
            <p>{t("pick-a-card-or-let-it-pi.3", "Design added, no sample drawn yet. The first comparison to use it makes one.")}</p>
            <span class="sky-horizon" aria-hidden="true"></span>
          </div>
        )}
      </div>
    </section>

    {/* ── 4. The five answers ─────────────────────────────────────────── */}
    <section class="cx-in cx-sec" id="answers">
      <div class="cx-headblock">
        <p class="t-eyebrow">The five answers</p>
        <h2>{t("the-testimonies-are-weig.1", "The testimonies are weighed. Five things they can add up to.")}</h2>
        <p class="cx-lead">
          These are real terms of art, not moods. A <strong>testimony</strong> is
          how a horary astrologer weighs a question; <strong>sect</strong> is the
          division of charts into day and night, and it changes which planets
          help. You always see the count that produced the verdict.
        </p>
      </div>

      <div class="cx-bands">
        {BANDS.map((b) => (
          <article class="cx-band" data-band={b.key}>
            <span class="cx-tally" aria-hidden="true">
              <i style={`--share:${Math.round(b.share * 100)}%`}></i>
            </span>
            <p class="cx-range t-tabular">{b.range}</p>
            <h3>
              {b.name}
              {b.key === "same-sky" && <span class="t-glyph" aria-hidden="true"> {MOON}</span>}
            </h3>
            <p class="cx-bandsays">{b.says}</p>
          </article>
        ))}
      </div>
    </section>

    {/* ── 5. The honest note ──────────────────────────────────────────── */}
    <section class="cx-in cx-sec">
      <div class="cx-honest">
        <div class="cx-honest-l">
          <p class="t-eyebrow"><span class="t-glyph" aria-hidden="true">{OPEN}</span> The honest part</p>
          <h2>{t("it-is-a-reading-not-a-re.1", "It is a reading, not a result.")}</h2>
          <p class="cx-lead">{t("it-is-a-reading-not-a-re.2", "Astrologers have argued about these rules for two thousand years and have not finished. I am not going to pretend a share card settles it — and the disagreement is the interesting part, not an embarrassment.")}</p>
          <p class="cx-lead">
            <strong>{t("it-is-a-reading-not-a-re.3", "It does not predict anything")}</strong>, and there is no
            percentage in it anywhere. It reads the contacts between two charts
            and tells you what classical practice attaches to them. Post it
            because it is fun, not because it is a verdict.
          </p>
          <p class="cx-sign"><span class="cx-sign-rule" aria-hidden="true"></span> Shruti</p>
        </div>
        <dl class="cx-almanac">
          {ALMANAC.map(([k, v]) => (
            <div class="cx-alrow">
              <dt>{k}</dt>
              <span class="cx-leader" aria-hidden="true"></span>
              <dd class="t-tabular">{v}</dd>
            </div>
          ))}
        </dl>
      </div>
    </section>

    {/* ── 6. Admin blocks ─────────────────────────────────────────────── */}
    {sections.length > 0 && (
      <section class="cx-in cx-sec cx-more">
        <p class="t-eyebrow">More from Shruti</p>
        <div class="cx-blocks">
          {sections.map((s) => (
            <div class="cx-block">
              {s.title && <h2>{s.title}</h2>}
              <SectionFigure media={s.media} title={s.title} />
              <Prose html={s.html} />
            </div>
          ))}
        </div>
      </section>
    )}

    {/* ── 7. Close ────────────────────────────────────────────────────── */}
    <div class="cx-in"><span class="cx-close" aria-hidden="true"></span></div>
  </main>
</BaseLayout>

<script>
  /* Progressive only. Everything below already works without it: the cycling
     word renders statically, the time field is honoured server-side, and every
     copy target is selectable text. */
  const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  // The cycling verdict word. Never started at all under reduced motion —
  // collapsing the transition to 1ms would still be a word changing every
  // 2.6 seconds in somebody's peripheral vision.
  const word = document.querySelector<HTMLElement>("[data-cycle]");
  if (word && !reduced) {
    const names = ["Contrary to sect", "Hard going", "Mixed testimony",
                   "Well aspected", "Written in the same sky"];
    let i = 0;
    setInterval(() => {
      word.style.opacity = "0";
      setTimeout(() => {
        i = (i + 1) % names.length;
        word.textContent = names[i];
        word.style.opacity = "1";
      }, 210);
    }, 2600);
  }

  // "I don't know my birth time" hides the time field rather than leaving a
  // control that is ignored — the server honours the checkbox either way.
  const noTime = document.querySelector<HTMLInputElement>("[data-no-time]");
  const timeField = document.querySelector<HTMLElement>("[data-time-field]");
  if (noTime && timeField) {
    const sync = () => { timeField.hidden = noTime.checked; };
    noTime.addEventListener("change", sync);
    sync();
  }

  // Copy buttons. The value is visible and selectable in every case, so this
  // is a convenience and never the only route.
  document.querySelectorAll<HTMLButtonElement>("[data-copy]").forEach((b) => {
    b.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(b.dataset.copy ?? "");
        const was = b.textContent;
        b.textContent = "Copied";
        setTimeout(() => { b.textContent = was; }, 1800);
      } catch {
        /* Clipboard refused — the text beside the button is still selectable. */
      }
    });
  });
</script>



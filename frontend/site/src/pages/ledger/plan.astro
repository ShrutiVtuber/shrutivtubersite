  // It cannot open yet (lib/ledger/limit.ts)
  "missing.path.fixtures": say("missing.path.fixtures", "fixtures · {short}"),
  "missing.path.type": say("missing.path.type", "type · course"),
  "missing.path.products": say("missing.path.products", "products"),
  "missing.fixtures": say("missing.fixtures", "{typeA} needs {names} to open. Add one under Fixtures."),
  "missing.needs": say("missing.needs", "Each {neededBy} stands on {names}. Add one under Fixtures."),
  "missing.course": say("missing.course", "{typeA} needs the {course} course finished first. A ledger's courses decide which types it can open."),
  "missing.products": say("missing.products", "{typeA} needs one of {names} in stock. Choose it under Products."),
  "missing.or": say("missing.or", "or"),
};

const STATE = {
  signedIn: !!me,
  ledgers,
  ledgerId,
  business,
  sample: params.get("sample") === "1",
  draft: params.get("draft") === "1",
  section,
  building: params.get("building") || null,
  campaigns: (params.get("campaigns") || "").split(",").map((c) => c.trim()).filter(Boolean),
};
/* The ledger the plan streams through: the business's, or the one asked for. */
const streamLedger = ledgers.find((l) => l.id === (business?.ledgerId ?? asked)) ?? null;
const streamSignIn = `/signin?next=${encodeURIComponent(`/ledger/plan?draft=1&section=${section}`)}`;
const signInHref = `/signin?next=${encodeURIComponent("/ledger/plan?draft=1&section=review")}`;
const planHref = business ? `/ledger/plan?business=${business.id}` : "/ledger/plan";
---

<BaseLayout title={say("meta.title", "Plan a business — the Ledger")}
            description={say("meta.description", "Plan a Big Ambitions business before you spend a dollar of the game's money, and see what the game will do with it.")}
            noindex={!!business}>
  <div class="page gd-full lg-root lg-plan" data-planner data-loaded={loaded ? "pending" : "no"}
       data-words={JSON.stringify(WORDS)} data-state={JSON.stringify(STATE)}>
    <LedgerBar current="plan" signedIn={!!me} ledger={ledger} business={business && ledger ? { id: business.id, name: business.name } : null} planHref={planHref} />

    {loaded && <LedgerStats note={say("stats.noteStart", "Normal · satisfaction 80 %")} />}
    {loaded && <StreamSwitch signedIn={!!me} ledger={streamLedger ? { id: streamLedger.id, name: streamLedger.name } : null}
                             ledgers={ledgers.map((l) => ({ id: l.id, name: l.name }))} signInHref={streamSignIn} />}

    <header class="lg-head">
      <span class="gd-eyebrow">{say("head.eyebrow", "Plan a business")}</span>
      <h1 data-plan-title>{business ? business.name : say("title.none", "A business, not kept")}</h1>
      <span class="lg-head-meta" data-plan-meta>{say("meta.start", "no type yet · no building yet · nothing is saved until you keep it")}</span>
    </header>

    {!loaded && (
      <Empty n={3} eyebrow={say("notloaded.eyebrow", "Not loaded yet")}
             title={say("notloaded.title", "The game's data is not loaded yet.")}
             body={say("notloaded.body", "The Ledger reckons from the game's own figures, gathered for one version of the game. Until they arrive there is nothing honest to plan from.")}
             action={say("notloaded.action", "Back to the Ledger")} href="/ledger"
             ringAria={say("notloaded.aria", "The game's data is not loaded")} />
    )}

    {loaded && (
      <div class="lg-work">
        <nav class="lg-rail" aria-label={say("rail.aria", "The plan's sections")}>
          {SECTIONS.map((id) => (
            <button type="button" class="lg-rail-row" data-go={id} aria-current={id === section ? "step" : "false"}>
              <span class="lg-rail-mark" data-rail-mark data-state={id === section ? "now" : "open"} aria-hidden="true"></span>
              <span class="lg-rail-name">{NAMES[id]}</span>
              <span class="lg-rail-count" data-rail-count></span>
            </button>
          ))}
        </nav>

        <div class="lg-main" data-main>
          <WhatLimitsIt loaded={loaded} />
          <SaveNote kind="missing" hidden data-missing />

          {/* ── Type ── */}
          <Console as="section" class="lg-section" data-section="type" hidden={section !== "type"} aria-labelledby="lg-s-type">
            <div class="gd-console-head"><span class="gd-eyebrow" id="lg-s-type">{NAMES.type}</span><span class="gd-note" data-type-note></span></div>
            <div class="lg-rows" data-types></div>
          </Console>

          {/* ── Building ── */}
          <Console as="section" class="lg-section" data-section="building" hidden={section !== "building"} aria-labelledby="lg-s-building">
            <div class="gd-console-head"><span class="gd-eyebrow" id="lg-s-building">{say("building.eyebrow", "Building · find one")}</span><span class="gd-note" data-finder-count></span></div>
            <div class="lg-filters">
              <div class="lg-chips" data-hoods></div>
              <div class="lg-chips" data-caps></div>
              <div class="lg-chips">
                <span class="lg-chip-label">{say("finder.rank", "rank for")}</span>
                <button type="button" class="lg-chip" data-rank aria-pressed="true">{say("finder.rankNone", "Choose a type to rank for it")}</button>
              </div>
            </div>
            <div data-finder-empty hidden>
              <Empty n={3} compact eyebrow={say("finder.emptyEyebrow", "No buildings")} title={say("finder.emptyTitle", "Widen one filter.")}
                     body={say("finder.emptyBody", "No building in {hood} has a capacity of {cap} an hour. The nearest match is one filter away.")}
                     ringAria={say("finder.emptyAria", "No building matches")}>
                <button slot="action" type="button" class="lg-btn" data-variant="secondary" data-size="sm" data-clear-filters>{say("finder.clear", "Clear the filters")}</button>
              </Empty>
            </div>
            <div class="lg-rows" data-finder-rows></div>
            <div class="lg-actions lg-spread">
              <a class="lg-link" href="/ledger/places" data-finder-more>{say("finder.moreStart", "See every building in Places")}</a>
              <button type="button" class="lg-link" data-no-building>{say("finder.none", "Plan without a building")}</button>
            </div>
          </Console>

          {/* ── Products ── */}
          <Console as="section" class="lg-section" data-section="products" hidden={section !== "products"} aria-labelledby="lg-s-products">
            <div class="gd-console-head"><span class="gd-eyebrow" id="lg-s-products">{NAMES.products}</span><span class="gd-note" data-products-note></span></div>
            <p class="lg-rule-note" data-products-none>{say("products.none", "Choose a type first: its products and their prices come with it.")}</p>
            <div class="lg-rows" data-products></div>
            <div class="lg-chips" data-products-more></div>
            <div class="lg-stair-block" data-stair-block>
              <div class="lg-stair-head">
                <h2 class="lg-sub">{say("stair.title", "The price staircase")} · <span data-stair-name></span></h2>
                <span class="lg-chips">
                  <button type="button" class="lg-chip" data-event="monopoly" aria-pressed="false">{say("event.monopoly", "Monopoly")}</button>
                  <button type="button" class="lg-chip" data-event="hype" aria-pressed="false">{say("event.hype", "Hype")}</button>
                  <button type="button" class="lg-chip" data-event="shortage" aria-pressed="false">{say("event.shortage", "Shortage")}</button>
                  <button type="button" class="lg-chip" data-event="backorder" aria-pressed="false">{say("event.backorder", "Backorder")}</button>
                </span>
              </div>
              <div data-stair></div>
              <div class="lg-almanac lg-best-table">
                <div class="lg-group-head"><span class="gd-eyebrow">{say("best.title", "Best prices · ready for the game")}</span><span class="lg-count" data-best-count></span></div>
                <div class="lg-al lg-best lg-best-heads"><span>{say("best.product", "Product")}</span><span class="lg-lead" aria-hidden="true"></span><span class="lg-val">{say("best.price", "Best price")}</span><span class="lg-val lg-best-week">{say("best.week", "Its week")}</span></div>
                <div data-best></div>
              </div>
            </div>
          </Console>

          {/* ── Fixtures ── */}
          <Console as="section" class="lg-section" data-section="fixtures" hidden={section !== "fixtures"} aria-labelledby="lg-s-fixtures">
            <div class="gd-console-head"><span class="gd-eyebrow" id="lg-s-fixtures">{NAMES.fixtures}</span><span class="gd-note" data-fixtures-note></span></div>
            <p class="lg-rule-note" data-fixtures-none>{say("fixtures.none", "Choose a type first: it says which fixtures it needs to open.")}</p>
            <div class="lg-rows" data-fixtures></div>
            <div class="lg-almanac">
              <div class="lg-al"><span>{say("setup.fixtures", "Fixtures")}</span><span class="lg-lead" aria-hidden="true"></span><span class="lg-val" data-setup-fixtures>—</span></div>
              <div class="lg-al"><span>{say("setup.deposit", "Rent deposit")}</span><span class="lg-lead" aria-hidden="true"></span><span class="lg-val" data-setup-deposit>—</span></div>
              <div class="lg-total"><span>{say("setup.total", "Setup")}</span><span class="lg-val" data-setup-total>—</span></div>
            </div>
          </Console>

          {/* ── Hours and staff ── */}
          <Console as="section" class="lg-section lg-hours" data-section="hours" hidden={section !== "hours"} aria-labelledby="lg-s-hours">
            <div class="gd-console-head"><span class="gd-eyebrow" id="lg-s-hours">{NAMES.hours}</span><span class="gd-note" data-hours-note></span></div>
            <HoursPainter />
            <div class="lg-actions">
              <button type="button" class="lg-link" data-open-usual>{say("hours.usual", "Open 09–21 every day")}</button>
              <button type="button" class="lg-link" data-close-all>{say("hours.closeAll", "Close every hour")}</button>
            </div>
            <WeekGrid />
            <div class="lg-staff">
              <h2 class="lg-sub">{say("staff.title", "Staff")}</h2>
              <p class="lg-row-line">{say("staff.help", "The registers' staff work every staffed register-hour you paint. Give other roles their hours a week. A wage left empty is the game's starting wage for the difficulty, marked approximate.")}</p>
              <div class="lg-rows" data-staff></div>
            </div>
          </Console>

          {/* ── Campaigns ── */}
          <Console as="section" class="lg-section" data-section="campaigns" hidden={section !== "campaigns"} aria-labelledby="lg-s-campaigns">
            <div class="gd-console-head"><span class="gd-eyebrow" id="lg-s-campaigns">{NAMES.campaigns}</span><span class="gd-note" data-campaigns-note></span></div>
            <div class="lg-rows" data-campaigns></div>
          </Console>

          {/* ── Assumptions ── */}
          <Console as="section" class="lg-section" data-section="assumptions" hidden={section !== "assumptions"} aria-labelledby="lg-s-assumptions">
            <div class="gd-console-head"><span class="gd-eyebrow" id="lg-s-assumptions">{NAMES.assumptions}</span><span class="gd-note">{say("assume.note", "3 in force")}</span></div>
            <div class="lg-assume">
              <div class="lg-assume-row">
                <div class="lg-assume-text">
                  <span class="lg-assume-name">{say("assume.satisfaction", "Satisfaction")}</span>
                  <span class="lg-row-line">{say("assume.satisfactionHelp", "How the game adds it up is not known. Copy today's figure from the business's overview in the game; ×0.5 at 0 %, ×1.5 at 100 %.")}</span>
                </div>
                <div class="lg-actions">
                  <span class="lg-stepper">
                    <button type="button" class="lg-step" data-sat-dec aria-label={say("assume.lower", "Lower satisfaction")}>−</button>
                    <span class="lg-step-value lg-sat" data-sat-value>{say("assume.default", "80 %")}</span>
                    <button type="button" class="lg-step" data-sat-inc aria-label={say("assume.raise", "Raise satisfaction")}>+</button>
                  </span>
                  <span class="lg-actions" data-sat-typed hidden>
                    <span class="lg-yours">{say("yours", "yours")}</span>
                    <button type="button" class="lg-link" data-sat-reset>{say("assume.reset", "Use the Ledger's 80 %")}</button>
                  </span>
                </div>
              </div>
              <div class="lg-assume-row">
                <div class="lg-assume-text">
                  <span class="lg-assume-name">{say("assume.demand", "Demand")}</span>
                  <span class="lg-row-line">{say("assume.demandHelp", "How much each product is wanted, out of 100. The Ledger reckons with 80 for every product; the game's market screen shows today's figure.")}</span>
                </div>
                <span class="lg-fixed lg-num" data-demand>—</span>
              </div>
              <div class="lg-assume-row">
                <div class="lg-assume-text">
                  <span class="lg-assume-name">{say("assume.competitor", "A competitor's lowest price")}</span>
                  <span class="lg-row-line" data-comp-help></span>
                </div>
                <label class="lg-money"><span>$</span><input class="lg-input" data-wide type="text" inputmode="decimal" autocomplete="off" placeholder="—"
                  data-competitor aria-label={say("assume.competitorAria", "A competitor's lowest price")} /></label>
              </div>
            </div>
          </Console>

          {/* ── Review ── */}
          <Console as="section" class="lg-section" data-section="review" hidden={section !== "review"} aria-labelledby="lg-s-review">
            <div class="gd-console-head"><span class="gd-eyebrow" id="lg-s-review">{NAMES.review}</span><span class="gd-note">{say("review.note", "the plan's lines")}</span></div>
            <div class="lg-review-grid" data-review-lines></div>
          </Console>
          <div class="lg-review-after" data-section="review" hidden={section !== "review"}>
            <SaveNote kind="before" hidden data-before>
              <div data-compare></div>
              <div class="lg-actions">
                <button type="button" class="lg-btn" data-save>{say("before.save", "Save these changes")}</button>
                <button type="button" class="lg-btn" data-variant="ghost" data-put-back>{say("before.putBack", "Put the kept plan back")}</button>
              </div>
            </SaveNote>
            <SaveNote kind="saved" hidden data-saved />
            <SaveNote kind="refusal" hidden data-refusal />
            <p class="lg-rule-note" data-review-note hidden></p>

            <div class="lg-actions" data-keep-out hidden={!!me}>
              <Button variant="primary" href={signInHref}>{say("keep.out", "Keep it in a ledger")}</Button>
              <span class="lg-row-line">{say("keep.outNote", "Keeping needs an account, as a build does. It is free and it has no limits.")}</span>
            </div>

            {me && !business && ledgers.length > 0 && (
              <Console as="div" class="lg-keep" data-keep-in>
                <div class="gd-console-head"><span class="gd-eyebrow">{say("keep.eyebrow", "Keep it in a ledger")}</span><span class="gd-note">{say("keep.note", "one company in one saved game")}</span></div>
                <label class="lg-field">
                  <span class="lg-field-label">{say("keep.name", "Name")}</span>
                  <input class="lg-text" type="text" maxlength="120" autocomplete="off" data-keep-name
                         placeholder={say("keep.namePlaceholder", "The name it has in the game")} />
                </label>
                <label class="lg-field">
                  <span class="lg-field-label">{say("keep.ledger", "Ledger")}</span>
                  <select class="lg-text" data-keep-ledger>
                    {ledgers.map((l) => <option value={l.id} selected={l.id === ledgerId}>{l.name}</option>)}
                  </select>
                </label>
                <div class="lg-actions">
                  <button type="button" class="lg-btn" data-keep>{say("keep.in", "Keep it in this ledger")}</button>
                  <span class="lg-row-line">{say("keep.inNote", "It is kept as planned. Changing it later shows what changes before it saves.")}</span>
                </div>
              </Console>
            )}
            {me && !business && ledgers.length === 0 && (
              <p class="lg-rule-note" data-keep-none>
                {say("keep.none", "Keeping a plan needs a ledger first: one company in one saved game.")}
                {" "}<a href="/ledger#new">{say("keep.start", "Start a ledger")}</a>
              </p>
            )}
          </div>

          <div class="lg-actions lg-spread">
            <button type="button" class="lg-btn" data-variant="ghost" data-prev>{say("nav.start", "Start of the plan")}</button>
            <button type="button" class="lg-btn" data-variant="secondary" data-next>{say("nav.nextStart", "Building →")}</button>
          </div>
        </div>
      </div>
    )}

    <LedgerFoot game={pack?.game ?? null} />
  </div>
</BaseLayout>

<style is:global>
  .lg-head { display: grid; gap: 4px; }
  .lg-head h1 { margin: 0; font-family: var(--font-display); font-size: 36px; font-weight: 600; line-height: 1.2; letter-spacing: -0.01em; text-wrap: balance; }
  @media (max-width: 600px) { .lg-head h1 { font-size: 28px; } }
  .lg-head-meta { font-family: var(--font-mono); font-size: 12px; color: var(--ink-soft); }

  /* the desk: a 264px rail, then the main column (flex 1 1 480px), 24/32 apart */
  .lg-work { display: flex; flex-wrap: wrap; gap: 24px 32px; align-items: flex-start; }
  .lg-rail { flex: 0 0 264px; position: sticky; top: calc(var(--site-header-h, 57px) + 84px); display: flex; flex-direction: column; box-sizing: border-box;
    border: 1px solid var(--line); border-radius: 4px; background: var(--surface-card); padding: 6px; }
  .lg-rail-row { appearance: none; border: 0; background: transparent; display: grid; grid-template-columns: 15px 1fr auto; gap: 10px; align-items: center;
    text-align: left; padding: 9px 10px; border-radius: 4px; cursor: pointer; color: var(--ink); font: 500 14px/1.2 var(--font-body); min-height: 40px; }
  .lg-rail-row:hover { background: var(--surface-veil); }
  .lg-rail-row[aria-current="step"] { background: var(--accent-wash); }
  .lg-rail-mark { justify-self: center; box-sizing: border-box; width: 9px; height: 9px; border-radius: 50%; border: 1.5px solid var(--ink); }
  .lg-rail-mark[data-state="now"] { border: 0; background: var(--accent); }
  .lg-rail-mark[data-state="done"] { width: 10px; height: 2px; border: 0; border-radius: 1px; background: var(--rose); }
  .lg-rail-count { font-family: var(--font-mono); font-size: 11px; color: var(--ink-faint); font-variant-numeric: tabular-nums; }
  .lg-main { flex: 1 1 480px; min-width: 0; display: flex; flex-direction: column; gap: 24px; }
  /* at 390 the rail is a row of 32px chips */
  @media (max-width: 899px) {
    .lg-rail { flex: 1 1 100%; position: static; flex-direction: row; gap: 6px; overflow-x: auto; scrollbar-width: none; border: 0; background: none; padding: 0 0 4px; }
    .lg-rail::-webkit-scrollbar { display: none; }
    .lg-rail-row { flex: none; display: flex; gap: 8px; height: 32px; min-height: 32px; padding: 0 12px; border-radius: 999px; border: 1px solid var(--line); background: var(--surface-card); font-size: 13px; white-space: nowrap; }
    .lg-rail-count { display: none; }
    .lg-hours { padding: 16px 12px; }
  }

  .lg-section { gap: 12px; }
  .lg-filters { display: grid; gap: 10px; }
  .lg-spread { justify-content: space-between; }
  .lg-stair-block { display: grid; gap: 8px; margin-top: 8px; }
  .lg-stair-head { display: flex; justify-content: space-between; gap: 12px; flex-wrap: wrap; align-items: baseline; }
  .lg-best-table { margin-top: 8px; }
  .lg-best .lg-best-week { min-width: 96px; text-align: right; }
  .lg-best-heads { font: 600 11px/1.2 var(--font-body); letter-spacing: .14em; text-transform: uppercase; color: var(--ink-faint); }
  .lg-best-heads .lg-val { font: inherit; }
  .lg-best-heads .lg-lead { visibility: hidden; }
  .lg-staff { display: grid; gap: 8px; margin-top: 8px; }
  .lg-assume { display: flex; flex-direction: column; gap: 20px; }
  .lg-assume-row { display: flex; flex-wrap: wrap; gap: 8px 24px; align-items: center; }
  .lg-assume-text { flex: 1 1 260px; display: flex; flex-direction: column; gap: 2px; }
  .lg-assume-name { font-size: 14px; font-weight: 600; }
  .lg-sat { min-width: 56px; }
  .lg-fixed { font-size: 14px; padding: 8px 12px; border: 1px solid var(--line); border-radius: 4px; background: var(--surface-card); }
  .lg-review-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 20px 32px; }
  .lg-review-after { display: flex; flex-direction: column; gap: 16px; }
  .lg-keep { max-width: 640px; }
  .lg-field { display: grid; gap: 6px; }
  .lg-field-label { font-size: 14px; font-weight: 600; }
</style>

<script>
  import { mountPlanner } from "../../lib/ledger/planner";
  import { mountStreamSwitch } from "../../lib/ledger/stream-switch";
  const root = document.querySelector<HTMLElement>("[data-planner]");
  const box = document.querySelector<HTMLElement>("[data-stream-switch]");
  // the switch listens before the planner's first ledger:plan
  if (root && box && root.dataset.loaded !== "no") mountStreamSwitch(box, root);
  if (root && root.dataset.loaded !== "no") mountPlanner(root);
</script>

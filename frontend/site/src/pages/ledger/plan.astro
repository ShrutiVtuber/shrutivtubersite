---
/* Plan a business (handoff README §2): the Ledger's planner. Works signed
 * out; keeping a plan needs an account.
 *
 * The server draws the shell — the sub-bar, the stats bar with every figure
 * at —, the rail, What limits it, and the eight sections with all their fixed
 * words — and the script (lib/ledger/planner.ts) fetches the game's data
 * once, reckons the plan with the engine on every change, and fills the
 * lists. With no data loaded the page says so and plans nothing.
 *
 *   ?section=type|building|…|review   the section in view
 *   ?sample=1                         the brief's sample gift shop
 *   ?business=ID                      a kept business: Review shows Before it saves
 *   ?ledger=ID                        the ledger a new plan is for (its difficulty and courses)
 *   ?draft=1                          the plan in progress before signing in
 *   ?building=ID                      a new plan on this building (Places' "Plan a business here"), over the plan in hand
 *   ?campaigns=a,b                    …with these campaigns on (Calculators' "Use this mix in the plan")
 *
 * The Plan on stream switch (StreamSwitch.astro, lib/ledger/stream-switch.ts)
 * streams through ?ledger=ID or the business's own ledger, never a default one.
 *
 * ⚠ Every word the script draws is in WORDS below, as say() strings, and
 * reaches it through data-words. test/ledger-planner-words.test.mjs checks
 * that every key the script asks for is here.
 */
import BaseLayout from "../../layouts/BaseLayout.astro";
import Console from "../../components/guides/Console.astro";
import Empty from "../../components/guides/Empty.astro";
import Button from "../../components/forms/Button.astro";
import LedgerBar from "../../components/ledger/LedgerBar.astro";
import LedgerFoot from "../../components/ledger/LedgerFoot.astro";
import LedgerStats from "../../components/ledger/LedgerStats.astro";
import WhatLimitsIt from "../../components/ledger/WhatLimitsIt.astro";
import WeekGrid from "../../components/ledger/WeekGrid.astro";
import HoursPainter from "../../components/ledger/HoursPainter.astro";
import SaveNote from "../../components/ledger/SaveNote.astro";
import StreamSwitch from "../../components/ledger/StreamSwitch.astro";
import "../../styles/ledger-stream-switch.css";
import { account, asReader } from "../../lib/account";
import { copy } from "../../lib/copy";
import { loadPack } from "../../lib/ledger/data";

const say = await copy("ledger/plan");
const me = await account(Astro);
const pack = await loadPack();
const loaded = !!pack;
const params = Astro.url.searchParams;

type LedgerRow = { id: number; name: string; difficulty: string; custom?: Record<string, unknown> | null; courses: string[] };
const ledgersRead = me ? await asReader(Astro, "/api/ledger/ledgers") : null;
const ledgers: LedgerRow[] = ledgersRead?.ok && Array.isArray(ledgersRead.body)
  ? ledgersRead.body.map((l: any) => ({ id: l.id, name: l.name, difficulty: l.difficulty, custom: l.custom ?? null, courses: l.courses ?? [] }))
  : [];

/* ?business= opens a kept plan. Anyone else's is a 404 from the API, which
   reads here as "no such business": the planner then starts empty. */
const businessId = Number(params.get("business") || 0) || 0;
const businessRead = me && businessId ? await asReader(Astro, `/api/ledger/businesses/${businessId}`) : null;
const business = businessRead?.ok && businessRead.body?.id
  ? { id: businessRead.body.id, name: businessRead.body.name, ledgerId: businessRead.body.ledgerId, opened: !!businessRead.body.opened,
      plan: businessRead.body.plan ?? {}, keptPlan: businessRead.body.keptPlan ?? null }
  : null;
const asked = Number(params.get("ledger") || 0) || 0;
const ledgerId = business?.ledgerId ?? (ledgers.some((l) => l.id === asked) ? asked : ledgers[0]?.id ?? null);
const ledger = ledgers.find((l) => l.id === ledgerId) ?? null;

const SECTIONS = ["type", "building", "products", "fixtures", "hours", "campaigns", "assumptions", "review"] as const;
const wanted = String(params.get("section") || "");
const section = (SECTIONS as readonly string[]).includes(wanted) ? wanted : "type";

const NAMES: Record<string, string> = {
  type: say("section.type", "Type"),
  building: say("section.building", "Building"),
  products: say("section.products", "Products"),
  fixtures: say("section.fixtures", "Fixtures"),
  hours: say("section.hours", "Hours and staff"),
  campaigns: say("section.campaigns", "Campaigns"),
  assumptions: say("section.assumptions", "Assumptions"),
  review: say("section.review", "Review"),
};

const WORDS = {
  ...Object.fromEntries(Object.entries(NAMES).map(([k, v]) => [`section.${k}`, v])),
  and: say("and", "and"),
  or: say("or", "or"),
  chosen: say("chosen", "Chosen"),
  yours: say("yours", "yours"),
  loss: say("loss", "loss"),
  "unit.days": say("unit.days", "days"),
  "stats.note": say("stats.note", "{difficulty} · satisfaction {s} %"),
  "title.none": say("title.none", "A business, not kept"),
  "title.type": say("title.type", "A {type}, not kept"),
  "meta.noType": say("meta.noType", "no type yet"),
  "meta.noBuilding": say("meta.noBuilding", "no building yet"),
  "meta.unsaved": say("meta.unsaved", "nothing is saved until you keep it"),

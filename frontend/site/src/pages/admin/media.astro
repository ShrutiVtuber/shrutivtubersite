---
/* Media — upload art, see what is stored and where.
 *
 * Every image on this site is a NULLABLE reference with a designed absent
 * state, so uploading is never urgent — which is exactly why this screen says
 * plainly where each file lives. A bucket that is half-configured, or one that
 * was switched on after some files were already on disk, is the kind of thing
 * that produces a page of broken images and no explanation.
 */
import AdminLayout from "../../layouts/AdminLayout.astro";
import CsrfField from "../../components/forms/CsrfField.astro";
import Button from "../../components/forms/Button.astro";
import Badge from "../../components/navigation/Badge.astro";
import { asAdmin, ADMIN_COOKIE } from "../../lib/admin";
import { SITE_API } from "../../lib/api";
import { verifyCsrf } from "../../lib/csrf";

let notice = "";
let failed = "";

function auth(): Record<string, string> {
  const token = Astro.cookies.get(ADMIN_COOKIE)?.value;
  return token ? { cookie: `${ADMIN_COOKIE}=${token}` } : {};
}

if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  if (!verifyCsrf(Astro.cookies, form)) {
    failed = "That did not work. Reload the page and try again.";
  } else {
    const action = String(form.get("action") ?? "upload");
    const id = String(form.get("id") ?? "");

    if (action === "upload") {
      const file = form.get("file");
      if (!(file instanceof File) || file.size === 0) {
        failed = "Choose a file first.";
      } else {
        /* Forwarded as multipart to the backend, which is where the type
           allow-list and the size limit are enforced — not here, because a
           check in the browser or in a proxy is a courtesy, not a control. */
        const out = new FormData();
        out.append("file", file, file.name);
        out.append("title", String(form.get("title") ?? ""));
        out.append("tags", String(form.get("tags") ?? ""));
        out.append("alt_text", String(form.get("alt_text") ?? ""));
        const r = await fetch(`${SITE_API}/api/admin/media`, {
          method: "POST", headers: auth(), body: out,
        });
        const body = await r.json().catch(() => null);
        if (!r.ok) failed = body?.detail ?? "That did not upload.";
        else if (body?.deduped)
          notice = "That image was already here — the same bytes, so the same file.";
        else notice = `Uploaded — stored on ${body?.storage ?? "disk"}.`;
      }
    }

    if (action === "rename" && id) {
      const r = await asAdmin(Astro, `/api/admin/media/${id}`, {
        method: "PATCH",
        headers: { "content-type": "application/json" },
        body: JSON.stringify({
          title: String(form.get("title") ?? ""),
          tags: String(form.get("tags") ?? ""),
          alt_text: String(form.get("alt_text") ?? ""),
        }),
      });
      notice = r.ok ? "Saved." : "";
      failed = r.ok ? "" : (r.body?.detail ?? "That did not save.");
    }

    if (action === "sweep") {
      const names = form.getAll("orphan").map(String);
      if (names.length === 0) {
        failed = "Tick at least one file first.";
      } else {
        const r = await asAdmin(Astro, "/api/admin/media/orphans/sweep", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ filenames: names }),
        });
        if (r.ok) {
          const n = (r.body?.deleted ?? []).length;
          const skipped = (r.body?.skipped ?? []).length;
          notice = `${n} file${n === 1 ? "" : "s"} removed from the bucket.`
            + (skipped ? ` ${skipped} skipped — something claimed them since the check.` : "");
        } else {
          failed = r.body?.detail ?? "That could not be swept.";
        }
      }
    }

    if (action === "delete" && id) {
      const r = await asAdmin(Astro, `/api/admin/media/${id}`, { method: "DELETE" });
      /* A refusal here is the useful kind: it names what still points at the
         image, so the next step is obvious rather than a guess. */
      notice = r.ok ? "Deleted — the file and the record together." : "";
      failed = r.ok ? "" : (r.body?.detail ?? "That could not be deleted.");
    }
  }
}

const q = Astro.url.searchParams.get("q") ?? "";
const tag = Astro.url.searchParams.get("tag") ?? "";
const editing = Astro.url.searchParams.get("edit") ?? "";

const query = new URLSearchParams();
if (q) query.set("q", q);
if (tag) query.set("tag", tag);
const list = await asAdmin(Astro, `/api/admin/media${query.size ? `?${query}` : ""}`);
const items: any[] = Array.isArray(list.body) ? list.body : [];

/* Every tag in use, for the filter row. Taken from the unfiltered library —
   a tag list that shrinks as you filter by it cannot be used to change
   filter. */
const all = q || tag ? await asAdmin(Astro, "/api/admin/media") : list;
const allTags = [
  ...new Set((Array.isArray(all.body) ? all.body : []).flatMap((m: any) => m.tags ?? [])),
].sort((a, b) => String(a).localeCompare(String(b)));

const here = (extra: Record<string, string> = {}) => {
  const u = new URLSearchParams();
  if (q) u.set("q", q);
  if (tag) u.set("tag", tag);
  for (const [k, v] of Object.entries(extra)) v ? u.set(k, v) : u.delete(k);
  return `/admin/media${u.size ? `?${u}` : ""}`;
};

const onR2 = items.filter((m) => m.storage === "r2").length;

/* Only asked for when the storage it describes is actually in use — on disk
   there is no bucket to be out of step with. */
const orphanCall = onR2 > 0
  ? await asAdmin(Astro, "/api/admin/media/orphans")
  : { ok: false, body: null };
const bucket = orphanCall.ok ? orphanCall.body : null;
const kb = (n: number) => `${Math.round(n / 1024)} KB`;
---

<AdminLayout title="Media">
  <div class="head">
    <h1 class="adm-h">Media</h1>
    <Badge tone={onR2 > 0 ? "accent" : "faint"}>
      {onR2 > 0 ? `${onR2} of ${items.length} on R2` : "storing on disk"}
    </Badge>
  </div>

  {notice && <p class="adm-ok" role="status">{notice}</p>}
  {failed && <p class="adm-bad" role="alert">{failed}</p>}

  {bucket?.configured && (bucket.orphans.length > 0 || bucket.missing.length > 0) && (
    <section class="adm-card bucket">
      <h2 class="adm-h2">The bucket and the library disagree</h2>

      {bucket.missing.length > 0 && (
        <>
          <p class="adm-note">
            <strong>{bucket.missing.length} record{bucket.missing.length === 1 ? "" : "s"}
            {bucket.missing.length === 1 ? " has" : " have"} no file.</strong> These
            render as broken images wherever they are used. Re-upload the
            picture, or delete the record and point whatever used it somewhere
            else.
          </p>
          <ul class="plain">
            {bucket.missing.map((m: any) => (
              <li><code>{m.filename}</code> {m.title && <span class="dim">— {m.title}</span>}</li>
            ))}
          </ul>
        </>
      )}

      {bucket.orphans.length > 0 && (
        <>
          <p class="adm-note">
            <strong>{bucket.orphans.length} file{bucket.orphans.length === 1 ? "" : "s"} in
            the bucket {bucket.orphans.length === 1 ? "has" : "have"} no record.</strong>
            {" "}Nothing on the site can reach {bucket.orphans.length === 1 ? "it" : "them"},
            and {bucket.orphans.length === 1 ? "it is" : "they are"} costing storage.
          </p>

          {!bucket.canSweep ? (
            <p class="adm-bad" role="status">
              This is the <strong>{bucket.env}</strong> environment, which shares
              the bucket with the live site — so this list includes every file
              belonging to production. Sweeping is only possible from production
              itself.
            </p>
          ) : (
            <form method="POST" class="sweep">
              <CsrfField />
              <input type="hidden" name="action" value="sweep" />
              <ul class="plain">
                {bucket.orphans.map((o: any) => (
                  <li>
                    <label class="ck">
                      <input type="checkbox" name="orphan" value={o.filename} />
                      <code>{o.filename}</code>
                      <span class="dim">{(o.sizeBytes / 1024).toFixed(0)} KB</span>
                    </label>
                  </li>
                ))}
              </ul>
              <p class="adm-note">
                Ticked files are deleted from the bucket permanently. Each is
                re-checked first, so anything that has gained a record since
                this page loaded is skipped rather than removed.
              </p>
              <Button type="submit" variant="ghost">Delete the ticked files</Button>
            </form>
          )}
        </>
      )}
    </section>
  )}

  <form method="POST" enctype="multipart/form-data" class="adm-card upload">
    <CsrfField />
    <input type="hidden" name="action" value="upload" />
    <label class="field">
      <span class="adm-lbl">Image</span>
      <input class="adm-input" type="file" name="file" accept="image/png,image/jpeg,image/webp,image/avif,image/svg+xml" required />
    </label>
    <div class="naming">
      <label class="field">
        <span class="adm-lbl">Name it</span>
        <input class="adm-input" type="text" name="title" placeholder="Stream overlay, corner frame" />
      </label>
      <label class="field">
        <span class="adm-lbl">Tags</span>
        <input class="adm-input" type="text" name="tags" placeholder="overlay, twitch" />
      </label>
    </div>
    <label class="field">
      <span class="adm-lbl">Alt text</span>
      <input class="adm-input" type="text" name="alt_text" placeholder="What someone who cannot see it would need told" />
    </label>
    <div><Button type="submit">Upload</Button></div>
    <p class="adm-note">
      PNG, JPEG, WebP, AVIF or SVG. Files are named by their own SHA-256, so the same image
      uploaded twice is stored once and its URL never changes — the name you give is yours,
      kept beside it, and can be changed whenever without moving anything.
    </p>
  </form>

  <form method="GET" class="adm-card finder">
    <label class="field grow">
      <span class="adm-lbl">Search</span>
      <input class="adm-input" type="search" name="q" value={q}
             placeholder="Name, tag or alt text" />
    </label>
    {tag && <input type="hidden" name="tag" value={tag} />}
    <div><Button type="submit">Find</Button></div>
    {
      (q || tag) && <a class="clear" href="/admin/media">Clear</a>
    }
    {
      allTags.length > 0 && (
        <nav class="tags" aria-label="Tags">
          {allTags.map((t: any) => (
            <a class="tag" href={here({ tag: tag === t ? "" : String(t), edit: "" })}
               aria-current={tag === t ? "page" : undefined}>{t}</a>
          ))}
        </nav>
      )
    }
  </form>

  {
    items.length === 0 ? (
      <p class="adm-note">
        {q || tag
          ? "Nothing matches that."
          : "Nothing uploaded yet. Every art slot on the site has a designed absent state, so there is no hurry."}
      </p>
    ) : (
      <div class="grid">
        {
          items.map((m) => (
            <figure class="item" data-editing={String(m.id) === editing || undefined}>
              <a href={m.url} class="thumb">
                <img src={m.url} alt={m.altText || m.title || m.filename} loading="lazy" />
              </a>
              {
                String(m.id) === editing ? (
                  <form method="POST" class="editor">
                    <CsrfField />
                    <input type="hidden" name="action" value="rename" />
                    <input type="hidden" name="id" value={m.id} />
                    <input class="adm-input" type="text" name="title" value={m.title} placeholder="Name" />
                    <input class="adm-input" type="text" name="tags" value={(m.tags ?? []).join(", ")} placeholder="Tags" />
                    <input class="adm-input" type="text" name="alt_text" value={m.altText} placeholder="Alt text" />
                    <div class="editor-actions">
                      <Button type="submit">Save</Button>
                      <a class="cancel" href={here({ edit: "" })}>Cancel</a>
                    </div>
                  </form>
                ) : (
                  <figcaption>
                    <span class="name">{m.title || `${m.filename.slice(0, 14)}…`}</span>
                    <span class="meta">
                      {m.width && m.height ? `${m.width}×${m.height} · ` : ""}{kb(m.sizeBytes)}
                    </span>
                    {
                      (m.tags ?? []).length > 0 && (
                        <span class="itemtags">
                          {m.tags.map((t: string) => <a class="tag" href={here({ tag: t, edit: "" })}>{t}</a>)}
                        </span>
                      )
                    }
                    <span class="store" data-r2={m.storage === "r2" || undefined}>{m.storage}</span>
                    <span class="actions">
                      <a href={here({ edit: String(m.id) })}>Rename</a>
                      <form method="POST" class="del">
                        <CsrfField />
                        <input type="hidden" name="action" value="delete" />
                        <input type="hidden" name="id" value={m.id} />
                        <button type="submit" class="danger">Delete</button>
                      </form>
                    </span>
                  </figcaption>
                )
              }
            </figure>
          ))
        }
      </div>
    )
  }
</AdminLayout>

<style>
  .bucket { display: grid; gap: 10px; margin-bottom: 16px; }
  .bucket .plain { list-style: none; margin: 0; padding: 0; display: grid; gap: 4px; }
  .bucket code { font-family: var(--font-mono); font-size: var(--text-xs); }
  .bucket .dim { color: var(--ink-faint); font-size: var(--text-xs); }
  .ck { display: flex; align-items: baseline; gap: 8px; cursor: pointer; }
  .sweep { display: grid; gap: 10px; justify-items: start; }

  .head { display: flex; gap: var(--space-4); align-items: baseline; flex-wrap: wrap; }
  .upload { max-width: 520px; }
  .field { display: grid; gap: 4px; }
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(160px, 1fr)); gap: var(--space-4); }
  .item { margin: 0; display: grid; gap: 6px; }
  .thumb {
    display: block; aspect-ratio: 1; border: var(--border-w) solid var(--line);
    border-radius: var(--radius-md); overflow: hidden; background: var(--surface-inset);
  }
  .thumb img { width: 100%; height: 100%; object-fit: cover; display: block; }
  figcaption { display: grid; gap: 2px; }
  .name { font: 400 var(--text-xs) var(--font-mono); color: var(--ink); }
  .meta { font: 400 var(--text-xs) var(--font-mono); color: var(--ink-faint); }
  .store {
    font: 600 0.625rem var(--font-mono); letter-spacing: var(--tracking-caps);
    text-transform: uppercase; color: var(--ink-faint);
  }
  .store[data-r2] { color: var(--accent); }
</style>

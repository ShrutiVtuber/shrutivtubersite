---
/* Counters, and the overlays that show them.
 *
 * The one rule this page is built around: **a token is shown exactly once,
 * when the overlay is made, and never again.** OBS settings get screen-shared,
 * and an admin that renders a credential every time it loads is a credential
 * on stream. There is no route that returns it afterwards — losing it costs a
 * new row and a paste, which is cheap.
 */
import AdminLayout from "../../layouts/AdminLayout.astro";
import CsrfField from "../../components/forms/CsrfField.astro";
import Button from "../../components/forms/Button.astro";
import { asAdmin } from "../../lib/admin";
import { verifyCsrf } from "../../lib/csrf";
import { SITE_URL } from "../../lib/api";

export const prerender = false;

let notice = "";
let failed = "";
let minted = "";      // the one moment a token is readable

const SOURCES: [string, string, string][] = [
  ["stripe.support", "Support", "money"],
  ["stripe.membership", "Memberships", "money"],
  ["stripe.shop", "Shop orders", "money"],
  ["youtube.superchat", "YouTube Super Chats", "money"],
  ["twitch.sub", "Twitch subscriptions", "count"],
  ["twitch.gift", "Twitch gifted subs", "count"],
  ["twitch.bits", "Twitch bits", "bits"],
  ["twitch.raid", "Raids", "count"],
  ["twitch.follow", "Follows", "count"],
  ["course.signup", "Course signups", "people"],
  ["workshop.signup", "Workshop signups", "people"],
];

if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  if (!verifyCsrf(Astro.cookies, form)) {
    failed = "That did not save. Reload and try again.";
  } else {
    const action = String(form.get("action") ?? "");

    if (action === "new-counter") {
      const unit = String(form.get("unit") ?? "money");
      const raw = Number(form.get("target") ?? 0);
      const r = await asAdmin(Astro, "/api/overlay/admin/counters", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          name: String(form.get("name") ?? ""),
          note: String(form.get("note") ?? ""),
          unit,
          /* Money is stored in minor units, as Stripe counts it — she types
             euros. Everything else is already a plain count. */
          target: unit === "money" ? Math.round(raw * 100) : Math.round(raw),
          sources: form.getAll("sources").map(String),
        }),
      });
      notice = r.ok ? "Counter made." : "";
      if (!r.ok) failed = r.body?.detail ?? "That could not be made.";
    } else if (action === "delete-counter") {
      await asAdmin(Astro, `/api/overlay/admin/counters/${form.get("id")}`, { method: "DELETE" });
      notice = "Counter removed. The events it counted are untouched.";
    } else if (action === "new-overlay") {
      const r = await asAdmin(Astro, "/api/overlay/admin/overlays", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          kind: String(form.get("kind") ?? "counter"),
          label: String(form.get("label") ?? ""),
          counter_id: form.get("counter_id") ? Number(form.get("counter_id")) : null,
          motion: String(form.get("motion") ?? "reduced"),
          appearance: String(form.get("appearance") ?? "almanac"),
        }),
      });
      if (r.ok) {
        const size = String(form.get("size") ?? "");
        minted = `${SITE_URL}/overlay/${form.get("kind")}?t=${r.body.token}` +
                 (size === "compact" ? "&size=compact" : "");
      } else {
        failed = r.body?.detail ?? "That could not be made.";
      }
    } else if (action === "upload-sound") {
      const f = form.get("sound");
      if (f instanceof File && f.size > 0) {
        const body = new FormData();
        body.append("file", f);
        body.append("title", String(form.get("sound_title") ?? "") || f.name);
        const r = await asAdmin(Astro, "/api/admin/sounds", { method: "POST", body });
        if (r.ok) {
          notice = `Uploaded. Assign it to an alert below.`;
        } else {
          failed = r.body?.detail ?? "That file could not be uploaded.";
        }
      } else {
        failed = "Choose a WAV or OGG file first.";
      }
    } else if (action === "assign-sound") {
      const r = await asAdmin(Astro, "/api/overlay/admin/sounds", {
        method: "PUT",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          kind: String(form.get("kind") ?? ""),
          filename: String(form.get("filename") ?? ""),
          gain_db: Number(form.get("gain_db") ?? 0),
        }),
      });
      notice = r.ok
        ? (form.get("filename") ? "Assigned." : "Silenced. That alert makes no sound.")
        : "";
      if (!r.ok) failed = r.body?.detail ?? "That could not be saved.";
    } else if (action === "mute") {
      const on = form.get("on") === "1";
      const r = await asAdmin(Astro, `/api/overlay/admin/sounds/mute?on=${on}`, { method: "PUT" });
      notice = r.ok
        ? (on ? "Muted. Nothing is unassigned — flip it back when you want them."
              : "Sound on.")
        : "";
      if (!r.ok) failed = "That could not be saved.";
    } else if (action === "ticker-line") {
      const r = await asAdmin(Astro, "/api/admin/settings", {
        method: "PUT",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          values: { "overlay.ticker_standing": String(form.get("standing") ?? "").trim() },
        }),
      });
      notice = r.ok ? "Saved. The ticker picks it up within a few minutes." : "";
      if (!r.ok) failed = "That could not be saved.";
    } else if (action === "revoke") {
      await asAdmin(Astro, `/api/overlay/admin/overlays/${form.get("id")}`, { method: "DELETE" });
      notice = "Revoked. That address stops working immediately.";
    }
  }
}

const counters = (await asAdmin(Astro, "/api/overlay/admin/counters")).body ?? [];
const tickerLine = (await asAdmin(Astro, "/api/admin/settings?prefix=overlay."))
  .body?.["overlay.ticker_standing"] ?? "";

const soundState = (await asAdmin(Astro, "/api/overlay/admin/sounds")).body
  ?? { muted: false, sounds: {} };
/* Everything already uploaded as an alert sound, so assigning is a pick from a
   list rather than typing a hash by hand. */
const soundFiles = ((await asAdmin(Astro, "/api/admin/media?tag=alert-sound")).body ?? [])
  .filter((m: any) => String(m.mimeType ?? "").startsWith("audio/"));
const overlays = (await asAdmin(Astro, "/api/overlay/admin/overlays")).body ?? [];

/* Her words for each surface, in one place — the picker, the list and the
   instructions all read from it, so renaming one renames all three. */
const SURFACE: Record<string, string> = {
  counter: "Counter bar",
  alerts: "Alerts",
  ticker: "Supporters ticker",
  sky: "Sky chart",
  hours: "Planetary hours",
  countdown: "Countdown",
};

const SYMBOL: Record<string, string> = { eur: "€", gbp: "£", usd: "$" };
const show = (c: any, v: number) =>
  c.unit === "money" ? `${SYMBOL[c.currency] ?? ""}${(v / 100).toFixed(0)}` : String(v);
const nameOf = (id: number | null) =>
  counters.find((c: any) => c.id === id)?.name ?? "—";
---

<AdminLayout title="Stream">
  <div class="cn">
    <h1>Stream overlays</h1>
    <p class="lede">
      Six things you can put on the stream, all fed from here. Each one is a
      separate Browser Source in OBS — add only the ones you want.
    </p>

    <details class="how" open={overlays.length === 0}>
      <summary>How to put one on the stream</summary>

      <ol class="steps">
        <li>
          <strong>Make a counter first</strong> if the overlay needs one — the
          bar, the countdown and the ticker all show a counter; the sky chart
          and the hours strip do not. The form is further down this page.
        </li>
        <li>
          <strong>Make the overlay</strong> under <em>Overlays</em>, below.
          Pick which surface, which counter, and how much animation the machine
          you stream from can afford.
        </li>
        <li>
          <strong>Copy the address.</strong> It is shown once, at the top of
          this page, straight after you make it. Nothing can retrieve it
          afterwards — that is deliberate, because this page gets screen-shared.
          Losing one costs nothing: make another and paste the new address in.
        </li>
        <li>
          <strong>In OBS:</strong> Sources → <em>+</em> → <strong>Browser</strong>.
          Paste the address into <em>URL</em>. Set <strong>Width 1920</strong>
          and <strong>Height 1080</strong>. Leave the custom CSS box alone —
          the page is already transparent.
        </li>
        <li>
          Tick <strong>“Shutdown source when not visible”</strong> and
          <strong>“Refresh browser when scene becomes active”</strong>. The
          first stops an overlay you are not showing from costing you frames;
          the second makes it pick up changes you make here.
        </li>
      </ol>

      <p class="fine">
        Every surface draws in its own corner of a 1920 × 1080 canvas, so
        several can sit on top of each other without colliding — the hours
        strip is top left, the countdown top right, alerts across the middle,
        the sky chart on the right, the ticker and the bar along the bottom.
        Drag them anywhere you like in OBS; nothing here depends on where they
        end up.
      </p>

      <table class="surfaces">
        <thead><tr><th>Surface</th><th>Needs a counter</th><th>What it shows</th></tr></thead>
        <tbody>
          <tr><td>Counter bar</td><td>yes</td>
              <td>A goal and how far along it is. Wide, or compact.</td></tr>
          <tr><td>Alerts</td><td>no</td>
              <td>Support, subs, gifts, bits, raids, class and workshop signups, follows.</td></tr>
          <tr><td>Supporters ticker</td><td>optional</td>
              <td>A row of names along the bottom. No amounts, on purpose.</td></tr>
          <tr><td>Sky chart</td><td>no</td>
              <td>The sky right now, from your own ephemeris, with the Moon’s drift.</td></tr>
          <tr><td>Planetary hours</td><td>no</td>
              <td>Past, current and next hour, and whose day it is.</td></tr>
          <tr><td>Countdown</td><td>yes</td>
              <td>How long a counter’s window has left.</td></tr>
        </tbody>
      </table>

      <p class="fine">
        <strong>Nothing here can change the site.</strong> An overlay address is
        read-only and scoped to one surface — if one leaks on a stream, the most
        anyone can do is watch a bar you were already showing them.
      </p>
    </details>
    {notice && <p class="ok">{notice}</p>}
    {failed && <p class="bad">{failed}</p>}

    {minted && (
      <section class="minted">
        <p class="ov-once">
          Made. In OBS: Sources → + → Browser, paste this into URL, set
          1920 × 1080.
        </p>
        <input class="url" type="text" readonly value={minted} onclick="this.select()" />
        <p class="fine">
          <strong>This is the only time it is shown.</strong> Nothing here can
          retrieve it again — not by design accident but on purpose, because
          this page gets screen-shared. If it goes missing, make another
          overlay and paste the new address in; it costs nothing.
        </p>
      </section>
    )}

    <section class="block">
      <h2>What is being counted</h2>
      {counters.length === 0 ? (
        <p class="fine">None yet. The form below makes one.</p>
      ) : (
        <ul class="list">
          {counters.map((c: any) => (
            <li>
              <div>
                <p class="nm">{c.name}</p>
                <p class="fine">
                  {c.note || "no note"} · {c.sources.length} source{c.sources.length === 1 ? "" : "s"}
                  {c.sources.length === 0 && " — nothing will ever count toward it"}
                </p>
              </div>
              <span class="fig t-tabular">
                {show(c, c.current)} / {show(c, c.target)}
                {c.unit !== "money" && ` ${c.unit}`}
              </span>
              <form method="POST">
                <CsrfField />
                <input type="hidden" name="action" value="delete-counter" />
                <input type="hidden" name="id" value={c.id} />
                <button class="rm" type="submit">Remove</button>
              </form>
            </li>
          ))}
        </ul>
      )}
    </section>

    <section class="block">
      <h2>Make a counter</h2>
      <form method="POST" class="grid">
        <CsrfField />
        <input type="hidden" name="action" value="new-counter" />
        <label class="wide"><span>Name — your words</span>
          <input name="name" required maxlength="120" placeholder="A new microphone" /></label>
        <label class="wide"><span>One line under it</span>
          <input name="note" maxlength="200" placeholder="for cleaner streams" /></label>
        <label><span>Unit</span>
          <select name="unit">
            <option value="money">Money</option>
            <option value="people">People</option>
            <option value="bits">Bits</option>
            <option value="subs">Subscriptions</option>
          </select></label>
        <label><span>Target</span>
          <input name="target" required inputmode="decimal" placeholder="300" />
          <em class="fine">Money in whole euros. Everything else a plain count.</em></label>
        <fieldset class="wide srcs">
          <legend>What counts toward it</legend>
          {SOURCES.map(([v, label, kind]) => (
            <label class="chk">
              <input type="checkbox" name="sources" value={v} />
              <span>{label} <em>{kind}</em></span>
            </label>
          ))}
          <p class="fine">
            YouTube memberships are <strong>not listed and cannot be</strong> —
            the API is gated behind a Google partner relationship. Super Chats
            are unaffected.
          </p>
        </fieldset>
        <div class="wide"><Button type="submit">Make it</Button></div>
      </form>
    </section>

    <section class="block">
      <h2>Sound</h2>
      <p class="fine">
        Your own files, one per alert. An alert with nothing assigned is
        <strong>silent</strong> — there is no default beep, because a sound you
        have not heard should never play on your stream. Follows are silent
        until you give them something.
      </p>
      <p class="fine">
        WAV or OGG, up to 512 KB each. They are loaded into the overlay when it
        connects and held there, so nothing is fetched mid-stream.
      </p>

      <form method="post" enctype="multipart/form-data" class="stack">
        <CsrfField />
        <input type="hidden" name="action" value="upload-sound" />
        <label><span>Add a sound</span>
          <input type="file" name="sound" accept=".wav,.ogg,audio/wav,audio/ogg" /></label>
        <label><span>Call it</span>
          <input name="sound_title" maxlength="80" placeholder="Little bell" /></label>
        <button class="btn">Upload</button>
      </form>

      <form method="post" class="mute-row">
        <CsrfField />
        <input type="hidden" name="action" value="mute" />
        <input type="hidden" name="on" value={soundState.muted ? "0" : "1"} />
        <button class="btn ghost">
          {soundState.muted ? "Un-mute everything" : "Mute everything"}
        </button>
        <span class="fine">
          {soundState.muted
            ? "Everything is silent. Nothing has been unassigned."
            : "Silences every alert without unassigning anything."}
        </span>
      </form>

      {soundFiles.length === 0 ? (
        <p class="fine">Nothing uploaded yet, so every alert is silent.</p>
      ) : (
        <table class="rows">
          <thead><tr><th>Alert</th><th>Sound</th><th>Level</th><th></th></tr></thead>
          <tbody>
            {SOURCES.map(([key, label]) => {
              const cur = soundState.sounds?.[key] ?? { filename: "", gainDb: 0 };
              return (
                <tr>
                  <td>{label}</td>
                  <td colspan="3">
                    <form method="post" class="assign">
                      <CsrfField />
                      <input type="hidden" name="action" value="assign-sound" />
                      <input type="hidden" name="kind" value={key} />
                      <select name="filename">
                        <option value="" selected={!cur.filename}>Silent</option>
                        {soundFiles.map((m: any) => (
                          <option value={m.filename} selected={cur.filename === m.filename}>
                            {m.title || m.filename}
                          </option>
                        ))}
                      </select>
                      <label class="gain">
                        <span class="fine">dB</span>
                        <input type="number" name="gain_db" value={cur.gainDb ?? 0}
                               min="-40" max="0" step="1" />
                      </label>
                      <button class="btn ghost small">Save</button>
                      {cur.filename && (
                        /* The row's own URL, never a path built from the
                           filename — where a file is served from depends on
                           which backend it landed in. */
                        <audio controls preload="none"
                               src={soundFiles.find((m: any) => m.filename === cur.filename)?.url}
                        ></audio>
                      )}
                    </form>
                  </td>
                </tr>
              );
            })}
          </tbody>
        </table>
      )}
      <p class="fine">
        The level only turns a sound <em>down</em>. If one is too quiet,
        normalise the file before uploading — turning it up here would clip it
        on the stream rather than in this page, where you could hear it.
      </p>
    </section>

    <section class="block">
      <h2>What the ticker says before anyone has given</h2>
      <p class="fine">
        The supporters row runs along the bottom of the stream for the whole
        session. Before there is a name to put in it, it does <strong>not</strong>
        say "no supporters yet" — that tells the room nobody has given, at the
        moment it is most expensive to say. It carries this line instead, so the
        row still earns its space on the first day of a campaign.
      </p>
      <form method="post" class="stack">
        <CsrfField />
        <input type="hidden" name="action" value="ticker-line" />
        <label><span>Your standing line</span>
          <input name="standing" value={tickerLine} maxlength="120"
                 placeholder="Support goes straight into the tools and the time." /></label>
        <p class="fine">One line. It is truncated at the plate edge, not wrapped.</p>
        <button class="btn">Save</button>
      </form>
    </section>

    <section class="block">
      <h2>Overlays</h2>
      <p class="fine">
        Each is a separate Browser Source at <strong>1920 × 1080</strong>. Add
        only the ones you want; none depends on another being present, and each
        draws in its own corner of the canvas so several can overlap without
        colliding.
      </p>
      <p class="fine">
        The sky chart and the hours strip take an optional
        <code>&amp;lat=</code> and <code>&amp;lon=</code> — without them they
        use Athens.
      </p>
      {overlays.length > 0 && (
        <ul class="list">
          {overlays.map((o: any) => (
            <li>
              <div>
                <p class="nm">{o.label || SURFACE[o.kind] || o.kind}</p>
                <p class="fine">
                  {SURFACE[o.kind] ?? o.kind} · {o.appearance} · motion {o.motion}
                  {o.counterId && ` · ${nameOf(o.counterId)}`}
                  {o.lastSeen ? ` · last seen ${new Date(o.lastSeen).toLocaleString("en-GB", { dateStyle: "short", timeStyle: "short" })}` : " · never opened"}
                </p>
              </div>
              <span class="fig t-tabular">••••••••</span>
              <form method="POST">
                <CsrfField />
                <input type="hidden" name="action" value="revoke" />
                <input type="hidden" name="id" value={o.id} />
                <button class="rm" type="submit">Revoke</button>
              </form>
            </li>
          ))}
        </ul>
      )}

      <form method="POST" class="grid">
        <CsrfField />
        <input type="hidden" name="action" value="new-overlay" />
        <label><span>Surface</span>
          <select name="kind">
            {Object.entries(SURFACE).map(([v, label]) => (
              <option value={v}>{label}</option>
            ))}
          </select></label>
        <label><span>Size <em class="fine">counter bar only</em></span>
          <select name="size">
            <option value="wide">Wide — 1360px</option>
            <option value="compact">Compact — 620px</option>
          </select></label>
        <label><span>Which counter</span>
          <select name="counter_id">
            <option value="">— none —</option>
            {counters.map((c: any) => <option value={c.id}>{c.name}</option>)}
          </select>
          <em class="fine">
            The bar and the countdown need one. The ticker uses it to show only
            that campaign&rsquo;s supporters. The sky chart, the hours strip and
            alerts ignore it.
          </em></label>
        <label><span>Appearance</span>
          <select name="appearance">
            <option value="almanac">Almanac</option>
            <option value="grimoire">Grimoire</option>
          </select></label>
        <label><span>Motion</span>
          <select name="motion">
            <option value="reduced">Reduced — everyday</option>
            <option value="full">Full — the strong machine</option>
            <option value="still">Still — no animation</option>
          </select>
          <em class="fine">
            This is about the machine you stream from, not about the design.
            Still is complete and legible — it is the weaker PC and a bad night,
            not a lesser version.
          </em></label>
        <label><span>Label, for you</span>
          <input name="label" maxlength="80" placeholder="Main scene" />
          <em class="fine">
            Only ever shown on this page. Name it after the OBS scene it goes
            in, so revoking the right one later is obvious.
          </em></label>
        <div class="wide"><Button type="submit">Make an overlay</Button></div>
      </form>
    </section>
  </div>
</AdminLayout>

<style>
  .how {
    border: var(--border-w) solid var(--line);
    border-radius: var(--radius-md);
    background: var(--surface-card);
    padding: 14px 18px;
    margin: 0 0 20px;
  }
  .how > summary {
    cursor: pointer; font-weight: 600; font-family: var(--font-display);
    font-size: var(--text-md);
  }
  .how[open] > summary { margin-bottom: 10px; }
  .steps { margin: 0 0 12px; padding-left: 20px; display: grid; gap: 8px; }
  .steps li { line-height: 1.55; }

  .surfaces { width: 100%; border-collapse: collapse; margin: 10px 0; font-size: var(--text-sm); }
  .surfaces th, .surfaces td {
    text-align: left; padding: 6px 10px 6px 0;
    border-bottom: 1px solid var(--line); vertical-align: top;
  }
  .surfaces th { color: var(--ink-faint); font-weight: 600; }
  .surfaces td:first-child { white-space: nowrap; font-weight: 500; }

  .cn { display: grid; gap: var(--space-5); max-width: 78ch; }
  .cn h1 { font: 500 var(--text-h1) var(--font-display); color: var(--ink); margin: 0; }
  .cn h2 { font: 600 var(--text-h3) var(--font-display); color: var(--ink); margin: 0; }
  .lede { font: 400 var(--text-body) / var(--leading-body) var(--font-body); color: var(--ink-soft); margin: 0; }
  .ok { font: 400 var(--text-sm) var(--font-body); color: var(--accent); margin: 0; }
  .bad { font: 400 var(--text-sm) var(--font-body); color: var(--live); margin: 0; }
  .fine { font: 400 var(--text-xs) / 1.7 var(--font-body); color: var(--ink-faint); margin: 0; }

  .block { display: grid; gap: 12px; padding: 18px 20px;
    background: var(--surface-card); border: var(--border-w) solid var(--line);
    border-radius: var(--radius-md); }

  .minted { display: grid; gap: 10px; padding: 18px 20px;
    background: var(--rose-wash); border: var(--border-w) solid var(--rose);
    border-left-width: 3px; border-radius: var(--radius-md); }
  .ov-once { font: 600 var(--text-sm) var(--font-body); color: var(--ink); margin: 0; }
  .url { font: 400 var(--text-xs) var(--font-mono); color: var(--ink);
    background: var(--surface-card); border: var(--border-w) solid var(--line);
    border-radius: var(--radius-sm); padding: 10px 12px; width: 100%; box-sizing: border-box; }

  .list { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; }
  .list li { display: grid; grid-template-columns: 1fr auto auto; gap: 14px; align-items: center;
    padding: 11px 14px; background: var(--surface-inset);
    border: var(--border-w) solid var(--line); border-radius: var(--radius-sm); }
  .nm { font: 600 var(--text-sm) var(--font-body); color: var(--ink); margin: 0; }
  .fig { font: 500 var(--text-sm) var(--font-mono); color: var(--accent); white-space: nowrap; }
  .rm { cursor: pointer; background: none; border: none; padding: 0;
    font: 400 var(--text-micro) var(--font-body); color: var(--ink-faint); }

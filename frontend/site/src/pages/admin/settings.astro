---
/* Site settings — currently the legal imprint.
 *
 * The imprint is hidden until it is both filled in and switched on. The design
 * ships bracketed placeholders, which is right for a mock-up and wrong to
 * publish: a registry number that looks like a registry number and is not one
 * reads as a claim rather than as a gap.
 *
 * The reason the design wanted it from day one is not lost — pseudonymity is
 * off, and a virtual office on the page is what stops a home address reaching
 * a WHOIS record or a takedown notice. This screen is how it goes up the day
 * the company exists, without a deploy.
 */
import AdminLayout from "../../layouts/AdminLayout.astro";
import CsrfField from "../../components/forms/CsrfField.astro";
import Button from "../../components/forms/Button.astro";
import Badge from "../../components/navigation/Badge.astro";
import PasskeyList, { type PasskeyRow } from "../../components/auth/PasskeyList.astro";
import { asAdmin } from "../../lib/admin";
import { verifyCsrf } from "../../lib/csrf";

const FIELDS: [string, string, string][] = [
  ["imprint.entity", "Entity", "The registered name, e.g. ShrutiVTuber, LLC"],
  /* This used to read "the VIRTUAL OFFICE — never a home address". That is
     good personal-safety advice and it may not be lawful: the EU e-commerce
     rules every member state implements ask for the geographic address at
     which the provider is ESTABLISHED, and a mail-forwarding box is not
     obviously that. The two goals are genuinely in tension and the resolution
     is a lawyer's, not a form field's — so the help text now says so instead
     of confidently recommending one side of it. */
  ["imprint.street", "Street", "A real address you can legally be reached at. A forwarding box may not satisfy this — ask your lawyer before relying on one."],
  ["imprint.postcode", "Postcode", ""],
  ["imprint.city", "City", ""],
  ["imprint.country", "Country", "Two letters, e.g. GR"],
  ["imprint.email", "Role email", "Reachable, and monitored"],
  ["imprint.registry", "Registry", "e.g. GEMI 123456789012"],
  ["imprint.vat", "VAT", "e.g. VAT EL123456789"],
];

let notice = "";
let failed = "";

if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  if (!verifyCsrf(Astro.cookies, form)) {
    failed = "That did not save. Reload the page and try again.";
  } else {
    const values: Record<string, string> = {};
    for (const [key] of FIELDS) values[key] = String(form.get(key) ?? "").trim();
    values["imprint.visible"] = form.get("visible") === "1" ? "1" : "0";
    if (String(form.get("action") ?? "") === "site-state") {
      /* "1" and "0" rather than present/absent, because absent means ON — a
         fresh deploy must hold the door until somebody opens it. */
      const r = await asAdmin(Astro, "/api/admin/settings", {
        method: "PUT",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          values: { "site.coming_soon": form.get("live") === "1" ? "0" : "1" },
        }),
      });
      notice = r.ok
        ? form.get("live") === "1"
          ? "The site is live. Everyone sees it now."
          : "The holding page is up. Only you see the site."
        : "";
      failed = r.ok ? "" : "That did not save.";
    } else if (String(form.get("action") ?? "") === "section") {
      const name = String(form.get("section") ?? "");
      const live = form.get("live") === "1";
      const r = await asAdmin(Astro, "/api/admin/settings", {
        method: "PUT",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ values: { [`page.${name}`]: live ? "1" : "0" } }),
      });
      notice = r.ok
        ? live
          ? "Published — visitors can reach it now."
          : "Hidden. Visitors get a 404; you still see it and can keep building."
        : "";
      /* The backend refuses to hide classes while anybody holds one, and says
         how many. Its sentence is better than anything generic here. */
      failed = r.ok ? "" : (r.body?.detail ?? "That did not save.");
    }

    const r = await asAdmin(Astro, "/api/admin/settings", {
      method: "PUT",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ values }),
    });
    notice = r.ok ? "Saved." : "";
    failed = r.ok ? "" : (r.body?.detail ?? "That did not save.");
  }
}

const read = await asAdmin(Astro, "/api/admin/settings?prefix=imprint.");
const stateRead = await asAdmin(Astro, "/api/admin/settings?prefix=site.");
const holdingOn = (stateRead.ok ? stateRead.body?.settings ?? {} : {})["site.coming_soon"] !== "0";

/* Sections she can finish in private. Absent means published — a section that
   vanished because a settings row was missing would be the worst surprise. */
const pageRead = await asAdmin(Astro, "/api/admin/settings?prefix=page.");
const pageValues: Record<string, string> = pageRead.ok ? (pageRead.body?.settings ?? {}) : {};
const SECTIONS: [string, string, string][] = [
  ["shop", "Shop", "Products, prices and orders. Hidden, nobody can find or buy — and everything you build stays here waiting."],
  ["horoscopes", "Horoscopes", "Draft and stage as many months as you like. None of it is public until the section is."],
  ["classes", "Classes", "Courses, lessons and workshops. Cannot be hidden once anybody holds a place — they paid for it."],
  ["guides", "Shruti's Guides", "Game guides, the catalogue and the queue. Hidden, /guides is a 404 for visitors and the nav has no link — write the first one in private."],
];

const keyRead = await asAdmin(Astro, "/api/passkeys/admin");
const passkeys: PasskeyRow[] = keyRead.ok ? (keyRead.body?.passkeys ?? []) : [];
const values: Record<string, string> = read.body?.settings ?? {};
const on = values["imprint.visible"] === "1";
const complete = Boolean(values["imprint.entity"]?.trim() && values["imprint.email"]?.trim());
const live = on && complete;
---

<AdminLayout title="Settings">
  <div class="head">
    <h1 class="adm-h">Settings</h1>
    <Badge tone={live ? "accent" : "faint"}>
      {live ? "imprint is published" : on ? "switched on, but incomplete" : "imprint is hidden"}
    </Badge>
  </div>

  {notice && <p class="adm-ok" role="status">{notice}</p>}
  {failed && <p class="adm-bad" role="alert">{failed}</p>}

  <section class="adm-card state">
    <div class="state-head">
      <h2 class="h2">Who can see the site</h2>
      <Badge tone={holdingOn ? "faint" : "accent"}>
        {holdingOn ? "holding page is up" : "live to everyone"}
      </Badge>
    </div>
    <p class="adm-note">
      {
        holdingOn
          ? "Visitors get the holding page — the countdown, the reckonings and the newsletter form. You are signed in, so you get the real site and can keep working on it in public without publishing it."
          : "Everyone gets the real site."
      }
    </p>
    <p class="adm-note">
      Either way, the privacy policy, the terms and the newsletter confirmation link stay
      reachable. The confirmation link especially: gate that and subscribing from the holding
      page silently cannot finish.
    </p>
    <form method="POST">
      <CsrfField />
      <input type="hidden" name="action" value="site-state" />
      <input type="hidden" name="live" value={holdingOn ? "1" : "0"} />
      <Button type="submit">
        {holdingOn ? "Take the site live" : "Put the holding page back up"}
      </Button>
    </form>
  </section>

      <section class="adm-card">
        <div class="state-head">
          <h2 class="h2">Sections you are still building</h2>
        </div>
        <p class="adm-note">
          A hidden section gives visitors a 404 and its links come out of the
          navigation, so nobody is sent somewhere that is not there. <strong>You
          still see it and can keep working</strong> — write twelve horoscopes,
          price a shelf of products, record a course, and publish the whole
          thing when it is ready rather than in pieces.
        </p>
        <ul class="sections">
          {
            SECTIONS.map(([name, label, note]) => {
              const live = pageValues[`page.${name}`] !== "0";
              return (
                <li>
                  <div class="sec-row">
                    <span class="sec-name">{label}</span>
                    <Badge tone={live ? "accent" : "faint"}>
                      {live ? "published" : "hidden — 404 for visitors"}
                    </Badge>
                  </div>
                  <p class="adm-note sec-note">{note}</p>
                  <form method="POST">
                    <CsrfField />
                    <input type="hidden" name="action" value="section" />
                    <input type="hidden" name="section" value={name} />
                    <input type="hidden" name="live" value={live ? "0" : "1"} />
                    <Button type="submit" variant="secondary">
                      {live ? `Hide ${label.toLowerCase()}` : `Publish ${label.toLowerCase()}`}
                    </Button>
                  </form>
                </li>
              );
            })
          }
        </ul>
      </section>

  <form method="POST" class="adm-card">
    <h2 class="h2">Legal imprint</h2>
    <p class="adm-note">
      Hidden until it is filled in and switched on. It stays down while the entity or the email is
      blank, however the switch is set — a half-filled imprint is worse than none, because the
      missing half reads as an omission rather than as work in progress.
    </p>
    <CsrfField />

    <div class="fields">
      {
        FIELDS.map(([key, label, hint]) => (
          <label class="field">
            <span class="adm-lbl">{label}</span>
            <input class="adm-input" name={key} value={values[key] ?? ""} autocomplete="off" />
            {hint && <span class="hint">{hint}</span>}
          </label>
        ))
      }
    </div>

    <label class="switch">
      <input type="checkbox" name="visible" value="1" checked={on} />
      <span>
        <strong>Show it in the footer and on the legal pages</strong>
        <span class="hint">
          Turn this on once the company is registered. Leave it off while the numbers are not real
          — publishing a registry number that is not one is a claim, not a placeholder.
        </span>
      </span>
    </label>

    <div><Button type="submit">Save</Button></div>
  </form>

  <section class="adm-card">
    <h2 class="h2">Passkeys</h2>
    <p class="adm-note">
      Sign in to the admin with Face ID, a fingerprint or your phone's PIN instead of typing a
      password on a phone keyboard. A passkey is a keypair held by the device — Apple and Google
      are told nothing and no request reaches them, which is why this is here and
      &ldquo;Sign in with Google&rdquo; is not.
    </p>
    <p class="adm-note">
      An admin passkey always asks for the face, the finger or the PIN, never merely for an
      unlocked phone: this one rewrites the site. Your password keeps working, so removing every
      passkey cannot lock you out.
    </p>
    <PasskeyList passkeys={passkeys} prefix="/api/passkeys/admin" />
  </section>
</AdminLayout>

<style>
  .state { display: grid; gap: var(--space-3); }
  .state-head { display: flex; gap: var(--space-4); align-items: baseline; flex-wrap: wrap; }

  .head { display: flex; gap: var(--space-4); align-items: baseline; flex-wrap: wrap; }
  .h2 { font: 600 var(--text-h3) var(--font-display); color: var(--ink); margin: 0; }
  .fields { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: var(--space-4); }
  .field { display: grid; gap: 4px; align-content: start; }
  .hint { font: 400 var(--text-xs) / 1.5 var(--font-body); color: var(--ink-faint); }
  .switch { display: flex; gap: 10px; align-items: start; cursor: pointer; padding-top: var(--space-3); border-top: var(--border-w) solid var(--line); }
  .switch input { margin-top: 3px; accent-color: var(--accent); width: 18px; height: 18px; flex: none; }
  .switch > span { display: grid; gap: 3px; }
  .switch strong { font: 500 var(--text-body) var(--font-body); color: var(--ink); }
  .sections { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--space-5); }
  .sections > li { border-top: var(--border-w) solid var(--line); padding-top: var(--space-4); display: grid; gap: 8px; justify-items: start; }
  .sec-row { display: flex; gap: var(--space-3); align-items: baseline; flex-wrap: wrap; }
  .sec-name { font: 600 var(--text-body) var(--font-display); color: var(--ink); }
  .sec-note { max-width: 62ch; }
</style>

---
/* Admin overview — what needs attention, and the way in to everything else. */
import AdminLayout from "../../layouts/AdminLayout.astro";
import Badge from "../../components/navigation/Badge.astro";
import { asAdmin, KINDS } from "../../lib/admin";

const now = new Date();
const thisMonth = `${now.getUTCFullYear()}-${String(now.getUTCMonth() + 1).padStart(2, "0")}`;

const [horoscopes, messages, questions, sections] = await Promise.all([
  asAdmin(Astro, `/api/horoscopes/drafts?period=monthly&covers=${thisMonth}`),
  asAdmin(Astro, "/api/admin/inbox/messages"),
  asAdmin(Astro, "/api/admin/inbox/questions"),
  asAdmin(Astro, "/api/admin/sections"),
]);

const written = horoscopes.body?.written ?? 0;
const published = horoscopes.body?.published ?? false;
const msgCount = Array.isArray(messages.body) ? messages.body.length : 0;
const qCount = Array.isArray(questions.body) ? questions.body.length : 0;
const rows = Array.isArray(sections.body) ? sections.body : [];
const hidden = rows.filter((s: any) => !s.visible).length;
/* Only the count, for the tile. The page itself does the real listing. */
const classCall = await asAdmin(Astro, "/api/classes/admin/courses");
const classList: any[] = Array.isArray(classCall.body) ? classCall.body : [];

const discountList = await asAdmin(Astro, "/api/shop/admin/discounts");
const discountCodes: any[] = Array.isArray(discountList.body) ? discountList.body : [];

const membershipList = await asAdmin(Astro, "/api/billing/admin/tiers");
const memberships: any[] = Array.isArray(membershipList.body) ? membershipList.body : [];

const [shopList, shopOrders] = await Promise.all([
  asAdmin(Astro, "/api/shop/admin/products"),
  asAdmin(Astro, "/api/shop/admin/orders"),
]);
const shopProducts: any[] = Array.isArray(shopList.body) ? shopList.body : [];
const toPost = (Array.isArray(shopOrders.body) ? shopOrders.body : [])
  .filter((o: any) => o.fulfilment === "to_send").length;

const peopleList = await asAdmin(Astro, "/api/admin/users");
const people: any[] = Array.isArray(peopleList.body) ? peopleList.body : [];
const [letterCall, reachCall] = await Promise.all([
  asAdmin(Astro, "/api/newsletter/admin/issues"),
  asAdmin(Astro, "/api/newsletter/admin/audience"),
]);
const letters: any[] = Array.isArray(letterCall.body) ? letterCall.body : [];
const reach = reachCall.body ?? {};
const useCall = await asAdmin(Astro, "/api/insight/summary?days=7");
const use = useCall.body ?? {};
const skyList = await asAdmin(Astro, "/api/journal/entries");
const skyEntries: any[] = skyList.body?.entries ?? [];
/* Only what is still outstanding. A dashboard tile showing "13" when twelve
   are ticked would be a number that never moves. */
const growthRows = (await asAdmin(Astro, "/api/admin/growth")).body ?? [];
const growthLeft = (growthRows as any[]).filter((r) => !r.done && r.visible !== false).length;

const twitchLinked = Boolean((await asAdmin(Astro, "/api/twitch/admin/status")).body?.connected);

const overlayCount = ((await asAdmin(Astro, "/api/overlay/admin/overlays")).body ?? []).length;

---

<AdminLayout title="Overview">
  <h1 class="adm-h">Overview</h1>

  <div class="cards">
    <a class="adm-card tile" href="/admin/horoscopes">
      <span class="adm-lbl">This month's horoscopes</span>
      <span class="big">{written} <span class="of">of 12</span></span>
      <Badge tone={published ? "accent" : written === 12 ? "rose" : "faint"}>
        {published ? "published" : written === 12 ? "ready to publish" : "in progress"}
      </Badge>
    </a>

    <a class="adm-card tile" href="/admin/inbox">
      <span class="adm-lbl">Inbox</span>
      <span class="big">{msgCount + qCount}</span>
      <span class="sub">{msgCount} messages · {qCount} questions</span>
    </a>

    <a class="adm-card tile" href="/admin/classes">
      <span class="adm-lbl">Classes</span>
      <span class="big">{classList.length}</span>
      <span class="sub">
        {classList.filter((c: any) => c.kind === "workshop").length} workshops
      </span>
    </a>

    <a class="adm-card tile" href="/admin/discounts">
      <span class="adm-lbl">Discount codes</span>
      <span class="big">{discountCodes.filter((d: any) => d.active).length}</span>
      <span class="sub">{discountCodes.length} made</span>
    </a>

    <a class="adm-card tile" href="/admin/memberships">
      <span class="adm-lbl">Memberships</span>
      <span class="big">{memberships.length}</span>
      <span class="sub">on offer on /support</span>
    </a>

    <a class="adm-card tile" href="/admin/shop">
      <span class="adm-lbl">Shop</span>
      <span class="big">{shopProducts.length}</span>
      <span class="sub">
        {toPost > 0 ? `${toPost} to post` : "nothing waiting to post"}
      </span>
    </a>

    <a class="adm-card tile" href="/admin/users">
      <span class="adm-lbl">People</span>
      <span class="big">{people.length}</span>
      <span class="sub">
        {people.filter((u: any) => u.supporter).length} supporting
      </span>
    </a>

    <a class="adm-card tile" href="/admin/journal">
      <span class="adm-lbl">Journal skies</span>
      <span class="big">{skyEntries.length}</span>
      <span class="sub">
        {skyEntries.filter((e: any) => e.written).length} with a writing sky
      </span>
    </a>

    <a class="adm-card tile" href="/admin/newsletter">
      <span class="adm-lbl">The letter</span>
      <span class="big">{letters.length}</span>
      <span class="sub">
        {letters.filter((i: any) => i.sentAt).length} sent · {reach.wouldReceive ?? 0} would receive
      </span>
    </a>

    {/* Not a number about the site — a number about her. It is the only tile
        that counts something she has to go and do in the world, which is why
        it earns a place beside the ones that count content. */}
    <a class="adm-card tile" href="/admin/twitch">
      <span class="adm-lbl">Twitch</span>
      <span class="big">{twitchLinked ? "on" : "off"}</span>
      <span class="sub">{twitchLinked ? "events arriving" : "not connected yet"}</span>
    </a>

    <a class="adm-card tile" href="/admin/counters">
      <span class="adm-lbl">Stream overlays</span>
      <span class="big">{overlayCount}</span>
      <span class="sub">
        {overlayCount === 0 ? "none set up yet" :
         overlayCount === 1 ? "browser source" : "browser sources"}
      </span>
    </a>

    <a class="adm-card tile" href="/admin/growth">
      <span class="adm-lbl">Growing</span>
      <span class="big">{growthLeft}</span>
      <span class="sub">{growthLeft === 1 ? "thing left to do" : "things left to do"}</span>
    </a>

    <a class="adm-card tile" href="/admin/insight">
      <span class="adm-lbl">Use, this week</span>
      <span class="big">{use.views ?? 0}</span>
      <span class="sub">{use.visitors ?? 0} different people</span>
    </a>

    <a class="adm-card tile" href="/admin/blocks">
      <span class="adm-lbl">Page blocks</span>
      <span class="big">{rows.length}</span>
      <span class="sub">{hidden} hidden</span>
    </a>
  </div>

  <section class="adm-card">
    <h2 class="h2">Everything you can edit</h2>
    <p class="adm-note">
      Each of these is a table with a visible flag and an order. Nothing appears on the site until
      it is marked visible — the default is hidden, so nothing half-done ships by accident.
    </p>
    <div class="kinds">
      {KINDS.map((k) => <a class="kind" href={`/admin/blocks?kind=${k.kind}`}>{k.label}</a>)}
    </div>
  </section>
</AdminLayout>

<style>
  .cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: var(--space-4); }
  .tile { text-decoration: none; align-content: start; }
  .tile:hover { border-color: var(--line-strong); }
  .big { font: 500 2.2rem var(--font-display); color: var(--ink); line-height: 1; font-variant-numeric: tabular-nums; }
  .of { font-size: var(--text-body); color: var(--ink-faint); }
  .sub { font: 400 var(--text-sm) var(--font-body); color: var(--ink-soft); }
  .h2 { font: 600 var(--text-h3) var(--font-display); color: var(--ink); margin: 0; }
  .kinds { display: flex; gap: 8px; flex-wrap: wrap; }
  .kind {
    font: 500 var(--text-sm) var(--font-body); color: var(--ink-soft); text-decoration: none;
    border: var(--border-w) solid var(--line); border-radius: var(--radius-full);
    padding: 8px 14px; min-height: 40px; display: inline-flex; align-items: center;
  }
  .kind:hover { border-color: var(--accent); color: var(--accent); }
</style>

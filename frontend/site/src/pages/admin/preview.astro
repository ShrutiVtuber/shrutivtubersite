---
/* Edit the words with the page in front of you.
 *
 * The Words screen made every string editable; it did not make editing them
 * pleasant. Nine hundred rows in a list, with no sense of which sentence is
 * the one you are looking at on the site, is a database browser rather than a
 * CMS. Her words: "make the admin panel modern and useable as a CMS that lets
 * me edit the pages while previewing them."
 *
 * So: the real page in an iframe, its strings beside it, and the two wired
 * together in both directions — click a field and the page scrolls to it and
 * flashes; click the words in the page and the field takes focus.
 *
 * **No instrumentation in the site itself.** The iframe is same-origin, so
 * this page can read its DOM directly and match on the text it already
 * renders. That matters: adding preview markers to every page would mean the
 * preview showed something different from what a reader gets, which is the one
 * thing a preview must never do.
 *
 * The holding page is not in the way either — the gate already lets a signed-in
 * operator through to the real site, which is how she can work on it in public
 * without publishing it.
 */
import AdminLayout from "../../layouts/AdminLayout.astro";
import { asAdmin } from "../../lib/admin";

const all: any[] = (await asAdmin(Astro, "/api/admin/copy")).body ?? [];

/* Components have no page of their own to preview — their words are shared by
   every page that shows them. They stay on the Words screen. */
const isComponent = (pg: string) => pg.startsWith("component:");
const pages = [...new Set(all.map((r) => r.page))].filter((p) => !isComponent(p)).sort();

const page = pages.includes(Astro.url.searchParams.get("page") ?? "")
  ? Astro.url.searchParams.get("page")!
  : (pages.includes("home") ? "home" : pages[0] ?? "");

const rows = all
  .filter((r) => r.page === page)
  .sort((a, b) => (a.position ?? 0) - (b.position ?? 0));

/* The page's BLOCKS, which are most of what a reader actually sees.
 *
 * Leaving them out was the bug she found: on /about the visible prose is three
 * blocks totalling 1,500 characters, and the panel showed nine strings of which
 * the first two were the <title> and the meta description — neither of them on
 * the page at all. "The areas to edit don't actually match up to what is on the
 * page." They did not, because most of the page was not in the panel. */
const allSections: any[] = (await asAdmin(Astro, "/api/admin/sections")).body ?? [];
const blocks = allSections
  .filter((b: any) => b.page === page)
  .sort((a: any, b: any) => (a.position ?? 0) - (b.position ?? 0));

/* Every image, so a block can show the one it uses and offer the rest.
 *
 * The sections listing returns `media_id` and nothing else about the picture —
 * it is the generic table route and does not join. One extra call here is
 * cheaper than one per block, and the same list is what the picker offers. */
const media: any[] = (await asAdmin(Astro, "/api/admin/media")).body ?? [];
const byId = new Map<number, any>(media.map((m: any) => [m.id, m]));

/* The fields of a block a person reads, in the order they render. */
const BLOCK_FIELDS: [string, string, boolean][] = [
  ["eyebrow", "Eyebrow", false],
  ["title", "Heading", false],
  ["body_md", "Body", true],
  ["link_label", "Link label", false],
];

/* The route the iframe loads. "home" is "/". */
const previewUrl = `/${page === "home" ? "" : page}`;
const changed = rows.filter((r) => r.changed).length;
---

<AdminLayout title="Preview">
  <div class="cms" data-page={page}>
    <header class="bar">
      <label class="pick">
        <span class="sr">Page</span>
        <select id="pagepick">
          {pages.map((p) => (
            <option value={p} selected={p === page}>/{p === "home" ? "" : p}</option>
          ))}
        </select>
      </label>
      <span class="count">
        {blocks.length > 0 && <>{blocks.length} block{blocks.length === 1 ? "" : "s"} · </>}
        {rows.length} string{rows.length === 1 ? "" : "s"}
        {changed > 0 && <> · <strong>{changed} changed</strong></>}
      </span>
      <a class="out" href={previewUrl} target="_blank" rel="noopener">Open the page ↗</a>
      <a class="out" href={`/admin/blocks?kind=sections&page=${page}`}>Blocks on this page →</a>
    </header>

    <div class="split">
      <div class="frame">
        {/* `key` on the src forces a fresh document when the page changes,
            rather than a same-document navigation that keeps stale scroll. */}
        <iframe id="preview" src={previewUrl} title={`Preview of ${previewUrl}`}></iframe>
        <p class="hint" id="hint">Click any text in the page to jump to it →</p>
      </div>

      <aside class="panel" id="panel">
        {blocks.map((b: any) => (
          <section class="blk">
            <h3 class="blk-head">
              {b.key}
              {!b.visible && <span class="hidden-tag">hidden</span>}
            </h3>
            {BLOCK_FIELDS.filter(([f]) => (b[f] ?? "") !== "" || f === "body_md").map(([f, label, multi]) => (
              <div class="str" data-block={b.id} data-field={f} data-value={b[f] ?? ""}>
                <div class="head"><label for={`b-${b.id}-${f}`}>{label}</label></div>
                {multi ? (
                  <textarea id={`b-${b.id}-${f}`} rows="5" data-orig={b[f] ?? ""}>{b[f] ?? ""}</textarea>
                ) : (
                  <input id={`b-${b.id}-${f}`} value={b[f] ?? ""} data-orig={b[f] ?? ""} />
                )}
                <div class="foot">
                  <code>block · {f}</code>
                  <span class="state" aria-live="polite"></span>
                </div>
              </div>
            ))}

            {/* The picture. Every block can carry one, so the control is
                always here — a block with no image needs the control MORE
                than one that has it, because adding the first image is the
                thing that was impossible from this screen. */}
            <div class="pic" data-block={b.id} data-media={b.media_id ?? ""}>
              <div class="head"><label>Image</label></div>
              <div class="pic-row">
                <div class="pic-thumb">
                  {b.media_id && byId.get(b.media_id) ? (
                    <img src={byId.get(b.media_id).url}
                         alt={byId.get(b.media_id).altText || ""} />
                  ) : (
                    <span class="pic-none">none</span>
                  )}
                </div>
                <div class="pic-do">
                  <label class="pic-btn">
                    Upload…
                    <input type="file" accept="image/*" hidden />
                  </label>
                  <button type="button" class="pic-btn pic-pick">Choose…</button>
                  {b.media_id && <button type="button" class="pic-btn pic-clear">Remove</button>}
                </div>
              </div>
              {b.media_id && byId.get(b.media_id) && (
                <input class="pic-alt" placeholder="Alt text — what the picture shows"
                       value={byId.get(b.media_id).altText ?? ""}
                       data-orig={byId.get(b.media_id).altText ?? ""}
                       data-media={b.media_id} />
              )}
              <div class="foot">
                <code>block · media_id</code>
                <span class="state" aria-live="polite"></span>
              </div>
            </div>
          </section>
        ))}

        {rows.length === 0 && blocks.length === 0 ? (
          <p class="empty">
            Nothing registered for this page yet. Run <code>node scripts/seed-copy.mjs</code>.
          </p>
        ) : (
          rows.map((r: any) => (
            <div class="str" data-id={r.id} data-value={r.value}>
              <div class="head">
                <label for={`f-${r.id}`}>{r.label || r.key}</label>
                {r.changed && <span class="dot" title="changed from the original"></span>}
              </div>
              {r.multiline ? (
                <textarea id={`f-${r.id}`} rows="3" data-orig={r.value}>{r.value}</textarea>
              ) : (
                <input id={`f-${r.id}`} value={r.value} data-orig={r.value} />
              )}
              <div class="foot">
                <code>{r.key}</code>
                <span class="state" aria-live="polite"></span>
                {r.changed && <button type="button" class="revert" data-id={r.id}>put it back</button>}
              </div>
            </div>
          ))
        )}
      </aside>
    </div>

    {/* The library, opened by "Choose…" on any block. One dialog reused rather
        than one per block: at a few hundred images the markup would otherwise
        be repeated for every block on the page. */}
    <dialog id="picker" class="picker">
      <header class="picker-bar">
        <input id="picker-q" type="search" placeholder="Search images…" />
        <button type="button" id="picker-close">Close</button>
      </header>
      <div class="picker-grid" id="picker-grid">
        {media.map((m: any) => (
          <button type="button" class="picker-item" data-media={m.id}
                  data-hay={`${m.title ?? ""} ${(m.tags ?? []).join(" ")} ${m.altText ?? ""}`.toLowerCase()}>
            <img src={m.url} alt={m.altText || m.title || ""} loading="lazy" />
            <span>{m.title || m.filename}</span>
          </button>
        ))}
      </div>
      {media.length === 0 && (
        <p class="picker-empty">Nothing uploaded yet. Use Upload… on a block.</p>
      )}
    </dialog>
  </div>
</AdminLayout>

<script>
  const cms = document.querySelector<HTMLElement>(".cms")!;
  const frame = document.getElementById("preview") as HTMLIFrameElement;
  const panel = document.getElementById("panel")!;
  const hint = document.getElementById("hint")!;

  document.getElementById("pagepick")!.addEventListener("change", (e) => {
    location.search = `?page=${(e.target as HTMLSelectElement).value}`;
  });

  /* ── finding a string inside the page ──────────────────────────────────
   *
   * Matched on the text the page already renders, because the alternative —
   * marking every string with a data attribute — would make the preview
   * structurally different from what a reader gets.
   *
   * Whitespace is collapsed on both sides: the source wraps its lines, the
   * browser does not, and an exact match would fail on almost every
   * paragraph. */
  const flat = (s: string) => s.replace(/\s+/g, " ").trim();

  /* The page shows RENDERED markdown; a block stores the source. Comparing
     "**Shruti** — Shruti Swara" against "Shruti — Shruti Swara" fails on the
     asterisks alone, so the markers come off both sides before matching. */
  const plain = (s: string) =>
    flat(s.replace(/\[([^\]]+)\]\([^)]*\)/g, "$1")
          .replace(/[*_`#>]/g, ""));

  function textNodes(doc: Document) {
    const walk = doc.createTreeWalker(doc.body, NodeFilter.SHOW_TEXT);
    const out: Text[] = [];
    let n: Node | null;
    while ((n = walk.nextNode())) {
      const t = n as Text;
      if (!flat(t.data)) continue;
      const p = t.parentElement;
      if (!p || p.closest("script,style,head")) continue;
      out.push(t);
    }
    return out;
  }

  function findIn(doc: Document, value: string): HTMLElement | null {
    const want = plain(value);
    /* Short strings collide — a nav label, a button, a heading that repeats.
       Below this length a match says more about coincidence than location. */
    if (want.length < 8) return null;
    let best: HTMLElement | null = null;
    for (const t of textNodes(doc)) {
      const have = plain(t.data);
      if (have === want) return t.parentElement;
      /* The fallback: a node on the page CONTAINS the whole string. Only that
         direction — the reverse, a short page node inside a longer string,
         matches almost anything and put the page <title> halfway down the
         page. A string that genuinely cannot be found is reported as not
         visible, which is true and useful, rather than placed wrongly. */
      if (!best && want.length > 16 && have.includes(want)) {
        best = t.parentElement;
      }
    }
    return best;
  }

  /* A heading is a reliable place to match a SHORT string. "Shruti" is six
     characters and would be refused by the general matcher — rightly, because
     six characters of body text collide with everything — but as an <h2> it is
     unambiguous. Raising the general minimum to eight had pushed /about's
     blocks into "not visible" for exactly this reason. */
  function findHeadingIn(doc: Document, value: string): HTMLElement | null {
    const want = plain(value);
    if (want.length < 3) return null;
    for (const h of doc.querySelectorAll<HTMLElement>("h1,h2,h3,h4,h5,h6")) {
      if (plain(h.textContent ?? "") === want) return h;
    }
    return null;
  }

  /* A block's body is markdown and renders as SEVERAL paragraphs, so no single
     text node holds all of it. Its first paragraph does, and that is enough to
     say where the block begins. */
  const firstPara = (md: string) => (md ?? "").split(/\n\s*\n/)[0] ?? "";

  let marked: HTMLElement | null = null;
  function markInPage(value: string) {
    const doc = frame.contentDocument;
    if (!doc) return;
    if (marked) marked.style.removeProperty("outline");
    const el = findIn(doc, value);
    marked = el;
    if (!el) { hint.textContent = "That one is not visible on the page right now."; return; }
    hint.textContent = "";
    el.style.outline = "2px solid #C86B8B";
    el.style.outlineOffset = "2px";
    el.scrollIntoView({ block: "center", behavior: "smooth" });
  }

  /* ── page → panel ─────────────────────────────────────────────────────── */
  function wireFrame() {
    const doc = frame.contentDocument;
    if (!doc) return;
    /* Nothing in the preview navigates. Ever.
     *
     * This is an editor, and a link that works is a link that takes the frame
     * somewhere else — which loses the panel's place, re-runs the reorder, and
     * makes a button impossible to edit because clicking it leaves the page it
     * belongs to. Her words: it should be possible to edit buttons and link
     * content, and clicking them should not activate them.
     *
     * Prevented FIRST and unconditionally, before any attempt to match a
     * field. The previous version only prevented the default once it had found
     * a panel entry, so every link the panel did not know about — a nav item, a
     * card, anything behind a condition — still navigated.
     *
     * This changes nothing about the real page. The handler lives in the admin
     * document and is attached to the iframe's DOM from outside; a reader
     * loading the same URL gets a page with no listener on it at all. */
    const swallow = (ev: Event) => {
      ev.preventDefault();
      ev.stopPropagation();
    };
    doc.addEventListener("submit", swallow, true);
    /* Ctrl/middle-click opens a new tab without a click event of the usual
       kind; auxclick is where that arrives. */
    doc.addEventListener("auxclick", swallow, true);

    doc.body.addEventListener("click", (ev) => {
      const target = ev.target as HTMLElement;

      /* An image is a block's picture, not a string. Clicking one should open
         the control that changes it.
         
         The wrapper counts as the image. Every picture on this site is served
         as a <picture> with avif and webp sources, and its box is larger than
         the <img> inside it — so a click aimed at a photograph frequently
         lands on the wrapper, where `closest("img")` finds nothing and the
         whole thing silently does nothing at all. A <figure> is the same story
         with a caption. */
      const holder = target.closest?.("img,picture,figure") as HTMLElement | null;
      const img = holder
        ? (holder.tagName === "IMG" ? holder as HTMLImageElement
                                    : holder.querySelector("img"))
        : null;
      if (img) {
        ev.preventDefault();
        const file = (img.currentSrc || img.src || "").split("/").pop() ?? "";
        const pic = file
          ? [...panel.querySelectorAll<HTMLElement>(".pic")].find((el) =>
              (el.querySelector("img")?.getAttribute("src") ?? "").endsWith(file))
          : null;
        if (pic) {
          pic.scrollIntoView({ block: "center", behavior: "smooth" });
          pic.classList.add("lit");
          setTimeout(() => pic.classList.remove("lit"), 1200);
          hint.textContent = "";
        } else {
          hint.textContent = "That picture is not one of this page's blocks.";
        }
        return;
      }

      /* Anything that would take the frame somewhere is stopped whether or not
         a field is found for it. */
      if (target.closest?.("a,button,[role=button],label,summary")) {
        ev.preventDefault();
        ev.stopPropagation();
      }

      const text = flat(target.textContent ?? "");
      if (!text) return;
      let match: HTMLElement | null = null;
      let bestLen = Infinity;
      for (const box of panel.querySelectorAll<HTMLElement>(".str")) {
        const v = flat(box.dataset.value ?? "");
        if (!v || v.length < 3) continue;
        if (text === v || text.includes(v) || v.includes(text)) {
          /* The closest-sized match, so clicking a paragraph does not land on
             a two-word label that happens to sit inside it. */
          const d = Math.abs(v.length - text.length);
          if (d < bestLen) { bestLen = d; match = box; }
        }
      }
      if (!match) {
        /* Say so. Silence here reads as a broken editor — the click did stop
           the link, so something clearly happened, and nothing moved. */
        if (target.closest?.("a,button")) {
          hint.textContent = "That one is not editable from this panel — "
            + "try Blocks on this page.";
        }
        return;
      }
      ev.preventDefault();
      hint.textContent = "";
      match.scrollIntoView({ block: "center", behavior: "smooth" });
      match.querySelector<HTMLElement>("input,textarea")?.focus();
    }, true);
  }
  frame.addEventListener("load", wireFrame);

  /* ── put the panel in the page's own order ───────────────────────────────
   *
   * The stored `position` is the order things appear in the SOURCE, which is
   * not the order they appear on the screen: a page's <title> and meta
   * description are declared first and rendered nowhere, and a block's prose
   * can sit anywhere. Sorting by it produced a panel that read nothing like
   * the page — which is exactly the complaint.
   *
   * So the page is asked. Every item is looked up in the rendered document and
   * sorted by how far down it is. Anything that cannot be found is not on this
   * page at all — the meta tags, a hidden block, a string behind a condition —
   * and is moved to the end under a heading that says so, rather than sitting
   * at the top pretending to be the first thing a reader sees. */
  function reorderByPage() {
    const doc = frame.contentDocument;
    if (!doc) return;

    const items = [...panel.querySelectorAll<HTMLElement>(":scope > .str, :scope > .blk")];
    const offsets = new Map<HTMLElement, number>();

    const scrolled = doc.scrollingElement?.scrollTop ?? 0;
    const topOf = (v: string) => {
      const el = v ? findIn(doc, v) : null;
      return el ? el.getBoundingClientRect().top + scrolled : Infinity;
    };

    for (const item of items) {
      if (!item.classList.contains("blk")) {
        offsets.set(item, topOf(item.dataset.value ?? ""));
        continue;
      }
      /* A block is placed by its most DISTINCTIVE field, tried in order, and
         the first one found wins.
         
         Not the minimum across all of them: the home page's support block has
         a link label of "Support the work", which is also a header nav item at
         the very top of the page. Taking the minimum put a block that lives at
         the bottom of the page first in the panel. A body paragraph is the
         thing least likely to appear twice; a link label is the most. */
      const byField = new Map<string, string>();
      for (const f of item.querySelectorAll<HTMLElement>(".str")) {
        byField.set(f.dataset.field ?? "", f.dataset.value ?? "");
      }
      const scrolledNow = doc.scrollingElement?.scrollTop ?? 0;
      const at = (el: HTMLElement | null) =>
        el ? el.getBoundingClientRect().top + scrolledNow : Infinity;

      /* In order of how distinctive each field is, and how reliably it can be
         found. A heading match is tried before body text because it is exact;
         a link label is last because it is the likeliest to also be a nav
         item — which is what put the home page's support block at the top. */
      const tries: (() => number)[] = [
        () => at(findHeadingIn(doc, byField.get("title") ?? "")),
        () => topOf(firstPara(byField.get("body_md") ?? "")),
        () => topOf(byField.get("title") ?? ""),
        () => topOf(byField.get("eyebrow") ?? ""),
        () => topOf(byField.get("link_label") ?? ""),
      ];
      let top = Infinity;
      for (const t of tries) {
        const v = t();
        if (v < Infinity) { top = v; break; }
      }
      offsets.set(item, top);
    }

    const onPage = items.filter((i) => offsets.get(i)! < Infinity)
                        .sort((a, b) => offsets.get(a)! - offsets.get(b)!);
    const elsewhere = items.filter((i) => offsets.get(i)! === Infinity);

    /* Clear the previous run's heading before writing this one.
     *
     * This runs on every `load` of the iframe, and it used to only ever ADD.
     * One reorder per page-change would have been survivable; what made it
     * visible was that clicking a link in the preview navigated the frame,
     * which fired `load`, which stacked another heading — so the panel filled
     * with "6 not visible…", "32 not visible…", "6 not visible…" and the
     * counts differed because they were counted against different pages. The
     * navigation is prevented now as well; this is the other half. */
    for (const stale of panel.querySelectorAll(".not-here")) stale.remove();

    for (const i of onPage) panel.appendChild(i);
    if (elsewhere.length) {
      const h = document.createElement("p");
      h.className = "not-here";
      h.textContent = `${elsewhere.length} not visible on this page — page title, description, and anything behind a condition`;
      panel.appendChild(h);
      for (const i of elsewhere) panel.appendChild(i);
    }
  }
  frame.addEventListener("load", reorderByPage);

  /* ── does the picture actually appear? ─────────────────────────────────
   *
   * A block can carry a `media_id` that its page has nowhere to render. Not
   * every template shows a block's image — the home page passes its blocks to
   * SupportBand, which has no picture in it at all — so the image can be set,
   * saved, and never seen.
   *
   * That is the same complaint as "the areas to edit don't match what is on
   * the page", and the answer is the same one: say so. Silence here means she
   * uploads a picture, sees nothing change, and has no way to tell whether
   * the upload failed, the page is cached, or the template simply does not
   * have a place for it. */
  function checkPicturesShow() {
    const doc = frame.contentDocument;
    if (!doc) return;
    const shown = [...doc.querySelectorAll("img")]
      .map((i) => (i.getAttribute("src") ?? "").split("/").pop() ?? "")
      .filter(Boolean);

    for (const pic of panel.querySelectorAll<HTMLElement>(".pic")) {
      pic.querySelector(".pic-unused")?.remove();
      const src = pic.querySelector("img")?.getAttribute("src") ?? "";
      if (!src) continue;
      const file = src.split("/").pop() ?? "";
      if (file && shown.includes(file)) continue;
      const note = document.createElement("p");
      note.className = "pic-unused";
      note.textContent = "Saved, but this page does not show a block image here.";
      pic.querySelector(".foot")!.before(note);
    }
  }
  frame.addEventListener("load", checkPicturesShow);

  /* ── pictures ─────────────────────────────────────────────────────────
   *
   * Adding or changing a block's image was the one thing this screen could not
   * do: the panel edited four text fields and `media_id` was not among them,
   * so the only route to a picture was the Media screen and then the Blocks
   * screen, with the page you were editing nowhere in sight.
   *
   * Two writes are involved and they go to different places — the FILE is a
   * media row, the CHOICE is a field on the block — so an upload is a POST to
   * /media followed by a PATCH of the section. Alt text belongs to the image
   * rather than to the block, because the same picture used twice describes
   * itself the same way both times.
   */
  const picker = document.getElementById("picker") as HTMLDialogElement | null;
  let pickingFor: HTMLElement | null = null;

  /** Redraw one block's thumbnail after its image changes. */
  function showPicture(pic: HTMLElement, m: any | null) {
    const thumb = pic.querySelector<HTMLElement>(".pic-thumb")!;
    thumb.innerHTML = "";
    if (m) {
      const img = document.createElement("img");
      img.src = m.url;
      img.alt = m.altText || "";
      thumb.appendChild(img);
    } else {
      const none = document.createElement("span");
      none.className = "pic-none";
      none.textContent = "none";
      thumb.appendChild(none);
    }
    pic.dataset.media = m ? String(m.id) : "";

    /* The alt field belongs to whichever image is there now. */
    pic.querySelector(".pic-alt")?.remove();
    if (m) {
      const alt = document.createElement("input");
      alt.className = "pic-alt";
      alt.placeholder = "Alt text — what the picture shows";
      alt.value = m.altText ?? "";
      alt.dataset.orig = m.altText ?? "";
      alt.dataset.media = String(m.id);
      pic.querySelector(".foot")!.before(alt);
    }

    const doRow = pic.querySelector<HTMLElement>(".pic-do")!;
    const clear = doRow.querySelector(".pic-clear");
    if (m && !clear) {
      const b = document.createElement("button");
      b.type = "button";
      b.className = "pic-btn pic-clear";
      b.textContent = "Remove";
      doRow.appendChild(b);
    } else if (!m && clear) {
      clear.remove();
    }
  }

  /** Point a block at an image, or at none. Returns false if it did not save. */
  async function setPicture(pic: HTMLElement, m: any | null): Promise<boolean> {
    const state = pic.querySelector<HTMLElement>(".state")!;
    state.textContent = "saving…";
    try {
      const r = await fetch(`/api/admin/sections/${pic.dataset.block}`, {
        method: "PATCH",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ media_id: m ? m.id : null }),
      });
      if (!r.ok) throw new Error(String(r.status));
      showPicture(pic, m);
      state.textContent = "saved";
      /* The page has to be re-fetched to show it — the change is on the
         server, and the frame is holding the old render. The load handler
         then reports whether it actually appears anywhere. */
      frame.contentWindow?.location.reload();
      setTimeout(() => (state.textContent = ""), 1500);
      return true;
    } catch (err) {
      state.textContent = `did not save (${err instanceof Error ? err.message : "error"})`;
      return false;
    }
  }

  for (const pic of panel.querySelectorAll<HTMLElement>(".pic")) {
    /* Upload. The file goes up first; only if that succeeds is the block
       pointed at it, so a failed upload never leaves a block referring to a
       row that does not exist. */
    pic.querySelector<HTMLInputElement>('input[type=file]')!
      .addEventListener("change", async (ev) => {
        const input = ev.target as HTMLInputElement;
        const file = input.files?.[0];
        if (!file) return;
        const state = pic.querySelector<HTMLElement>(".state")!;
        state.textContent = "uploading…";
        try {
          const form = new FormData();
          form.append("file", file);
          /* Named from the filename so the library is searchable straight
             away; she can rename it on the Media screen. */
          form.append("title", file.name.replace(/\.[^.]+$/, ""));
          const up = await fetch("/api/admin/media", { method: "POST", body: form });
          if (!up.ok) {
            /* 415 is the one worth spelling out: it is a real answer, not a
               fault, and it names the formats that would work. */
            const why = up.status === 415
              ? "that file type is not allowed"
              : `upload failed (${up.status})`;
            throw new Error(why);
          }
          await setPicture(pic, await up.json());
        } catch (err) {
          state.textContent = err instanceof Error ? err.message : "upload failed";
        } finally {
          input.value = "";
        }
      });

    pic.querySelector(".pic-pick")?.addEventListener("click", () => {
      pickingFor = pic;
      picker?.showModal();
      (document.getElementById("picker-q") as HTMLInputElement | null)?.focus();
    });

    /* Delegated, because the Remove button is created and destroyed as the
       picture changes. */
    pic.addEventListener("click", (ev) => {
      const t = ev.target as HTMLElement;
      if (!t.classList.contains("pic-clear")) return;
      setPicture(pic, null);
    });

    /* Alt text saves to the IMAGE, not the block. Delegated for the same
       reason: the field comes and goes with the picture. */
    pic.addEventListener("blur", async (ev) => {
      const t = ev.target as HTMLInputElement;
      if (!t.classList.contains("pic-alt")) return;
      if (t.value === t.dataset.orig) return;
      const state = pic.querySelector<HTMLElement>(".state")!;
      state.textContent = "saving…";
      try {
        const r = await fetch(`/api/admin/media/${t.dataset.media}`, {
          method: "PATCH",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ alt_text: t.value }),
        });
        if (!r.ok) throw new Error(String(r.status));
        t.dataset.orig = t.value;
        state.textContent = "saved";
        setTimeout(() => (state.textContent = ""), 1500);
      } catch (err) {
        state.textContent = `did not save (${err instanceof Error ? err.message : "error"})`;
      }
    }, true);
  }

  /* The library. */
  document.getElementById("picker-close")?.addEventListener("click", () => picker?.close());
  picker?.addEventListener("click", (ev) => {
    /* Clicking the backdrop closes it — the dialog element reports those as
       clicks on itself rather than on any child. */
    if (ev.target === picker) picker.close();
  });
  document.getElementById("picker-q")?.addEventListener("input", (ev) => {
    const q = (ev.target as HTMLInputElement).value.trim().toLowerCase();
    for (const item of document.querySelectorAll<HTMLElement>(".picker-item")) {
      item.hidden = q !== "" && !(item.dataset.hay ?? "").includes(q);
    }
  });
  document.getElementById("picker-grid")?.addEventListener("click", async (ev) => {
    const item = (ev.target as HTMLElement).closest<HTMLElement>(".picker-item");
    if (!item || !pickingFor) return;
    picker?.close();
    const id = Number(item.dataset.media);
    const r = await fetch("/api/admin/media");
    const all: any[] = r.ok ? await r.json() : [];
    await setPicture(pickingFor, all.find((m) => m.id === id) ?? null);
    pickingFor = null;
  });

  /* ── panel → page, and saving ─────────────────────────────────────────── */
  for (const box of panel.querySelectorAll<HTMLElement>(".str")) {
    const field = box.querySelector<HTMLInputElement | HTMLTextAreaElement>("input,textarea")!;
    const state = box.querySelector<HTMLElement>(".state")!;

    field.addEventListener("focus", () => markInPage(box.dataset.value ?? ""));

    field.addEventListener("blur", async () => {
      const value = field.value;
      if (value === field.dataset.orig) return;
      state.textContent = "saving…";
      try {
        /* Two kinds of thing in one panel: a copy string, and one field of a
           page block. They save to different routes, and the panel should not
           make her care which is which. */
        const blockId = box.dataset.block;
        const r = blockId
          ? await fetch(`/api/admin/sections/${blockId}`, {
              method: "PATCH",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({ [box.dataset.field!]: value }),
            })
          : await fetch(`/api/admin/copy/${box.dataset.id}`, {
              method: "PUT",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({ value }),
            });
        if (!r.ok) throw new Error(String(r.status));
        field.dataset.orig = value;
        box.dataset.value = value;
        state.textContent = "saved";
        /* Reload so she sees the words in place rather than in a box. The
           scroll position is restored, because losing it on every keystroke's
           worth of editing is what makes a preview useless. */
        const y = frame.contentWindow?.scrollY ?? 0;
        frame.addEventListener("load", function once() {
          frame.removeEventListener("load", once);
          frame.contentWindow?.scrollTo(0, y);
          wireFrame();
        });
        frame.contentWindow?.location.reload();
      } catch {
        state.textContent = "did not save";
      }
      setTimeout(() => { state.textContent = ""; }, 2500);
    });
  }

  for (const b of panel.querySelectorAll<HTMLButtonElement>(".revert")) {
    b.addEventListener("click", async () => {
      await fetch(`/api/admin/copy/${b.dataset.id}/revert`, { method: "POST" });
      location.reload();
    });
  }
</script>

<style>
  .blk {
    display: grid; gap: 8px; padding: 10px;
    border: var(--border-w) solid var(--line-strong);
    border-radius: var(--radius-sm);
    background: var(--surface-veil);
  }
  .blk-head {
    margin: 0; display: flex; align-items: center; gap: 8px;
    font: 600 10px var(--font-mono); letter-spacing: .1em; text-transform: uppercase;
    color: var(--ink-faint);
  }
  .hidden-tag {
    font-size: 9px; padding: 1px 5px; border-radius: var(--radius-full, 999px);
    background: var(--surface-inset); color: var(--ink-faint); letter-spacing: 0;
  }
  .blk .str { background: var(--surface-card); }
  /* Everything below this line is real, and is not on the page. Saying which
     is which beats letting her hunt for words that were never there. */
  .not-here {
    margin: var(--space-3) 0 0; padding-top: var(--space-2);
    border-top: var(--border-w) dashed var(--line);
    font-size: var(--text-xs); color: var(--ink-faint); font-style: italic;
  }

  /* The preview is the point, so it gets the room. */
  .cms { display: grid; grid-template-rows: auto 1fr; gap: var(--space-3); height: calc(100vh - 150px); min-height: 520px; }

  .bar { display: flex; align-items: center; gap: var(--space-3); flex-wrap: wrap; }
  .pick select {
    font: 500 var(--text-sm) var(--font-mono);
    padding: 6px 10px;
    border: var(--border-w) solid var(--line);
    border-radius: var(--radius-sm);
    background: var(--surface-card); color: var(--ink);
  }
  .count { font-size: var(--text-xs); color: var(--ink-faint); }
  .out { margin-left: auto; font-size: var(--text-xs); color: var(--accent); }
  .out + .out { margin-left: 0; }
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }

  .split { display: grid; grid-template-columns: 1fr minmax(300px, 380px); gap: var(--space-3); min-height: 0; }
  @media (max-width: 900px) { .split { grid-template-columns: 1fr; } }

  .frame { position: relative; min-height: 0; }
  iframe {
    width: 100%; height: 100%;
    border: var(--border-w) solid var(--line);
    border-radius: var(--radius-md);
    background: var(--surface-page);
  }
  .hint {
    position: absolute; left: 10px; bottom: 10px; margin: 0;
    font-size: var(--text-xs); color: var(--ink-faint);
    background: var(--surface-card); padding: 4px 8px;
    border-radius: var(--radius-sm); border: var(--border-w) solid var(--line);
  }

  .panel { overflow-y: auto; display: grid; gap: 10px; align-content: start; padding-right: 4px; }
  .empty { font-size: var(--text-sm); color: var(--ink-soft); }

  .str {
    display: grid; gap: 5px; padding: 10px;
    border: var(--border-w) solid var(--line);
    border-radius: var(--radius-sm);
    background: var(--surface-card);
  }
  .str:focus-within { border-color: var(--accent); }
  .head { display: flex; align-items: center; gap: 8px; }
  .head label { font-weight: 600; font-size: var(--text-xs); color: var(--ink); }
  /* A changed string is marked, so a page she has edited is legible at a
     glance rather than by reading every field. */
  .dot { width: 6px; height: 6px; border-radius: 50%; background: var(--rose); flex: none; }

  .str input, .str textarea {
    width: 100%; font: 400 var(--text-sm) var(--font-body);
    padding: 6px 8px;
    border: var(--border-w) solid var(--line);
    border-radius: var(--radius-sm);
    background: var(--surface-page); color: var(--ink);
  }
  .str textarea { line-height: 1.55; resize: vertical; }

  /* ── the picture control ─────────────────────────────────────────────── */
  .pic {
    border: var(--border-w) solid var(--line);
    border-radius: var(--radius-sm);
    padding: 10px;
    display: grid;
    gap: 8px;
    background: var(--surface-card);
  }
  .pic.lit { border-color: var(--accent); box-shadow: 0 0 0 2px var(--accent-wash); }
  .pic-row { display: flex; gap: 10px; align-items: flex-start; }
  .pic-thumb {
    width: 84px; height: 84px; flex: none;
    border: var(--border-w) solid var(--line);
    border-radius: var(--radius-sm);
    background: var(--surface-inset);
    display: grid; place-items: center; overflow: hidden;
  }
  .pic-thumb img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .pic-none {
    font: 400 var(--text-micro) var(--font-body);
    color: var(--ink-faint); text-transform: uppercase;
    letter-spacing: var(--tracking-eyebrow);
  }
  .pic-do { display: flex; flex-wrap: wrap; gap: 6px; }
  .pic-btn {
    font: 500 var(--text-xs) var(--font-body);
    color: var(--ink-soft);
    background: var(--surface-page);
    border: var(--border-w) solid var(--line);
    border-radius: var(--radius-sm);
    padding: 6px 10px; min-height: 32px; cursor: pointer;
  }
  .pic-btn:hover { color: var(--accent); border-color: var(--accent); }
  .pic-unused {
    font: 400 var(--text-xs) var(--font-body);
    color: var(--ink-faint);
    margin: 0;
    padding: 6px 8px;
    border-left: 2px solid var(--line-strong);
    background: var(--surface-inset);
    border-radius: var(--radius-sm);
  }
  .pic-alt {
    font: 400 var(--text-sm) var(--font-body);
    color: var(--ink); background: var(--surface-page);
    border: var(--border-w) solid var(--line);
    border-radius: var(--radius-sm);
    padding: 7px 9px; width: 100%; box-sizing: border-box;
  }

  /* ── the library ─────────────────────────────────────────────────────── */
  .picker {
    border: var(--border-w) solid var(--line);
    border-radius: var(--radius-md);
    background: var(--surface-card);
    color: var(--ink);
    width: min(880px, 92vw);
    max-height: 82vh;
    padding: 0;
  }
  .picker::backdrop { background: rgb(0 0 0 / 0.55); }
  .picker-bar {
    display: flex; gap: 8px; padding: 12px;
    border-bottom: var(--border-w) solid var(--line);
    position: sticky; top: 0; background: var(--surface-card); z-index: 1;
  }
  .picker-bar input {
    flex: 1; font: 400 var(--text-sm) var(--font-body);
    color: var(--ink); background: var(--surface-page);
    border: var(--border-w) solid var(--line);
    border-radius: var(--radius-sm); padding: 8px 10px; min-height: 38px;
  }
  .picker-bar button {
    font: 500 var(--text-xs) var(--font-body); color: var(--ink-soft);
    background: none; border: var(--border-w) solid var(--line);
    border-radius: var(--radius-sm); padding: 8px 12px; cursor: pointer;
  }
  .picker-grid {
    display: grid; gap: 10px; padding: 12px;
    grid-template-columns: repeat(auto-fill, minmax(120px, 1fr));
    overflow: auto;
  }
  .picker-item {
    display: grid; gap: 6px; padding: 6px; cursor: pointer; text-align: left;
    background: var(--surface-page);
    border: var(--border-w) solid var(--line);
    border-radius: var(--radius-sm);
  }
  .picker-item:hover { border-color: var(--accent); }
  .picker-item img {
    width: 100%; aspect-ratio: 1; object-fit: cover;
    border-radius: var(--radius-sm); display: block;
  }
  .picker-item span {
    font: 400 var(--text-micro) var(--font-body); color: var(--ink-soft);
    overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  }
  .picker-empty {
    font: 400 var(--text-sm) var(--font-body); color: var(--ink-soft);
    padding: 24px; margin: 0; text-align: center;
  }

  .foot { display: flex; align-items: baseline; gap: 8px; }
  .foot code { font: 400 10px var(--font-mono); color: var(--ink-faint); }
  .state { font-size: var(--text-xs); color: var(--ink-faint); margin-left: auto; }
  .revert {
    background: none; border: 0; padding: 0; cursor: pointer;
    font: 500 10px var(--font-body); color: var(--ink-faint); text-decoration: underline;
  }
  .revert:hover { color: var(--ink); }
</style>

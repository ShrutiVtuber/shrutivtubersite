---
/* Page blocks — visibility, order, and editing, on one screen.
 *
 * The site's whole content model is that a block can be hidden and unhidden
 * without a deploy, and that art is nullable. So this screen's job is to make
 * "show this" and "hide this" one click, and to make the fact that something
 * is hidden obvious at a glance rather than something to go looking for.
 *
 * Every table defaults to HIDDEN. Nothing half-done ships by accident.
 */
import AdminLayout from "../../layouts/AdminLayout.astro";
import CsrfField from "../../components/forms/CsrfField.astro";
import MediaField from "../../components/forms/MediaField.astro";
import Button from "../../components/forms/Button.astro";
import Badge from "../../components/navigation/Badge.astro";
import { asAdmin, KINDS } from "../../lib/admin";
import { GROUP_ORDER, MEDIA_USE, blankFor, specFor } from "../../lib/adminFields";
import { verifyCsrf } from "../../lib/csrf";

const kind = KINDS.some((k) => k.kind === Astro.url.searchParams.get("kind"))
  ? Astro.url.searchParams.get("kind")!
  : "sections";
const spec = KINDS.find((k) => k.kind === kind)!;
const editing = Astro.url.searchParams.get("edit");

let notice = "";
let failed = "";

if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  if (!verifyCsrf(Astro.cookies, form)) {
    failed = "That did not save. Reload the page and try again.";
  } else {
    const action = String(form.get("action") ?? "");
    const id = String(form.get("id") ?? "");

    if (action === "visibility") {
      const r = await asAdmin(Astro, `/api/admin/${kind}/${id}/visibility`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ visible: form.get("visible") === "1" }),
      });
      notice = r.ok ? "Updated." : "";
      failed = r.ok ? "" : (r.body?.detail ?? "That did not change.");
    }

    if (action === "save" || action === "create") {
      /* Only the fields this table actually has are sent — the form renders
         from the row it is editing, so it cannot invent a column. */
      const payload: Record<string, unknown> = {};
      for (const [key, value] of form.entries()) {
        if (["action", "id", "_csrf", "kind"].includes(key)) continue;
        const s = String(value);
        /* An id field left empty means "nothing", not the empty string —
           which a nullable integer column rejects. */
        payload[key] =
          s === "" && key.endsWith("_id") ? null
          : s === "on" ? true
          : s === "off" ? false
          : /^-?\d+$/.test(s) && key !== "body_md" ? Number(s)
          : s;
      }
      const r = action === "create"
        ? await asAdmin(Astro, `/api/admin/${kind}`, {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(payload),
          })
        : await asAdmin(Astro, `/api/admin/${kind}/${id}`, {
            method: "PATCH",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(payload),
          });
      notice = r.ok ? "Saved." : "";
      failed = r.ok ? "" : (r.body?.detail ?? "That did not save.");
    }

    if (action === "delete") {
      const r = await asAdmin(Astro, `/api/admin/${kind}/${id}`, { method: "DELETE" });
      notice = r.ok ? "Deleted." : "";
      failed = r.ok ? "" : (r.body?.detail ?? "That did not delete.");
    }
  }
}

const list = await asAdmin(Astro, `/api/admin/${kind}`);
const rows: any[] = Array.isArray(list.body) ? list.body : [];
/* Creating and editing are the same form. A new one has no row to read its
   columns off, so its shape comes from the field spec — which is also what
   stops it being created with half its fields missing because the editor could
   not guess they existed. */
const creating = Astro.url.searchParams.get("new") === "1";
const row = editing
  ? rows.find((r) => String(r.id) === editing)
  : creating
    ? blankFor(kind)
    : null;

/* Fields grouped the way someone filling them in would expect, rather than in
   whatever order the table happens to return its columns. */
function grouped(r: any): [string, string[]][] {
  const groups = new Map<string, string[]>();
  for (const key of fieldsOf(r)) {
    const g = specFor(kind, key).group ?? "Details";
    (groups.get(g) ?? groups.set(g, []).get(g)!).push(key);
  }
  const seen = [...groups.keys()];
  seen.sort((a, b) => {
    const ia = GROUP_ORDER.indexOf(a), ib = GROUP_ORDER.indexOf(b);
    return (ia < 0 ? 99 : ia) - (ib < 0 ? 99 : ib);
  });
  return seen.map((g) => [g, groups.get(g)!]);
}

const mediaUse = MEDIA_USE[kind];
const mediaUnused = !!mediaUse && "unused" in mediaUse;
/* Named as the person would say it, for the sentence explaining that this kind
   has nowhere to show an image. */
const spec_kindLabel = (KINDS.find((k) => k.kind === kind)?.label ?? kind).toLowerCase();
const SKIP = new Set(["id", "created_at", "updated_at", "createdAt", "updatedAt", "media", "visible", "position"]);
const fieldsOf = (r: any) => Object.keys(r).filter((k) => !SKIP.has(k));
const label = (r: any) =>
  r.title || r.name || r.label || r.key || r.slug || r.artist || r.platform || `#${r.id}`;
---

<AdminLayout title={spec.label}>
  <div class="head">
    <h1 class="adm-h">{spec.label}</h1>
    <nav class="kinds">
      {
        KINDS.map((k) => (
          <a href={`/admin/blocks?kind=${k.kind}`} aria-current={k.kind === kind ? "page" : undefined}>
            {k.label}
          </a>
        ))
      }
    </nav>
  </div>

  {notice && <p class="adm-ok" role="status">{notice}</p>}
  {failed && <p class="adm-bad" role="alert">{failed}</p>}

  {
    row ? (
      <form method="POST" class="adm-card editor">
        <CsrfField />
        <input type="hidden" name="action" value={creating ? "create" : "save"} />
        {!creating && <input type="hidden" name="id" value={row.id} />}
        <h2 class="h2">
          {creating ? `New ${spec.singular}` : `Editing ${label(row)}`}
        </h2>
        {
          grouped(row).map(([group, keys]) => (
            <section class="group">
              <h3 class="group-head">{group}</h3>
              {
                keys.map((k) => {
                  const spec = specFor(kind, k);
                  const value = row[k];
                  return spec.type === "media" ? (
                    mediaUnused ? (
                      <p class="adm-note unused">
                        <strong>{spec.label}:</strong> nothing on the site draws an image
                        for {spec_kindLabel}.
                        Uploading one here would store a picture that never appears, so
                        the picker is not offered.
                      </p>
                    ) : (
                      <div class="field">
                        <MediaField
                          name={k}
                          value={value ?? null}
                          label={(mediaUse as any).label}
                        />
                        <p class="hint">{(mediaUse as any).where}</p>
                      </div>
                    )
                  ) : spec.type === "checkbox" || typeof value === "boolean" ? (
                    <div class="field field--check">
                      {/* An unchecked box sends nothing at all, so unticking
                          one would leave the field out of the payload and the
                          patch would not unset it. The hidden partner is always
                          sent; the checkbox overrides it when ticked. */}
                      <input type="hidden" name={k} value="off" />
                      <label class="check">
                        <input type="checkbox" name={k} checked={!!value} />
                        <span>{spec.label}</span>
                      </label>
                      {spec.help && <p class="hint">{spec.help}</p>}
                    </div>
                  ) : (
                    <label class="field">
                      <span class="adm-lbl">{spec.label}</span>
                      {
                        spec.type === "textarea"
                          ? <textarea class="adm-area" name={k} rows="10">{value ?? ""}</textarea>
                          : spec.type === "select"
                            ? (
                              <select class="adm-input" name={k}>
                                {(spec.options ?? []).map((o) => (
                                  <option value={o.value} selected={value === o.value}>{o.label}</option>
                                ))}
                              </select>
                            )
                            : spec.type === "datetime"
                              ? (
                                /* Stored UTC, typed local. The visible box has
                                   no name and never posts; a script keeps the
                                   hidden one filled with a full ISO instant,
                                   offset included, so a time typed here means
                                   the same instant after a clock change. */
                                <>
                                  <input class="adm-input" type="datetime-local" data-dt-local />
                                  <input type="hidden" name={k} value={value ?? ""} data-dt-value />
                                  <noscript>
                                    <input class="adm-input" name={k} value={value ?? ""}
                                           placeholder="2026-09-01T19:00:00+03:00" />
                                  </noscript>
                                </>
                              )
                              : (
                                <input
                                  class="adm-input"
                                  type={spec.type === "url" ? "url" : spec.type === "number" ? "number" : "text"}
                                  name={k}
                                  value={value ?? ""}
                                  placeholder={spec.placeholder}
                                />
                              )
                      }
                      {spec.help && <p class="hint">{spec.help}</p>}
                    </label>
                  );
                })
              }
            </section>
          ))
        }
        <div class="row-actions">
          <Button type="submit">{creating ? `Add ${spec.singular}` : "Save"}</Button>
          <a class="cancel" href={`/admin/blocks?kind=${kind}`}>Cancel</a>
        </div>
      </form>
    ) : (
      <>
        <p class="adm-note">
          Nothing appears on the site until it is marked visible. Hidden is the default, so nothing
          half-finished ships by accident — and a hidden row is dimmed here rather than tucked away.
        </p>

        <div class="list-actions">
          <Button href={`/admin/blocks?kind=${kind}&new=1`}>Add a {spec.singular}</Button>
        </div>

        <div class="rows">
          {
            rows.length === 0 ? (
              <p class="adm-note">
                No {spec.label.toLowerCase()} yet — “Add a {spec.singular}” above is where they start.
              </p>
            ) : (
              rows.map((r) => (
                <div class="row" data-hidden={!r.visible || undefined}>
                  <div class="row-main">
                    <span class="row-label">{label(r)}</span>
                    {r.page && <span class="row-sub">on /{r.page}</span>}
                    {r.eyebrow && <span class="row-sub">{r.eyebrow}</span>}
                  </div>
                  {/* Which two lead the home page, visible from the list —
                      otherwise you have to open each one to find out. */}
                  {/* Featured but hidden shows nowhere at all — the home page
                      draws from what is public. Silently doing nothing is the
                      trap; saying so is the fix. */}
                  {r.featured && (
                    <Badge tone={r.visible ? "rose" : "faint"}>
                      {r.visible ? "on the home page" : "featured, but hidden"}
                    </Badge>
                  )}
                  <Badge tone={r.visible ? "accent" : "faint"}>{r.visible ? "visible" : "hidden"}</Badge>
                  <div class="row-actions">
                    <form method="POST" class="inline">
                      <CsrfField />
                      <input type="hidden" name="action" value="visibility" />
                      <input type="hidden" name="id" value={r.id} />
                      <input type="hidden" name="visible" value={r.visible ? "0" : "1"} />
                      <Button type="submit" variant="ghost" size="sm">
                        {r.visible ? "Hide" : "Show"}
                      </Button>
                    </form>
                    <a class="edit" href={`/admin/blocks?kind=${kind}&edit=${r.id}`}>Edit</a>
                    <form method="POST" class="inline" data-confirm={`Delete ${label(r)}? This cannot be undone.`}>
                      <CsrfField />
                      <input type="hidden" name="action" value="delete" />
                      <input type="hidden" name="id" value={r.id} />
                      <button type="submit" class="danger">Delete</button>
                    </form>
                  </div>
                </div>
              ))
            )
          }
        </div>
      </>
    )
  }
</AdminLayout>

<style>
  .head { display: flex; gap: var(--space-4); align-items: baseline; flex-wrap: wrap; }
  .kinds { display: flex; gap: 2px; flex-wrap: wrap; margin-left: auto; }
  .kinds a {
    font: 500 var(--text-xs) var(--font-body); color: var(--ink-soft); text-decoration: none;
    padding: 7px 11px; border-radius: var(--radius-sm);
  }
  .kinds a:hover { color: var(--ink); background: var(--surface-veil); }
  .kinds a[aria-current="page"] { color: var(--accent); background: var(--accent-wash); }

  .rows { display: grid; gap: 6px; }
  .row {
    display: flex; gap: var(--space-4); align-items: center; flex-wrap: wrap;
    background: var(--surface-card); border: var(--border-w) solid var(--line);
    border-radius: var(--radius-sm); padding: 12px 14px;
  }
  /* Hidden is dimmed, not hidden from you. */
  .row[data-hidden] { opacity: 0.6; border-style: dashed; }
  .row-main { display: grid; gap: 2px; min-width: 0; flex: 1; }
  .row-label { font: 500 var(--text-body) var(--font-body); color: var(--ink); }
  .row-sub { font: 400 var(--text-xs) var(--font-mono); color: var(--ink-faint); }
  .row-actions { display: flex; gap: 10px; align-items: center; }
  .inline { display: inline; }
  .edit, .cancel { font: 500 var(--text-sm) var(--font-body); color: var(--accent); text-decoration: none; }
  .edit:hover, .cancel:hover { text-decoration: underline; }

  .editor { gap: var(--space-4); max-width: 760px; }
  .h2 { font: 600 var(--text-h3) var(--font-display); color: var(--ink); margin: 0; }
  .list-actions { margin-bottom: var(--space-4); }

  /* Destructive, and dressed as it: not a primary button competing with Edit,
     but not hidden either. */
  .danger {
    appearance: none; background: none; border: 0; padding: 0; cursor: pointer;
    font: 500 var(--text-sm) var(--font-body); color: var(--live);
  }
  .danger:hover { text-decoration: underline; }

  .field { display: grid; gap: 4px; }

  /* Grouped, so a form of fourteen boxes reads as four short questions rather
     than one long one. */
  .group { display: grid; gap: var(--space-3); }
  .group-head {
    margin: 0;
    font: 600 var(--text-xs) var(--font-mono);
    letter-spacing: .08em;
    text-transform: uppercase;
    color: var(--accent);
    padding-bottom: 4px;
    border-bottom: var(--border-w) solid var(--accent-wash);
  }

  /* What the field is for, under the field. The editor used to say nothing at
     all, which is why filling it in was a guess you had to go and check. */
  .hint {
    margin: 0;
    font: 400 var(--text-xs) var(--font-body);
    color: var(--ink-soft);
    max-width: 62ch;
  }

  .field--check { gap: 6px; }
  .check { display: flex; align-items: center; gap: 8px; cursor: pointer; }
  .check span { font: 500 var(--text-sm) var(--font-body); color: var(--ink); }
  .check input { width: 18px; height: 18px; accent-color: var(--accent); }

  .unused {
    border-left: 2px solid var(--accent-wash);
    padding-left: var(--space-3);
    max-width: 62ch;
  }
</style>

<script>
  /* A time is typed in the local clock and stored as an instant.
   *
   * `datetime-local` has no zone, so posting its value raw would be read as UTC
   * and land the stream three hours out in summer. The visible box is unnamed
   * and never posts; this keeps the hidden field beside it holding a full ISO
   * instant with the offset of the moment being typed — not of now, which is a
   * different offset across a clock change.
   */
  document.querySelectorAll<HTMLInputElement>("[data-dt-local]").forEach((local) => {
    const hidden = local.parentElement?.querySelector<HTMLInputElement>("[data-dt-value]");
    if (!hidden) return;

    if (hidden.value) {
      const at = new Date(hidden.value);
      if (!Number.isNaN(at.getTime())) {
        const pad = (n: number) => String(n).padStart(2, "0");
        local.value =
          `${at.getFullYear()}-${pad(at.getMonth() + 1)}-${pad(at.getDate())}` +
          `T${pad(at.getHours())}:${pad(at.getMinutes())}`;
      }
    }

    const sync = () => {
      if (!local.value) { hidden.value = ""; return; }
      const at = new Date(local.value);
      hidden.value = Number.isNaN(at.getTime()) ? "" : at.toISOString();
    };
    local.addEventListener("change", sync);
    local.form?.addEventListener("submit", sync);
  });

  /* Deleting is one click and cannot be undone, so it asks first. The message
     lives on the form, because only the form knows what it is about to remove. */
  document.querySelectorAll<HTMLFormElement>("form[data-confirm]").forEach((form) => {
    form.addEventListener("submit", (event) => {
      if (!window.confirm(form.dataset.confirm ?? "Delete this?")) event.preventDefault();
    });
  });
</script>

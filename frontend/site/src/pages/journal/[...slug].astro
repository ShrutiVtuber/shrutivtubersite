---
/* The journal.
 *
 * BeeRanked's agent syncs published pages to disk; this route reads them for
 * their DATA and renders the designersay("text.skeleton.inside.site", 's skeleton inside the site')s own layout.
 * So the section gets the REAL SiteHeader and SiteFooter — live badge, mobile
 * drawer, session state — and the content is the design, not BeeRanked's
 * default wearing a stylesheet.
 *
 * Their markup is never passed through. That was the earlier arrangement and
 * it is what the designer's package replaces.
 */
import BaseLayout from "../../layouts/BaseLayout.astro";
import Article from "../../components/journal/Article.astro";
import AzPage from "../../components/journal/AzPage.astro";
import Changelog from "../../components/journal/Changelog.astro";
import DocsPage from "../../components/journal/DocsPage.astro";
import Listing from "../../components/journal/Listing.astro";
import Masthead from "../../components/journal/Masthead.astro";
import NotFound from "../../components/journal/NotFound.astro";
import ReleasePage from "../../components/journal/ReleasePage.astro";
import { read } from "../../lib/journal/parse";
import { SITE_URL } from "../../lib/api";
import { KIND_LABEL } from "../../lib/journal/types";
import "../../styles/journal.css";
import { copy } from "../../lib/copy";

/* Every word here, editable from the admin. The defaults below are what
   it was written with and what still renders if nothing was changed. */
const say = await copy("journal/[...slug]");


export const prerender = false;

const slug = Astro.params.slug ?? "";
const parts = slug.split("/").filter(Boolean);

const page = await read(parts);

/* A miss inside the section gets the sectionsay("text.site", 's own 404, not the site')s: the
   reader was looking for an entry, and the two things that can still help are
   in here. The status is still 404 — it looks like a page, but nothing is
   allowed to tell a crawler this address resolved. */
if (!page) {
  Astro.response.status = 404;
}

/* Related entries come from the section's own index rather than from the
   article, because BeeRanked does not put them in the page and a "continue
   reading" block that links nowhere is worse than none. */
let related = page?.entries ?? [];
if (page && (page.type === "article" || page.type === "docs" || page.type === "wiki")) {
  const index = await read([parts[0]]);
  const here = `/journal/${parts.join("/")}/`;
  related = (index?.entries ?? []).filter((e) => e.href !== here);
}

/* The journal's own markup, which BeeRanked does not supply for an index.
   An article page gets BlogPosting from the engine; a section index gets
   nothing, so a crawler sees a list of links with no statement that it is a
   blog or what is on it.

   Only for indexes, and only when there is something to list — an empty
   ItemList claims a page has contents it does not. */
/* Every listing shape the engine has: the section front, the everything page,
   a category, and a docs or wiki index. Not the sitemap, which is a directory
   rather than a set of posts, and not an article, which BeeRanked already
   marks up as a BlogPosting on its own. */
const LISTINGS = new Set(["hub", "all", "index", "category"]);
const isIndex = Boolean(page && LISTINGS.has(page.type));
const listed = (page?.entries ?? []).filter((e: any) => e?.href && e?.title);
const journalLd = !isIndex || listed.length === 0 ? null : {
  "@context": "https://schema.org",
  "@type": "Blog",
  name: page.title,
  description: page.description ?? undefined,
  url: `${SITE_URL}/journal/${parts.join("/")}`.replace(/\/$/, ""),
  blogPost: listed.slice(0, 50).map((e: any) => ({
    "@type": "BlogPosting",
    headline: e.title,
    url: e.href.startsWith("http") ? e.href : `${SITE_URL}${e.href}`,
    ...(e.date ? { datePublished: e.date } : {}),
    ...(e.description ? { description: e.description } : {}),
  })),
};

const LEDE: Record<string, string> = {
  hub: say("text.notes.practice.software", "Notes on practice, and on the software written as practice. Documentation for the instruments, and what changed in them."),
  all: say("text.everything.section.newest", "Everything in the section, newest first."),
  sitemap:
    say("text.every.page.section", "Every page in the section, as the engine knows it. The machine-readable one is at /journal/sitemap.xml."),
};
---

<BaseLayout
  jsonLd={journalLd}
  title={page ? `${page.title} — Shruti` : "Nothing is filed here — Shruti"}
  description={page?.description}
>
  <div class="journal" data-journal>
    {
      !page ? <NotFound />
      : page.type === "article" || page.type === "wiki"
        ? <Article page={page} related={related} />
        : page.type === "docs"
          ? <DocsPage page={page} />
          : page.type === "changelog"
            ? <Changelog title={page.title} lede={page.lede} releases={page.releases} />
            : page.type === "changelog-entry" && page.release
              ? <ReleasePage release={page.release} crumbs={page.crumbs} body={page.body} />
              : page.type === "sitemap"
                ? (
                    <main class="j-page">
                      <Masthead eyebrow="Journal" title={page.title} lede={page.lede || LEDE.sitemap} />
                      <AzPage groups={page.groups} />
                    </main>
                  )
                : page.type === "index" && page.kind === "wiki"
                  ? (
                      <main class="j-page">
                        <Masthead eyebrow={KIND_LABEL.wiki} title={page.title} lede={page.lede}
                                  count={page.count > 0 ? `${page.count} ${page.count === 1 ? "article" : "articles"}` : undefined} />
                        <AzPage groups={page.groups} />
                      </main>
                    )
                  : page.type === "hub"
                    ? <Listing eyebrow="Journal" title={say("text.1", "Writing, documentation, and what changed")}
                               lede={LEDE.hub} entries={page.entries} feature />
                    : page.type === "all"
                      ? <Listing eyebrow="Everything" title="All content"
                                 lede={LEDE.all} entries={page.entries} grouped />
                      : <Listing
                          eyebrow={page.type === "category" ? "Category" : KIND_LABEL[page.kind]}
                          title={page.title}
                          lede={page.lede}
                          count={page.count > 0 ? `${page.count} ${page.count === 1 ? "entry" : "entries"}` : undefined}
                          entries={page.entries} />
    }

    {/* BeeRanked's own schema.org blocks, passed straight through.
        Valid in the body as well as the head — Google documents both — and
        keeping them here confines the change to the journal instead of adding
        a head slot to the layout every other page shares. */}
    {page.structuredData.map((block) => (
      <script type="application/ld+json" set:html={block} />
    ))}
  </div>
</BaseLayout>

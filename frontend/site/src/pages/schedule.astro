---
/* Schedule — ported from `ui_kits/site/Schedule.jsx`.
 *
 * The designed empty state is the current reality and the handoff says so
 * outright, so it is not a fallback here — it is the page most visitors will
 * see until streams are scheduled. Never fake liveness.
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionHeader from "../components/brand/SectionHeader.astro";
import ScheduleItem from "../components/tables/ScheduleItem.astro";
import TimezoneToggle from "../components/tables/TimezoneToggle.astro";
import EmptyState from "../components/feedback/EmptyState.astro";
import Button from "../components/forms/Button.astro";
import { site, PATHS, SITE_URL } from "../lib/api";
import { copy } from "../lib/copy";


/* One origin for the whole site, read at runtime. See lib/env.ts. */
const SITE = SITE_URL;
/* Every word on this page, editable from the admin. The defaults below are
   what it was written with and what still renders if nothing was changed. */
const say = await copy("schedule");


interface ScheduleRow {
  title: string; startsAt: string; durationMinutes: number | null;
  platform: string | null; url: string | null; notesMd: string | null;
}
const rows = (await site<ScheduleRow[]>(PATHS.schedule)) ?? [];
const now = Date.now();
const statusOf = (r: ScheduleRow): "live" | "upcoming" | "past" => {
  const start = new Date(r.startsAt).getTime();
  const end = start + (r.durationMinutes ?? 120) * 60_000;
  if (now >= start && now <= end) return "live";
  return now > end ? "past" : "upcoming";
};

/* Upcoming streams as Events.
 *
 * "When is she live" is the one question about a creator that a search engine
 * can answer directly, and it can only do it if the times are marked up. Only
 * FUTURE streams are published: a past date presented as an event is a wrong
 * answer with a confident face, and the whole point of this page is that the
 * time is right.
 *
 * `eventAttendanceMode` and a `location` of type VirtualLocation are the parts
 * usually left off, and without them an online stream reads as an event with
 * no venue rather than as one you attend from anywhere.
 */

const upcoming = rows.filter((r) => statusOf(r) !== "past");
const jsonLd = upcoming.length
  ? {
      "@context": "https://schema.org",
      "@graph": upcoming.map((r) => ({
        "@type": "Event",
        name: r.title,
        startDate: r.startsAt,
        ...(r.durationMinutes
          ? { endDate: new Date(new Date(r.startsAt).getTime() + r.durationMinutes * 60_000).toISOString() }
          : {}),
        eventAttendanceMode: "https://schema.org/OnlineEventAttendanceMode",
        eventStatus: "https://schema.org/EventScheduled",
        location: {
          "@type": "VirtualLocation",
          url: r.url || SITE,
        },
        organizer: { "@id": `${SITE}/#person` },
        performer: { "@id": `${SITE}/#person` },
        ...(r.notesMd ? { description: r.notesMd.replace(/[*_`#>\[\]]/g, "").trim() } : {}),
      })),
    }
  : null;
---

<BaseLayout
  title={say("text.2", "Schedule — Shruti")}
  description={say("text.3", "When Shruti is live: upcoming streams of programming, astrology and magickal practice, authored in Athens and shown in your own timezone.")}
  jsonLd={jsonLd}
>
  <div class="page">
    <div class="section-head">
      <SectionHeader
        as="h1" glyph="☾" eyebrow="Schedule" title={say("text.4", "Upcoming streams")}
        body="Authored in Athens (GMT+3); times shown in your zone."
      />
      {rows.length > 0 && <TimezoneToggle value="athens" />}
    </div>

    {
      rows.length === 0 ? (
        <EmptyState
          as="h2"
          glyph="○"
          title={say("text.5", "The sky is quiet")}
          body={say("text.6", "Nothing scheduled yet — streams are announced on Discord first, and the calendar fills at the new moon.")}
        >
          <Button slot="action" variant="secondary" href="/contact">{say("text.7", "Get in touch")}</Button>
        </EmptyState>
      ) : (
        <div class="schedule-rows">
          {rows.map((r) => (
            <ScheduleItem
              title={r.title}
              startISO={r.startsAt}
              durationMin={r.durationMinutes ?? undefined}
              topic={r.platform ?? undefined}
              status={statusOf(r)}
              href={r.url ?? undefined}
            />
          ))}
        </div>
      )
    }

    <p class="schedule-note">{say("text.1", "Conversions use your system timezone.")}</p>
  </div>
</BaseLayout>

<style>
  .schedule-rows { display: grid; gap: var(--space-3); margin-top: var(--space-5); }
  .schedule-note {
    font: 400 var(--text-xs) / 1.6 var(--font-body);
    color: var(--ink-faint);
    margin: var(--space-5) 0 0;
  }
</style>

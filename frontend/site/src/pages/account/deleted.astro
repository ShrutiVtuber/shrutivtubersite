---
/* After deletion. States what happened without asking anything further. */
import BaseLayout from "../../layouts/BaseLayout.astro";
import SectionHeader from "../../components/brand/SectionHeader.astro";
import Button from "../../components/forms/Button.astro";
import { copy } from "../../lib/copy";

/* Every word on this page, editable from the admin. The defaults below are
   what it was written with and what still renders if nothing was changed. */
const say = await copy("account/deleted");

---

<BaseLayout title={say("text.4", "Account deleted — Shruti")} description={say("text.5", "Your account has been deleted.")} noindex>
  <div class="page done">
    <SectionHeader as="h1" glyph="○" eyebrow="Deleted" title={say("text.8", "That's done")} />
    <p class="body">{say("text.1", "The account, your email address, your preferences, your saved nativity and your newsletter subscription are gone. It reached the list as well as the account.")}</p>
    <p class="body">{say("text.2", "What is kept is a record that consent was given and withdrawn, with dates and no birth data. That record is the proof the law asks for, and it no longer names you.")}</p>
    <p class="body quiet">{say("text.3", "Everything on the site that never needed an account still works, and always will.")}</p>
    <div class="actions">
      <Button href="/today">{say("text.6", "Day at a glance")}</Button>
      <Button variant="secondary" href="/tools/solar-stations">{say("text.7", "Station tracker")}</Button>
    </div>
  </div>
</BaseLayout>

<style>
  .done { max-width: 620px; display: grid; gap: var(--space-3); }
  .body { font: 400 var(--text-body) / var(--leading-body) var(--font-body); color: var(--ink-soft); margin: 0; max-width: 62ch; }
  .quiet { color: var(--ink-faint); font-size: var(--text-sm); }
  .actions { display: flex; gap: 10px; flex-wrap: wrap; margin-top: var(--space-4); }
</style>

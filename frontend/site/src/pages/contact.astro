---
/* Contact — ported from `ui_kits/site/Contact.jsx`.
 *
 * A real POST form handled on this route, so it works with scripting off.
 * The reference validates in React state; here the server validates, calls the
 * backend, and re-renders with the field errors verbatim from the design.
 *
 * Two routes in, deliberately: business mail and everything else land in
 * different inboxes so neither buries the other.
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import { pageSections } from "../lib/content";
import Prose from "../components/content/Prose.astro";
import SectionFigure from "../components/blocks/SectionFigure.astro";
import SectionHeader from "../components/brand/SectionHeader.astro";
import TextField from "../components/forms/TextField.astro";
import TextArea from "../components/forms/TextArea.astro";
import SelectField from "../components/forms/SelectField.astro";
import Button from "../components/forms/Button.astro";
import EmptyState from "../components/feedback/EmptyState.astro";
import CsrfField from "../components/forms/CsrfField.astro";
import { SITE_API } from "../lib/api";
import { verifyCsrf } from "../lib/csrf";
import { copy } from "../lib/copy";
import Copy from "../components/content/Copy.astro";

/* Every word on this page, editable from the admin. The defaults below are
   what it was written with and what still renders if nothing was changed. */
const say = await copy("contact");


let sent = false;
let failed = "";
const errors: Record<string, string> = {};
const values = { topic: "", name: "", email: "", msg: "" };

/* The question box is a different thing from the contact form and lives on the
   same page. Contact goes to an inbox and gets a private reply; a question may
   be answered in public, and only ever after she has approved it. Keeping them
   apart on the page matters because the second one has a consequence the first
   does not. */
let asked = false;
let askFailed = "";
const askErrors: Record<string, string> = {};
const askValues = { body: "", askedBy: "" };

if (Astro.request.method === "POST" && String((await Astro.request.clone().formData()).get("form") ?? "") === "question") {
  const form = await Astro.request.formData();
  if (!verifyCsrf(Astro.cookies, form)) {
    askFailed = say("error.csrf", "That did not send. Reload the page and try again.");
  }
  askValues.body = String(form.get("body") ?? "");
  askValues.askedBy = String(form.get("asked_by") ?? "");
  const honeypot = String(form.get("website") ?? "");

  if (!askFailed && askValues.body.trim().length < 3) {
    askErrors.body = say("error.short", "A question needs a few words at least.");
  }
  if (!askFailed && askValues.body.trim().length > 1000) {
    askErrors.body = say("error.long", "That is longer than the box takes — a thousand characters.");
  }

  if (!askFailed && Object.keys(askErrors).length === 0) {
    try {
      const response = await fetch(`${SITE_API}/api/questions`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          body: askValues.body,
          asked_by: askValues.askedBy,
          website: honeypot,
        }),
      });
      if (response.ok) asked = true;
      else askFailed = say("error.failed", "That did not send. Try the address above instead.");
    } catch {
      askFailed = say("error.send3", "That did not send. Try the address above instead.");
    }
  }
} else if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();

  /* Rejected before anything is read out of the form. A submission without a
     matching token is not a user with a typo, it is a cross-site post. */
  if (!verifyCsrf(Astro.cookies, form)) {
    failed = say("error.retry", "That did not send. Reload the page and try again.");
  }
  values.topic = String(form.get("topic") ?? "");
  values.name = String(form.get("name") ?? "");
  values.email = String(form.get("email") ?? "");
  values.msg = String(form.get("msg") ?? "");
  const honeypot = String(form.get("website") ?? "");

  /* Error copy is the design's, verbatim — the wording is part of the design. */
  if (!failed) {
  if (!values.topic) errors.topic = say("error.route", "Pick a route so this lands in the right inbox.");
  if (!values.name.trim()) errors.name = say("error.name", "Please add a name — a handle is fine.");
  if (!/^\S+@\S+\.\S+$/.test(values.email)) errors.email = say("error.email", "That address doesn’t look complete.");
  if (values.msg.trim().length < 10) errors.msg = say("error.body", "A sentence or two helps me reply well.");
  }

  if (!failed && Object.keys(errors).length === 0) {
    try {
      const response = await fetch(`${SITE_API}/api/contact`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          kind: values.topic === "business" ? "business" : "general",
          name: values.name,
          email: values.email,
          subject: "",
          body: values.msg,
          website: honeypot,
        }),
      });
      if (response.ok) sent = true;
      else failed = say("error.send", "That did not send. The address above works, and always will.");
    } catch {
      failed = say("error.send2", "That did not send. The address above works, and always will.");
    }
  }
}

/* Only ever questions she has approved AND answered — the endpoint enforces
   that, and nothing else is ever public. */
let answered: { body: string; askedBy: string; answeredMd: string; answeredAt: string | null }[] = [];
try {
  const r = await fetch(`${SITE_API}/api/questions`);
  if (r.ok) answered = await r.json();
} catch {
  /* A question list that cannot be fetched is not worth failing the page for. */
}

/* Every block the admin has added to /contact. */
const sections = await pageSections("contact");
const extra = sections.filter((s) => s.key !== "intro");
---

<BaseLayout title={say("text.1", "Contact — Shruti")} description={say("text.2", "How to reach Shruti. Business and sponsorship enquiries route one way and everything else another, so neither gets lost in the other's inbox.")}>
  <div class="page">
    <SectionHeader
      as="h1" glyph="☿︎" eyebrow="Contact" title={say("text.3", "Two routes in")}
      body={say("text.4", "Business goes to one inbox, everything else to another — pick the right one and it gets answered faster.")}
    />

    <div class="grid-2 contact-cards">
      <div class="contact-card">
        <h2>{say("business-enquiries.1", "Business enquiries")}</h2>
        <p>{say("business-enquiries.2", "Sponsorships, events, press. The brand-safety statement and asset pack are in the press kit.")}</p>
        <span class="contact-addr">{say("business-enquiries.3", "business@shrutivtuber.com")}</span>
        <div><Button variant="ghost" href="/press">{say("business-enquiries.4", "Open the press kit")}</Button></div>
      </div>
      <div class="contact-card">
        <h2>{say("everything-else.1", "Everything else")}</h2>
        <p>{say("everything-else.2", "Fan works, questions, edge cases, hellos.")}</p>
        <span class="contact-addr">{say("everything-else.3", "hello@shrutivtuber.com")}</span>
      </div>
    </div>

    {
      sent ? (
        <EmptyState
          glyph="☾︎"
          title={say("text.5", "Sent — thank you.")}
          body={say("text.6", "Replies come from hello@shrutivtuber.com, usually within two working days. Business mail may take one more.")}
        >
          <Button slot="action" variant="secondary" href="/contact">{say("text.10", "Send another")}</Button>
        </EmptyState>
      ) : (
        <form method="POST" novalidate class="contact-form">
          <CsrfField />
          {failed && <p class="contact-failed" role="alert">{failed}</p>}
          <SelectField
            label="Route" name="topic" required placeholder="Choose one"
            value={values.topic} error={errors.topic}
            options={[
              { value: "business", label: "Business — sponsorship, events, press" },
              { value: "general", label: "Everything else" },
            ]}
          />
          <TextField label="Name" name="name" required value={values.name} error={errors.name} autocomplete="name" />
          <TextField label="Email" name="email" type="email" required value={values.email} error={errors.email} autocomplete="email" />
          <TextArea label="Message" name="msg" required rows={6} maxlength={5000} value={values.msg} error={errors.msg} />
          {/* Honeypot: a real person never fills this; bots fill everything. */}
          <div class="hp" aria-hidden="true">
            <label for="website">{say("text.11", "Website")}</label>
            <input id="website" name="website" type="text" tabindex="-1" autocomplete="off" />
          </div>
          <div><Button type="submit">{say("text.12", "Send")}</Button></div>
        </form>
      )
    }
  </div>

    <section class="ask">
      <h2>{say("ask-something.1", "Ask something")}</h2>
      {/* One string, bold and all.
          
          It was three pieces: two runs of prose hardcoded around an editable
          <strong>. Only the bold half could be changed, which is the worst of
          both — the sentence is visibly editable and mostly is not. */}
      <p class="ask-why">
        <Copy text={say("ask-something.2", "Different from the form above. That one reaches an inbox and gets a reply to you; this one may be answered here, in public, where the next person with the same question can read it. **Nothing appears until she has approved it**, and you can leave the name blank.")} />
      </p>

      {asked ? (
        <p class="ask-ok">{say("ask-something.3", "Asked. It goes nowhere public until she has read it and answered it — and she may not answer every one.")}</p>
      ) : (
        <form method="POST" class="ask-form">
          <CsrfField />
          <input type="hidden" name="form" value="question" />
          <TextArea
            name="body"
            label={say("text.7", "Your question")}
            rows={4}
            value={askValues.body}
            error={askErrors.body}
            required
          />
          <TextField
            name="asked_by"
            label={say("text.8", "A name to put on it, if you want one")}
            value={askValues.askedBy}
            placeholder={say("text.9", "Leave blank to stay anonymous")}
          />
          {/* Left empty by people, filled in by robots. */}
          <div class="hp" aria-hidden="true">
            <label>Website<input type="text" name="website" tabindex="-1" autocomplete="off" /></label>
          </div>
          {askFailed && <p class="ask-bad">{askFailed}</p>}
          <div><Button type="submit" data-track="question:asked">Ask it</Button></div>
        </form>
      )}

      {
        answered.length > 0 && (
          <div class="answers">
            <h3>{say("answered.1", "Answered")}</h3>
            <ul>
              {answered.map((q) => (
                <li>
                  <p class="a-q">{q.body}</p>
                  <p class="a-by">{q.askedBy || "Anonymous"}</p>
                  <Prose html={q.answeredMd} />
                </li>
              ))}
            </ul>
          </div>
        )
      }
    </section>

    {/* Anything else the admin has put on this page. Only `intro` used to
        render, so a block added in the admin simply did not appear — which
        makes the editor feel broken rather than the page feel empty. */}
    {
      extra.length > 0 && (
        <div class="page-sections">
          {
            extra.map((s) => (
              <section class="page-section">
                {s.title && <h2>{s.title}</h2>}
                <SectionFigure media={s.media} title={s.title} />
                <Prose html={s.html} />
              </section>
            ))
          }
        </div>
      )
    }

</BaseLayout>

<style>
  .ask {
    margin-top: var(--space-7); display: grid; gap: var(--space-4);
    padding: var(--space-6);
    background: var(--surface-card);
    border: var(--border-w) solid var(--line);
    border-radius: var(--radius-md);
  }
  .ask h2 { font: 600 var(--text-h3) var(--font-display); color: var(--ink); margin: 0; }
  .ask h3 { font: 600 var(--text-h4) var(--font-display); color: var(--ink); margin: 0 0 var(--space-3); }
  .ask-why { font: 400 var(--text-body) / var(--leading-body) var(--font-body); color: var(--ink-soft); margin: 0; max-width: 62ch; }
  .ask-ok { font: 400 var(--text-body) var(--font-body); color: var(--accent); margin: 0; max-width: 62ch; }
  .ask-bad { font: 400 var(--text-sm) var(--font-body); color: var(--live); margin: 0; }
  .ask-form { display: grid; gap: var(--space-4); max-width: 56ch; }
  /* Off-screen rather than display:none — a hidden field some robots skip is a
     honeypot that catches nothing. */
  .hp { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }
  .answers ul { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--space-5); }
  .answers li { border-top: var(--border-w) solid var(--line); padding-top: var(--space-4); }
  .a-q { font: 500 var(--text-body) / var(--leading-body) var(--font-body); color: var(--ink); margin: 0 0 4px; }
  .a-by {
    font: 600 var(--text-micro) var(--font-body); letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase; color: var(--ink-faint); margin: 0 0 var(--space-3);
  }
  .contact-cards { margin-top: var(--space-6); }
  .contact-card {
    background: var(--surface-card);
    border: var(--border-w) solid var(--line);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-1);
    padding: 20px;
    display: grid;
    gap: 8px;
    align-content: start;
  }
  .contact-card h2 { font: 600 var(--text-h3) var(--font-display); color: var(--ink); margin: 0; }
  .contact-card p { font: 400 var(--text-sm) / 1.55 var(--font-body); color: var(--ink-soft); margin: 0; }
  .contact-addr { font: 400 var(--text-sm) var(--font-mono); color: var(--ink); }
  .contact-form { display: grid; gap: 18px; max-width: 560px; margin-top: var(--space-6); }
  .contact-failed {
    font: 400 var(--text-sm) / 1.55 var(--font-body);
    color: var(--live);
    margin: 0;
  }
  .hp { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }

  .page-sections { display: grid; gap: var(--space-6); margin-top: var(--space-6); }
  .page-section { display: grid; gap: var(--space-3); }
  .page-section h2 { font: 600 var(--text-h3) var(--font-display); color: var(--ink); margin: 0; }
</style>

---
/* Create a guide (board Desk, 20 Sep 2026): where a guide is written.
 *
 * Any account can write. Everything written is a draft until Shruti has read
 * it, and the page says so where the author will see it. Reading needs no
 * account and never will; writing needs one because a guide is published
 * under a name. Each guide is a row that carries its shape — one arc per
 * phase — with its versions as a ladder in the state vocabulary.
 *
 * ⚠ A new guide is created by SAVING a skeleton, not by a create endpoint:
 * the server has one rule for filing a draft (guide.id, title, game.id) and
 * this page uses it rather than growing a second one.
 */
import BaseLayout from "../../layouts/BaseLayout.astro";
import Head from "../../components/guides/Head.astro";
import Empty from "../../components/guides/Empty.astro";
import Console from "../../components/guides/Console.astro";
import Sigil from "../../components/guides/Sigil.astro";
import StateDot from "../../components/guides/StateDot.astro";
import TextField from "../../components/forms/TextField.astro";
import Button from "../../components/forms/Button.astro";
import { site } from "../../lib/api";
import { account, asReader } from "../../lib/account";
import { copy } from "../../lib/copy";

const say = await copy("guides/write");

interface Game { id: number; slug: string; name: string; variants: { id: string; name: string }[]; guides: number }
interface Version { id: number; number: number; state: string; note: string; problems: number; updated?: string | null }
interface Mine {
  id: number; slug: string; title: string; game: { slug: string; name: string };
  published: number | null; hidden: boolean; hiddenBy: string;
  shape?: { phases: number; steps: number };
  versions: Version[];
}

const me = await account(Astro);
const [games, mineRead] = await Promise.all([
  site<Game[]>("/api/guides/games"),
  me ? asReader(Astro, "/api/guides/mine") : Promise.resolve({ ok: false, status: 0, body: null }),
]);
const mine: Mine[] = mineRead.ok && Array.isArray(mineRead.body) ? mineRead.body : [];
interface Proposal {
  id: number; state: string; note: string; accepted: boolean; by: string; author: string;
  guide: { id: number; slug: string; title: string; game: { slug: string; name: string } | null } | null;
  changes: { added: number; removed: number; changed: number }; problems: number;
}
const propRead = me ? await asReader(Astro, "/api/guides/mine/contributions") : { ok: false, status: 0, body: null };
const given: Proposal[] = propRead.ok && Array.isArray(propRead.body?.given) ? propRead.body.given : [];
const received: Proposal[] = propRead.ok && Array.isArray(propRead.body?.received) ? propRead.body.received : [];
const PSTATE: Record<string, string> = {
  draft: say("pstate.draft", "still writing"),
  proposed: say("pstate.proposed", "sent to the author"),
  declined: say("pstate.declined", "declined"),
  submitted: say("pstate.submitted", "accepted — waiting for Shruti"),
  published: say("pstate.published", "accepted and published"),
  superseded: say("pstate.superseded", "accepted, since replaced"),
};
const pstate = (p: Proposal) => (p.accepted && p.state === "draft") ? say("pstate.accepted", "accepted — in the author's draft") : (PSTATE[p.state] ?? p.state);
const counts = (c: Proposal["changes"]) => say("changes.line", "{a} added · {r} removed · {c} changed").replace("{a}", String(c.added)).replace("{r}", String(c.removed)).replace("{c}", String(c.changed));

/* The ladder's words and dots: draft = open ring · to fix = open ring, bold ·
   waiting for Shruti = now disc · published = done dash · replaced = done's
   dash with the colour taken away, the word struck. */
const STATE: Record<string, string> = {
  draft: say("state.draft", "draft"),
  submitted: say("state.submitted", "waiting for Shruti"),
  published: say("state.published", "published"),
  sent_back: say("state.sent_back", "sent back"),
  superseded: say("state.superseded", "replaced"),
};
const dotOf = (v: Version) => (v.state === "published" ? "done" : v.state === "submitted" ? "now" : v.state === "superseded" ? "skipped" : "open");
const wordState = (v: Version) => (v.state === "published" ? "published" : v.state === "submitted" ? "waiting" : v.state === "superseded" ? "replaced" : v.problems > 0 ? "tofix" : "draft");
const wordOf = (v: Version) => {
  const base = STATE[v.state] ?? v.state;
  return (v.state === "draft" || v.state === "sent_back") && v.problems > 0 ? `${base} · ${v.problems} ${say("problems", "to fix")}` : base;
};
const dateOf = (v: Version) => (v.updated ? new Date(v.updated).toLocaleDateString("en-GB", { day: "numeric", month: "short" }) : "");
const openDraft = (g: Mine) => g.versions.find((v) => v.state === "draft" || v.state === "sent_back");
const shapeLine = (g: Mine) => [g.game.name, g.shape ? say("row.shape", "{p} phases · {s} steps").replace("{p}", String(g.shape.phases)).replace("{s}", String(g.shape.steps)) : ""].filter(Boolean).join(" · ");
---

<BaseLayout
  title={say("meta.title", "Create a guide — Squirrel Guides")}
  description={say("meta.description", "Write a game guide as a path: phases, steps, routines and a codex.")}
  noindex
>
  <div class="page dk-wrap">
    <Head as="h1" eyebrow={say("title", "Create a guide")} title={say("mine", "Your guides")}
      lede={say("lede", "Drafts, versions, and where each one stands with me. Create a guide, or import one from a file. Every version is read before it goes up.")} />
    <ol class="dk-how" aria-label={say("how.title", "How it works")}>
      <li>{say("how.1", "Write it here as a path: the phases, the steps in each, the routines that reset, and the codex behind them.")}</li>
      <li>{say("how.2", "Submit it. Shruti reads every guide before it goes up.")}</li>
      <li>{say("how.3", "It is published under your name. Readers track it, and can suggest corrections that you accept or decline.")}</li>
    </ol>

    {!me ? (
      <Empty n={9} eyebrow={say("signin.eyebrow", "Create a guide")} title={say("signin.title", "Sign in to write.")}
        body={say("signin.body", "A guide goes up under a name, so writing needs an account. Reading never will.")}
        action={say("signin.cta", "Sign in")} href="/signin?next=%2Fguides%2Fwrite" ringAria={say("empty.ring", "An empty ring")} />
    ) : (
      <div class="dk-grid" data-desk data-author={me.displayName}>
        {mine.length === 0 ? (
          <Empty n={9} eyebrow={say("empty.eyebrow", "Create a guide")} title={say("empty.title", "Create a guide.")}
            body={say("empty.body", "A guide is a path: phases, steps, routines, a codex. Write the first phase here — outline, form and preview side by side. Nothing publishes until Shruti has read it.")}
            action={say("empty.action", "Create a guide")} href="#start" ringAria={say("empty.ring", "An empty ring")} />
        ) : (
          <ul class="gd-rows dk-list">
            {mine.map((g) => (
              <li class="dk-guide">
                <Sigil n={Math.max(1, g.shape?.phases ?? 1)} done={0} now={-1} size={44} ring={false} showCount={false}
                  aria={say("row.aria", "{n} phases").replace("{n}", String(g.shape?.phases ?? 0))} />
                <div class="dk-main">
                  <div class="dk-title">
                    {g.published ? <a class="gd-row-name" href={`/guides/${g.game.slug}/${g.slug}`}>{g.title}</a> : <span class="gd-row-name">{g.title}</span>}
                    <span class="gd-note">{shapeLine(g)}</span>
                  </div>
                  {g.hidden && (
                    <p class="gd-hint">
                      {g.hiddenBy === "author"
                        ? say("hidden.author", "You took this down. Readers cannot see it.")
                        : g.hiddenBy === "reports"
                        ? say("hidden.reports", "Off the catalogue until Shruti has looked at the reports.")
                        : say("hidden.her", "Shruti took this down.")}
                    </p>
                  )}
                  <ol class="gd-ladder">
                    {g.versions.map((v) => (
                      <li>
                        <StateDot state={dotOf(v)} />
                        <span class="gd-vno">{say("version.short", "v{n}").replace("{n}", String(v.number))}</span>
                        <span class="dk-vline">
                          <span class="gd-vword" data-state={wordState(v)}>{wordOf(v)}</span>
                          {dateOf(v) && <span class="gd-vdate">{dateOf(v)}</span>}
                          {v.state === "sent_back" && v.note && <span class="dk-note">{say("note", "Shruti wrote:")} “{v.note}”</span>}
                        </span>
                        {(v.state === "draft" || v.state === "sent_back") ? (
                          <a class="dk-act" href={`/guides/write/${v.id}`}>{say("edit", "Open")}</a>
                        ) : v.state === "published" ? (
                          <a class="dk-act" href={`/guides/${g.game.slug}/${g.slug}`}>{say("read", "Read")}</a>
                        ) : <span />}
                      </li>
                    ))}
                  </ol>
                  {g.published && !openDraft(g) && (
                    <div><Button type="button" variant="secondary" size="sm" data-new-version={g.id} data-game={g.game.slug} data-slug={g.slug}>{say("new_version", "Start a new version")}</Button></div>
                  )}
                </div>
              </li>
            ))}
          </ul>
        )}

        {(received.length > 0 || given.length > 0) && (
          <section class="dk-section">
            <h2 class="gd-h2">{say("proposals", "Suggested changes")}</h2>
            {received.length > 0 && (
              <>
                <h3 class="gd-eyebrow dk-h3">{say("proposals.received", "To your guides")}</h3>
                <ul class="gd-index">
                  {received.map((p) => (
                    <li>
                      <span class="dk-ptitle">{p.guide?.title} <span class="gd-note">{say("proposals.by", "by {who}").replace("{who}", p.by)} · {counts(p.changes)} · {pstate(p)}</span></span>
                      <span class="gd-lead"></span>
                      <a class="dk-act" href={`/guides/write/${p.id}/changes`}>{say("proposals.see", "See the changes")}</a>
                    </li>
                  ))}
                </ul>
              </>
            )}
            {given.length > 0 && (
              <>
                <h3 class="gd-eyebrow dk-h3">{say("proposals.given", "Yours, to other people's guides")}</h3>
                <ul class="gd-index">
                  {given.map((p) => (
                    <li>
                      <span class="dk-ptitle">{p.guide?.title} <span class="gd-note">{say("proposals.to", "by {who}").replace("{who}", p.author)} · {counts(p.changes)} · {pstate(p)}</span>
                        {p.state === "declined" && p.note && <span class="dk-note">{say("proposals.note", "The author wrote:")} “{p.note}”</span>}
                      </span>
                      <span class="gd-lead"></span>
                      {p.state === "draft" && !p.accepted && <a class="dk-act" href={`/guides/write/${p.id}`}>{say("edit", "Open")}</a>}
                      {p.state !== "draft" && <a class="dk-act" href={`/guides/write/${p.id}/changes`}>{say("proposals.see", "See the changes")}</a>}
                    </li>
                  ))}
                </ul>
              </>
            )}
          </section>
        )}

        <div id="start" class="dk-start">
          <Console as="form" eyebrow={say("new", "Create a new guide")} data-new>
            <TextField label={say("new.title", "Title")} name="title" required maxlength="140" placeholder={say("new.title.hint", "What the path gets someone to")} />
            <TextField label={say("new.game", "Game")} name="game" required maxlength="80" list="dk-games" placeholder={say("new.game.hint", "Pick one, or name a new game")} hint={say("new.game.note", "A new game arrives with its first guide.")} />
            <datalist id="dk-games">
              {(games ?? []).map((g) => <option value={g.name} data-slug={g.slug} />)}
            </datalist>
            <TextField label={say("new.variants", "Ways a run can differ, if any")} name="variants" maxlength="200" optionalLabel placeholder={say("new.variants.hint", "Class · mode · platform")} hint={say("new.variants.note", "The fields a run checks in with, separated by commas. Leave empty if none.")} />
            <div><Button type="submit">{say("new.go", "Create the guide")}</Button></div>
            <p class="gd-hint" data-new-status></p>
          </Console>
          <div class="dk-side">
            <label class="dk-drop" data-drop>
              <span class="gd-eyebrow">{say("import", "Or import a guide file")}</span>
              <span class="dk-drop-title">{say("import.drop", "Drop a guide file here")}</span>
              <span class="dk-drop-body">{say("import.note", "The same guide.json the tracker reads and any guide's page offers to download. It is validated before anything is saved; one whose address matches a guide of yours opens as its next draft.")}</span>
              <span class="dk-drop-btn"><Button type="button" variant="secondary" size="sm" data-import-button>{say("import.pick", "Choose a file")}</Button></span>
              <input type="file" accept=".json,application/json" data-import class="dk-file-input" />
              <span class="gd-hint" data-import-status></span>
            </label>
            <p class="dk-foot">{say("foot", "Agents may draft and submit. Nothing an agent does publishes. Every version is read by Shruti before it goes up.")}</p>
          </div>
        </div>
      </div>
    )}
  </div>
</BaseLayout>

<style>
  .dk-wrap { padding-block: var(--space-6) var(--space-9); display: grid; gap: var(--space-7); font-family: var(--font-body); }
  .dk-grid { display: grid; gap: var(--space-7); }
  .dk-how { margin: 0; padding-left: 1.4rem; display: grid; gap: 4px; max-width: var(--measure-ui); font-size: var(--text-sm); line-height: var(--leading-body); color: var(--ink-soft); }
  .dk-how li::marker { font-family: var(--font-mono); color: var(--ink-faint); }
  .dk-guide { display: grid; grid-template-columns: 44px minmax(0, 1fr); gap: 16px; padding: 18px 0; border-bottom: 1px solid var(--line); }
  .dk-main { display: grid; gap: 10px; min-width: 0; }
  .dk-title { display: grid; gap: 3px; }
  .dk-title a { color: inherit; text-decoration: none; }
  .dk-title a:hover { color: var(--accent); }
  .dk-vline { display: flex; flex-wrap: wrap; gap: 4px 10px; align-items: baseline; min-width: 0; }
  .dk-note { flex-basis: 100%; font-style: italic; color: var(--ink-soft); font-size: 13px; }
  .dk-act { font-size: 13px; font-weight: 500; white-space: nowrap; color: var(--accent); }
  .dk-section { display: grid; gap: var(--space-3); }
  .dk-h3 { margin: 10px 0 0; }
  .dk-ptitle { display: grid; gap: 2px; min-width: 0; font-weight: 600; }
  .dk-start { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr)); gap: var(--space-6); align-items: start; scroll-margin-top: 80px; }
  .dk-side { display: grid; gap: var(--space-5); align-content: start; }
  .dk-drop { display: grid; gap: 10px; place-items: center; text-align: center; padding: 32px 20px; border: 1px dashed var(--line-strong); border-radius: 10px; background: color-mix(in srgb, var(--surface-veil) 40%, transparent); cursor: pointer; }
  .dk-drop[data-over="true"] { border-color: var(--accent); background: var(--accent-wash); }
  .dk-drop-title { font-weight: 600; }
  .dk-drop-body { font-size: 14px; color: var(--ink-soft); max-width: 36ch; text-wrap: pretty; }
  .dk-file-input { position: absolute; width: 1px; height: 1px; opacity: 0; overflow: hidden; }
  .dk-foot { margin: 0; font-family: var(--font-display); font-size: 17px; line-height: 1.6; color: var(--ink-soft); text-wrap: pretty; }
</style>

<script>
  const desk = document.querySelector<HTMLElement>("[data-desk]");
  if (desk) {
    const author = desk.dataset.author || "";
    const slugOf = (s: string) =>
      s.toLowerCase().normalize("NFKD").replace(/[^a-z0-9]+/g, "-").replace(/^-+|-+$/g, "").slice(0, 80);
    const token = () =>
      document.cookie.split("; ").find((c) => c.startsWith("shruti_csrf="))?.split("=")[1] ?? "";
    /* Saving a skeleton IS creating a guide: the server files it and answers
       with the version to open. */
    const file = async (body: unknown): Promise<{ ok: boolean; versionId?: number; detail?: string }> => {
      const r = await fetch("/api/guides/draft", {
        method: "PUT",
        headers: { "content-type": "application/json", "x-csrf-token": token() },
        body: JSON.stringify({ version_id: null, body }),
      });
      const answer = await r.json().catch(() => ({}));
      return r.ok ? { ok: true, versionId: answer.versionId } : { ok: false, detail: answer.detail };
    };
    const form = desk.querySelector<HTMLFormElement>("[data-new]");
    const status = desk.querySelector<HTMLElement>("[data-new-status]");
    form?.addEventListener("submit", async (event) => {
      event.preventDefault();
      const data = new FormData(form);
      const title = String(data.get("title") ?? "").trim();
      const gameName = String(data.get("game") ?? "").trim();
      const known = Array.from(document.querySelectorAll<HTMLOptionElement>("#dk-games option"))
        .find((o) => o.value.toLowerCase() === gameName.toLowerCase());
      const variants = String(data.get("variants") ?? "").split(",").map((v) => v.trim()).filter(Boolean)
        .map((name) => ({ id: slugOf(name).replace(/-/g, "_"), name }));
      const skeleton = {
        format: 1,
        game: { id: known?.dataset.slug || slugOf(gameName), name: gameName, variants },
        guide: { id: slugOf(title), title, authors: [author], version: "1.0", game_patch: "", summary: "", caveats: [] },
        checkin: [],
        phases: [{ id: "p1", name: "Getting started", order: 1 }],
        steps: [], routines: [], codex: [], codex_notes: [], tracks: [],
      };
      if (status) status.textContent = "Filing it…";
      const r = await file(skeleton);
      if (r.ok && r.versionId) location.href = `/guides/write/${r.versionId}`;
      else if (status) status.textContent = r.detail || "That did not save. Try again.";
    });
    const pick = desk.querySelector<HTMLInputElement>("[data-import]");
    const importStatus = desk.querySelector<HTMLElement>("[data-import-status]");
    const drop = desk.querySelector<HTMLElement>("[data-drop]");
    const importFile = async (chosen: File | undefined) => {
      if (!chosen) return;
      let body: unknown;
      try {
        body = JSON.parse(await chosen.text());
      } catch {
        if (importStatus) importStatus.textContent = "That file is not JSON.";
        return;
      }
      if (importStatus) importStatus.textContent = "Filing it…";
      const r = await file(body);
      if (r.ok && r.versionId) location.href = `/guides/write/${r.versionId}`;
      else if (importStatus) importStatus.textContent = r.detail || "That did not save. The file needs guide.id, guide.title and game.id at least.";
    };
    pick?.addEventListener("change", () => importFile(pick.files?.[0]));
    desk.querySelector("[data-import-button]")?.addEventListener("click", (e) => { e.preventDefault(); pick?.click(); });
    if (drop) {
      drop.addEventListener("dragover", (e) => { e.preventDefault(); drop.dataset.over = "true"; });
      drop.addEventListener("dragleave", () => { drop.dataset.over = "false"; });
      drop.addEventListener("drop", (e) => { e.preventDefault(); drop.dataset.over = "false"; importFile(e.dataTransfer?.files?.[0]); });
    }
    /* A new version starts from what is live, fetched from the reader API. */
    for (const button of desk.querySelectorAll<HTMLButtonElement>("[data-new-version]")) {
      button.addEventListener("click", async () => {
        button.disabled = true;
        const r = await fetch(`/api/guides/${button.dataset.game}/${button.dataset.slug}`);
        if (!r.ok) { button.disabled = false; return; }
        const live = await r.json();
        const filed = await file(live.body);
        if (filed.ok && filed.versionId) location.href = `/guides/write/${filed.versionId}`;
        else button.disabled = false;
      });
    }
  }
</script>

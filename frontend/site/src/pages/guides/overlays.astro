---
/* The gallery: layouts of Shruti's, shared for anybody to start from — the
 * kinds and their places on the 1920 × 1080 canvas, the theme, the motion.
 * Never her tokens; never the fields that name her routines, groups or
 * counters. "Use this layout" mints one for a run of yours, and shows the
 * URL once.
 */
import BaseLayout from "../../layouts/BaseLayout.astro";
import SectionHeader from "../../components/brand/SectionHeader.astro";
import { site } from "../../lib/api";
import { account, asReader } from "../../lib/account";
import { copy } from "../../lib/copy";

const say = await copy("guides/overlays");
interface Placed { kind: string; x: number; y: number; w: number; shows?: string }
interface Shared { id: number; label: string; theme: string; motion: string; layout: Placed[] }
const me = await account(Astro);
const [shared, runsRead] = await Promise.all([
  site<Shared[]>("/api/overlay/gallery"),
  me ? asReader(Astro, "/api/runs") : Promise.resolve({ ok: false, status: 0, body: null }),
]);
const layouts: Shared[] = Array.isArray(shared) ? shared : [];
const runs: { id: number; name: string }[] = runsRead.ok && Array.isArray(runsRead.body) ? runsRead.body : [];
const KIND: Record<string, string> = {
  "guide-now": say("kind.now", "Now card"), "guide-sigil": say("kind.sigil", "Sigil"), "guide-path": say("kind.path", "Path strip"),
  "guide-routine": say("kind.routine", "Routine"), "guide-goal": say("kind.goal", "Goal"), "counter": say("kind.counter", "Counter"),
  "text": say("kind.text", "Text"), "image": say("kind.image", "Picture"),
  "ticker": say("kind.ticker", "Ticker"), "sky": say("kind.sky", "Sky"), "hours": say("kind.hours", "Planetary hours"),
  "countdown": say("kind.countdown", "Countdown"), "alerts": say("kind.alerts", "Alerts"), "wheel": say("kind.wheel", "Transit wheel"),
  "build": say("kind.build", "Build"),
};
const THEME: Record<string, string> = { almanac: say("theme.almanac", "Almanac"), grimoire: say("theme.grimoire", "Grimoire"), plain: say("theme.plain", "Plain") };
const MOTION: Record<string, string> = { full: say("motion.full", "full motion"), reduced: say("motion.reduced", "reduced motion"), still: say("motion.still", "still") };
// A thumbnail: each element as a box on the canvas, at a tenth of the size.
const height = (k: string) => (k === "guide-sigil" ? 224 : k === "guide-path" ? 96 : k === "guide-now" ? 200 : k === "guide-routine" ? 260 : k === "counter" ? 140 : k === "text" ? 80 : k === "image" ? 160 : k === "ticker" ? 64 : k === "sky" ? 300 : k === "hours" ? 150 : k === "countdown" ? 130 : k === "alerts" ? 120 : k === "wheel" ? 432 : k === "build" ? 420 : 220);
const WORDS = {
  minted: say("words.minted", "Made. Paste this into OBS as a browser source, 1920 × 1080 — it is shown once."),
  failed: say("words.failed", "That did not go through. Try again."),
  pick: say("words.pick", "Pick a run first."),
};
---

<BaseLayout title={say("meta.title", "Overlay layouts — Squirrel Guides")} description={say("meta.description", "Layouts of Shruti's to start from: the elements and their places, in three themes.")}>
  <section class="page gallery" data-gallery data-words={JSON.stringify(WORDS)} data-runs={JSON.stringify(runs)}>
    <SectionHeader as="h1" eyebrow={say("head.eyebrow", "Squirrel Guides")} title={say("head.title", "Overlay layouts")} />
    <p class="lede">{say("head.lede", "The layouts Shruti streams with, shared to start from. A layout is where the elements sit; a theme is what they wear. Use one on a run of yours and it draws your place, not hers.")}</p>

    <p class="note" data-note hidden></p>

    {layouts.length === 0 ? (
      <p class="quiet">{say("none", "Nothing shared yet.")}</p>
    ) : (
      <ul class="list">
        {layouts.map((l) => (
          <li class="card" data-layout={JSON.stringify({ theme: l.theme, motion: l.motion, layout: l.layout })}>
            <svg class="thumb" viewBox="0 0 1920 1080" aria-hidden="true">
              <rect x="0" y="0" width="1920" height="1080" class="ground" />
              {l.layout.map((e) => (<g><rect x={e.x} y={e.y} width={e.w} height={height(e.kind)} class={`box ${e.kind}`} /><text x={e.x + 24} y={e.y + 56} class="label">{KIND[e.kind] ?? e.kind}</text></g>))}
            </svg>
            <div class="body">
              <h2>{l.label || say("card.untitled", "A layout")}</h2>
              <p class="mono">{THEME[l.theme] ?? l.theme} · {MOTION[l.motion] ?? l.motion} · {say("card.elements", "{n} elements").replace("{n}", String(l.layout.length))}</p>
              <p class="mono soft">{l.layout.map((e) => KIND[e.kind] ?? e.kind).join(" · ")}</p>
              {me ? (
                runs.length === 0 ? (
                  <p class="quiet">{say("card.norun", "Start a run first — a layout draws a run's place.")} <a href="/guides">{say("card.guides", "The guides")}</a></p>
                ) : (
                  <div class="use">
                    <label><span>{say("card.run", "Run")}</span><select data-run>{runs.map((r) => <option value={r.id}>{r.name}</option>)}</select></label>
                    <button type="button" class="button" data-use>{say("card.use", "Use this layout")}</button>
                  </div>
                )
              ) : (
                <p class="quiet"><a href="/signin?next=%2Fguides%2Foverlays">{say("card.signin", "Sign in")}</a> {say("card.signin_rest", "to use a layout on a run of yours.")}</p>
              )}
              <div class="minted" data-minted hidden>
                <label><span>{say("card.url", "Browser source URL — shown once")}</span><input type="text" readonly data-url /></label>
              </div>
            </div>
          </li>
        ))}
      </ul>
    )}
    <p class="quiet">{say("foot", "A theme changes palette, type and ornament. It never changes the layout or the four state colours, so chat learns them once.")}</p>
  </section>
</BaseLayout>

<style>
  .gallery { max-width: 960px; margin: 0 auto; padding: var(--space-6) var(--space-4); display: grid; gap: var(--space-5); }
  .lede { color: var(--ink-soft); max-width: 62ch; }
  .note { border-left: 2px solid var(--accent); padding-left: var(--space-3); }
  .quiet, .soft { color: var(--ink-soft); }
  .mono { font-family: var(--font-mono); font-variant-numeric: tabular-nums; font-size: .85rem; margin: 0; }
  .list { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--space-4); grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); }
  .card { border: 1px solid var(--rule); display: grid; gap: 0; }
  .thumb { width: 100%; height: auto; display: block; border-bottom: 1px solid var(--rule); }
  .thumb .ground { fill: var(--surface-inset, #f2f0ec); }
  .thumb .box { fill: var(--paper, #fff); stroke: var(--ink-soft); stroke-width: 4; }
  .thumb .box.guide-sigil { rx: 112; }
  .thumb .label { font: 40px var(--font-mono); fill: var(--ink-soft); }
  .body { padding: var(--space-3) var(--space-4); display: grid; gap: var(--space-2); }
  h2 { font-size: 1.05rem; margin: 0; }
  .use { display: grid; gap: var(--space-2); }
  label { display: grid; gap: 4px; }
  label span { font-size: .8rem; color: var(--ink-soft); }
  select, input { font: inherit; padding: .45rem .55rem; border: 1px solid var(--rule); background: var(--paper); color: var(--ink); width: 100%; }
  .minted { border-top: 1px solid var(--rule); padding-top: var(--space-2); }
</style>

<script>
  const root = document.querySelector<HTMLElement>("[data-gallery]");
  if (root) {
    const words = JSON.parse(root.dataset.words || "{}");
    const note = root.querySelector<HTMLElement>("[data-note]");
    const tell = (t: string) => { if (note) { note.textContent = t; note.hidden = false; } };
    const csrf = () => document.cookie.split("; ").find((c) => c.startsWith("shruti_csrf="))?.split("=")[1] ?? "";
    root.querySelectorAll<HTMLButtonElement>("[data-use]").forEach((btn) => {
      btn.addEventListener("click", async () => {
        const card = btn.closest<HTMLElement>("[data-layout]"); if (!card) return;
        const chosen = JSON.parse(card.dataset.layout || "{}");
        const run = card.querySelector<HTMLSelectElement>("[data-run]")?.value;
        if (!run) { tell(words.pick); return; }
        btn.disabled = true;
        const r = await fetch(`/api/runs/${run}/overlays`, { method: "POST", headers: { "content-type": "application/json", "x-csrf-token": csrf() },
          body: JSON.stringify({ kind: "guide-layout", theme: chosen.theme, motion: chosen.motion, label: card.querySelector("h2")?.textContent ?? "", layout: chosen.layout }) });
        btn.disabled = false;
        if (!r.ok) { tell(words.failed); return; }
        const made = await r.json();
        const box = card.querySelector<HTMLElement>("[data-minted]");
        const url = card.querySelector<HTMLInputElement>("[data-url]");
        if (url) url.value = `${location.origin}/overlay/guide-layout?t=${encodeURIComponent(made.token)}`;
        if (box) box.hidden = false;
        tell(words.minted);
      });
    });
  }
</script>

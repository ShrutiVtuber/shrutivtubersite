---
/* The gallery (board Layouts, 20 Sep 2026): layouts of Shruti's, shared for
 * anybody to start from — each a miniature of the plate in its theme, the
 * kinds and their places on the 1920 × 1080 canvas, the motion. Never her
 * tokens; never the fields that name her routines, groups or counters.
 * "Use this layout" mints one for a run of yours, and shows the URL once.
 * The Ledger's starting layout asks for a ledger instead: its plate draws
 * that ledger, bound to it with no run (POST /api/ledger/ledgers/{id}/layouts). */
import BaseLayout from "../../layouts/BaseLayout.astro";
import Head from "../../components/guides/Head.astro";
import Empty from "../../components/guides/Empty.astro";
import Plate from "../../components/guides/Plate.astro";
import SelectField from "../../components/forms/SelectField.astro";
import TextField from "../../components/forms/TextField.astro";
import Button from "../../components/forms/Button.astro";
import { site } from "../../lib/api";
import { account, asReader } from "../../lib/account";
import { copy } from "../../lib/copy";

const say = await copy("guides/overlays");
interface Placed { kind: string; x: number; y: number; w: number; shows?: string }
interface Shared { id: number | string; label: string; theme: string; motion: string; layout: Placed[]; starter?: boolean; note?: string; description?: string; game?: string }
interface Book { id: number; name: string }
interface Run { id: number; name: string; guide?: { slug: string; game: { slug: string } } }
const me = await account(Astro);
const [shared, runsRead, booksRead] = await Promise.all([
  site<Shared[]>("/api/overlay/gallery"),
  me ? asReader(Astro, "/api/runs") : Promise.resolve({ ok: false, status: 0, body: null }),
  me ? asReader(Astro, "/api/ledger/ledgers") : Promise.resolve({ ok: false, status: 0, body: null }),
]);
const books: Book[] = booksRead.ok && Array.isArray(booksRead.body) ? booksRead.body.map((b: any) => ({ id: b.id, name: b.name })) : [];
/* A layout holding a Ledger element draws a ledger, not a run's place. */
const isLedger = (l: Shared) => l.layout.some((e) => e.kind.startsWith("ledger-"));
const layouts: Shared[] = Array.isArray(shared) ? shared : [];
const runs: Run[] = runsRead.ok && Array.isArray(runsRead.body) ? runsRead.body : [];
const KIND: Record<string, string> = {
  "guide-now": say("kind.now", "Now card"), "guide-sigil": say("kind.sigil", "Sigil"), "guide-path": say("kind.path", "Path strip"),
  "guide-routine": say("kind.routine", "Routine"), "guide-goal": say("kind.goal", "Goal"), "counter": say("kind.counter", "Counter"),
  "text": say("kind.text", "Text"), "image": say("kind.image", "Picture"),
  "ticker": say("kind.ticker", "Ticker"), "sky": say("kind.sky", "Sky"), "hours": say("kind.hours", "Planetary hours"),
  "countdown": say("kind.countdown", "Countdown"), "alerts": say("kind.alerts", "Alerts"), "wheel": say("kind.wheel", "Transit wheel"),
  "build": say("kind.build", "Build"),
  "ledger-plate": say("kind.ledger_plate", "Ledger plate"), "ledger-card": say("kind.ledger_card", "Business card"),
  "ledger-strip": say("kind.ledger_strip", "Company strip"), "ledger-limit": say("kind.ledger_limit", "Limit line"),
  "ledger-counter": say("kind.ledger_counter", "Week counter"), "ledger-plan-panel": say("kind.ledger_plan_panel", "Plan on stream"),
  "ledger-plan-card": say("kind.ledger_plan_card", "Plan on stream, card"),
};
const THEME: Record<string, string> = { almanac: say("theme.almanac", "Almanac"), grimoire: say("theme.grimoire", "Grimoire"), plain: say("theme.plain", "Plain"), ledger: say("theme.ledger", "Ledger") };
/* The site's starting layouts come from the server with its own words; these are hers to change. */
const STARTER: Record<string, { label: string; note: string; description: string; line: string }> = {
  "big-ambitions-ledger": {
    label: say("starter.ledger.title", "Big Ambitions · Ledger"),
    note: say("starter.ledger.note", "Ledger theme"),
    description: say("starter.ledger.body", "The ledger plate on the right, a group's goal at the bottom left. Move anything once it is yours."),
    line: say("starter.ledger.line", "plate · goal · 1920 × 1080"),
  },
};
const MOTION: Record<string, string> = { full: say("motion.full", "full motion"), reduced: say("motion.reduced", "reduced motion"), still: say("motion.still", "still") };
const meta = (l: Shared) => `${THEME[l.theme] ?? l.theme} · ${MOTION[l.motion] ?? l.motion} · ${say("card.elements", "{n} elements").replace("{n}", String(l.layout.length))}`;
const kinds = (l: Shared) => l.layout.map((e) => KIND[e.kind] ?? e.kind).join(" · ");
const firstRun = runs[0];
const openRun = firstRun?.guide ? `/guides/${firstRun.guide.game.slug}/${firstRun.guide.slug}/track?run=${firstRun.id}` : "/guides";
const WORDS = {
  minted: say("words.minted", "Made. Paste this into OBS as a browser source, 1920 × 1080 — it is shown once."),
  failed: say("words.failed", "That did not go through. Try again."),
  pick: say("words.pick", "Pick a run first."),
  pickLedger: say("words.pick_ledger", "Pick a ledger first."),
  copied: say("words.copied", "Copied."),
};
---

<BaseLayout title={say("meta.title", "Overlay layouts — Squirrel Guides")} description={say("meta.description", "Layouts of Shruti's to start from: the elements and their places, in three themes.")}>
  <section class="page gallery" data-gallery data-words={JSON.stringify(WORDS)}>
    <Head as="h1" eyebrow={say("head.eyebrow", "Layouts")} title={say("head.title", "Overlay layouts to start from")} max="56ch"
      lede={say("head.lede", "A layout is where the elements sit; a theme is what they wear. Use one on a run of yours and it draws your place, not hers.")} />
    <p class="gd-rule-note" data-note hidden></p>

    {layouts.length === 0 ? (
      <Empty n={4} eyebrow={say("empty.eyebrow", "Layouts")} title={say("empty.title", "No layouts shared yet.")}
        body={say("empty.body", "When I share one it appears here with its canvas drawn. Until then, mint an overlay from a run — every run has a Now card and a sigil out of the box.")}
        action={say("empty.action", "Open a run")} href={openRun} ringAria={say("empty.ring", "An empty ring")} />
    ) : (
      <>
        <div class="cards">
          {layouts.map((l) => (
            <article class="card" data-layout={JSON.stringify({ theme: l.theme, motion: l.motion, layout: l.layout })}>
              <div class="plate"><Plate theme={l.theme} elements={l.layout} width={520} fluid labels={KIND} aria={say("card.plate_aria", "{theme} layout, {n} elements").replace("{theme}", THEME[l.theme] ?? l.theme).replace("{n}", String(l.layout.length))} /></div>
              <div class="body">
                <h2>{STARTER[String(l.id)]?.label ?? (l.label || say("card.untitled", "A layout"))}</h2>
                <span class="gd-mono gd-soft">{STARTER[String(l.id)]?.note ?? meta(l)}</span>
                {STARTER[String(l.id)] ? <p class="gd-note starter">{STARTER[String(l.id)].description}</p> : null}
                <span class="gd-note">{STARTER[String(l.id)]?.line ?? kinds(l)}</span>
              </div>
              <div class="foot">
                {me && isLedger(l) ? (
                  books.length === 0 ? (
                    <p class="gd-lede small">{say("card.noledger", "Start a ledger first — this layout draws one.")} <a href="/ledger#new">{say("card.ledger_start", "Start a ledger")}</a></p>
                  ) : (
                    <>
                      <div class="pick"><SelectField label={say("card.ledger", "Which ledger")} name={`ledger-${l.id}`} data-ledger options={books.map((b) => ({ value: String(b.id), label: b.name }))} /></div>
                      <Button type="button" data-use>{say("card.use", "Use this layout")}</Button>
                    </>
                  )
                ) : me ? (
                  runs.length === 0 ? (
                    <p class="gd-lede small">{say("card.norun", "Start a run first — a layout draws a run's place.")} <a href="/guides">{say("card.guides", "The guides")}</a></p>
                  ) : (
                    <>
                      <div class="pick"><SelectField label={say("card.run", "On which run")} name={`run-${l.id}`} data-run options={runs.map((r) => ({ value: String(r.id), label: r.name }))} /></div>
                      <Button type="button" data-use>{say("card.use", "Use this layout")}</Button>
                    </>
                  )
                ) : (
                  <p class="gd-lede small">{isLedger(l) ? say("card.signin_ledger", "Sign in with a ledger to use it. It mints an overlay and shows the URL once.") : say("card.signin", "Sign in with a run to use it. It mints an overlay and shows the URL once.")} <a href="/signin?next=%2Fguides%2Foverlays">{say("card.signin_link", "Sign in")}</a></p>
                )}
                <div class="gd-once minted" data-minted hidden>
                  <span class="gd-eyebrow">{say("card.once", "Shown once")}</span>
                  <TextField label={say("card.url", "Browser source URL")} name={`url-${l.id}`} readonly data-url />
                  <div class="gd-once-row"><Button type="button" variant="secondary" size="sm" data-copy>{say("card.copy", "Copy")}</Button><Button type="button" variant="ghost" size="sm" data-have-it>{say("card.have_it", "I have it")}</Button></div>
                </div>
              </div>
            </article>
          ))}
        </div>
        <p class="gd-hint foot-note">{say("foot", "Using a layout mints an overlay for your run and shows its URL once. The token is the secret: anyone with the URL sees the overlay; nobody with it can change your run.")}</p>
      </>
    )}
  </section>
</BaseLayout>

<style>
  .gallery { padding-block: var(--space-6) 0; display: grid; gap: var(--space-6); }
  .cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr)); gap: var(--space-5); }
  .card { display: grid; gap: 0; background: var(--surface-card); border: 1px solid var(--line); border-radius: 10px; box-shadow: var(--shadow-1); overflow: hidden; }
  .plate { padding: 14px 14px 0; }
  .plate :global(.gd-plate) { width: 100%; max-width: none; }
  .body { padding: 14px 18px 16px; display: grid; gap: 6px; }
  .body h2 { margin: 0; font-family: var(--font-display); font-size: 22px; font-weight: 600; line-height: 1.2; }
  .foot { display: flex; flex-wrap: wrap; gap: 10px; align-items: end; padding: 14px 18px 18px; border-top: 1px solid var(--line); background: var(--surface-page); }
  .pick { flex: 1 1 160px; }
  .pick :global(.sh-field) { max-width: none; }
  .small { font-size: 14px; }
  .starter { margin: 0; font-size: 14px; }
  .minted { flex-basis: 100%; }
  .foot-note { max-width: 66ch; text-wrap: pretty; }
</style>

<script>
  const root = document.querySelector<HTMLElement>("[data-gallery]");
  if (root) {
    const words = JSON.parse(root.dataset.words || "{}");
    const note = root.querySelector<HTMLElement>("[data-note]");
    const tell = (t: string) => { if (note) { note.textContent = t; note.hidden = false; } };
    const csrf = () => document.cookie.split("; ").find((c) => c.startsWith("shruti_csrf="))?.split("=")[1] ?? "";
    root.querySelectorAll<HTMLButtonElement>("[data-use]").forEach((btn) => {
      btn.addEventListener("click", async () => {
        const card = btn.closest<HTMLElement>("[data-layout]"); if (!card) return;
        const chosen = JSON.parse(card.dataset.layout || "{}");
        const label = card.querySelector("h2")?.textContent ?? "";
        /* The Ledger's layout is bound to a ledger; every other one to a run. */
        const ledger = card.querySelector<HTMLSelectElement>("[data-ledger]");
        const run = card.querySelector<HTMLSelectElement>("[data-run]")?.value;
        if (ledger ? !ledger.value : !run) { tell(ledger ? words.pickLedger : words.pick); return; }
        btn.disabled = true;
        const r = ledger
          ? await fetch(`/api/ledger/ledgers/${ledger.value}/layouts`, { method: "POST", credentials: "same-origin", headers: { "content-type": "application/json", "x-csrf-token": csrf() },
              body: JSON.stringify({ theme: chosen.theme, motion: chosen.motion, label, layout: chosen.layout }) })
          : await fetch(`/api/runs/${run}/overlays`, { method: "POST", headers: { "content-type": "application/json", "x-csrf-token": csrf() },
              body: JSON.stringify({ kind: "guide-layout", theme: chosen.theme, motion: chosen.motion, label, layout: chosen.layout }) });
        btn.disabled = false;
        if (!r.ok) { tell(words.failed); return; }
        const made = await r.json();
        const box = card.querySelector<HTMLElement>("[data-minted]");
        const url = card.querySelector<HTMLInputElement>("[data-url]");
        if (url) url.value = `${location.origin}${made.path ?? `/overlay/guide-layout?t=${encodeURIComponent(made.token)}`}`;
        if (box) box.hidden = false;
        tell(words.minted);
      });
    });
    root.querySelectorAll<HTMLButtonElement>("[data-copy]").forEach((btn) => {
      btn.addEventListener("click", async () => {
        const url = btn.closest("[data-minted]")?.querySelector<HTMLInputElement>("[data-url]");
        if (url?.value) { try { await navigator.clipboard.writeText(url.value); tell(words.copied); } catch { url.select(); } }
      });
    });
    root.querySelectorAll<HTMLButtonElement>("[data-have-it]").forEach((btn) => {
      btn.addEventListener("click", () => { const box = btn.closest<HTMLElement>("[data-minted]"); const url = box?.querySelector<HTMLInputElement>("[data-url]"); if (url) url.value = ""; if (box) box.hidden = true; });
    });
  }
</script>

---
/* What a proposal changes (board Changes, 20 Sep 2026), in the guide's own
 * terms — a step added, a phase renamed, a routine's item dropped — against
 * the version it was written against, in a diff console: each change a row,
 * the fields as before → after. The author accepts it (it becomes their
 * draft, credited) or declines it with a note; a bare "no" is not a reason,
 * so the decline button waits for the note.
 */
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import Console from "../../../../components/guides/Console.astro";
import TextArea from "../../../../components/forms/TextArea.astro";
import Button from "../../../../components/forms/Button.astro";
import { account, asReader } from "../../../../lib/account";
import { copy } from "../../../../lib/copy";

const say = await copy("guides/write/[version]/changes");
const id = Astro.params.version ?? "";
if (!/^\d{1,12}$/.test(id)) return Astro.rewrite("/404");
const me = await account(Astro);
if (!me) return Astro.redirect(`/signin?next=${encodeURIComponent(`/guides/write/${id}/changes`)}`);
const read = await asReader(Astro, `/api/guides/mine/by-id/${id}/changes`);
if (!read.ok) return Astro.rewrite("/404");
const view = read.body as {
  id: number; state: string; note: string; by: string; owner: boolean; mine: boolean; accepted: boolean;
  guide: { id: number; slug: string; title: string }; against: { id: number; number: number } | null;
  changes: { kind: string; id: string; title: string; change: string; fields: { name: string; before: unknown; after: unknown }[] }[];
  summary: { added: number; removed: number; changed: number };
};
const word = (c: string) => c === "added" ? say("change.added", "added") : c === "removed" ? say("change.removed", "removed") : say("change.changed", "changed");
const show = (v: unknown) => v === undefined || v === null || v === "" ? say("field.empty", "— nothing —") : typeof v === "string" ? v : JSON.stringify(v);
const isEmpty = (v: unknown) => v === undefined || v === null || v === "";
const counts = say("head.counts", "{a} added · {r} removed · {c} changed").replace("{a}", String(view.summary.added)).replace("{r}", String(view.summary.removed)).replace("{c}", String(view.summary.changed));
const total = view.summary.added + view.summary.removed + view.summary.changed;
const WORDS = {
  accepted: say("words.accepted", "Accepted. It is your draft now; open it from your guides and submit it when you are ready."),
  declined: say("words.declined", "Declined, with your note."),
  needNote: say("words.need_note", "Say why — the note goes to the person who wrote it."),
  openDraft: say("words.open_draft", "You have an open draft of this guide. Submit or discard it first."),
  failed: say("words.failed", "That did not go through. Try again."),
};
---

<BaseLayout title={`${say("meta.title", "Changes")} — ${view.guide.title}`} description={say("meta.description", "What a suggested change alters.")} noindex>
  <article class="page changes" data-changes={view.id} data-words={JSON.stringify(WORDS)}>
    <nav class="crumb" aria-label={say("crumb.aria", "Breadcrumb")}>
      <a href="/guides/write">{say("crumb.desk", "Your guides")}</a><span aria-hidden="true">/</span>
      <span class="crumb-title">{view.guide.title}</span><span aria-hidden="true">/</span>
      <span>{say("crumb.here", "Suggested change")}</span>
    </nav>
    <header class="head">
      <span class="gd-eyebrow">{say("head.eyebrow", "Suggested change")}</span>
      <h1>{view.guide.title}</h1>
      <span class="gd-mono gd-soft line">
        {say("head.by", "by {who}").replace("{who}", view.by)}
        {view.against && ` · ${say("head.against", "against version {n}").replace("{n}", String(view.against.number))}`}
        {` · ${counts}`}
      </span>
      {view.state === "declined" && view.note && <p class="note-was">{say("head.declined", "Declined. The author wrote:")} “{view.note}”</p>}
      {view.accepted && <p class="note-was">{say("head.accepted", "Accepted into the author's draft.")}</p>}
    </header>

    <p class="gd-rule-note" data-note hidden></p>

    {view.changes.length === 0 ? (
      <p class="gd-hint">{say("none", "No difference from the published version.")}</p>
    ) : (
      <Console as="section" class="diff" aria-label={say("diff.aria", "The changes")}>
        {view.changes.map((c) => (
          <article class="change">
            <div class="change-line">
              <span class="gd-change" data-change={c.change}>{word(c.change)}</span>
              <span class="kind">{c.kind}</span>
              {c.id && <span class="gd-mono gd-faint">{c.id}</span>}
              {c.title && <span class="title">{c.title}</span>}
            </div>
            {c.fields.length > 0 && (
              <dl class="fields">
                {c.fields.map((f) => (
                  <div>
                    <dt class="gd-note">{f.name}</dt>
                    <dd>
                      {!isEmpty(f.before) && <span class="before" data-removed={c.change === "removed"}><span class="tag">{say("field.before", "before")}</span>{show(f.before)}</span>}
                      <span class="after"><span class="tag">{say("field.after", "after")}</span>{show(f.after)}</span>
                    </dd>
                  </div>
                ))}
              </dl>
            )}
          </article>
        ))}
      </Console>
    )}

    {view.owner && view.state === "proposed" && (
      <section class="call" aria-labelledby="call">
        <div class="call-text">
          <h2 id="call">{say("decide.title", "Your call")}</h2>
          <p>{say("decide.text", "Accept, and the {n} changes become your draft, credited to {who} on the guide. Decline, and {who} reads your reason — a bare no is not a reason.").replaceAll("{n}", String(total)).replaceAll("{who}", view.by)}</p>
          <div><Button type="button" data-accept>{say("decide.accept", "Accept into a new draft")}</Button></div>
        </div>
        <form class="decline" data-decline-form>
          <TextArea label={say("decide.note", "Decline with a note")} name="note" rows={3} maxlength={1000} data-decline-note placeholder={say("decide.note_hint", "Why not, or what would make it right.")} hint={say("decide.note_note", "Required to decline. {who} sees it; nobody else does.").replace("{who}", view.by)} />
          <div><Button type="submit" variant="secondary" data-decline disabled>{say("decide.decline", "Decline with this note")}</Button></div>
        </form>
      </section>
    )}
  </article>
</BaseLayout>

<style>
  .changes { max-width: 820px; margin: 0 auto; width: 100%; padding-block: var(--space-6) var(--space-9); display: grid; gap: var(--space-6); }
  .crumb { display: flex; flex-wrap: wrap; gap: 8px; font-size: 13px; color: var(--ink-faint); }
  .crumb a { color: inherit; }
  .crumb-title { color: var(--ink-soft); }
  .head { display: grid; gap: 10px; }
  .head h1 { margin: 0; font-family: var(--font-display); font-size: 32px; font-weight: 600; line-height: 1.2; letter-spacing: -0.01em; text-wrap: pretty; }
  .line { font-size: 14px; }
  .gd-faint { color: var(--ink-faint); }
  .note-was { margin: 0; font-size: 15px; color: var(--ink-soft); max-width: 66ch; text-wrap: pretty; }
  .diff { gap: 0; padding: 0; }
  .change { display: grid; gap: 12px; padding: 16px 20px; border-bottom: 1px solid var(--line); }
  .change:last-child { border-bottom: 0; }
  .change-line { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; }
  .kind { font-size: 14px; color: var(--ink-soft); }
  .title { font-family: var(--font-display); font-size: 19px; font-weight: 600; flex-basis: 100%; }
  .fields { margin: 0; display: grid; gap: 10px; }
  .fields div { display: grid; grid-template-columns: 10ch minmax(0, 1fr); gap: 6px 16px; align-items: start; }
  @media (max-width: 520px) { .fields div { grid-template-columns: 1fr; } }
  .fields dt { padding-top: 8px; }
  .fields dd { margin: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr)); gap: 8px; }
  .before, .after { padding: 8px 10px; border-radius: 4px; font-size: 14px; white-space: pre-wrap; }
  .before { background: var(--surface-inset); color: var(--ink-soft); }
  .before[data-removed="true"] { text-decoration: line-through; }
  .after { background: var(--accent-wash); color: var(--ink); }
  .tag { font-family: var(--font-mono); font-size: 11px; color: var(--ink-faint); margin-right: 8px; }
  .call { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr)); gap: var(--space-6); align-items: start; }
  .call-text { display: grid; gap: 12px; }
  .call h2 { margin: 0; font-family: var(--font-display); font-size: 22px; font-weight: 600; }
  .call p { margin: 0; font-size: 14px; color: var(--ink-soft); text-wrap: pretty; }
  .decline { display: grid; gap: 12px; }
  .decline :global(.sh-field) { max-width: none; }
</style>

<script>
  const root = document.querySelector<HTMLElement>("[data-changes]");
  if (root) {
    const words = JSON.parse(root.dataset.words || "{}");
    const id = root.dataset.changes;
    const note = root.querySelector<HTMLElement>("[data-note]");
    const tell = (t: string) => { if (note) { note.textContent = t; note.hidden = false; } };
    const csrf = () => document.cookie.split("; ").find((c) => c.startsWith("shruti_csrf="))?.split("=")[1] ?? "";
    const post = (path: string, body?: unknown) => fetch(path, { method: "POST", headers: { "content-type": "application/json", "x-csrf-token": csrf() }, body: body === undefined ? undefined : JSON.stringify(body) });
    const field = root.querySelector<HTMLTextAreaElement>("[data-decline-note]");
    const declineBtn = root.querySelector<HTMLButtonElement>("[data-decline]");
    /* The decline button waits for a reason. */
    field?.addEventListener("input", () => { if (declineBtn) declineBtn.disabled = !field.value.trim(); });
    root.querySelector("[data-accept]")?.addEventListener("click", async () => {
      const r = await post(`/api/guides/mine/by-id/${id}/accept`);
      if (r.ok) { tell(words.accepted); root.querySelector<HTMLElement>(".call")?.remove(); return; }
      tell(r.status === 409 ? words.openDraft : words.failed);
    });
    root.querySelector<HTMLFormElement>("[data-decline-form]")?.addEventListener("submit", async (ev) => {
      ev.preventDefault();
      const text = (field?.value || "").trim();
      if (!text) { tell(words.needNote); return; }
      const r = await post(`/api/guides/mine/by-id/${id}/decline`, { note: text });
      if (r.ok) { tell(words.declined); root.querySelector<HTMLElement>(".call")?.remove(); return; }
      tell(words.failed);
    });
  }
</script>

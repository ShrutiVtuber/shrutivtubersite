---
/* An author (board W10): the name the catalogue prints, what they have
 * published — guide, licence, status, votes — and Block author, which is
 * the practice room's block. No avatar, no follower count: this site is
 * not that.
 */
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { account, asReader } from "../../../lib/account";
import { copy } from "../../../lib/copy";

const say = await copy("guides/by/[id]");
const id = Astro.params.id ?? "";
if (!/^\d{1,12}$/.test(id)) return Astro.rewrite("/404");
const me = await account(Astro);
const read = await asReader(Astro, `/api/guides/by/${id}`);
if (!read.ok) return Astro.rewrite("/404");
const author = read.body as {
  id: number; name: string; own: boolean; published: number; votes: number; contributed: number;
  guides: { id: number; slug: string; title: string; game: { slug: string; name: string }; licence: string; status: string; votes: number }[];
};
const statusWord = (s: string) =>
  s === "published" ? say("status.published", "published")
  : s === "in review" ? say("status.review", "in review")
  : s === "update in review" ? say("status.update", "update in review")
  : say("status.hidden", "hidden");
const WORDS = { blocked: say("words.blocked", "Blocked. Their guides stay in the catalogue; you will not see them in the practice room."), failed: say("words.failed", "That did not go through. Try again.") };
---

<BaseLayout title={`${author.name} — ${say("meta.title", "Squirrel Guides")}`} description={say("meta.description", "What {name} has published.").replace("{name}", author.name)}>
  <article class="page author" data-author={author.id} data-words={JSON.stringify(WORDS)}>
    <header class="head">
      <p class="eyebrow">{say("head.eyebrow", "Author")}</p>
      <h1>{author.name}</h1>
      <p class="mono meta">
        {say("head.published", "{n} published").replace("{n}", String(author.published))}
        <span class="rose"> · ● {say("head.votes", "{n} votes").replace("{n}", String(author.votes))}</span>
      </p>
    </header>

    <p class="note" data-note hidden></p>

    <div class="grid" role="table">
      <div class="tr th" role="row">
        <span role="columnheader">{say("col.guide", "Guide")}</span>
        <span role="columnheader">{say("col.licence", "Licence")}</span>
        <span role="columnheader">{say("col.status", "Status")}</span>
        <span role="columnheader" class="right">{say("col.votes", "Votes")}</span>
      </div>
      {author.guides.map((g) => (
        <a class="tr" role="row" href={g.status === "published" || g.status === "update in review" ? `/guides/${g.game.slug}/${g.slug}` : `/guides/${g.game.slug}`}>
          <span role="cell"><span class="title">{g.title}</span><span class="game mono">{g.game.name}</span></span>
          <span class="mono" role="cell">{g.licence || "—"}</span>
          <span class="mono" role="cell">{statusWord(g.status)}</span>
          <span class="mono rose right" role="cell">{g.votes}</span>
        </a>
      ))}
      {author.guides.length === 0 && <p class="quiet">{say("none", "Nothing published yet.")}</p>}
    </div>

    {author.contributed > 0 && (
      <p class="quiet">{(author.contributed === 1 ? say("contributed.one", "Contributed one correction to a guide by somebody else.") : say("contributed.many", "Contributed {n} corrections to guides by other people.")).replace("{n}", String(author.contributed))}</p>
    )}

    {me && !author.own && (
      <p class="block">
        <button type="button" class="link" data-block>{say("block.button", "Block author")}</button>
        <span class="quiet"> {say("block.text", "Blocking hides this person from you in the practice room. Their guides stay in the catalogue for everyone.")}</span>
      </p>
    )}
  </article>
</BaseLayout>

<style>
  .author { max-width: 620px; margin: 0 auto; padding: var(--space-6) var(--space-4); display: grid; gap: var(--space-5); }
  .eyebrow { font-size: .8rem; letter-spacing: .14em; text-transform: uppercase; color: var(--ink-soft); margin: 0 0 var(--space-1); }
  h1 { font-size: 1.9rem; line-height: 1.15; margin: 0; text-wrap: balance; }
  .mono { font-family: var(--font-mono); font-variant-numeric: tabular-nums; font-size: .9rem; }
  .meta { color: var(--ink-soft); margin: var(--space-2) 0 0; }
  .rose { color: var(--rose, #E0A4BC); }
  .quiet { color: var(--ink-soft); }
  .note { border-left: 2px solid var(--accent); padding-left: var(--space-3); }
  .grid { border-top: 1px solid var(--rule); }
  .tr { display: grid; grid-template-columns: 1fr 7rem 8rem 4rem; gap: var(--space-3); padding: var(--space-3) 0; border-bottom: 1px solid var(--rule); color: inherit; text-decoration: none; align-items: baseline; }
  .th { font-size: .8rem; letter-spacing: .1em; text-transform: uppercase; color: var(--ink-soft); }
  .title { display: block; font-weight: 600; }
  .game { display: block; color: var(--ink-soft); }
  .right { text-align: right; }
  @media (max-width: 560px) { .tr { grid-template-columns: 1fr 4rem; } .tr span:nth-child(2), .tr span:nth-child(3) { display: none; } }
  .link { font: inherit; background: none; border: 0; padding: 0; color: var(--accent); text-decoration: underline; cursor: pointer; }
</style>

<script>
  const root = document.querySelector<HTMLElement>("[data-author]");
  if (root) {
    const words = JSON.parse(root.dataset.words || "{}");
    const note = root.querySelector<HTMLElement>("[data-note]");
    const csrf = () => document.cookie.split("; ").find((c) => c.startsWith("shruti_csrf="))?.split("=")[1] ?? "";
    root.querySelector("[data-block]")?.addEventListener("click", async (ev) => {
      const r = await fetch("/api/practice/blocks", { method: "POST", headers: { "content-type": "application/json", "x-csrf-token": csrf() }, body: JSON.stringify({ user_id: Number(root.dataset.author) }) });
      if (note) { note.textContent = r.ok ? words.blocked : words.failed; note.hidden = false; }
      if (r.ok) (ev.currentTarget as HTMLButtonElement).disabled = true;
    });
  }
</script>

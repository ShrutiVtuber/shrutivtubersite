---
/* A game's guides: an almanac table, not a card grid (board W2).
 *
 * Six facts per guide, all comparable down a column. This is the page where
 * "is this still current?" gets answered, so the patch a guide was written
 * for sits next to when it was published, and nothing is hidden for being
 * old — the patch is a column, and the reader decides.
 */
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { site } from "../../../lib/api";
import { asReader } from "../../../lib/account";
import type { GuideSummary } from "../../../lib/guides";
import { copy } from "../../../lib/copy";

const say = await copy("guides/[game]");
const slug = Astro.params.game ?? "";
if (!/^[a-z0-9-]{1,80}$/.test(slug)) return Astro.rewrite("/404");

interface Game { id: number; slug: string; name: string; variants: { id: string; name: string }[]; guides: number }
const games = await site<Game[]>("/api/guides/games");
const game = (games ?? []).find((g) => g.slug === slug);
if (!game) return Astro.rewrite("/404");

const read = await asReader(Astro, `/api/guides?sort=top&game=${slug}&limit=200`);
const guides: GuideSummary[] = read.ok && Array.isArray(read.body) ? read.body : [];
const variants = game.variants ?? [];

const day = (iso: string | null) =>
  iso ? new Date(iso).toLocaleDateString("en-GB", { day: "numeric", month: "short", year: "numeric", timeZone: "UTC" }) : "";
---

<BaseLayout
  title={`${game.name} — ${say("meta.suffix", "Shruti's Guides")}`}
  description={say("meta.description", "Every guide for this game, with the patch each was written for.")}
>
  <div class="page gg">
    <p class="gg-crumb"><a href="/guides">{say("crumb", "Guides")}</a><span aria-hidden="true">/</span><span>{game.name}</span></p>

    <div class="gg-head">
      <div class="gg-art">
        <span class="gg-art-label">{say("art.empty", "art slot · empty")}</span>
        <span class="gg-art-name">{game.name}</span>
      </div>
      <div class="gg-intro">
        <h1 class="gg-title">{game.name}</h1>
        <p class="gg-lede">
          {guides.length} {guides.length === 1 ? say("count.one", "guide.") : say("count.many", "guides.")}
          {variants.length > 0 && <> {say("variants.a", "The game declares")} {variants.length} {say("variants.b", "ways to play")} — {variants.map((v) => v.name).join(" · ")} — {say("variants.c", "and every guide says which of them each step is for.")}</>}
        </p>
      </div>
    </div>

    <div class="gg-table" role="table">
      <div class="gg-tr gg-th" role="row">
        <span role="columnheader">{say("col.guide", "Guide")}</span>
        <span role="columnheader">{say("col.author", "Author")}</span>
        <span role="columnheader">{say("col.published", "Published")}</span>
        <span role="columnheader">{say("col.patch", "Patch")}</span>
        <span role="columnheader">{say("col.path", "Path")}</span>
        <span role="columnheader" class="right">{say("col.votes", "Votes")}</span>
      </div>
      {guides.map((g) => (
        <a class="gg-tr" role="row" href={`/guides/${game.slug}/${g.slug}`}>
          <span class="gg-guide" role="cell">
            <span class="gg-guide-title">{g.title}</span>
            {g.summary && <span class="gg-guide-sum">{g.summary}</span>}
          </span>
          <span class="gg-mono" role="cell">{g.author}</span>
          <span class="gg-mono" role="cell">{day(g.publishedAt)}</span>
          <span class="gg-mono" role="cell">{g.gamePatch || "—"}</span>
          <span class="gg-mono" role="cell">{g.phases}{g.hours > 0 && <> · ~{g.hours} h</>}</span>
          <span class="gg-mono rose right" role="cell">{g.votes}</span>
        </a>
      ))}
      {guides.length === 0 && <p class="gg-quiet">{say("none", "Nothing published for this game yet.")}</p>}
    </div>
    <p class="gg-note">{say("note", "A guide written for an older patch is not hidden — the patch it was written for is a column, and you decide.")}</p>
  </div>
</BaseLayout>

<style>
  .gg { padding-block: var(--space-6) var(--space-9); display: flex; flex-direction: column; gap: 22px; font-family: var(--font-body); }
  .gg-crumb { margin: 0; display: flex; align-items: center; gap: 10px; font-family: var(--font-mono); font-size: 12.5px; color: var(--ink-faint); }
  .gg-crumb a { color: var(--accent); text-decoration: none; }
  .gg-crumb > span:last-child { color: var(--ink); }
  .gg-head { display: flex; align-items: flex-end; gap: 28px; flex-wrap: wrap; }
  .gg-art { flex: none; width: 280px; height: 160px; border: var(--border-w) solid var(--line); border-radius: var(--radius-md); background: var(--surface-inset); position: relative; display: flex; align-items: flex-end; padding: 16px; }
  .gg-art-label { position: absolute; top: 12px; right: 14px; font-family: var(--font-mono); font-size: 10px; letter-spacing: .1em; text-transform: uppercase; color: var(--ink-faint); }
  .gg-art-name { font-family: var(--font-display); font-size: 26px; font-weight: 600; color: var(--ink); }
  .gg-intro { flex: 1; min-width: 260px; display: flex; flex-direction: column; gap: 10px; padding-bottom: 6px; }
  .gg-title { margin: 0; font-family: var(--font-display); font-size: 38px; line-height: 1.1; font-weight: 500; color: var(--ink); }
  .gg-lede { margin: 0; max-width: 62ch; font-family: var(--font-display); font-size: 17px; line-height: 1.65; color: var(--ink-soft); }
  .gg-table { display: flex; flex-direction: column; margin-top: 18px; overflow-x: auto; }
  .gg-tr { display: grid; grid-template-columns: minmax(0, 3fr) 1fr 1fr 1fr 1fr auto; gap: 0 24px; align-items: baseline; padding: 18px 0; border-bottom: var(--border-w) solid var(--line); text-decoration: none; color: inherit; min-width: 760px; }
  .gg-th { padding: 0 0 12px; border-bottom: var(--border-w) solid var(--line-strong); }
  .gg-th span { font-size: var(--text-micro); font-weight: 600; letter-spacing: var(--tracking-eyebrow); text-transform: uppercase; color: var(--ink-faint); }
  .right { text-align: right; }
  .gg-guide { display: flex; flex-direction: column; gap: 4px; }
  .gg-guide-title { font-family: var(--font-display); font-size: 20px; font-weight: 600; color: var(--ink); }
  a.gg-tr:hover .gg-guide-title { text-decoration: underline; }
  .gg-guide-sum { font-size: 13.5px; color: var(--ink-soft); }
  .gg-mono { font-family: var(--font-mono); font-size: 13px; color: var(--ink-soft); font-variant-numeric: tabular-nums; }
  .gg-mono.rose { color: var(--rose); }
  .gg-quiet { margin: 0; padding: 18px 0; font-size: var(--text-sm); color: var(--ink-faint); }
  .gg-note { margin: 0; font-family: var(--font-mono); font-size: var(--text-xs); color: var(--ink-faint); }
</style>

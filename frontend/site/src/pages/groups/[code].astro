---
/* A group (board Group, 20 Sep 2026): the goal's tiers are the sigil's parts,
 * and an almanac index beneath the head. The crew is listed by size with
 * "and N others" — no rank numbers and no medals, so a small contribution is
 * never the bottom of a leaderboard. Contribute is one stepper and one
 * button in a console frame. Reading needs no account; joining and
 * contributing do. The goal on stream is a console with theme tiles; the
 * URL is shown once.
 */
import BaseLayout from "../../layouts/BaseLayout.astro";
import Sigil from "../../components/guides/Sigil.astro";
import StateDot from "../../components/guides/StateDot.astro";
import Console from "../../components/guides/Console.astro";
import ThemeTiles from "../../components/guides/ThemeTiles.astro";
import Plate from "../../components/guides/Plate.astro";
import SelectField from "../../components/forms/SelectField.astro";
import TextField from "../../components/forms/TextField.astro";
import Button from "../../components/forms/Button.astro";
import { account, asReader } from "../../lib/account";
import { copy } from "../../lib/copy";
import PublishConsent from "../../components/feedback/PublishConsent.astro";

const say = await copy("groups/[code]");
const code = (Astro.params.code ?? "").toUpperCase();
if (!/^[A-Z]{6}$/.test(code)) return Astro.rewrite("/404");

const me = await account(Astro);
const read = await asReader(Astro, `/api/groups/${code}`);
if (!read.ok) return Astro.rewrite("/404");
type Row = { who: string; amount: number };
const g = read.body as {
  code: string; name: string; goal: string; target: number; tiers: number; total: number; tier: number; members: number; closed: boolean;
  contributions: Row[]; others: { count: number; amount: number }; sigil: { pct: number; state: string }[]; member: boolean; owner: boolean; since: string | null;
};
const tokensRead = me && g.member ? await asReader(Astro, `/api/groups/${code}/overlays`) : null;
type Token = { id: number; theme: string; motion?: string; label: string; lastSeen?: string | null };
const tokens: Token[] = tokensRead?.ok && Array.isArray(tokensRead.body) ? tokensRead.body : [];

const n = (v: number) => v.toLocaleString("en-GB");
const SMALL = ["zero", "one", "two", "three", "four", "five", "six", "seven", "eight", "nine", "ten", "eleven", "twelve"];
const few = (v: number) => (v >= 0 && v < SMALL.length ? SMALL[v] : String(v));
const since = g.since ? new Date(g.since).toLocaleDateString("en-GB", { day: "numeric", month: "short" }) : "";
const per = g.tiers > 0 ? g.target / g.tiers : g.target;
const filled = Math.min(g.tiers, g.tier);
const onTier = g.total >= g.target ? g.tiers : Math.min(g.tiers, filled + 1);
const headLine = [
  `${n(g.total)} / ${n(g.target)}`,
  say("head.tier", "tier {tier} of {tiers}").replace("{tier}", String(onTier)).replace("{tiers}", String(g.tiers)),
  g.members === 1 ? say("head.crew_one", "1 in the crew") : say("head.crew", "{n} in the crew").replace("{n}", String(g.members)),
].join(" · ");
/* Each tier as a row: filled, the one in progress with what is in it, or its range. */
const tiersIndex = Array.from({ length: g.tiers }, (_, i) => {
  const idx = i + 1, start = Math.round(i * per), end = Math.round(idx * per);
  const state = idx <= filled ? "done" : idx === filled + 1 && g.total < g.target ? "now" : "open";
  const right = state === "done" ? say("tiers.filled", "filled") : state === "now" ? say("tiers.in", "{n} in").replace("{n}", n(Math.max(0, g.total - start))) : `${n(start + 1)}–${n(end)}`;
  return { idx, state, right };
});
const othersLine = (g.others.count === 1 ? say("crew.one_other", "and one other") : say("crew.others", "and {n} others").replace("{n}", few(g.others.count)));
const themeWord = (t: string) => (t === "grimoire" ? say("theme.grimoire", "Grimoire") : t === "plain" ? say("theme.plain", "Plain") : say("theme.almanac", "Almanac"));
const motionWord = (m?: string) => (m === "full" ? say("motion.full_word", "full") : m === "still" ? say("motion.still_word", "still") : say("motion.reduced_word", "reduced"));
const seenWord = (t: Token) => {
  if (!t.lastSeen) return say("token.idle", "idle");
  const ago = Date.now() - new Date(t.lastSeen).getTime();
  return ago < 15000 ? say("token.drawing", "drawing, seen just now") : say("token.idle_since", "idle since {date}").replace("{date}", new Date(t.lastSeen).toLocaleDateString("en-GB", { day: "numeric", month: "short" }));
};
const WORDS = {
  closed: say("words.closed", "This group is closed."),
  failed: say("words.failed", "That did not go through. Try again."),
  oneNumber: say("words.one_number", "One number, one or more."),
  joinFirst: say("words.join_first", "Join the group first."),
  copied: say("words.copied", "Copied."),
  goalOverlay: say("words.goal_overlay", "Goal overlay"),
  revoke: say("words.revoke", "Revoke"),
  themes: { almanac: themeWord("almanac"), grimoire: themeWord("grimoire"), plain: themeWord("plain") },
  motions: { full: motionWord("full"), reduced: motionWord("reduced"), still: motionWord("still") },
  drawing: say("token.drawing", "drawing, seen just now"), idle: say("token.idle", "idle"),
};
---

<BaseLayout title={`${g.name} — ${say("meta.title", "Squirrel Guides")}`} description={g.goal || g.name} noindex>
  <article class="page group" data-group data-code={g.code} data-words={JSON.stringify(WORDS)}>
    <header class="head">
      <Sigil n={Math.max(1, g.tiers)} done={filled} size={160} ring label={n(g.total)}
        aria={say("head.sigil_aria", "{filled} of {tiers} tiers filled").replace("{filled}", String(filled)).replace("{tiers}", String(g.tiers))} />
      <span class="gd-eyebrow">{g.name} · <span class="code">{g.code}</span></span>
      <h1>{g.goal || g.name}</h1>
      <span class="gd-mono gd-soft line">{headLine}{g.closed && ` · ${say("head.closed", "closed")}`}</span>
    </header>

    <p class="gd-rule-note" data-note hidden></p>

    <section class="block" aria-labelledby="tiers">
      <div class="block-head"><span id="tiers" class="gd-eyebrow">{say("tiers.title", "Tiers")}</span><span class="gd-note">{say("tiers.each", "{n} each").replace("{n}", n(Math.round(per)))}</span></div>
      <ol class="tiers">
        {tiersIndex.map((t) => (
          <li data-state={t.state}>
            <StateDot state={t.state} />
            <span class="tier-name"><span class="tier-word">{say("tiers.tier", "Tier {n}").replace("{n}", String(t.idx))}</span><span class="gd-lead" aria-hidden="true"></span></span>
            <span class="gd-mono tier-right">{t.right}</span>
          </li>
        ))}
      </ol>
    </section>

    <section class="block" aria-labelledby="contrib">
      <div class="block-head"><span id="contrib" class="gd-eyebrow">{say("crew.title", "Contributions")}</span>{since && <span class="gd-note">{say("crew.since", "since {date}").replace("{date}", since)}</span>}</div>
      {g.contributions.length === 0 && g.others.count === 0 ? (
        <p class="gd-hint">{say("crew.none", "Nothing yet. The first number opens the first tier.")}</p>
      ) : (
        <ul class="gd-index crew">
          {g.contributions.map((c) => (<li><span>{c.who}</span><span class="gd-lead" aria-hidden="true"></span><span class="gd-val">{n(c.amount)}</span></li>))}
          {g.others.count > 0 && <li><span class="gd-soft">{othersLine}</span><span class="gd-lead" aria-hidden="true"></span><span class="gd-val">{n(g.others.amount)}</span></li>}
        </ul>
      )}
    </section>

    {me && g.member && !g.closed && (
      <Console as="section" eyebrow={say("give.title", "Contribute")} class="give">
        <div class="give-row">
          <span class="stepper">
            <button type="button" class="step" data-less aria-label={say("give.less", "One less")}>−</button>
            <input type="number" min="1" step="1" value="10" data-amount aria-label={say("give.amount", "Amount")} />
            <button type="button" class="step" data-more aria-label={say("give.more", "One more")}>+</button>
          </span>
          <Button type="button" data-contribute>{say("give.button", "Contribute")}</Button>
        </div>
        <p class="gd-hint">{say("give.rule", "One number. Nobody is ranked, and nobody is reminded.")}</p>
      </Console>
    )}

    <p class="nothing-else">{say("join.nothing_else", "A group has a goal and nothing else — no path, no steps, no schedule.")}</p>

    <div class="membership">
      {!me && (
        <>
          <span class="gd-soft small">{say("join.code_line", "Join with the code {code}.").replace("{code}", g.code)}</span>
          <Button href={`/signin?next=${encodeURIComponent(`/groups/${g.code}`)}`} size="sm">{say("join.signin", "Sign in to join")}</Button>
        </>
      )}
      {me && !g.member && !g.closed && (
        <>
          <span class="gd-soft small">{say("join.code_line", "Join with the code {code}.").replace("{code}", g.code)}</span>
          <Button type="button" size="sm" data-join>{say("join.button", "Join")}</Button>
        </>
      )}
      {me && g.member && (
        <>
          <span class="gd-soft small">{g.owner ? say("join.you_started", "You started this group.") : say("join.you_are_in", "You are in this group.")}</span>
          <span class="actions">
            {g.owner && <Button type="button" variant="ghost" size="sm" data-close={g.closed ? "0" : "1"}>{g.closed ? say("join.reopen", "Reopen the group") : say("join.close", "Close the group")}</Button>}
            {!g.owner && <Button type="button" variant="ghost" size="sm" data-leave>{say("join.leave", "Leave")}</Button>}
          </span>
        </>
      )}
    </div>

    {me && g.member && (
      <Console as="form" eyebrow={say("overlay.title", "The goal on stream")} class="overlay" data-overlay-form>
        <fieldset class="themes">
          <legend>{say("overlay.theme", "Theme")}</legend>
          <ThemeTiles name="theme" value="almanac" preset="goal"
            themes={[{ value: "almanac", label: themeWord("almanac") }, { value: "grimoire", label: themeWord("grimoire") }, { value: "plain", label: themeWord("plain") }]}
            note={say("overlay.theme_note", "A theme is a skin. The four state colours are the same in all three.")} />
        </fieldset>
        <SelectField label={say("overlay.motion", "Motion")} name="motion" data-motion value="reduced"
          options={[{ value: "reduced", label: say("overlay.reduced", "Reduced — an instant fill") }, { value: "full", label: say("overlay.full", "Arc fills on contribution · 600 ms") }, { value: "still", label: say("overlay.still", "Still") }]} />
        <div><Button type="button" data-mint>{say("overlay.mint", "Make an overlay")}</Button></div>
        <p class="gd-hint">{say("overlay.once_line", "This URL is shown once. The token is the secret: anyone with the URL sees the goal; nobody with it can contribute to it.")}</p>
        <div class="gd-once" data-minted hidden>
          <span class="gd-eyebrow">{say("overlay.shown_once", "Shown once")}</span>
          <TextField label={say("overlay.url", "Browser source URL")} name="url" readonly data-url />
          <div class="gd-once-row"><Button type="button" variant="secondary" size="sm" data-copy>{say("overlay.copy", "Copy")}</Button><Button type="button" variant="ghost" size="sm" data-have-it>{say("overlay.have_it", "I have it")}</Button></div>
        </div>
        <ul class="gd-tokens" data-tokens hidden={tokens.length === 0}>
          {tokens.map((t) => (
            <li class="gd-token" data-token-row>
              <Plate theme={t.theme} elements="goal" width={56} aria={themeWord(t.theme)} />
              <span class="gd-token-text"><span class="gd-token-label">{t.label || say("words.goal_overlay", "Goal overlay")}</span><span class="gd-note">{themeWord(t.theme)} · {motionWord(t.motion)} · {seenWord(t)}</span></span>
              <Button type="button" variant="ghost" size="sm" data-revoke={t.id}>{say("overlay.revoke", "Revoke")}</Button>
            </li>
          ))}
        </ul>
      </Console>
    )}
  </article>
  {me && <PublishConsent />}
</BaseLayout>

<style>
  .group { max-width: 620px; margin: 0 auto; padding-block: var(--space-6) var(--space-9); display: grid; gap: var(--space-7); width: 100%; }
  .head { display: grid; justify-items: center; text-align: center; gap: 12px; }
  .head .code { letter-spacing: .22em; }
  .head h1 { margin: 0; font-family: var(--font-display); font-size: 36px; font-weight: 600; line-height: 1.15; letter-spacing: -0.01em; text-wrap: pretty; }
  .head .line { font-size: 14px; }
  .block { display: grid; gap: 8px; }
  .block-head { display: flex; justify-content: space-between; align-items: baseline; border-bottom: 1px solid var(--line-strong); padding-bottom: 8px; }
  .tiers { margin: 0; padding: 0; list-style: none; display: grid; }
  .tiers li { display: grid; grid-template-columns: 15px 1fr auto; gap: 12px; align-items: center; padding: 10px 0; border-bottom: 1px solid var(--line); font-size: 15px; }
  .tier-name { display: flex; align-items: baseline; gap: 10px; min-width: 0; }
  .tier-name .gd-lead { flex: 1; border-bottom: 1px dotted var(--line-strong); transform: translateY(-4px); }
  .tiers li[data-state="done"] .tier-word { color: var(--ink-soft); }
  .tiers li[data-state="now"] .tier-word { font-weight: 600; }
  .tiers li[data-state="open"] .tier-word { color: var(--ink-faint); }
  .tier-right { white-space: nowrap; }
  .tiers li[data-state="done"] .tier-right { color: var(--rose); }
  .tiers li[data-state="now"] .tier-right { color: var(--accent); }
  .tiers li[data-state="open"] .tier-right { color: var(--ink-faint); }
  .crew li { font-size: 15px; }
  .give { gap: 12px; }
  .give-row { display: flex; flex-wrap: wrap; align-items: center; gap: 12px; }
  .stepper { display: flex; align-items: center; gap: 6px; font-family: var(--font-mono); font-size: 18px; font-variant-numeric: tabular-nums; }
  .stepper input { width: 6ch; text-align: center; font: inherit; color: var(--ink); background: var(--surface-card); border: 1px solid var(--line); border-radius: 4px; min-height: 44px; padding: 0 6px; box-sizing: border-box; appearance: textfield; -moz-appearance: textfield; }
  .stepper input::-webkit-outer-spin-button, .stepper input::-webkit-inner-spin-button { -webkit-appearance: none; margin: 0; }
  .step { width: 44px; height: 44px; border-radius: 4px; border: 1px solid var(--line); background: var(--surface-card); color: var(--ink); font: inherit; cursor: pointer; }
  .step:hover { border-color: var(--line-strong); }
  .nothing-else { margin: 0; font-family: var(--font-display); font-size: 17px; line-height: 1.6; color: var(--ink-soft); text-wrap: pretty; }
  .membership { display: flex; flex-wrap: wrap; gap: 12px; align-items: center; justify-content: space-between; padding-top: 16px; border-top: 1px solid var(--line); }
  .membership:empty { display: none; }
  .small { font-size: 14px; }
  .actions { display: flex; gap: 8px; }
  .themes { border: 0; padding: 0; margin: 0; display: grid; gap: 8px; }
  .themes legend { font-size: 14px; font-weight: 600; padding: 0; margin-bottom: 8px; }
</style>

<script>
  import { mountGroup } from "../../lib/groups";
  const root = document.querySelector<HTMLElement>("[data-group]");
  if (root) mountGroup(root);
</script>

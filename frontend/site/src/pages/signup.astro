---
/* Sign up — ported from `ui_kits/site/Auth.jsx`.
 *
 * Longer than a normal form, deliberately. Three decisions, three
 * checkboxes, none pre-ticked, and yes to one with no to another is possible.
 * Only the account agreement can block the submit.
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionHeader from "../components/brand/SectionHeader.astro";
import TextField from "../components/forms/TextField.astro";
import ConsentCheckbox from "../components/forms/ConsentCheckbox.astro";
import CsrfField from "../components/forms/CsrfField.astro";
import Button from "../components/forms/Button.astro";
import EmptyState from "../components/feedback/EmptyState.astro";
import { CONSENTS } from "../lib/consents";
import { SITE_API } from "../lib/api";
import { verifyCsrf } from "../lib/csrf";
import { copy } from "../lib/copy";
import Copy from "../components/content/Copy.astro";

/* Every word on this page, editable from the admin. The defaults below are
   what it was written with and what still renders if nothing was changed. */
const say = await copy("signup");


let done = false;
let failed = "";
const errors: Record<string, string> = {};
const values = { email: "", name: "", password: "" };
const given: Record<string, boolean> = {};

if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  if (!verifyCsrf(Astro.cookies, form)) {
    failed = say("error.retry", "That did not send. Reload the page and try again.");
  } else {
    values.email = String(form.get("email") ?? "").trim();
    values.name = String(form.get("name") ?? "").trim();
    values.password = String(form.get("password") ?? "");
    for (const c of CONSENTS) given[c.kind] = form.get(`consent_${c.kind}`) === "1";

    if (!/^\S+@\S+\.\S+$/.test(values.email)) errors.email = say("text.that.address.doesn", "That address doesn’t look complete.");
    if (values.password && values.password.length < 10) {
      errors.password = say("text.characters.more.leave", "Ten characters or more, or leave it blank and use a sign-in link.");
    }
    /* The ONLY consent that can produce an error. */
    if (!given.account) {
      errors.account = say("text.account.itself.needs", "The account itself needs this one — there is nothing to sign in to without it.");
    }

    if (Object.keys(errors).length === 0) {
      try {
        const response = await fetch(`${SITE_API}/api/account/signup`, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            email: values.email,
            password: values.password || null,
            display_name: values.name,
            consents: CONSENTS.map((c) => ({ kind: c.kind, granted: !!given[c.kind] })),
          }),
        });
        if (response.ok) {
          const cookie = response.headers.get("set-cookie");
          if (cookie) Astro.response.headers.append("set-cookie", cookie);
          done = true;
        } else {
          const body = await response.json().catch(() => null);
          failed = body?.detail ?? say("error.failed2", "That did not go through.");
        }
      } catch {
        failed = say("error.failed", "That did not go through.");
      }
    }
  }
}
---

<BaseLayout title={say("text.2", "Sign up — Shruti")} description={say("text.3", "An account for your own chart and your own reading. Nothing public.")} noindex>
  <div class="page auth">
    <SectionHeader
      as="h1" glyph="☾︎" eyebrow="Sign up" title={say("text.10", "An account")}
      body={say("text.4", "For keeping your own chart and reading your own horoscope. Nothing here is public — no profile, no avatar, no follower count.")}
    />

    {
      done ? (
        <EmptyState glyph="☾︎" title={say("text.11", "You're in")} body={say("text.5", "The account is made. Where would you like to start?")}>
          <div slot="action" class="auth-actions">
            <Button href="/nativity">{say("text.8", "Add a nativity")}</Button>
            <Button variant="secondary" href="/today">{say("text.9", "See today")}</Button>
          </div>
        </EmptyState>
      ) : (
        <form method="POST" novalidate class="auth-form">
          <CsrfField />
          {failed && <p class="auth-failed" role="alert">{failed}</p>}

          <TextField label={say("text.12", "Email")} name="email" type="email" required value={values.email} error={errors.email} autocomplete="email" />
          <TextField label={say("text.13", "Name")} name="name" optionalLabel value={values.name} hint={say("text.6", "Only ever shown back to you.")} autocomplete="name" />
          <TextField
            label={say("text.14", "Password")} name="password" type="password" optionalLabel
            value="" error={errors.password} autocomplete="new-password"
            hint={say("text.7", "Leave it blank to sign in by emailed link instead.")}
          />

          <div class="consents">
            <h2>{say("three-decisions.1", "Three decisions")}</h2>
            <p class="consents-intro">{say("three-decisions.2", "These are separate on purpose. You can say yes to one and no to another, and change any of them later from your account.")}</p>
            {
              CONSENTS.map((c) => (
                <ConsentCheckbox
                  name={`consent_${c.kind}`}
                  label={c.label}
                  basis={c.basis}
                  required={c.required}
                  explanation={c.explanation}
                  wording={c.wording}
                  error={errors[c.kind]}
                />
              ))
            }
          </div>

          <div><Button type="submit" size="lg">{say("three-decisions.3", "Create the account")}</Button></div>
          <p class="auth-alt"><Copy text={say("text.1", "Already have one? [Sign in](/signin).")} /></p>
        </form>
      )
    }
  </div>
</BaseLayout>

<style>
  .auth { max-width: 680px; }
  .auth-form { display: grid; gap: var(--space-5); margin-top: var(--space-6); }
  .consents { display: grid; gap: var(--space-3); }
  .consents h2 { font: 600 var(--text-h3) var(--font-display); color: var(--ink); margin: 0; }
  .consents-intro { font: 400 var(--text-sm) / 1.6 var(--font-body); color: var(--ink-soft); margin: 0 0 4px; max-width: 62ch; }
  .auth-failed { font: 400 var(--text-sm) var(--font-body); color: var(--live); margin: 0; }
  .auth-alt { font: 400 var(--text-sm) var(--font-body); color: var(--ink-soft); margin: 0; }
  .auth-alt a { color: var(--accent); }
  .auth-actions { display: flex; gap: 10px; flex-wrap: wrap; justify-content: center; }
</style>

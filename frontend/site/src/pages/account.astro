---
/* Profile, consents and data — `ui_kits/site/Account.jsx`.
 *
 * Small, and honestly so. The design says out loud on this screen that nothing
 * is public, because that sentence is what stops the feature creeping.
 *
 * Export, delete and change-consent are REAL CONTROLS that work here, not a
 * support address.
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionHeader from "../components/brand/SectionHeader.astro";
import TextField from "../components/forms/TextField.astro";
import SelectField from "../components/forms/SelectField.astro";
import ConsentCheckbox from "../components/forms/ConsentCheckbox.astro";
import CsrfField from "../components/forms/CsrfField.astro";
import Button from "../components/forms/Button.astro";
import { CONSENTS } from "../lib/consents";
import PasskeyList, { type PasskeyRow } from "../components/auth/PasskeyList.astro";
import { account, asReader } from "../lib/account";
import { verifyCsrf } from "../lib/csrf";
import { copy } from "../lib/copy";
import Copy from "../components/content/Copy.astro";

/* Every word on this page, editable from the admin. The defaults below are
   what it was written with and what still renders if nothing was changed. */
const say = await copy("account");


let notice = "";
let failed = "";

if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  if (!verifyCsrf(Astro.cookies, form)) {
    failed = say("error.csrf", "That did not save. Reload the page and try again.");
  } else {
    const action = String(form.get("action") ?? "");

    if (action === "profile") {
      const r = await asReader(Astro, "/api/account/profile", {
        method: "PUT",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          display_name: String(form.get("display_name") ?? ""),
          timezone: String(form.get("timezone") ?? ""),
          reading_language: String(form.get("reading_language") ?? "en"),
          preferred_tradition: String(form.get("preferred_tradition") ?? ""),
          house_system: String(form.get("house_system") ?? ""),
          ayanamsa: String(form.get("ayanamsa") ?? ""),
        }),
      });
      notice = r.ok ? "Saved." : "";
      failed = r.ok ? "" : (r.body?.detail ?? "That did not save.");
    }

    if (action === "stream-name") {
      const r = await asReader(Astro, "/api/billing/me/stream-name", {
        method: "PUT",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ stream_name: String(form.get("stream_name") ?? "") }),
      });
      notice = r.ok ? "Saved. She will read that one." : "";
      failed = r.ok ? "" : (r.body?.detail ?? "That did not save.");
    }

    if (action === "consent") {
      const kind = String(form.get("kind") ?? "");
      const granted = form.get("granted") === "1";
      const r = await asReader(Astro, "/api/account/consents", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ kind, granted }),
      });
      if (r.ok) {
        notice = r.body?.nativityDeleted
          ? say("notice.withdrawn", "Consent withdrawn, and the saved nativity was deleted with it.")
          : "Consent updated.";
      } else {
        failed = r.body?.detail ?? say("error.nochange", "That did not change.");
      }
    }

    if (action === "hosting") {
      /* Stripe's own checkout; the price is the tier's, never the form's. */
      const r = await asReader(Astro, "/api/billing/checkout", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ tier: String(form.get("tier") ?? "") }),
      });
      if (r.ok && r.body?.url) return Astro.redirect(r.body.url);
      failed = r.body?.detail ?? say("error.hosting", "That could not be started. Try again in a moment.");
    }

    if (action === "portal") {
      /* A redirect into Stripe's own portal. Building a cancel screen here
         would mean maintaining a worse copy of one Stripe keeps correct — and
         card details would have to pass through this server to do it. */
      const r = await asReader(Astro, "/api/billing/portal", { method: "POST" });
      if (r.ok && r.body?.url) return Astro.redirect(r.body.url, 303);
      failed = r.body?.detail ?? say("error.portal", "That could not be opened. Try again in a moment.");
    }

    if (action === "signout") {
      /* Told to the backend as well as done here. Clearing the cookie is what
         actually ends the session in this browser — the backend's own
         Set-Cookie would be on a response nobody sees — but the call is still
         made, so a future server-side session store gets the event rather than
         needing this to be remembered then. */
      await asReader(Astro, "/api/account/signout", { method: "POST" });
      Astro.cookies.delete("shruti_reader", { path: "/" });
      return Astro.redirect("/", 303);
    }

    if (action === "delete") {
      const r = await asReader(Astro, "/api/account/", { method: "DELETE" });
      if (r.ok) {
        Astro.cookies.delete("shruti_reader", { path: "/" });
        return Astro.redirect("/account/deleted");
      }
      failed = r.body?.detail ?? say("error.delete", "That did not delete.");
    }
  }
}

const me = await account(Astro);
if (!me) return Astro.redirect("/signin");

const state = Object.fromEntries(me.consents.map((c) => [c.kind, c]));

/* Kept charts. Listed here rather than on a page of their own: this is where
   somebody looks for the things the site is holding for them, and a chart is
   one of those. */
const chartCall = await asReader(Astro, "/api/charts/mine");
const charts: any[] = Array.isArray(chartCall.body) ? chartCall.body : [];

/* Fetched here rather than in the browser so the list is already on the page:
   the passkey CONTROLS need JavaScript, but reading what you have registered
   should not. */
const keys = await asReader(Astro, "/api/passkeys");
const passkeys: PasskeyRow[] = keys.ok ? (keys.body?.passkeys ?? []) : [];

/* ⚠ Who they have blocked, and the only place to undo it. The button is
   pressed in the practice room, in irritation, about a name that may not be
   remembered an hour later — so the undo cannot live beside the thing that is
   now invisible. It lives here, where somebody thinks to look. */
const blockCall = await asReader(Astro, "/api/practice/blocks");
const blocked: { id: number; name: string }[] =
  Array.isArray(blockCall.body) ? blockCall.body : [];

/* Support, if there is any. A 404 here means "not a supporter", which is the
   ordinary case and not a failure — so the card simply does not render. */
const supportRead = await asReader(Astro, "/api/billing/me");
const support = supportRead.ok ? supportRead.body : null;

const renews = (iso: string | null | undefined) =>
  iso ? new Date(iso).toLocaleDateString("en-GB", { day: "numeric", month: "long", year: "numeric" }) : "";

const TIER_NAMES: Record<string, string> = {
  lamplighter: "Lamplighter",
  almanac: "Almanac",
};
const TRADITIONS = [
  { value: "", label: say("pref.both", "No preference — show both") },
  { value: "hellenistic", label: "Hellenistic" },
  { value: "vedic", label: "Vedic" },
];
const [hostingRead, allowanceRead] = await Promise.all([asReader(Astro, "/api/billing/hosting"), asReader(Astro, "/api/overlay/allowance")]);
const hosting = hostingRead.ok ? hostingRead.body as { configured: boolean; testMode: boolean; tiers: { tier: string; name: string; amount: number; currency: string; interval: string }[]; active: boolean; status: string; tier: string; cancelAtPeriodEnd: boolean; currentPeriodEnd: string | null; canManage: boolean } : null;
const allowance = allowanceRead.ok ? allowanceRead.body as { tier: string; tokens: number; tokensLimit: number | null; hoursThisMonth: number; hoursLimit: number | null; over: boolean; tokensFull: boolean } : null;
const money = (cents: number, currency: string) => (currency === "EUR" ? "€" : currency + " ") + (cents % 100 === 0 ? String(cents / 100) : (cents / 100).toFixed(2));
const monthly = hosting?.tiers.find((t) => t.interval === "month") ?? null;
const yearly = hosting?.tiers.find((t) => t.interval === "year") ?? null;
const hostingRenews = hosting?.currentPeriodEnd ? new Date(hosting.currentPeriodEnd).toLocaleDateString("en-GB", { day: "numeric", month: "long", year: "numeric" }) : "";
const hostingStarted = Astro.url.searchParams.get("hosting") === "started";
const tokensRead = await asReader(Astro, "/api/overlay/mine");
const guideTokens: { id: number; kind: string; label: string; showing: string; href: string; theme: string; live: boolean; hoursThisMonth: number }[] =
  tokensRead.ok && Array.isArray(tokensRead.body) ? tokensRead.body : [];
const kindWord = (k: string) =>
  k === "guide-now" ? say("tokens.kind.now", "now card") : k === "guide-sigil" ? say("tokens.kind.sigil", "sigil")
  : k === "guide-path" ? say("tokens.kind.path", "path strip") : k === "guide-routine" ? say("tokens.kind.routine", "routine")
  : k === "guide-goal" ? say("tokens.kind.goal", "goal") : say("tokens.kind.layout", "layout");
const themeWord = (t: string) => t === "grimoire" ? say("tokens.theme.grimoire", "Grimoire") : t === "plain" ? say("tokens.theme.plain", "Plain") : say("tokens.theme.almanac", "Almanac");
---

<BaseLayout title={say("text.1", "Your account — Shruti")} description={say("text.2", "Profile, consents and your data.")} noindex>
  <div class="page account">
    <SectionHeader
      as="h1" glyph="☾︎" eyebrow="Account" title={me.displayName || me.email}
      body={say("text.3", "Nothing here is public. There is no profile page, no avatar and no follower count — this site is not that, and saying so is what keeps it that way.")}
    />

    {notice && <p class="notice" role="status">{notice}</p>}
    {failed && <p class="failed" role="alert">{failed}</p>}

    <section class="card">
      <h2>{say("profile.1", "Profile")}</h2>
      <form method="POST" class="stack">
        <CsrfField />
        <input type="hidden" name="action" value="profile" />
        <TextField label={say("text.4", "Display name")} name="display_name" value={me.displayName} optionalLabel hint={say("text.5", "Only ever shown back to you.")} />
        <TextField label={say("text.21", "Timezone")} name="timezone" value={me.timezone} optionalLabel hint={say("text.6", "IANA name, e.g. Europe/Athens.")} />
        <SelectField label={say("text.7", "Preferred tradition")} name="preferred_tradition" value={me.preferredTradition} options={TRADITIONS} />
        <TextField label={say("text.8", "House system")} name="house_system" value={me.houseSystem} optionalLabel />
        <TextField label={say("text.22", "Ayanāṁśa")} name="ayanamsa" value={me.ayanamsa} optionalLabel />
        <div><Button type="submit">{say("text.14", "Save")}</Button></div>
      </form>
    </section>

    <section class="card">
      <h2>{say("nativity.1", "Nativity")}</h2>
      {
        me.nativity ? (
          <div class="nativity">
            <p class="nat-line">
              <span class="t-tabular">{me.nativity.birthDate}</span>
              {me.nativity.timeUnknown
                ? <span class="undef">{say("nativity.2", "· birth time unknown")}</span>
                : <span class="t-tabular"> · {me.nativity.birthTime}</span>}
            </p>
            <p class="nat-place">
              {me.nativity.placeName || "—"}
              <span class="t-tabular faint"> · {me.nativity.lat.toFixed(4)}, {me.nativity.lon.toFixed(4)}</span>
              {me.nativity.timezone && <span class="t-tabular faint"> · {me.nativity.timezone}</span>}
            </p>
            <div><Button variant="secondary" href="/nativity">{say("text.15", "Edit")}</Button></div>
          </div>
        ) : state.nativity?.granted ? (
          <div class="stack">
            <p class="quiet">{say("nativity.3", "No nativity saved yet.")}</p>
            <div><Button href="/nativity">{say("text.16", "Add one")}</Button></div>
          </div>
        ) : (
          <p class="quiet">{say("nativity.4", "Storing birth data needs its own consent, below. Nothing is kept until it is given.")}</p>
        )
      }
    </section>

    <section class="card">
      <h2>{say("your-charts.1", "Your charts")}</h2>
      {
        charts.length === 0 ? (
          <div class="stack">
            <p class="quiet">{say("your-charts.2", "None kept yet. A chart you keep gets its own address, and a separate link you can hand to somebody and take back later without losing your own.")}</p>
            <div><Button variant="secondary" href="/tools/natal-chart">{say("text.17", "Cast one")}</Button></div>
          </div>
        ) : (
          <ul class="charts">
            {charts.map((c) => (
              <li>
                <a href={`/chart/${c.ownerToken}`}>{c.label || "Untitled"}</a>
                <span class="t-tabular faint">{c.birthDate}</span>
                <span class="faint">
                  {c.tradition === "vedic" ? "Vedic" : "Hellenistic"}
                  {c.figure === "south" ? " · South Indian" : c.figure === "north" ? " · North Indian" : ""}
                </span>
                {c.shared && <span class="shared-mark">{say("text.18", "shared")}</span>}
              </li>
            ))}
          </ul>
        )
      }
    </section>

    <section class="card">
      <h2>{say("tokens.1", "Overlay tokens")}</h2>
      {
        guideTokens.length === 0 ? (
          <div class="stack">
            <p class="quiet">{say("tokens.2", "None yet. An overlay is minted from a run's track page, or from a group's page; the URL is shown once, there.")}</p>
            <div><Button variant="secondary" href="/guides">{say("tokens.3", "Open the guides")}</Button></div>
          </div>
        ) : (
          <div class="tokens" role="table">
            <div class="tokens-row tokens-head" role="row">
              <span role="columnheader">{say("tokens.col.name", "Name")}</span>
              <span role="columnheader">{say("tokens.col.showing", "Showing")}</span>
              <span role="columnheader">{say("tokens.col.theme", "Theme")}</span>
              <span role="columnheader">{say("tokens.col.state", "State")}</span>
              <span role="columnheader" class="right">{say("tokens.col.hours", "On air this month")}</span>
            </div>
            {guideTokens.map((t) => (
              <div class="tokens-row" role="row">
                <span role="cell">{t.label || kindWord(t.kind)}<span class="faint"> — {kindWord(t.kind)}</span></span>
                <span role="cell">{t.href ? <a href={t.href}>{t.showing}</a> : t.showing}</span>
                <span role="cell" class="faint">{themeWord(t.theme)}</span>
                <span role="cell" class={`t-tabular ${t.live ? "live" : "faint"}`}>{t.live ? say("tokens.live", "live") : say("tokens.idle", "idle")}</span>
                <span role="cell" class="t-tabular faint right">{say("tokens.hours", "{n} h").replace("{n}", String(t.hoursThisMonth ?? 0))}</span>
              </div>
            ))}
            <p class="quiet t-tabular">{say("tokens.total", "{n} hours on air this month, all overlays together.").replace("{n}", String(Math.round(guideTokens.reduce((a, t) => a + (t.hoursThisMonth ?? 0), 0) * 10) / 10))}</p>
            <p class="quiet">{say("tokens.4", "A token's URL is shown once, when it is minted. Revoke one from the page it was minted on.")}</p>
          </div>
        )
      }
    </section>

    <section class="card">
      <h2>{say("limits.1", "Limits")}</h2>
      <p class="quiet">{say("limits.2", "Fair use, stated plainly.")}</p>
      {allowance && (
        <dl class="limits">
          <div><dt>{say("limits.tokens", "Overlay tokens")}</dt><dd class="t-tabular">{allowance.tokensLimit === null ? say("limits.unlimited", "unlimited") : say("limits.of", "{n} of {m}").replace("{n}", String(allowance.tokens)).replace("{m}", String(allowance.tokensLimit))}</dd></div>
          <div><dt>{say("limits.hours", "Hours on air this month")}</dt><dd class="t-tabular">{allowance.hoursLimit === null ? say("limits.hours_free", "{n}, no limit").replace("{n}", String(allowance.hoursThisMonth)) : say("limits.of", "{n} of {m}").replace("{n}", String(allowance.hoursThisMonth)).replace("{m}", String(allowance.hoursLimit))}</dd></div>
          <div><dt>{say("limits.reading", "Reading and tracking")}</dt><dd>{say("limits.reading_value", "unlimited, and free")}</dd></div>
        </dl>
      )}
      {allowance?.over && <p class="over">{say("limits.over", "You are past the free hours for this month. Going past a limit does not cut you off mid-stream: the overlay keeps drawing, and this page says so until it is sorted — next month, or with hosting.")}</p>}
      {allowance?.tokensFull && !allowance.over && <p class="over">{say("limits.full", "Every overlay slot is in use. Revoke one you no longer stream with, or move to hosting for more.")}</p>}
    </section>

    <section class="card hosting" data-hosting>
      <h2>{say("hosting.1", "Overlay hosting")}</h2>
      {hostingStarted && <p class="notice">{say("hosting.started", "Thank you. Hosting shows here as soon as Stripe confirms it, usually within a minute.")}</p>}
      {hosting?.active ? (
        <div class="stack">
          <p class="status">
            <span class="live">{hosting.cancelAtPeriodEnd ? say("hosting.ending", "ends") : say("hosting.active", "active")}</span>
            {hostingRenews && <span class="faint"> · {hosting.cancelAtPeriodEnd ? say("hosting.ends_on", "on {date}").replace("{date}", hostingRenews) : say("hosting.renews", "renews {date}").replace("{date}", hostingRenews)}</span>}
            {hosting.tier && <span class="faint"> · {hosting.tier === "hosting-yearly" ? say("hosting.yearly_word", "yearly") : say("hosting.monthly_word", "monthly")}</span>}
          </p>
          <p class="quiet">{say("hosting.what", "She runs the server that draws your overlays while you stream. That is the part that costs real processing, and it is the only thing on this site that costs anything.")}</p>
          {hosting.canManage && (
            <form method="POST"><input type="hidden" name="csrf" value={csrf} /><input type="hidden" name="action" value="portal" />
              <Button type="submit" variant="secondary">{say("hosting.manage", "Manage billing or cancel")}</Button></form>
          )}
        </div>
      ) : (
        <div class="stack">
          <p class="price">
            {monthly && <span class="t-tabular"><strong>{money(monthly.amount, monthly.currency)}</strong> {say("hosting.per_month", "a month")}</span>}
            {monthly && yearly && <span class="faint"> · </span>}
            {yearly && <span class="t-tabular"><strong>{money(yearly.amount, yearly.currency)}</strong> {say("hosting.per_year", "a year — two months free")}</span>}
          </p>
          <p class="quiet">{say("hosting.what", "She runs the server that draws your overlays while you stream. That is the part that costs real processing, and it is the only thing on this site that costs anything.")}</p>
          <p class="quiet">{say("hosting.free", "Without it, overlays are free for {n} hours on air a month.").replace("{n}", String(allowance?.hoursLimit ?? 100))}</p>
          {hosting?.configured ? (
            <div class="row">
              {monthly && <form method="POST"><input type="hidden" name="csrf" value={csrf} /><input type="hidden" name="action" value="hosting" /><input type="hidden" name="tier" value={monthly.tier} /><Button type="submit">{say("hosting.buy_month", "Host monthly")}</Button></form>}
              {yearly && <form method="POST"><input type="hidden" name="csrf" value={csrf} /><input type="hidden" name="action" value="hosting" /><input type="hidden" name="tier" value={yearly.tier} /><Button type="submit" variant="secondary">{say("hosting.buy_year", "Host yearly")}</Button></form>}
            </div>
          ) : (
            <p class="quiet">{say("hosting.not_yet", "Not on sale yet.")}</p>
          )}
          {hosting?.testMode && <p class="quiet">{say("hosting.test", "Test mode: cards are not charged.")}</p>}
        </div>
      )}
      <div class="self">
        <h3>{say("self.1", "Or run it yourself")}</h3>
        <p class="quiet">{say("self.2", "The server, the overlays and the MCP are AGPL-3.0. A Docker image and a compose file are in the hosting notes; a self-hosted instance downloads public guides from here.")} <a href="/guides/hosting">{say("self.3", "Hosting notes")}</a></p>
      </div>
    </section>

    <section class="card">
      <h2>{say("consents.1", "Consents")}</h2>
      <p class="quiet">{say("consents.2", "Three decisions, revisitable. Withdrawing is exactly as easy as giving — one control, here, with no email and no waiting.")}</p>
      {
        CONSENTS.map((c) => {
          const now = state[c.kind];
          const granted = !!now?.granted;
          return (
            <div class="consent-row">
              <ConsentCheckbox
                name={`consent_${c.kind}`}
                label={c.label}
                basis={c.basis}
                required={c.required}
                explanation={c.explanation}
                wording={c.wording}
                checked={granted}
              />
              <div class="consent-state">
                {
                  now?.givenAt && (
                    <span class="t-tabular faint">
                      {granted ? "Given" : "Withdrawn"} {new Date(now.givenAt).toISOString().slice(0, 10)}
                      {granted ? " · withdraw any time" : ""}
                    </span>
                  )
                }
                {
                  !c.required && (
                    <form method="POST" class="inline">
                      <CsrfField />
                      <input type="hidden" name="action" value="consent" />
                      <input type="hidden" name="kind" value={c.kind} />
                      <input type="hidden" name="granted" value={granted ? "0" : "1"} />
                      <Button type="submit" variant="ghost" size="sm">
                        {granted ? "Withdraw" : "Give"}
                      </Button>
                    </form>
                  )
                }
              </div>
            </div>
          );
        })
      }
    </section>

    {
      support?.supporting && (
        <section class="card">
          <h2>{say("your-support.1", "Your support")}</h2>
          <p class="support-tier">
            <strong>{TIER_NAMES[support.tier] || "Monthly support"}</strong>
            {support.status === "past_due" && <span class="undef">{say("text.9", "· payment failed")}</span>}
          </p>
          <p class="quiet">
            {
              support.cancelAtPeriodEnd
                ? `Cancelled. It stays active until ${renews(support.currentPeriodEnd)}, and then stops — you keep what you have already paid for.`
                : support.currentPeriodEnd
                  ? `Renews ${renews(support.currentPeriodEnd)}.`
                  : "Active."
            }
          </p>
          <p class="quiet">{say("your-support.2", "Cancelling is one button on Stripe's own page, it takes effect at the end of the month you have already paid for rather than the moment you press it, and no message to me is needed or wanted. Thank you either way — genuinely.")}</p>
          {/* The name she reads out.
              ⚠ Only here, inside the monthly-support card. A one-off gift is
              not read on stream, and a box that quietly did nothing for
              somebody who had given once would be worse than no box. */}
          <form method="POST" class="stream-name">
            <CsrfField />
            <input type="hidden" name="action" value="stream-name" />
            <label for="stream-name">{say("stream.label", "Name to read on stream")}</label>
            <div class="stream-row">
              <input id="stream-name" name="stream_name" maxlength="60"
                     value={support.streamName ?? ""}
                     placeholder={say("stream.placeholder", "However you would like to be called")} />
              <Button type="submit" variant="secondary">{say("stream.save", "Save")}</Button>
            </div>
            <p class="quiet">
              {support.streamName
                ? say("stream.set", "This is what she says when she reads the supporters out.")
                : say("stream.unset", "Left blank, she reads your account name. Put something here if you would rather be called something else — a magickal name, a handle, anything.")}
            </p>
          </form>

          <div>
            <form method="POST">
              <CsrfField />
              <input type="hidden" name="action" value="portal" />
              <Button type="submit" variant="secondary">{say("text.10", "Manage or cancel")}</Button>
            </form>
          </div>
        </section>
      )
    }

    <section class="card">
      <h2>{say("passkeys.1", "Passkeys")}</h2>
      <p class="quiet">
        <Copy text={say("passkeys.body", "A passkey signs you in with Face ID, a fingerprint or your phone's PIN instead of a password. It is a keypair that lives on your device — **Apple and Google are told nothing**, no request reaches them, and this site never learns anything about you from them. That is why there is no “Sign in with Google” button here and there never will be: the convenience of one, without the third party.")} />
      </p>
      <PasskeyList passkeys={passkeys} />
    </section>

    <section class="card">
      <h2>{say("blocked.1", "Blocked")}</h2>
      <p class="quiet">
        {say("blocked.2", "Blocking is yours alone. Nobody was told, nothing went to Shruti, and no one else's feed changed. Unblocking brings their writing back and lets them answer yours again.")}
      </p>
      {blocked.length === 0 ? (
        <p class="quiet">{say("blocked.none", "You have not blocked anybody.")}</p>
      ) : (
        <ul class="acc-blocked">
          {blocked.map((b) => (
            <li>
              <span>{b.name}</span>
              <button type="button" data-unblock={b.id}>{say("blocked.undo", "Unblock")}</button>
            </li>
          ))}
        </ul>
      )}
    </section>

    <section class="card">
      <h2>{say("signing-out.1", "Signing out")}</h2>
      <p class="quiet">{say("signing-out.2", "Ends this session in this browser. Your account and everything in it stay exactly as they are — this is not deleting anything.")}</p>
      <form method="POST">
        <CsrfField />
        <input type="hidden" name="action" value="signout" />
        <div><Button variant="secondary" type="submit">{say("text.19", "Sign out")}</Button></div>
      </form>
    </section>

    <section class="card">
      <h2>{say("your-data.1", "Your data")}</h2>
      <div class="rights">
        <div class="right">
          <h3>{say("export.1", "Export")}</h3>
          <p class="quiet">{say("export.2", "Everything held about you, as a file, now — profile, nativity, the full consent history with dates, and your newsletter state. No email round-trip and no thirty days.")}</p>
          <div><Button variant="secondary" href="/account/export">{say("text.11", "Download JSON")}</Button></div>
        </div>
        <div class="right">
          <h3>{say("delete.1", "Delete")}</h3>
          <p class="quiet">{say("delete.2", "Immediate, irreversible, and it reaches the newsletter list too — not just the account.")}</p>
          <div><Button variant="secondary" data-open-delete>{say("text.12", "Delete my account")}</Button></div>
        </div>
      </div>
    </section>

    <dialog class="modal" data-delete-modal>
      <h2>{say("delete-your-account.1", "Delete your account")}</h2>
      <div class="lists">
        <div>
          <h3>{say("what-goes.1", "What goes")}</h3>
          <ul>
            <li>{say("what-goes.2", "Your email address")}</li>
            <li>{say("what-goes.3", "Your name and preferences")}</li>
            <li>{say("what-goes.4", "Your saved nativity")}</li>
            <li>{say("what-goes.5", "Your newsletter subscription")}</li>
          </ul>
        </div>
        <div>
          <h3>{say("what-is-kept-and-why.1", "What is kept, and why")}</h3>
          <ul>
            <li>
              <Copy text={say("kept.consent", "A record that consent was given and withdrawn, with dates and **no birth data** — that record is the proof the law asks for, and it no longer names you.")} />
            </li>
            <li>{say("what-is-kept-and-why.3", "Invoices, for as long as tax law requires. There are none yet.")}</li>
          </ul>
        </div>
      </div>
      <p class="modal-note">{say("what-is-kept-and-why.4", "Immediate. Not reversible. No grace period.")}</p>
      <div class="modal-actions">
        <form method="POST">
          <CsrfField />
          <input type="hidden" name="action" value="delete" />
          <Button type="submit">{say("text.20", "Delete it")}</Button>
        </form>
        <Button variant="ghost" data-close-delete>{say("text.13", "Keep my account")}</Button>
      </div>
    </dialog>
  </div>
</BaseLayout>


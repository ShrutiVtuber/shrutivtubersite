<script is:inline>
  (function () {
    var modal = document.querySelector("[data-delete-modal]");
    if (!modal) return;
    document.querySelector("[data-open-delete]")?.addEventListener("click", function (e) {
      e.preventDefault(); modal.showModal();
    });
    document.querySelector("[data-close-delete]")?.addEventListener("click", function (e) {
      e.preventDefault(); modal.close();
    });
  })();

  /* Unblocking. ⚠ DELETE with the CSRF token, the same as every other
     state-changing call from this page — the cookie alone is not enough. */
  (function () {
    var rows = document.querySelectorAll("[data-unblock]");
    if (!rows.length) return;
    function token() {
      var c = document.cookie.split("; ").find(function (x) {
        return x.indexOf("shruti_csrf=") === 0;
      });
      return c ? c.split("=")[1] : "";
    }
    rows.forEach(function (button) {
      button.addEventListener("click", async function () {
        button.disabled = true;
        var r = await fetch("/api/practice/blocks/" + button.dataset.unblock, {
          method: "DELETE",
          headers: { "x-csrf-token": token() },
        });
        if (r.ok) {
          button.closest("li").remove();
        } else {
          button.disabled = false;
          button.textContent = "That did not work";
        }
      });
    });
  })();
</script>

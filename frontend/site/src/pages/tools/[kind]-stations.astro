---
/* Solar and lunar station trackers — ported from `ui_kits/site/Stations.jsx`.
 *
 * One page, two bodies, exactly as the design has it. Rules from the handoff
 * that are load-bearing here:
 *
 *   - the current or next station is called out ABOVE the table, because
 *     someone opening this at four in the afternoon wants "sunset in 2h 14m"
 *     before they want thirty rows;
 *   - the range cap is STATED and REFUSED, never quietly trimmed;
 *   - the resolved coordinates are shown back, because a station table for the
 *     wrong city is indistinguishable from a right one until someone misses a
 *     dawn;
 *   - never a blank cell — a station that does not occur says so;
 *   - the preset only LABELS the stations. The tool computes times, and
 *     "none — times only" is a first-class choice, not a fallback.
 */
import BaseLayout from "../../layouts/BaseLayout.astro";
import PlaceField from "../../components/forms/PlaceField.astro";
import SectionHeader from "../../components/brand/SectionHeader.astro";
import NextStation from "../../components/tables/NextStation.astro";
import StationTable from "../../components/tables/StationTable.astro";
import ExportBlock from "../../components/tables/ExportBlock.astro";
import Button from "../../components/forms/Button.astro";
import { stations, nextStation, SOLAR, LUNAR, GLYPHS, PRESETS } from "../../lib/stations";
import { instrument, parseFaq, faqPageNode } from "../../lib/instruments";
import { savedPlace } from "../../lib/account";
import InstrumentNotes from "../../components/tools/InstrumentNotes.astro";
import ToolCta from "../../components/brand/ToolCta.astro";
import RememberPlace from "../../components/tools/RememberPlace.astro";
import { copy } from "../../lib/copy";

/* Every word on this page, editable from the admin. The defaults below are
   what it was written with and what still renders if nothing was changed. */
const t = await copy("tools/[kind]-stations");


/* SSR, so no getStaticPaths — params come off the URL. Anything that is not
   one of the two known kinds is a 404 rather than a silent fallback to solar,
   which would answer a question nobody asked. */
const kind = Astro.params.kind;
if (kind !== "solar" && kind !== "lunar") return Astro.rewrite("/404");
const body: "sun" | "moon" = kind === "lunar" ? "moon" : "sun";
const names = kind === "lunar" ? [...LUNAR] : [...SOLAR];

const q = Astro.url.searchParams;
const ATHENS = { lat: 37.9838, lon: 23.7275, label: "Athens, Greece" };
/* Where they are, if they have said. A URL still wins: a link somebody was
   sent has to show the place it names rather than the reader's own. */
const mine = await savedPlace(Astro);
const lat = Number(q.get("lat") ?? (mine ? mine.lat : ATHENS.lat));
const lon = Number(q.get("lon") ?? (mine ? mine.lon : ATHENS.lon));
const place = q.get("place") ?? (q.has("lat") ? "" : (mine ? mine.name : ATHENS.label));
/* Times only, until a visitor asks for otherwise.
 *
 * The dedications are a real person's devotional practice, not decoration for
 * a public page, and defaulting to them both exposes hers and assumes the
 * reader's. The preset stays a first-class choice — the design brief is
 * emphatic that the tool computes times and the naming is the visitor's — but
 * the choice now starts unmade. */
const preset = PRESETS.some((p) => p.value === q.get("preset")) ? q.get("preset")! : "none";
const start = q.get("start") ?? "";

/* THE CAP IS REFUSED, NOT TRIMMED. Asking for 60 days gets a stated refusal
   and the maximum, not 31 days pretending to be what was asked for. */
const MAX_DAYS = 31;
const asked = Number(q.get("days") ?? 7);
const overCap = Number.isFinite(asked) && asked > MAX_DAYS;
const days = Math.min(MAX_DAYS, Math.max(1, Number.isFinite(asked) ? asked : 7));

const query = new URLSearchParams({
  lat: String(lat), lon: String(lon), body, preset, days: String(days),
});
if (start) query.set("start", start);

const [table, next] = await Promise.all([
  stations(query),
  nextStation(new URLSearchParams({ lat: String(lat), lon: String(lon), body })),
]);

const today = new Date().toISOString().slice(0, 10);
const rows = (table?.table ?? []).map((d) => {
  const byName = Object.fromEntries(d.stations.map((s) => [s.name, s]));
  return {
    date: d.date,
    weekday: new Date(`${d.date}T12:00:00Z`).toLocaleDateString("en-GB", { weekday: "short" }),
    today: d.date === today,
    /* null is the designed absent cell and StationTable renders absentLabel
       for it. It is never an empty string. */
    times: names.map((n) => (byName[n]?.occurred ? byName[n].at : null)),
    phase: d.phase ? `${d.phase}${d.moonAgeDays != null ? ` · ${d.moonAgeDays}d` : ""}` : undefined,
  };
});

const dedications = names.map(
  (n) => table?.table?.[0]?.stations.find((s) => s.name === n)?.dedication ?? "",
);
const feed = `/api/astro/stations/ical?lat=${lat}&lon=${lon}&body=${body}&preset=${preset}&days=${days}`;
/* Name and copy from the instrument's row, like every other tool. This page
   is two instruments rather than one — solar and lunar are separate rows — so
   it looks them up by the kind in the URL. */
const self = await instrument(`${kind}-stations`);
const title = self?.name ?? (kind === "lunar" ? "Lunar stations" : "Solar stations");

/* This page is two instruments on one route and does not use ToolLayout, so
   the structured data the other seven get for free has to be assembled here.
   It was the only pair without any — which is exactly the shape of gap that
   survives a sweep, because the page it is missing from looks complete. */
const SITE = (import.meta.env.SHRUTI_SITE_URL ?? "https://shrutivtuber.com").replace(/\/$/, "");
const pageUrl = `${SITE}/tools/${kind}-stations`;
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebApplication",
      "@id": `${pageUrl}#app`,
      name: title,
      url: pageUrl,
      description: self?.summary ?? "",
      applicationCategory: "ReferenceApplication",
      operatingSystem: "Any",
      browserRequirements: "No JavaScript required",
      isAccessibleForFree: true,
      offers: { "@type": "Offer", price: "0", priceCurrency: "EUR" },
      inLanguage: "en",
      author: { "@id": `${SITE}/#person` },
      publisher: { "@id": `${SITE}/#person` },
      isPartOf: { "@id": `${SITE}/#website` },
    },
    ...faqPageNode(parseFaq(self?.faqMd ?? ""), pageUrl),
    {
      "@type": "BreadcrumbList",
      "@id": `${pageUrl}#breadcrumbs`,
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: `${SITE}/` },
        { "@type": "ListItem", position: 2, name: "Instruments", item: `${SITE}/tools` },
        { "@type": "ListItem", position: 3, name: title, item: pageUrl },
      ],
    },
  ],
};

/* Polar. The test is NOT "every cell is empty" — at Longyearbyen in December
 * noon and midnight still occur, because a culmination happens whether or not
 * the body is above the horizon. What breaks is the rise and the set, and with
 * them the shape the stations assume: the day has no beginning and no end.
 * The handoff puts it exactly this way for the planetary hours too — with no
 * sunrise there is nothing to divide.
 *
 * For the Moon this must not fire on an ordinary skipped day: a missing
 * moonrise is routine, so the state only applies when EVERY day in the range
 * lacks both the rise and the set.
 */
const riseIndex = 0;
const setIndex = names.indexOf(kind === "lunar" ? "moonset" : "sunset");
const noRiseOrSet =
  rows.length > 0 &&
  rows.every((r) => r.times[riseIndex] === null && r.times[setIndex] === null);
const polarReason = noRiseOrSet
  ? kind === "solar"
    ? "The Sun does not cross the horizon here on these dates, so there are no solar stations to keep. This is the sky, not a failure to compute — at this latitude the day does not begin or end in the way the stations assume."
    : "The Moon does not cross the horizon here on these dates. At this latitude whole weeks can pass without a moonrise or a moonset."
  : undefined;
---

<BaseLayout
  title={`${title} — Shruti`}
  description={self?.summary ?? ""}
  jsonLd={jsonLd}
>
  <div class="page stations">
    <SectionHeader
      as="h1"
      glyph={self?.glyph || (kind === "lunar" ? "☾" : "☉")}
      eyebrow="Theourgia · instrument"
      title={title}
      body={self?.summary ?? ""}
    />

    <div class="meta-bar t-tabular">
      <span>{place || `${lat.toFixed(4)}, ${lon.toFixed(4)}`}</span>
      <span>·</span><span>{lat.toFixed(4)}, {lon.toFixed(4)}</span>
      <span>·</span><span>{days} {days === 1 ? "day" : "days"}</span>
      <span>·</span><span>{t("text.1", "shown in your local time")}</span>
    </div>
    <p class="place-why">{t("text.2", "A station table for the wrong city is indistinguishable from a right one until someone misses a dawn — so the coordinates in use are shown above.")}</p>

    <form class="controls" method="GET">
      <PlaceField lat={lat} lon={lon} place={place} />
      <label><span>Days</span><input type="number" name="days" value={days} min="1" max={MAX_DAYS} /></label>
      <label>
        <span>Naming</span>
        <select name="preset">
          {PRESETS.map((p) => <option value={p.value} selected={p.value === preset}>{p.label}</option>)}
        </select>
      </label>
      <Button type="submit" size="sm" data-track="tool:used" data-track-tool="stations">Show</Button>
    </form>

    {
      overCap && (
        <p class="cap-refusal" role="alert">
          One month is the cap — you asked for {asked} days, and it is refused rather than quietly
          trimmed. Showing {MAX_DAYS}.
        </p>
      )
    }
    <p class="cap-note">{t("text.3", "One month is the cap — ask for more and it is refused, not quietly trimmed.")}</p>

    {
      next && !polarReason ? (
        <NextStation
          name={next.name}
          glyph={GLYPHS[next.name]}
          atISO={next.at}
          secondsAway={next.secondsAway}
          attribution={next.dedication || undefined}
        />
      ) : (
        <NextStation undefinedReason={polarReason ?? "No upcoming station could be computed for this place."} />
      )
    }

    <StationTable
      stations={names}
      glyphs={names.map((n) => GLYPHS[n])}
      attributions={dedications}
      rows={rows}
      absentLabel={kind === "lunar" ? "no moonrise today" : "does not occur"}
      undefinedReason={polarReason}
      caption={`${title} · ${place || `${lat.toFixed(4)}, ${lon.toFixed(4)}`} · times in your local zone`}
    />

    {
      kind === "lunar" && !polarReason && (
        <p class="table-why">{t("text.4", "The Moon does not rise every day. It rises roughly fifty minutes later each day and occasionally skips a civil day entirely; at high latitude whole weeks can lack a moonrise or a moonset. An empty cell here is the sky, not missing data.")}</p>
      )
    }

    {
      !polarReason && (
        <ExportBlock
          feedHref={feed}
          fileHref={feed}
          fileName={`${kind}-stations.ics`}
          fileScope={`${days} ${days === 1 ? "day" : "days"} from ${table?.start ?? "today"}`}
          meta={`${place || "coordinates"} · ${lat.toFixed(4)}, ${lon.toFixed(4)} · naming: ${preset}`}
        />
      )
    }

    <RememberPlace place={place} lat={lat} lon={lon} />

    {/* The reckoning passage. Every other instrument gets this from ToolLayout,
        which this page does not use — so these two had the column, had it
        editable in the admin, and had nowhere for it to appear. The text was
        never missing; the surface was. Exactly the shape of half-built thing
        that survives a sweep, because both halves look finished on their own. */}
    {self?.reckoned && (
      <section class="reckoned">
        <h2>{t("how-it-is-reckoned.1", "How it is reckoned")}</h2>
        {self.reckoned.split(/\n\s*\n/).map((para: string) => <p>{para.trim()}</p>)}
      </section>
    )}

    <InstrumentNotes instrument={self} />

    <ToolCta />
  </div>
</BaseLayout>

<style>
  .stations { display: grid; gap: var(--space-5); }

  /* Same treatment as the aside on the other seven instruments, so the two
     pages read as the same object even though one is built differently. */
  .reckoned {
    padding: var(--space-4);
    border: var(--border-w) solid var(--line);
    border-radius: var(--radius-md);
    background: var(--surface-card);
  }
  .reckoned h2 { font: 600 var(--text-h4) var(--font-display); color: var(--ink); margin: 0 0 8px; }
  .reckoned p { margin: 0; font-size: var(--text-sm); line-height: 1.65; color: var(--ink-soft); }
  .reckoned p + p { margin-top: var(--space-3); }
  .meta-bar {
    display: flex; gap: 8px; flex-wrap: wrap; align-items: center;
    font: 400 var(--text-xs) var(--font-mono); color: var(--ink-soft);
    border: var(--border-w) solid var(--line); border-radius: var(--radius-sm); padding: 8px 12px;
  }
  .place-why { font: 400 var(--text-xs) / 1.6 var(--font-body); color: var(--ink-faint); margin: 0; max-width: 62ch; }
  .controls {
    display: flex; gap: var(--space-3); flex-wrap: wrap; align-items: end;
    background: var(--surface-card); border: var(--border-w) solid var(--line);
    border-radius: var(--radius-md); padding: var(--space-4);
  }
  .controls label { display: grid; gap: 4px; }
  .controls span {
    font: 600 var(--text-micro) var(--font-body); letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase; color: var(--ink-faint);
  }
  .controls input, .controls select {
    font: 400 var(--text-sm) var(--font-body); color: var(--ink); background: var(--surface-page);
    border: var(--border-w) solid var(--line); border-radius: var(--radius-sm);
    padding: 8px 10px; min-height: 40px;
  }
  .controls input:focus-visible, .controls select:focus-visible { outline: 2px solid var(--focus-ring); outline-offset: 1px; }
  .cap-refusal { font: 500 var(--text-sm) / 1.6 var(--font-body); color: var(--live); margin: 0; max-width: 62ch; }
  .cap-note { font: 400 var(--text-xs) var(--font-mono); color: var(--ink-faint); margin: 0; }
  .table-why { font: 400 var(--text-sm) / 1.6 var(--font-body); color: var(--ink-soft); margin: 0; max-width: 62ch; }
</style>

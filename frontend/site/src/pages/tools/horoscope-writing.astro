---
/* The horoscope writing desk, for everybody.
 *
 * The same material her own desk gives her — the sky for a period, rotated to
 * a sign, and the events that fall inside it — with somewhere to write. What
 * it deliberately does NOT have is a publish button: readings on this site are
 * hers, and a public tool that could put words on her pages would be a
 * different thing entirely.
 *
 * Practice is the point. Somebody who wants feedback submits from the app,
 * where there is an account behind the name and a room to be read in; here
 * they get the instrument and their own draft, kept in this browser.
 *
 * ⚠ The period arithmetic comes from `lib/periods.ts`, shared with the admin
 * desk. Two copies of ISO week reckoning is two chances to disagree about
 * which week it is, and both would render a perfectly plausible week.
 */
import ToolLayout from "../../layouts/ToolLayout.astro";
import TransitWheel from "../../components/chart/TransitWheel.astro";
import PeriodWheel from "../../components/chart/PeriodWheel.astro";
import SkyDrawer from "../../components/tools/SkyDrawer.astro";
import Copy from "../../components/content/Copy.astro";
import { askAstro } from "../../lib/api";
import { copy } from "../../lib/copy";
import { asReader } from "../../lib/account";
import { ZODIAC } from "../../lib/signs";
import { BODY_GLYPH, SIGN_GLYPH, signIndex } from "../../lib/wheel";
import type { Period } from "../../lib/periods";
import {
  PERIODS, asPeriod, currentCovers, label as periodLabel, range,
} from "../../lib/periods";

const say = await copy("tools/horoscope-writing");

const q = Astro.url.searchParams;
const period: Period = asPeriod(q.get("period"));
const covers = q.get("covers") || currentCovers(period);
const signParam = (q.get("sign") ?? "").toLowerCase();
const sign = ZODIAC.map((s) => s.toLowerCase()).includes(signParam)
  ? signParam
  : "aries";
const Rising = sign.charAt(0).toUpperCase() + sign.slice(1);

/* Signed in? Then the draft belongs to the account and follows them to the app
   and to any other machine. Signed out, it stays in this browser — which is
   still the right answer, because a writing tool that demands an account
   before you may type a sentence is a tool people close. */
const me = await asReader(Astro, "/api/account/me");
const signedIn = me.ok;
/* What the account already holds for this exact sign and period, so the box
   opens on it rather than on whatever this browser happens to remember. */
const savedHere = signedIn
  ? ((await asReader(
      Astro,
      `/api/practice/draft?period=${period}&covers=${encodeURIComponent(covers)}&sign=${sign}`,
    )).body?.bodyMd ?? "")
  : "";

const [start, end] = range(period, covers);
const heading = periodLabel(period, covers);

interface EventRow {
  kind: string; at: string; bodies: string[]; sign: string;
  degree: number; detail?: Record<string, any>;
}
interface ChartBody {
  name: string; longitude: number; retrograde: boolean;
  dignities?: { sign: string; degree: number };
}

/* Both at once. Two round trips in sequence is a second of staring at nothing
   every time somebody changes sign, and the sign changes a lot here. */
const [eventsRes, chartRes, daysRes] = await Promise.all([
  askAstro<{ events: EventRow[] }>(
    `/events?start=${start}T00:00:00Z&end=${end}T23:59:59Z`, 20000),
  askAstro<{ bodies: ChartBody[] }>(
    `/chart?when=${start}T12:00:00Z&lat=51.4779&lon=0` +
    `&tradition=hellenistic&house_system=whole_sign&diagram=false`, 20000),
  /* Every day of the period, for the movement wheel — where each body starts,
     where it ends, and what it did on the way. */
  askAstro<{ days: any[] }>(
    `/ephemeris?start=${start}&end=${end}&hour=midnight` +
    `&include_modern=true&events=true`, 20000),
]);
const days = daysRes?.data?.days ?? [];

const events = (eventsRes?.data?.events ?? []).filter((e) =>
  ["ingress", "station", "lunation", "eclipse"].includes(e.kind));
const bodies = (chartRes?.data?.bodies ?? []).map((b) => ({
  name: b.name,
  longitude: b.longitude,
  sign: b.dignities?.sign ??
    ZODIAC[Math.floor((((b.longitude % 360) + 360) % 360) / 30)],
  degree: b.dignities?.degree ?? ((b.longitude % 30) + 30) % 30,
  retrograde: b.retrograde,
}));

/* Changing the PERIOD moves to that period's current id — "this week" rather
   than a week number borrowed from a month. Changing only the sign keeps the
   period being read. */
const href = (o: { period?: Period; covers?: string; sign?: string }) => {
  const p = o.period ?? period;
  const c = o.covers ?? (o.period && o.period !== period ? currentCovers(p) : covers);
  return `/tools/horoscope-writing?period=${p}&covers=${c}&sign=${o.sign ?? sign}`;
};

const whenOf = (e: EventRow) => new Date(e.at).toLocaleDateString("en-GB",
  { weekday: "short", day: "numeric", month: "short", timeZone: "UTC" });

const eventLine = (e: EventRow) => {
  const who = e.bodies.join(" & ");
  return e.kind === "ingress" ? `${who} enters ${e.sign}`
    : e.kind === "station" ? `${who} turns ${e.detail?.direction ?? "station"}`
    : e.kind === "lunation" ? `${e.detail?.phase ?? "lunation"} moon in ${e.sign}`
    : e.kind === "eclipse"
      ? `${e.detail?.type ?? ""} ${e.detail?.of ?? "solar"} eclipse in ${e.sign}`.trim()
    : `${e.kind} in ${e.sign}`;
};

/* ⚠ The Moon is separated because it OUTNUMBERS everything else, not because
   it matters less. It crosses a sign every two and a half days: in a month it
   contributes thirteen ingresses to a list where the planets contribute two or
   three, and the reader scrolling for "Mars enters Leo" scrolls past twelve
   lines about the Moon to find it. Split, both halves are readable.

   Its LOUD events stay full rows — a new moon or an eclipse is the spine of a
   monthly reading. Only the crossings are compressed, into a chain that reads
   as one movement, which is what thirteen ingresses in a row actually are. */
/* ⚠ INCLUDES, not equals. A lunation and an eclipse carry ("Moon", "Sun") —
   they are the Sun and Moon meeting — so testing for a lone Moon files every
   new moon under the planets, which is precisely backwards: the new moon is
   the loudest lunar event there is. */
const isMoons = (e: EventRow) => e.bodies.includes("Moon");
const planetEvents = events.filter((e) => !isMoons(e));
const moonLoud = events.filter((e) => isMoons(e) && e.kind !== "ingress");
const moonCrossings = events.filter((e) => isMoons(e) && e.kind === "ingress");

/* Which hue a row wears — the wheel's table, so a body is one colour on this
   page wherever it appears. */
const hueOf = (e: EventRow) => {
  const n = e.bodies[0]?.toLowerCase() ?? "";
  return ["sun", "moon", "mercury", "venus", "mars", "jupiter", "saturn"].includes(n)
    ? `var(--body-${n})` : "var(--ink-faint)";
};
const glyphOf = (e: EventRow) => BODY_GLYPH[e.bodies[0]] ?? "◦";
---

{/* No title, heading or lede here. ToolLayout reads them from the
    instrument's row — that is the whole point of the row, and a prop would be
    a second place to write them. This page's slug does the finding. */}
{/* wide: the writing box gets the page rather than two thirds of it. Prose
    written in a narrow column reads like it was written in a narrow column. */}
<ToolLayout where="server" disclosure="○" wide>
  <Fragment slot="parameters">
    <nav class="hw-periods" aria-label={say("nav.period", "Period")}>
      {PERIODS.map((p) => (
        <a href={href({ period: p })} aria-current={p === period ? "page" : undefined}>
          {p.charAt(0).toUpperCase() + p.slice(1)}
        </a>
      ))}
    </nav>

    {/* Counted on the sign links, because choosing a sign is what makes this
        tool compute — there is no submit button to hang it on. Without it the
        desk reads as unused on her dashboard however many people write at it.
        
        ⚠ The comment lives HERE, outside the map. An Astro comment placed
        inside an arrow body that returns an element is not in a position that
        allows one — Astro drops it AND the element's attributes, silently and
        without failing a typecheck. The same mistake in unsubscribed.astro
        broke that page outright; here it quietly stopped twelve links from
        being counted. */}
    <nav class="hw-signs" aria-label={say("nav.sign", "Sign")}>
      {ZODIAC.map((s) => (
        <a
          href={href({ sign: s.toLowerCase() })}
          aria-current={s.toLowerCase() === sign ? "page" : undefined}
          data-track="tool:used"
          data-track-tool="horoscope-writing"
        >{s}</a>
      ))}
    </nav>

    <p class="hw-covers">{heading}</p>
  </Fragment>

  {/* ⚠ The writing box goes BELOW everything, not beside it.
      
      It used to sit in the right half of a two-column split, which gave it
      about sixty characters of line and a column of sky pressed against it the
      whole time. Her words: "put the part where they write below all the other
      information so it's large enough for them to actually write meaningful
      things." A reading is prose, and prose written in a narrow box reads like
      it was written in a narrow box. */}
  <div class="hw"
       data-hw-desk
       data-signed-in={signedIn ? "1" : "0"}
       data-period={period}
       data-covers={covers}
       data-sign={sign}
       data-title={heading}
       data-saved={savedHere}>
    <div class="hw-material">
      <div class="hw-sky">
        {/* ⚠ The MOVEMENT wheel, not the instant. A reading for a week is
            about what happens across it — where Mercury starts, where it ends,
            the day it turns, where it crosses a sign — and that is what this
            draws. The instant chart is below it for the placements. */}
        {days.length > 1 ? (
          <PeriodWheel days={days} rising={Rising} size={360} keyOpen={false}
                       caption={say("wheel.caption", "Where each body starts, where it ends, and what it does on the way. The Moon has its own ring.")} />
        ) : (
          <TransitWheel
            bodies={bodies}
            rising={Rising}
            size={360}
            degreeRing={false}
            houseNumbers={true}
            caption=""
          />
        )}
        <h2 class="hw-h">{say("events.heading", "What happens in this period")}</h2>
        {/* The whole sky, behind a button. What is listed below are the loud
            events; the drawer has the daily positions, every aspect, the
            phases, the eclipses and the voids — everything a printed ephemeris
            would give you, without any of it sitting on top of the writing. */}
        <p class="hw-advanced">
          <SkyDrawer start={start} end={end}
                     label={say("sky.open", "The sky in full")}
                     heading={heading} />
        </p>
        {events.length === 0 ? (
          <p class="hw-none">{say("events.none", "Nothing ingresses, stations or lunates inside it. That is itself worth saying in a reading — a quiet period reads differently from a loud one.")}</p>
        ) : (
          <div class="hw-groups">
            {planetEvents.length > 0 && (
              <section class="hw-group">
                <h3 class="hw-sub">{say("events.planets", "The planets")}</h3>
                <ul class="hw-events">
                  {planetEvents.map((e) => (
                    <li class:list={["hw-ev", `k-${e.kind}`]} style={`--hue:${hueOf(e)}`}>
                      <span class="hw-glyph" aria-hidden="true">{glyphOf(e)}</span>
                      <span class="hw-what">{eventLine(e)}</span>
                      <span class="hw-when">{whenOf(e)}</span>
                    </li>
                  ))}
                </ul>
              </section>
            )}

            {(moonLoud.length > 0 || moonCrossings.length > 0) && (
              <section class="hw-group hw-moon" style="--hue: var(--body-moon)">
                <h3 class="hw-sub">{say("events.moon", "The Moon")}</h3>
                {moonLoud.length > 0 && (
                  <ul class="hw-events">
                    {moonLoud.map((e) => (
                      <li class:list={["hw-ev", `k-${e.kind}`]} style="--hue: var(--body-moon)">
                        <span class="hw-glyph" aria-hidden="true">{BODY_GLYPH.Moon}</span>
                        <span class="hw-what">{eventLine(e)}</span>
                        <span class="hw-when">{whenOf(e)}</span>
                      </li>
                    ))}
                  </ul>
                )}
                {moonCrossings.length > 0 && (
                  <>
                    <p class="hw-chain-label">
                      {say("events.moon.crossings", "and it crosses")}
                    </p>
                    {/* One chain, not thirteen lines. The Moon's month IS one
                        continuous movement; a list of rows says it thirteen
                        times and hides the two that matter above. */}
                    <ol class="hw-chain">
                      {moonCrossings.map((e) => (
                        <li>
                          <span class="hw-cross-sign" aria-hidden="true">
                            {SIGN_GLYPH[signIndex(e.sign)]}
                          </span>
                          <span class="hw-cross-when">
                            {new Date(e.at).toLocaleDateString("en-GB",
                              { day: "numeric", month: "short", timeZone: "UTC" })}
                          </span>
                          <span class="hw-sr">{e.sign}</span>
                        </li>
                      ))}
                    </ol>
                  </>
                )}
              </section>
            )}
          </div>
        )}
      </div>

    </div>

    <div class="hw-write">
      <h2 class="hw-h">{say("write.heading", "Your reading")}</h2>
      <p class="hw-note">
        <Copy text={say("write.note", "Kept in this browser and nowhere else. Nothing here is published — the readings on this site are hers. To have other people read yours and say what they think, submit it from the app.")} />
      </p>
      <textarea
        class="hw-text"
        rows="26"
        data-hw-text
        data-hw-key={`hw:${period}:${covers}:${sign}`}
        placeholder={say("write.placeholder", "What does this sky ask of this sign?")}
        aria-label={say("write.label", "Your reading")}
      ></textarea>
      <p class="hw-state" data-hw-state aria-live="polite"></p>
    </div>
  </div>
</ToolLayout>

<script>
  /* Where a draft lives.
   *
   * Signed out: this browser, and the tool says so. That is still the right
   * answer for a public instrument — one that demands an account before you may
   * type a sentence is one people close.
   *
   * Signed in: the account as well, so it follows them to the app and to
   * whatever machine they open next. Both, not either: the local copy is what
   * survives the connection dropping mid-sentence.
   */
  const box = document.querySelector<HTMLTextAreaElement>("[data-hw-text]");
  const state = document.querySelector<HTMLElement>("[data-hw-state]");
  const desk = document.querySelector<HTMLElement>("[data-hw-desk]");

  if (box && state && desk) {
    const key = box.dataset.hwKey ?? "hw";
    const signedIn = desk.dataset.signedIn === "1";
    const period = desk.dataset.period ?? "weekly";
    const covers = desk.dataset.covers ?? "";
    const sign = desk.dataset.sign ?? "aries";
    const title = desk.dataset.title ?? "";

    /* The account's copy wins where there is one: it is the newer of the two
       whenever anything was written on another machine, and the local copy is
       still underneath if this one is offline. */
    const fromAccount = desk.dataset.saved ?? "";
    try {
      box.value = fromAccount || localStorage.getItem(key) || "";
    } catch {
      box.value = fromAccount;
      state.textContent = "This browser will not keep a draft.";
    }

    const words = () => (box.value.trim() ? box.value.trim().split(/\s+/).length : 0);
    const said = (where: string) => {
      const n = words();
      state.textContent = `${n} word${n === 1 ? "" : "s"} · ${where}`;
    };

    let timer: number | undefined;
    let sending = false;

    async function keep() {
      let local = true;
      try {
        localStorage.setItem(key, box!.value);
      } catch {
        local = false;
      }
      if (!signedIn) {
        said(local ? "kept in this browser" : "not kept — this browser refused");
        return;
      }
      if (sending) return;
      sending = true;
      try {
        const r = await fetch("/api/practice/draft", {
          method: "PUT",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            period, covers, sign, title, body_md: box!.value,
          }),
        });
        said(r.ok ? "kept to your account" : "kept here — the site did not answer");
      } catch {
        /* Offline. The local copy is the point of keeping both. */
        said("kept here — you are offline");
      } finally {
        sending = false;
      }
    }

    box.addEventListener("input", () => {
      window.clearTimeout(timer);
      timer = window.setTimeout(keep, 600);
    });
  }
</script>

<style>
  .hw { display: grid; gap: var(--space-4); }
  .hw-periods, .hw-signs { display: flex; flex-wrap: wrap; gap: 6px; }
  .hw-periods a, .hw-signs a {
    font: 600 var(--text-xs) var(--font-body);
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--ink-faint);
    text-decoration: none;
    padding: 5px 10px;
    border: var(--border-w) solid var(--line);
    border-radius: 999px;
  }
  .hw-periods a:hover, .hw-signs a:hover { color: var(--ink); border-color: var(--line-strong); }
  .hw-periods a[aria-current="page"], .hw-signs a[aria-current="page"] {
    color: var(--accent); border-color: var(--accent); background: var(--accent-wash);
  }
  .hw-covers {
    font: 600 var(--text-sm) var(--font-body);
    color: var(--ink-soft); margin: 0;
  }
  /* The sky across the top, in as many columns as fit; the writing below it
     with the whole width to itself. */
  .hw-material {
    display: grid; gap: var(--space-5); align-items: start;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
  }
  .hw-write { margin-top: var(--space-5); }
  .hw-h { font: 600 var(--text-h4, 1.05rem) var(--font-display); color: var(--ink); margin: var(--space-4) 0 8px; }
  .hw-advanced { margin: 0 0 var(--space-3); }
  .hw-groups { display: grid; gap: var(--space-4); }
  .hw-group { display: grid; gap: 8px; }
  .hw-sub {
    font: 600 var(--text-xs) var(--font-body); color: var(--ink-faint);
    text-transform: uppercase; letter-spacing: 0.08em; margin: 0;
  }
  .hw-events { list-style: none; padding: 0; margin: 0; display: grid; gap: 4px; }
  .hw-ev {
    display: grid; grid-template-columns: 1.6em 1fr auto; gap: 10px;
    align-items: baseline;
    font: 400 var(--text-sm) var(--font-body); color: var(--ink-soft);
    padding: 8px 10px 8px 8px; border: var(--border-w) solid var(--line);
    /* The hue rides the left edge rather than the text, so the colour reads at
       a glance down the column without ever being what carries the meaning. */
    border-left: 3px solid var(--hue);
    border-radius: var(--radius-sm); background: var(--surface-card);
  }
  .hw-glyph { color: var(--hue); font-size: 1.05em; line-height: 1; }
  .hw-when {
    color: var(--ink-faint); font-size: var(--text-xs);
    font-variant-numeric: tabular-nums; white-space: nowrap;
  }
  /* Stations and eclipses are the loud ones, and a reading is usually built
     around them. */
  .hw-ev.k-station .hw-what, .hw-ev.k-eclipse .hw-what { font-weight: 600; color: var(--ink); }
  .hw-ev.k-eclipse { background: var(--rose-wash); border-left-color: var(--rose); }
  .hw-ev.k-eclipse .hw-glyph { color: var(--rose); }

  .hw-chain-label {
    margin: 2px 0 0; font: 400 var(--text-xs) var(--font-body);
    color: var(--ink-faint);
  }
  .hw-chain {
    list-style: none; margin: 0; padding: 0;
    display: flex; flex-wrap: wrap; align-items: center; gap: 2px 0;
  }
  .hw-chain li {
    display: inline-flex; align-items: baseline; gap: 5px;
    padding: 4px 9px; border: var(--border-w) solid var(--line);
    border-radius: 999px; background: var(--surface-card);
    font: 400 var(--text-xs) var(--font-body); color: var(--ink-soft);
  }
  /* The links of the chain — a hairline between chips, so the sequence reads
     as one movement rather than a bag of dates. */
  .hw-chain li + li { margin-left: 9px; position: relative; }
  .hw-chain li + li::before {
    content: ""; position: absolute; left: -9px; top: 50%;
    width: 9px; height: var(--border-w); background: var(--line);
  }
  .hw-chain .hw-cross-sign { color: var(--body-moon); font-size: 1.1em; }
  /* The glyph is decoration; the sign's NAME is the fact, and a reader using a
     screen reader gets the fact. */
  .hw-sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
  .hw-chain .hw-cross-when { font-variant-numeric: tabular-nums; color: var(--ink-faint); }
  .hw-none, .hw-note {
    font: 400 var(--text-sm) / 1.6 var(--font-body); color: var(--ink-soft);
    margin: 0 0 10px; max-width: 62ch;
  }
  .hw-text {
    width: 100%; box-sizing: border-box;
    /* Tall enough to hold a reading rather than a paragraph, and it grows with
       the window instead of staying at whatever rows="" said. */
    min-height: clamp(360px, 52vh, 720px);
    font: 400 var(--text-body) / var(--leading-body) var(--font-display);
    color: var(--ink); background: var(--surface-page);
    border: var(--border-w) solid var(--line); border-radius: var(--radius-sm);
    padding: 12px 14px; resize: vertical;
  }
  .hw-text:focus { border-color: var(--accent); outline: none; }
  .hw-state { font: 400 var(--text-xs) var(--font-body); color: var(--ink-faint); margin: 6px 0 0; }
</style>

---
/* Hindu calendar — `templates/hindu-calendar/`.
 *
 * The year-level companion to the pañcāṅga's day view: the months with their
 * Gregorian spans and festivals, the era lines, and the sixty-year Jovian
 * saṁvatsara.
 *
 * The disagreement: WHERE THE MONTH BEGINS. Amānta ends at the new moon
 * (south and west, Śaka); pūrṇimānta ends at the full (north, Vikrama). They
 * AGREE through the bright fortnight and diverge in the dark one, which is why
 * a date can carry two different month names and neither is wrong.
 *
 * ADHIKA MĀSA carries no festivals — they wait for the nija month. That rule is
 * authentic and is kept.
 */
import ToolLayout from "../../layouts/ToolLayout.astro";
import PlaceField from "../../components/forms/PlaceField.astro";
import DisagreementControl from "../../components/tools/DisagreementControl.astro";
import CannotCompute from "../../components/tools/CannotCompute.astro";
import { askAstro } from "../../lib/api";
import { savedPlace } from "../../lib/account";
import { byMonth, corpus } from "../../lib/festivals";

const q = Astro.url.searchParams;
const ATHENS = { lat: 37.9838, lon: 23.7275 };
const UJJAIN = { lat: 23.1765, lon: 75.7885, label: "Ujjain · 23.18°N 75.79°E" };
/* Where they are, if they have said. The URL still wins — a link
   somebody was sent must show the place it names, not the reader's. */
const mine = await savedPlace(Astro);
const home = mine ?? UJJAIN;
const lat = Number(q.get("lat") ?? (mine ? mine.lat : UJJAIN.lat));
const lon = Number(q.get("lon") ?? (mine ? mine.lon : UJJAIN.lon));
const place = q.get("place") ?? (q.has("lat")
  ? `${lat.toFixed(2)}, ${lon.toFixed(2)}`
  : (mine ? mine.name : UJJAIN.label));
const reckoning = q.get("reckoning") === "purnimanta" ? "purnimanta" : "amanta";
const authority = q.get("authority") === "surya_siddhanta" ? "surya_siddhanta" : "drik";
const year = Number(q.get("year") ?? new Date().getUTCFullYear());

interface Month {
  name: string; index: number; adhika: boolean; kshaya: boolean;
  start: string; end: string; festivals?: { key: string; name: string; date: string }[];
}
interface Payload {
  gregorianYear: number; reckoning: string; authority: string;
  eras: { vikrama: number; shaka: number; kali: number; bengali: number; samvatsara: { index: number; name: string } };
  hasAdhikaMasa: boolean; hasKshayaMasa: boolean; monthCount: number; months: Month[];
}

const url = (r: string, a: string) =>
  `/hindu-year?year=${year}&lat=${lat}&lon=${lon}&reckoning=${r}&authority=${a}`;
const [answer, otherAnswer, corpusData] = await Promise.all([
  askAstro<Payload>(url(reckoning, authority)),
  askAstro<Payload>(url(reckoning === "amanta" ? "purnimanta" : "amanta", authority)),
  /* The corpus. `/hindu-year` returns months and never festivals, so the
     column the designer put in this table has always rendered a dash — the
     join was simply never made, and seventy-two entries sat behind /festivals
     unreachable from the page built to show them. A lunar year overlaps its
     neighbours at both ends, so both adjacent years are asked for. */
  /* Two years, not three. The table's first month opens in the previous
     December, so the year before is needed; the year after contributes
     nothing and costs another eleven seconds. */
  corpus("hindu", [year - 1, year], lat, lon),
]);
const d = answer.data;
const other = otherAnswer.data;

/* Attached by SPAN CONTAINMENT, never by matching Gregorian month numbers: a
   lunar month starts mid-Gregorian-month by definition. An adhika māsa is
   skipped, because its festivals wait for the nija month that follows — the
   rule the table already states and would otherwise contradict. */
if (d && corpusData) {
  const grouped = byMonth(d.months, corpusData.festivals);
  d.months.forEach((m, i) => {
    m.festivals = m.adhika ? [] : grouped[i];
  });
}

/* The consequence to show is the month name a date carries under each scheme —
   the concrete thing that differs, not an abstraction. */
const monthNow = (p: Payload | null) => {
  if (!p) return null;
  const today = new Date().toISOString().slice(0, 10);
  const m = p.months.find((x) => x.start <= today && today <= x.end);
  return m ? `${m.name}${m.adhika ? " (adhika)" : ""}` : null;
};
const mineNow = monthNow(reckoning === "amanta" ? d : other);
const theirsNow = monthNow(reckoning === "amanta" ? other : d);

/* The two schemes AGREE through the bright fortnight and only part in the
 * dark one. On an agreeing day both options would show the same month name and
 * the control would look inert — so it says that it agrees, and why, rather
 * than leaving a reader to conclude the choice does nothing. The design's own
 * demo sidesteps this by picking a dark-fortnight date; saying it out loud is
 * better than choosing a flattering day.
 */
const schemesAgree = !!mineNow && mineNow === theirsNow;
const consequence = (which: "amanta" | "purnimanta") => {
  const name = which === "amanta" ? mineNow : theirsNow;
  if (!name) return "—";
  return schemesAgree
    ? `today is ${name} — both agree in the bright fortnight`
    : `today is ${name}`;
};
/* The API returns full ISO timestamps with microseconds. A month boundary is
   a moment, and the exact moment matters to the computation — but printing
   `2026-01-18T19:52:01.668470+00:00` in a table cell is showing a reader the
   machine's working rather than the answer. */
const spanDay = (iso: string) =>
  new Date(iso).toLocaleDateString("en-GB", {
    day: "numeric", month: "short", year: "numeric",
  });

const RULE_NAME: Record<string, string> = {
  amanta: "month ends at the new moon",
  purnimanta: "month ends at the full moon",
};
---

<ToolLayout
  rule={RULE_NAME[reckoning]}
  ruleLabel="month ends"
  place={place}
  date={String(year)}
  disclosure="○"
  lat={lat}
  lon={lon}
>
  <div slot="parameters" class="params">
    <DisagreementControl
      legend="Where the month begins"
      name="reckoning"
      value={reckoning}
      keep={{ lat: String(lat), lon: String(lon), place, authority, year: String(year) }}
      options={[
        {
          value: "amanta",
          name: "Amānta",
          rule: "The month ends at the new moon. Southern and western India; the Śaka era counts this way.",
          consequence: consequence("amanta"),
        },
        {
          value: "purnimanta",
          name: "Pūrṇimānta",
          rule: "The month ends at the full moon. Northern India; the Vikrama era counts this way.",
          consequence: consequence("purnimanta"),
        },
      ]}
    />
    <hr class="param-rule" />
    <form class="param-panel" method="GET">
      <input type="hidden" name="reckoning" value={reckoning} />
      <label><span>Year</span><input type="number" name="year" value={year} min="1900" max="2100" /></label>
      <PlaceField lat={lat} lon={lon} place={place} />
      <label>
        <span>Authority</span>
        <select name="authority">
          <option value="drik" selected={authority === "drik"}>Dṛk gaṇita — modern ephemeris</option>
          <option value="surya_siddhanta" selected={authority === "surya_siddhanta"}>Sūrya Siddhānta — classical tables</option>
        </select>
      </label>
      <button type="submit" data-track="tool:used" data-track-tool="hindu-calendar">Show</button>
    </form>
  </div>

  {
    !d ? (
      <CannotCompute
        title="The calendar could not be computed"
        why={answer.detail || "The ephemeris could not be reached, so this year cannot be laid out right now."}
      />
    ) : (
      <>
        <section class="eras">
          <h2>The year</h2>
          <dl>
            <div><dt>Vikrama Saṁvat</dt><dd class="t-tabular">{d.eras.vikrama}</dd></div>
            <div><dt>Śaka Saṁvat</dt><dd class="t-tabular">{d.eras.shaka}</dd></div>
            <div><dt>Kali Yuga</dt><dd class="t-tabular">{d.eras.kali}</dd></div>
            <div><dt>Bengali San</dt><dd class="t-tabular">{d.eras.bengali}</dd></div>
            <div><dt>Saṁvatsara</dt><dd>{d.eras.samvatsara.name} <span class="t-tabular faint">({d.eras.samvatsara.index}/60)</span></dd></div>
            <div><dt>Months</dt><dd class="t-tabular">{d.monthCount}</dd></div>
          </dl>
        </section>

        {
          d.hasAdhikaMasa && (
            <p class="note">
              This year carries an <strong>adhika māsa</strong> — an intercalary month, inserted
              because a lunar month contained no solar transition. It carries no festivals: they
              wait for the <em>nija</em> month that follows.
            </p>
          )
        }
        {
          d.hasKshayaMasa && (
            <p class="note">
              This year carries a <strong>kṣaya māsa</strong>, the rarer opposite — a month removed
              rather than added.
            </p>
          )
        }

        <section class="months">
          <h2>Months</h2>
          <div class="table-scroll">
            <table>
            <thead>
              <tr><th scope="col">Month</th><th scope="col">From</th><th scope="col">To</th><th scope="col">Festivals</th></tr>
            </thead>
            <tbody>
              {
                d.months.map((m) => (
                  <tr data-adhika={m.adhika || undefined} data-kshaya={m.kshaya || undefined}>
                    <th scope="row">
                      {m.name}
                      {m.adhika && <span class="tag">adhika</span>}
                      {m.kshaya && <span class="tag">kṣaya</span>}
                    </th>
                    <td class="t-tabular">{spanDay(m.start)}</td>
                    <td class="t-tabular">{spanDay(m.end)}</td>
                    <td class="fest">
                      {
                        m.adhika
                          ? <span class="fest-none">none — they wait for the nija month</span>
                          : (m.festivals ?? []).length > 0
                            ? (m.festivals ?? []).map((f) => <span class="fest-one">{f.name} <span class="t-tabular faint">{f.date.slice(5)}</span></span>)
                            : <span class="fest-none">—</span>
                      }
                    </td>
                  </tr>
                ))
              }
            </tbody>
          </table>
          </div>

          {
            corpusData && (
              <p class="fest-provenance">
                {corpusData.counts.entries} festivals in the corpus,
                {" "}{corpusData.counts.dated} dated across the months shown.
                {corpusData.undated.length > 0 && (
                  <>
                    {" "}Kept but deliberately undated:
                    {" "}{corpusData.undated.map((u) => u.name).join(", ")} — a plausible date
                    would make the table look complete and make it wrong.
                  </>
                )}
              </p>
            )
          }
        </section>

        <p class="note">
          Amānta and pūrṇimānta <strong>agree through the bright fortnight and diverge in the
          dark one</strong>. A date in the dark fortnight therefore carries two different month
          names, and neither is a mistake — which is why this page offers both rather than
          picking one.
        </p>
      </>
    )
  }
</ToolLayout>

<style>
  /* Wide content scrolls inside its own box, never by moving the page.
   *
   * This matters more since `overflow-x: clip` went on <html>: without a
   * scroll container of its own, a table wider than a phone is now CLIPPED
   * rather than reachable — the columns past the edge simply cannot be read.
   * Clipping the page's accidental overflow is right; clipping a table is
   * not, and the difference is this rule. */
  .table-scroll { overflow-x: auto; -webkit-overflow-scrolling: touch; }
  .table-scroll table { min-width: 34rem; }

  .fest-provenance {
    font: 400 var(--text-xs) / 1.7 var(--font-body); color: var(--ink-faint);
    margin: var(--space-3) 0 0; max-width: 78ch;
  }

  .params { display: grid; gap: var(--space-4); }
  .param-rule { border: 0; border-top: var(--border-w) solid var(--line); margin: 0; }
  .param-panel { display: flex; gap: var(--space-3); flex-wrap: wrap; align-items: end; }
  .param-panel label { display: grid; gap: 4px; }
  .param-panel > label > span { font: 600 var(--text-micro) var(--font-body); letter-spacing: var(--tracking-eyebrow); text-transform: uppercase; color: var(--ink-faint); }
  .param-panel input, .param-panel select {
    font: 400 var(--text-sm) var(--font-body); color: var(--ink); background: var(--surface-page);
    border: var(--border-w) solid var(--line); border-radius: var(--radius-sm); padding: 8px 10px; min-height: 40px;
  }
  .param-panel button {
    appearance: none; min-height: 40px; padding: 0 16px; font: 600 var(--text-sm) var(--font-body);
    color: var(--on-accent); background: var(--accent); border: var(--border-w) solid var(--accent);
    border-radius: var(--radius-sm); cursor: pointer;
  }

  .eras h2, .months h2 { font: 600 var(--text-h4) var(--font-display); color: var(--ink); margin: 0 0 8px; }
  .eras dl { display: grid; grid-template-columns: repeat(auto-fit, minmax(190px, 1fr)); gap: 0 var(--space-4); margin: 0; }
  .eras dl > div { display: flex; gap: 10px; align-items: baseline; padding: 8px 0; border-bottom: var(--border-w) solid var(--line); }
  .eras dt { font: 600 var(--text-micro) var(--font-body); letter-spacing: var(--tracking-eyebrow); text-transform: uppercase; color: var(--ink-faint); }
  .eras dd { margin: 0 0 0 auto; font: 400 var(--text-sm) var(--font-body); color: var(--ink); }
  .faint { color: var(--ink-faint); font-size: var(--text-xs); }

  .months table { width: 100%; border-collapse: collapse; }
  .months th[scope="col"] {
    text-align: left; font: 600 var(--text-micro) var(--font-body); letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase; color: var(--ink-faint); padding: 0 10px 8px 0;
    border-bottom: var(--border-w) solid var(--line-strong);
  }
  .months td, .months tbody th { padding: 9px 10px 9px 0; border-bottom: var(--border-w) solid var(--line); text-align: left; vertical-align: top; }
  .months tbody th { font: 500 var(--text-body) var(--font-display); color: var(--ink); white-space: nowrap; }
  .months td { font: 400 var(--text-sm) var(--font-mono); color: var(--ink-soft); }
  .months tr[data-adhika] { background: var(--rose-wash); }
  .tag {
    margin-left: 8px; font: 600 0.625rem var(--font-mono); letter-spacing: var(--tracking-caps);
    text-transform: uppercase; color: var(--rose);
  }
  .fest { font-family: var(--font-body) !important; }
  .fest-one { display: block; }
  .fest-none { color: var(--ink-faint); font-style: italic; }
  .note { font: 400 var(--text-sm) / 1.7 var(--font-body); color: var(--ink-soft); margin: 0; max-width: 66ch; }
</style>

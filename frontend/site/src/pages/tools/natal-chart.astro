---
/* Natal chart — `templates/natal-chart/`.
 *
 * The disagreement: WHICH SKY, WHOSE HOUSES. Hellenistic reads a tropical
 * zodiac from the equinox with whole-sign places, sect and rulership, and no
 * orbs. Vedic reads a sidereal zodiac with bhāva houses and graha dṛṣṭi. They
 * sit about 24° apart, which is enough to move the Sun a whole sign.
 *
 * NOTHING IS ROUNDED BEFORE DISPLAY AND NOTHING IS INTERPRETED. The tables are
 * the primary reading; the wheel is a figure drawn from the same numbers.
 *
 * THE UNKNOWN BIRTH TIME IS THE STATE THAT MATTERS. The ascendant moves a
 * degree every four minutes, so with no time the angles, houses, sect and the
 * lots that depend on them are UNDEFINED — and the tool must not guess. The
 * daemon has no flag for this: given a date with no time it will happily
 * compute angles from midnight, which is a fabricated ascendant. So the page
 * enforces it: noon for the planets, the Moon given as a range across the day,
 * and everything ascendant-dependent withheld and named.
 */
import ToolLayout from "../../layouts/ToolLayout.astro";
import PlaceField from "../../components/forms/PlaceField.astro";
import DisagreementControl from "../../components/tools/DisagreementControl.astro";
import CannotCompute from "../../components/tools/CannotCompute.astro";
import KeepChart from "../../components/chart/KeepChart.astro";
import { askAstro, SITE_API } from "../../lib/api";
import { account, asReader } from "../../lib/account";
import { verifyCsrf } from "../../lib/csrf";
import { copy } from "../../lib/copy";
import Copy from "../../components/content/Copy.astro";

/* Every word on this page, editable from the admin. The defaults below are
   what it was written with and what still renders if nothing was changed. */
const say = await copy("tools/natal-chart");


export const prerender = false;

let keepFailed = "";

/* Keeping happens BEFORE the chart is read back, because it ends in a
   redirect: rendering the whole page and then throwing it away would be work
   nobody sees. */
if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  if (!verifyCsrf(Astro.cookies, form)) {
    keepFailed = say("error.retry", "That did not save. Reload the page and try again.");
  } else {
    const p = Astro.url.searchParams;
    const kept = await asReader(Astro, "/api/charts", {
      method: "POST",
      headers: { "content-type": "application/json" },
      body: JSON.stringify({
        label: String(form.get("label") ?? "").slice(0, 80),
        tradition: p.get("tradition") === "vedic" ? "vedic" : "hellenistic",
        house_system: p.get("house_system") ?? "whole_sign",
        figure: p.get("tradition") === "vedic"
          ? (p.get("vedic_style") === "south" ? "south" : "north")
          : "wheel",
        birth_date: p.get("date") ?? "",
        birth_time: p.get("time") || null,
        time_unknown: p.get("unknownTime") === "1" || !p.get("time"),
        place_name: p.get("place") ?? "",
        lat: Number(p.get("lat") ?? 0),
        lon: Number(p.get("lon") ?? 0),
        // Without this the saved row cannot be re-cast correctly, and every
        // later view of it falls back to UTC.
        timezone: p.get("tz") ?? "",
        consent: form.get("consent") === "1",
      }),
    });
    if (kept.ok && kept.body?.ownerToken) {
      return Astro.redirect(`/chart/${kept.body.ownerToken}`, 303);
    }
    keepFailed = kept.status === 400
      ? say("text.chart.cannot.kept", "A chart cannot be kept without agreeing to the birth data being stored.")
      : say("error.save", "That did not save. It is a failure on this side, not something you did.");
  }
}

/* Only to decide whether to ask for a consent already on file. Signed out is
   the ordinary case here and not a lesser one. */
const reader = await account(Astro);
const hasNativityConsent = !!reader?.consents?.some(
  (c) => c.kind === "nativity" && c.granted,
);

const q = Astro.url.searchParams;
const tradition = q.get("tradition") === "vedic" ? "vedic" : "hellenistic";
const date = q.get("date") ?? "";
const time = q.get("time") ?? "";
const unknownTime = q.get("unknownTime") === "1" || (!!date && !time);
const lat = Number(q.get("lat") ?? 37.9838);
const lon = Number(q.get("lon") ?? 23.7275);
const place = q.get("place") ?? "";
/* The BIRTHPLACE's IANA zone, filled in by the place control. Not the
   visitor's own zone, which is a different fact about a different person. */
const tz = q.get("tz") ?? "";
const HOUSE_SYSTEMS = ["whole_sign", "placidus", "equal", "porphyry", "regiomontanus", "campanus"];
/* North and South Indian are different diagrams, not two styles of one: the
   North figure fixes the houses and moves the signs, the South figure fixes
   the signs. Some people read one, some the other, and some want both — so it
   is a choice on the page rather than a decision made for them. */
const FIGURES = ["north", "south"];
const vedicStyle = FIGURES.includes(q.get("vedic_style") ?? "") ? q.get("vedic_style")! : "north";
const houseSystem = HOUSE_SYSTEMS.includes(q.get("house_system") ?? "") ? q.get("house_system")! : "whole_sign";

interface Body {
  name: string; longitude: number; retrograde: boolean; speed: number;
  /* Absent for Rāhu and Ketu: the nodes have no essential dignity, which is a
     fact about the scheme rather than missing data. They still have a sign. */
  dignities?: { sign: string; degree: number; domicile?: boolean; exaltation?: boolean; detriment?: boolean; fall?: boolean };
  house?: number;
}
interface Payload {
  tradition: string; zodiac: string; when: string; houseSystem: string; ayanamsa: string | null;
  angles: { ascendant: number; midheaven: number; descendant: number; imumCoeli: number };
  bodies: Body[];
  sect?: { isDay: boolean; luminary: string; benefic: string; malefic: string };
  places?: { place: number; name: string; sign: string; ruler: string }[];
  lots?: Record<string, number>;
  /* Hellenistic returns `configurations`; Vedic returns `drishti`. Not a
     naming inconsistency to smooth over — a whole-sign configuration and a
     graha dṛṣṭi are different claims about the sky, and one is not the other
     translated. Reading whichever is absent gives `undefined.map`, which is a
     500 on every Vedic chart. */
  aspects: {
    basis: string;
    configurations?: { from: string; to: string; aspect: string; separationSigns?: number }[];
    drishti?: { from: string; to: string; aspect: string; mutual?: boolean }[];
  };
  diagram?: { kind: string; svg: string };
  lagna?: unknown; nakshatraOfMoon?: unknown; dasha?: unknown;
}

const SIGNS = [
  "Aries", "Taurus", "Gemini", "Cancer", "Leo", "Virgo",
  "Libra", "Scorpio", "Sagittarius", "Capricorn", "Aquarius", "Pisces",
];
/* The nodes carry no dignities, so sign and degree come off the longitude
   rather than being left blank. */
const signOf = (b: Body) => b.dignities?.sign ?? SIGNS[Math.floor((b.longitude % 360) / 30)];
const degreeOf = (b: Body) => b.dignities?.degree ?? Number((b.longitude % 30).toFixed(4));
const dignityWords = (b: Body) =>
  b.dignities
    ? [b.dignities.domicile && "domicile", b.dignities.exaltation && "exaltation",
       b.dignities.detriment && "detriment", b.dignities.fall && "fall"].filter(Boolean).join(" · ")
    : "";

/* THE INSTANT, NOT A WALL CLOCK.
 *
 * This page used to send `1996-05-14T09:30:00` and the ephemeris read it as
 * UTC, so a birth in Athens was cast for half past twelve there. The planets
 * barely moved and only the angles did, which is why nothing looked wrong:
 * Athens came out 37° off, Mumbai 76°, Los Angeles 127° — the right Sun and
 * the wrong rising sign.
 *
 * The offset is the one that applied AT THE BIRTHPLACE ON THE BIRTH DATE, and
 * it is resolved by the same server function that casts every saved chart.
 * Greece was +02:00 in the January of the same year.
 */
const clock = unknownTime ? "12:00" : time || "12:00";

async function offsetAt(local: string): Promise<{ offset: string; note: string } | null> {
  if (!tz) return null;
  try {
    const r = await fetch(
      `${SITE_API}/api/places/offset?tz=${encodeURIComponent(tz)}&when=${encodeURIComponent(local)}`,
    );
    if (!r.ok) return null;
    const body = await r.json();
    return { offset: body.offset as string, note: (body.note as string) ?? "" };
  } catch {
    return null;
  }
}

const resolved = date ? await offsetAt(`${date}T${clock}`) : null;
/* No zone means the chart is cast in UTC — the same instant this page has
   always used. It is now said out loud instead of assumed silently, and the
   page warns rather than drawing a confident wheel for the wrong sky. */
const zoneKnown = !!resolved;
const offsetNote = resolved?.note ?? "";
const moment = date ? `${date}T${clock}:00${resolved?.offset ?? "+00:00"}` : "";
const chartUrl = (t: string) =>
  `/chart?when=${encodeURIComponent(moment)}&lat=${lat}&lon=${lon}&tradition=${t}` +
  `&house_system=${houseSystem}&vedic_style=${vedicStyle}`;

const answer = date ? await askAstro<Payload>(chartUrl(tradition)) : null;
const d = answer?.data ?? null;

/* Whichever of the two this tradition returned. Neither carries both. */
const looks: { from: string; to: string; aspect: string; separationSigns?: number; mutual?: boolean }[] =
  d ? (d.aspects.configurations ?? d.aspects.drishti ?? []) : [];

/* The Moon as a range, since it can move 12–15° across a day and the time is
   unknown. Two extra reads at the ends of the day — not an estimate. */
let moonRange: { start: string; end: string } | null = null;
if (date && unknownTime) {
  /* Each end resolved separately: a clock change falls inside this very
     window, and reusing one offset for both would misplace the far end by an
     hour on exactly the days it matters. */
  const [startOff, endOff] = await Promise.all([
    offsetAt(`${date}T00:00`), offsetAt(`${date}T23:59`),
  ]);
  const ends = [
    `${date}T00:00:00${startOff?.offset ?? "+00:00"}`,
    `${date}T23:59:00${endOff?.offset ?? "+00:00"}`,
  ];
  const [a, b] = await Promise.all([
    askAstro<Payload>(`/chart?when=${encodeURIComponent(ends[0])}&lat=${lat}&lon=${lon}&tradition=${tradition}`),
    askAstro<Payload>(`/chart?when=${encodeURIComponent(ends[1])}&lat=${lat}&lon=${lon}&tradition=${tradition}`),
  ]);
  const moonOf = (p: Payload | null) => p?.bodies.find((x) => x.name === "Moon");
  const m0 = moonOf(a.data), m1 = moonOf(b.data);
  if (m0 && m1) {
    moonRange = {
      start: `${degreeOf(m0).toFixed(2)}° ${signOf(m0)}`,
      end: `${degreeOf(m1).toFixed(2)}° ${signOf(m1)}`,
    };
  }
}

const sunSign = (p: Payload) => {
  const s = p.bodies.find((b) => b.name === "Sun");
  return s ? `Sun in ${signOf(s)}` : "—";
};
const ASPECT_BASIS: Record<string, string> = {
  whole_sign: say("text.sign.based.then", "sign-based, then by degree — aspects between non-aspecting signs are not listed however close the degrees"),
  drishti: say("text.graha.whole.sign", "graha dṛṣṭi — whole-sign and asymmetric, by rule rather than by orb"),
};
---

<ToolLayout
  rule={tradition === "vedic" ? "sidereal zodiac, graha dṛṣṭi" : "tropical zodiac, whole-sign places"}
  ruleLabel="tradition"
  place={place || (date ? `${lat.toFixed(2)}, ${lon.toFixed(2)}` : undefined)}
  date={date || undefined}
  disclosure="○"
>
  <div slot="parameters" class="params">
    <DisagreementControl
      legend={say("text.8", "Which sky, whose houses")}
      name="tradition"
      value={tradition}
      keep={{ date, time, lat: String(lat), lon: String(lon), place, tz, house_system: houseSystem, ...(unknownTime ? { unknownTime: "1" } : {}) }}
      options={[
        {
          value: "hellenistic",
          name: "Hellenistic",
          rule: "Tropical zodiac measured from the equinox, whole-sign places, sect and rulership, no orbs.",
          consequence: d && tradition === "hellenistic" ? sunSign(d) : "tropical",
        },
        {
          value: "vedic",
          name: "Vedic",
          rule: "Sidereal zodiac, bhāva houses, graha dṛṣṭi. About 24° back from tropical.",
          consequence: d && tradition === "vedic" ? sunSign(d) : "sidereal",
        },
      ]}
    />
    <hr class="param-rule" />
    <form class="param-panel" method="GET">
      <input type="hidden" name="tradition" value={tradition} />
      <label><span>{say("text.10", "Birth date")}</span><input type="date" name="date" value={date} required /></label>
      <label><span>{say("text.11", "Birth time")}</span><input type="time" name="time" value={time} disabled={unknownTime} /></label>
      <label class="check">
        <input type="checkbox" name="unknownTime" value="1" checked={unknownTime} />
        <span class="check-label">{say("text.1", "I don't know my birth time")}</span>
      </label>
      {/* `wantTimezone` is what puts the zone in the form. Without it this
          page had coordinates and no clock, and cast every chart in UTC. */}
      <PlaceField lat={lat} lon={lon} place={place} timezone={tz} wantTimezone />
      <label>
        <span>{say("text.12", "Houses")}</span>
        <select name="house_system">
          {HOUSE_SYSTEMS.map((h) => <option value={h} selected={h === houseSystem}>{h.replace(/_/g, " ")}</option>)}
        </select>
      </label>
      {
        /* Only for the Vedic sky. A North Indian square drawn for a
           Hellenistic chart is exactly the relabelling that gives away
           software which has not understood the difference. */
        tradition === "vedic" ? (
          <label>
            <span>{say("text.13", "Figure")}</span>
            <select name="vedic_style">
              <option value="north" selected={vedicStyle === "north"}>{say("text.6", "North Indian")}</option>
              <option value="south" selected={vedicStyle === "south"}>{say("text.7", "South Indian")}</option>
            </select>
          </label>
        ) : (
          <input type="hidden" name="vedic_style" value={vedicStyle} />
        )
      }
      <button type="submit" data-track="tool:used" data-track-tool="natal-chart">{say("text.14", "Cast")}</button>
    </form>
    <p class="privacy">{say("text.2", "Birth data in a link is birth data in a browser history. This page puts the date, time and place in the URL so a reckoning can be shared or re-opened — bear that in mind before sending one on.")}</p>
  </div>

  {
    !date ? (
      <p class="prompt">{say("text.3", "Give a date, a place, and a time if you know it.")}</p>
    ) : !d ? (
      <CannotCompute
        title={say("text.4", "The chart could not be cast")}
        why={answer?.detail || "The ephemeris could not be reached. That is a failure on my side, not a fact about the sky."}
      />
    ) : (
      <>
        {
          /* A chart cast without the birthplace's zone is cast in UTC, and it
             looks exactly like a correct one — the Sun is right and the rising
             sign is not. Said here rather than drawn silently. */
          !zoneKnown && (
            <CannotCompute
              mark="◐"
              title={say("no-zone.1", "This chart is cast in UTC, not local time")}
              why={say("no-zone.2", "The birthplace's timezone is not set, so the birth time has been read as UTC. Every planet will be very nearly right and the ascendant will not — by an hour's worth of rotation for each hour of offset, which is fifteen degrees. Pick the birth city from the place field above and it will be cast properly.")}
              alternatives={[
                "Choose the birth city from the list in the place field, which fills in the timezone with it.",
                "Read the planetary positions, which are barely affected.",
                "Treat the ascendant, houses and sect below as unreliable until the place is set.",
              ]}
            />
          )
        }
        {
          /* The clock did something odd that night. Reported, never resolved
             on somebody's behalf. */
          offsetNote && (
            <CannotCompute
              mark="◐"
              title={say("clock-note.1", "The clock changed that night")}
              why={offsetNote}
            />
          )
        }
        {
          unknownTime && (
            <CannotCompute
              mark="◐"
              title={say("text.5", "Without a birth time, the angles are undefined")}
              why={say("text.9", "The ascendant moves a degree every four minutes, so an unknown time leaves the ascendant, midheaven, the houses and the sect genuinely undefined — not approximate. They are withheld below rather than filled in from an assumed midnight, because a fabricated ascendant is worse than an absent one. The planets are given for noon, and the Moon as the range it covers across the day.")}
              alternatives={[
                "Read the planetary positions, which move little across a day — except the Moon, whose range is given.",
                "Rectify the time from known events with an astrologer, and come back with it.",
                "Leave the angles undefined, which is the honest state of the chart.",
              ]}
            />
          )
        }

        <section class="positions">
          <h2>{say("positions.1", "Positions")}</h2>
          <div class="table-scroll">
            <table>
            <thead>
              <tr>
                <th scope="col">Body</th><th scope="col">Longitude</th>
                <th scope="col">Sign</th><th scope="col">House</th><th scope="col">Dignity</th>
              </tr>
            </thead>
            <tbody>
              {
                d.bodies.map((b) => (
                  <tr>
                    <th scope="row">{b.name}{b.retrograde && <span class="retro" title={say("text.21", "retrograde")}> ℞</span>}</th>
                    <td class="t-tabular">{b.longitude}°</td>
                    <td>{signOf(b)} <span class="t-tabular faint">{degreeOf(b)}°</span></td>
                    <td class="t-tabular">
                      {unknownTime ? <span class="undef">{say("text.15", "undefined")}</span> : (b.house ?? "—")}
                    </td>
                    <td class="dig">{dignityWords(b) || "—"}</td>
                  </tr>
                ))
              }
            </tbody>
          </table>
          </div>
          {
            unknownTime && moonRange && (
              <p class="moon-range">
                <Copy
                  text={say("positions.2", "**Moon across the day:** {start} at midnight to {end} at the day's end.")}
                  vars={{ start: moonRange.start, end: moonRange.end }}
                />
              </p>
            )
          }
        </section>

        <section class="angles">
          <h2>{say("angles.1", "Angles")}</h2>
          {
            unknownTime ? (
              <p class="undef-block">{say("angles.2", "◐ Ascendant, midheaven, descendant and imum coeli are undefined without a birth time. Nothing is shown here because there is nothing true to show.")}</p>
            ) : (
              <dl>
                <div><dt>{say("text.16", "Ascendant")}</dt><dd class="t-tabular">{d.angles.ascendant}°</dd></div>
                <div><dt>{say("text.17", "Midheaven")}</dt><dd class="t-tabular">{d.angles.midheaven}°</dd></div>
                <div><dt>{say("text.18", "Descendant")}</dt><dd class="t-tabular">{d.angles.descendant}°</dd></div>
                <div><dt>{say("text.19", "Imum coeli")}</dt><dd class="t-tabular">{d.angles.imumCoeli}°</dd></div>
              </dl>
            )
          }
        </section>

        {
          d.sect && !unknownTime && (
            <section class="sect">
              <h2>{say("sect.1", "Sect")}</h2>
              <p>
                <Copy
                  text={say("sect.2", "A **{sect}** chart. Luminary of the sect: {luminary}. Benefic of the sect: {benefic}. Malefic: {malefic}.")}
                  vars={{
                    sect: d.sect.isDay ? "day" : "night",
                    luminary: d.sect.luminary,
                    benefic: d.sect.benefic,
                    malefic: d.sect.malefic,
                  }}
                />
              </p>
            </section>
          )
        }
        {
          d.sect && unknownTime && (
            <section class="sect">
              <h2>{say("sect.2", "Sect")}</h2>
              <p class="undef-block">{say("sect.3", "◐ Sect depends on whether the Sun was above or below the horizon, which needs the time. Undefined.")}</p>
            </section>
          )
        }

        <section class="aspects">
          <h2>{tradition === "vedic" ? "Dṛṣṭi" : "Configurations"}</h2>
          <p class="aspect-basis">{ASPECT_BASIS[d.aspects.basis] ?? d.aspects.basis}</p>
          <ul>
            {
              looks.map((c) => (
                <li>
                  <span class="a-pair">{c.from} — {c.to}</span>
                  <span class="a-kind">{c.aspect}</span>
                  {c.separationSigns != null && <span class="t-tabular a-sep">{c.separationSigns} signs</span>}
                  {c.mutual && <span class="a-sep">{say("text.20", "mutual")}</span>}
                </li>
              ))
            }
          </ul>
          {looks.length === 0 && <p class="faint">{say("sect.4", "No configurations by this rule.")}</p>}
        </section>

        {
          d.diagram?.svg && (
            <section class="wheel">
              <h2>{say("the-figure.1", "The figure")}</h2>
              <div class="wheel-frame" set:html={d.diagram.svg} />
              <p class="wheel-note">{say("the-figure.2", "Drawn from the same numbers as the tables above. The tables remain the reading.")}</p>
            </section>
          )
        }

          <KeepChart
            signedIn={!!reader}
            hasNativityConsent={hasNativityConsent}
            failed={keepFailed}
          />
      </>
    )
  }
</ToolLayout>

<style>
  /* Wide content scrolls inside its own box, never by moving the page.
   *
   * This matters more since `overflow-x: clip` went on <html>: without a
   * scroll container of its own, a table wider than a phone is now CLIPPED
   * rather than reachable — the columns past the edge simply cannot be read.
   * Clipping the page's accidental overflow is right; clipping a table is
   * not, and the difference is this rule. */
  .table-scroll { overflow-x: auto; -webkit-overflow-scrolling: touch; }
  .table-scroll table { min-width: 34rem; }

  .params { display: grid; gap: var(--space-4); }
  .param-rule { border: 0; border-top: var(--border-w) solid var(--line); margin: 0; }
  .param-panel { display: flex; gap: var(--space-3); flex-wrap: wrap; align-items: end; }
  .param-panel label { display: grid; gap: 4px; }
  .param-panel > label > span { font: 600 var(--text-micro) var(--font-body); letter-spacing: var(--tracking-eyebrow); text-transform: uppercase; color: var(--ink-faint); }
  .param-panel input, .param-panel select {
    font: 400 var(--text-sm) var(--font-body); color: var(--ink); background: var(--surface-page);
    border: var(--border-w) solid var(--line); border-radius: var(--radius-sm); padding: 8px 10px; min-height: 40px;
  }
  .param-panel .check { display: flex; gap: 8px; align-items: center; min-height: 40px; }
  .param-panel .check input { min-height: 0; accent-color: var(--accent); }
  /* Not an error, not a warning — a first-class choice. */
  .check-label { font: 400 var(--text-sm) var(--font-body) !important; color: var(--ink) !important; text-transform: none !important; letter-spacing: normal !important; }
  .param-panel button {
    appearance: none; min-height: 40px; padding: 0 16px; font: 600 var(--text-sm) var(--font-body);
    color: var(--on-accent); background: var(--accent); border: var(--border-w) solid var(--accent);
    border-radius: var(--radius-sm); cursor: pointer;
  }
  .privacy { font: 400 var(--text-xs) / 1.6 var(--font-body); color: var(--ink-faint); margin: 0; max-width: 66ch; }
  .prompt { font: 400 var(--text-body) var(--font-body); color: var(--ink-soft); margin: 0; }

  section h2 { font: 600 var(--text-h4) var(--font-display); color: var(--ink); margin: 0 0 8px; }
  .positions table { width: 100%; border-collapse: collapse; }
  .positions th[scope="col"] {
    text-align: left; font: 600 var(--text-micro) var(--font-body); letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase; color: var(--ink-faint); padding: 0 10px 8px 0; border-bottom: var(--border-w) solid var(--line-strong);
  }
  .positions td, .positions tbody th { padding: 8px 10px 8px 0; border-bottom: var(--border-w) solid var(--line); text-align: left; }
  .positions tbody th { font: 500 var(--text-body) var(--font-body); color: var(--ink); }
  .positions td { font: 400 var(--text-sm) var(--font-body); color: var(--ink-soft); }
  .positions .t-tabular { font-family: var(--font-mono); }
  .retro { color: var(--rose); }
  .faint { color: var(--ink-faint); font-size: var(--text-xs); }

---
/* One thing for sale.
 *
 * The buy button posts to our own API, which makes the Stripe session and
 * hands back where to go. Nothing that touches a card runs on this box, which
 * is what keeps the whole site outside PCI scope.
 */
import BaseLayout from "../../layouts/BaseLayout.astro";
import Prose from "../../components/content/Prose.astro";
import Button from "../../components/forms/Button.astro";
import CsrfField from "../../components/forms/CsrfField.astro";
import { site, PATHS, SITE_API, type ShopProduct } from "../../lib/api";
import { renderMarkdown } from "../../lib/markdown";
import { verifyCsrf } from "../../lib/csrf";
import { copy } from "../../lib/copy";

/* Every word here, editable from the admin. The defaults below are what
   it was written with and what still renders if nothing was changed. */
const say = await copy("shop/[slug]");


export const prerender = false;

const slug = Astro.params.slug ?? "";
const product = await site<ShopProduct>(PATHS.product(slug));
if (!product) return new Response(null, { status: 404, statusText: "Not found" });

let failed = "";

if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  if (!verifyCsrf(Astro.cookies, form)) {
    failed = "That did not go through. Reload the page and try again.";
  } else {
    const r = await fetch(`${SITE_API}/api/shop/checkout`, {
      method: "POST",
      headers: { "content-type": "application/json" },
      body: JSON.stringify({
        slug,
        quantity: Math.max(1, Math.min(20, Number(form.get("quantity") ?? 1))),
      }),
    });
    const body = await r.json().catch(() => null);
    if (r.ok && body?.url) return Astro.redirect(body.url, 303);
    failed = body?.detail ?? "Checkout could not be opened. Try again in a moment.";
  }
}

/* The first photograph leads; the rest sit under it. Falls back to `media` so
   a product from before there were several still shows its one. */
const gallery = product.photos?.length ? product.photos : product.media ? [product.media] : [];
const [lead, ...rest] = gallery;

const html = await renderMarkdown(product.bodyMd);
const money = `${(product.priceCents / 100).toFixed(2)} ${product.currency.toUpperCase()}`;

/* Availability comes from the API, which is also what the checkout enforces.
   Deriving it again here would be a second opinion, and the two would drift. */
const av = product.availability ?? { state: product.soldOut ? "sold-out" : "open",
                                     buyable: !product.soldOut, leadTime: "",
                                     opensAt: null, closesAt: null, madeToOrder: false };

const dateWords = (iso: string | null) =>
  iso ? new Date(iso).toLocaleDateString("en-GB",
        { day: "numeric", month: "long", year: "numeric" }) : "";

/* A shop page that does not say it is a shop page gets treated as an article.
 * Price, currency and availability are the three a result actually shows, and
 * all three are already on this page in words — this states them in the form a
 * machine reads, from the same values, so they cannot disagree with the label
 * beside the button.
 *
 * No rating and no review count. Both would be invented, and an invented
 * rating is the one thing here that gets a site penalised rather than ignored.
 */
const SITE = (import.meta.env.SHRUTI_SITE_URL ?? "https://shrutivtuber.com").replace(/\/$/, "");
const productUrl = `${SITE}/shop/${product.slug}`;
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Product",
  "@id": `${productUrl}#product`,
  name: product.name,
  description: product.tagline,
  url: productUrl,
  ...(lead?.url ? { image: new URL(lead.url, SITE).href } : {}),
  brand: { "@type": "Brand", name: "Shruti" },
  offers: {
    "@type": "Offer",
    url: productUrl,
    price: (product.priceCents / 100).toFixed(2),
    priceCurrency: product.currency.toUpperCase(),
    availability: {
      "open": "https://schema.org/InStock",
      "sold-out": "https://schema.org/SoldOut",
      "not-yet": "https://schema.org/PreOrder",
      "closed": "https://schema.org/Discontinued",
    }[av.state] ?? "https://schema.org/InStock",
    seller: { "@id": `${SITE}/#person` },
  },
};
---

<BaseLayout title={`${product.name} — Shruti`} description={product.tagline} jsonLd={jsonLd}>
  <div class="page product">
    <div class="shots">
      <div class="shot" data-empty={!lead}>
        {lead && <img src={lead.url} alt={lead.alt || product.name} />}
        {!lead && <span class="plate">{say("text.1", "no photograph yet")}</span>}
      </div>
      {rest.length > 0 && (
        <ol class="more">
          {rest.map((ph: { url: string; alt: string }) => (
            <li><img src={ph.url} alt={ph.alt || product.name} loading="lazy" /></li>
          ))}
        </ol>
      )}
    </div>

    <div class="detail">
      <p class="eyebrow"><a href="/shop">Shop</a></p>
      <h1>{product.name}</h1>
      {product.tagline && <p class="dek">{product.tagline}</p>}

      <p class="price">{money}</p>
      <p class="taxline">
        Tax included.
        {product.kind === "physical"
          ? " Posted to the address you give at checkout."
          : " A download link is emailed to you the moment it is paid for."}
      </p>

      {failed && <p class="adm-bad" role="alert">{failed}</p>}

      {av.leadTime && av.buyable && (
        <p class="lead-time">{av.leadTime}</p>
      )}

      {
        !av.buyable ? (
          <p class="sold" data-state={av.state}>
            {av.state === "not-yet"
              ? `Opens ${dateWords(av.opensAt)}. Nothing to do until then — it will simply be on sale.`
              : av.state === "closed"
              ? `That drop closed ${dateWords(av.closesAt)}. Things here come back when they come back, and this page will say so.`
              : "Sold out. There may be more later."}
          </p>
        ) : (
          <form method="POST" class="buy">
            <CsrfField />
            <label class="qty">
              <span>How many</span>
              <input type="number" name="quantity" value="1" min="1" max="20" />
            </label>
            <Button type="submit" size="lg">Buy it</Button>
          </form>
        )
      }

      {html && <Prose html={html} />}
    </div>
  </div>
</BaseLayout>

<style>
  .product {
    display: grid; gap: var(--space-6); margin-top: var(--space-6);
    grid-template-columns: minmax(0, 1fr);
  }
  @media (min-width: 960px) { .product { grid-template-columns: 1fr 1fr; } }
  .shots { display: grid; gap: var(--space-3); align-content: start; }
  .more {
    list-style: none; margin: 0; padding: 0; display: grid; gap: var(--space-3);
    grid-template-columns: repeat(auto-fill, minmax(88px, 1fr));
  }
  .more img {
    width: 100%; aspect-ratio: 1; object-fit: cover; display: block;
    border-radius: var(--radius-sm); border: var(--border-w) solid var(--line);
  }
  .shot {
    display: grid; place-items: center; background: var(--surface-veil);
    border: var(--border-w) solid var(--line); border-radius: var(--radius-md);
    overflow: hidden; aspect-ratio: 4 / 3;
  }
  .shot img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .plate { font: 400 var(--text-xs) var(--font-mono); color: var(--ink-faint); }
  .detail { display: grid; gap: var(--space-3); align-content: start; }
  .eyebrow { margin: 0; font: 400 var(--text-xs) var(--font-mono); }
  .eyebrow a { color: var(--accent); text-decoration: none; }
  h1 { margin: 0; font: 600 var(--text-h2) var(--font-display); color: var(--ink); }
  .dek { margin: 0; font: 400 var(--text-body) var(--font-body); color: var(--ink-soft); }
  .lead-time {
    font: 400 var(--text-sm) var(--font-mono); color: var(--ink-soft);
    margin: var(--space-2) 0 0;
  }
  .sold[data-state="not-yet"] { color: var(--accent); }
  .price { margin: var(--space-3) 0 0; font: 500 var(--text-h3) var(--font-mono); color: var(--accent); }
  .taxline { margin: 0; font: 400 var(--text-xs) var(--font-body); color: var(--ink-soft); }
  .sold { font: 500 var(--text-body) var(--font-body); color: var(--ink-soft); }
  .buy { display: flex; gap: var(--space-4); align-items: end; flex-wrap: wrap; margin-top: var(--space-3); }
  .qty { display: grid; gap: 4px; }
  .qty span { font: 400 var(--text-xs) var(--font-mono); color: var(--ink-soft); }
  .qty input {
    width: 88px; padding: 10px 12px; font: 400 var(--text-body) var(--font-body);
    border: var(--border-w) solid var(--line); border-radius: var(--radius-sm);
    background: var(--surface-card); color: var(--ink);
  }
</style>

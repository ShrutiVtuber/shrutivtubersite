---
/* Past readings.
 *
 * Readings do not expire. Someone who liked last October's should be able to
 * find it, and someone arriving in March should be able to read back rather
 * than meet an empty page because this month's twelve are not written yet.
 */
import BaseLayout from "../../layouts/BaseLayout.astro";
import SectionHeader from "../../components/brand/SectionHeader.astro";
import EmptyState from "../../components/feedback/EmptyState.astro";
import Button from "../../components/forms/Button.astro";
import { site } from "../../lib/api";
import { SIGNS } from "../../lib/signs";
import { copy } from "../../lib/copy";

/* Every word here, editable from the admin. The defaults below are what
   it was written with and what still renders if nothing was changed. */
const say = await copy("horoscopes/archive");


const sign = SIGNS.includes(Astro.url.searchParams.get("sign") ?? "")
  ? Astro.url.searchParams.get("sign")!
  : "";

interface Archive {
  period: string; sign: string | null; current: string;
  periods: { covers: string; signs: string[]; count: number }[];
}
/* Weekly is what she reads on stream; monthly is the newsletter's. The archive
   asked only for months, so a week's readings were written, published, and
   reachable at their own address while being invisible from the one page whose
   job is listing what exists. */
const PERIODS = ["weekly", "monthly", "yearly", "daily"] as const;
const period = (PERIODS as readonly string[]).includes(
  Astro.url.searchParams.get("period") ?? "",
)
  ? Astro.url.searchParams.get("period")!
  : "weekly";

const data = await site<Archive>(
  `/api/horoscopes/archive?period=${period}${sign ? `&sign=${sign}` : ""}`,
);
const periods = data?.periods ?? [];

const NAME = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);
/* Each period is named the way somebody would say it out loud. A week reads as
   the date it starts, not as "2026-W38", which is an identifier rather than a
   thing anybody says. */
const MONTH_YEAR = { month: "long", year: "numeric", timeZone: "UTC" } as const;

const coversName = (covers: string) => {
  const month = /^(\d{4})-(\d{2})$/.exec(covers);
  if (month) {
    return new Date(Date.UTC(Number(month[1]), Number(month[2]) - 1, 1))
      .toLocaleDateString("en-GB", MONTH_YEAR);
  }
  const week = /^(\d{4})-W(\d{2})$/.exec(covers);
  if (week) {
    /* ISO weeks: week 1 is the one holding 4 January, so step back to that
       week's Monday and forward by whole weeks. Counting sevens from the 1st
       drifts a week every few years. */
    const jan4 = new Date(Date.UTC(Number(week[1]), 0, 4));
    const monday = new Date(
      jan4.getTime() - ((jan4.getUTCDay() + 6) % 7) * 864e5
        + (Number(week[2]) - 1) * 7 * 864e5,
    );
    return `Week of ${monday.toLocaleDateString("en-GB", {
      day: "numeric", month: "long", year: "numeric", timeZone: "UTC",
    })}`;
  }
  const day = /^(\d{4})-(\d{2})-(\d{2})$/.exec(covers);
  if (day) {
    return new Date(`${covers}T00:00:00Z`).toLocaleDateString("en-GB", {
      day: "numeric", month: "long", year: "numeric", timeZone: "UTC",
    });
  }
  return covers;   /* a year is already what a person would say */
};
const monthName = coversName;
---

<BaseLayout
  title={sign ? `Every ${NAME(sign)} reading — Shruti` : "Past readings — Shruti"}
  description={say("text.1", "Every horoscope published so far. They do not expire.")}
>
  <div class="page archive">
    <SectionHeader
      as="h1" glyph="⁂" eyebrow="Archive"
      title={sign ? `Every ${NAME(sign)} reading` : "Past readings"}
      body={say("text.2", "Readings stay up. Nothing here expires.")}
    />

    {/* Which kind of reading. Weekly first: it is the one she writes on
        stream every week, and the monthly set is the newsletter's. Before
        this, a week's readings could be written, published and reachable at
        their own address while being invisible from the one page whose job is
        listing what exists. */}
    <nav class="periods-nav" aria-label={say("text.10", "Kind of reading")}>
      {
        PERIODS.map((p) => (
          <a
            href={`/horoscopes/archive?period=${p}${sign ? `&sign=${sign}` : ""}`}
            aria-current={p === period ? "page" : undefined}
          >
            {p.charAt(0).toUpperCase() + p.slice(1)}
          </a>
        ))
      }
    </nav>

    <nav class="filter" aria-label={say("text.3", "Filter by sign")}>
      <a href="/horoscopes/archive" aria-current={!sign ? "page" : undefined}>{say("text.6", "All signs")}</a>
      {
        SIGNS.map((s) => (
          <a
            href={`/horoscopes/archive?period=${period}&sign=${s}`}
            aria-current={s === sign ? "page" : undefined}
          >
            {NAME(s)}
          </a>
        ))
      }
    </nav>

    {
      periods.length === 0 ? (
        <EmptyState
          glyph="○"
          title={say("text.4", "Nothing published yet")}
          body={say("text.5", "Once a set of twelve readings goes up they stay here, and this fills in behind them.")}
        >
          <Button slot="action" variant="secondary" href={`/horoscopes?period=${period}`}>{say("text.7", "Current")}</Button>
        </EmptyState>
      ) : (
        <ul class="periods">
          {
            periods.map((p) => (
              <li>
                <div class="p-head">
                  <span class="p-name">{monthName(p.covers)}</span>
                  {p.covers === data?.current && <span class="p-now">{say("text.8", "current")}</span>}
                  <span class="t-tabular p-count">{p.count} of 12</span>
                </div>
                <div class="p-signs">
                  {
                    (sign ? [sign] : p.signs).map((s) => (
                      <a href={`/horoscopes/${s}/${period}/${p.covers}`}>{NAME(s)}</a>
                    ))
                  }
                </div>
              </li>
            ))
          }
        </ul>
      )
    }
  </div>
</BaseLayout>

<style>
  .periods-nav {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-bottom: var(--space-3);
  }
  .periods-nav a {
    font: 600 var(--text-xs) var(--font-body);
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--ink-faint);
    text-decoration: none;
    padding: 6px 12px;
    border: var(--border-w) solid var(--line);
    border-radius: var(--radius-pill, 999px);
  }
  .periods-nav a:hover { color: var(--ink); border-color: var(--line-strong); }
  .periods-nav a[aria-current="page"] {
    color: var(--accent);
    border-color: var(--accent);
    background: var(--accent-wash);
  }

  .archive { display: grid; gap: var(--space-5); }
  .filter { display: flex; gap: 4px; flex-wrap: wrap; }
  .filter a {
    font: 500 var(--text-xs) var(--font-body); color: var(--ink-soft); text-decoration: none;
    padding: 7px 12px; border-radius: var(--radius-full);
    border: var(--border-w) solid var(--line); min-height: 36px;
    display: inline-flex; align-items: center;
  }
  .filter a:hover { border-color: var(--line-strong); color: var(--ink); }
  .filter a[aria-current="page"] { background: var(--accent-wash); border-color: color-mix(in srgb, var(--accent) 50%, transparent); color: var(--accent); }

  .periods { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--space-4); }
  .periods li { border-top: var(--border-w) solid var(--line); padding-top: var(--space-4); }
  .p-head { display: flex; gap: 12px; align-items: baseline; flex-wrap: wrap; }
  .p-name { font: 600 var(--text-h3) var(--font-display); color: var(--ink); }
  .p-now {
    font: 600 0.625rem var(--font-mono); letter-spacing: var(--tracking-caps);
    text-transform: uppercase; color: var(--accent);
  }
  .p-count { font: 400 var(--text-xs) var(--font-mono); color: var(--ink-faint); margin-left: auto; }
  .p-signs { display: flex; gap: 6px; flex-wrap: wrap; margin-top: 10px; }
  .p-signs a {
    font: 400 var(--text-sm) var(--font-body); color: var(--ink-soft); text-decoration: none;
    border: var(--border-w) solid var(--line); border-radius: var(--radius-sm);
    padding: 6px 12px; min-height: 36px; display: inline-flex; align-items: center;
  }
  .p-signs a:hover { border-color: var(--accent); color: var(--accent); }
</style>

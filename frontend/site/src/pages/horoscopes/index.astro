---
/* Horoscope index — `ui_kits/site/Horoscopes.jsx`.
 *
 * The sign picker is the primary control. A SIGNED-IN READER WITH A SAVED
 * NATIVITY SEES THEIR OWN SIGN FIRST, without picking — that is the whole
 * reward for having an account, so it is an accent-wash band naming their sign
 * rather than a subtle highlight.
 */
import BaseLayout from "../../layouts/BaseLayout.astro";
import SectionHeader from "../../components/brand/SectionHeader.astro";
import SignPicker from "../../components/navigation/SignPicker.astro";
import PeriodSwitcher from "../../components/navigation/PeriodSwitcher.astro";
import Prose from "../../components/content/Prose.astro";
import Button from "../../components/forms/Button.astro";
import EmptyState from "../../components/feedback/EmptyState.astro";
import { site } from "../../lib/api";
import { account } from "../../lib/account";
import { renderMarkdown } from "../../lib/markdown";
import { sunSign } from "../../lib/signs";
import Copy from "../../components/content/Copy.astro";
import { copy } from "../../lib/copy";

const t = await copy("horoscopes");


const period = Astro.url.searchParams.get("period") ?? "monthly";
/* Readings do not expire. `covers` opens a past month; without it you get the
   current one. */
const covers = Astro.url.searchParams.get("covers") ?? "";
const coversQuery = covers ? `&covers=${encodeURIComponent(covers)}` : "";

interface Index {
  period: string; covers: string; availablePeriods: string[];
  readings: { sign: string; published: boolean; bodyMd: string }[];
}
const data = await site<Index>(`/api/horoscopes?period=${encodeURIComponent(period)}${coversQuery}`);
const me = await account(Astro);
const yours = me?.nativity ? sunSign(me.nativity.birthDate) : null;

const readings = data?.readings ?? [];
const yourReading = yours ? readings.find((r) => r.sign === yours) : null;
const yourHtml = yourReading?.published ? await renderMarkdown(yourReading.bodyMd) : "";
const anyPublished = readings.some((r) => r.published);
const NAME = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);
---

<BaseLayout title="Horoscopes — Shruti" description="Twelve readings a month, one per sign, written by hand from a real ephemeris rather than generated. This month's, and the archive of every one before it.">
  <div class="page horoscopes">
    <SectionHeader
      as="h1" glyph="☾" eyebrow="Horoscopes" title={data?.covers && data.covers !== new Date().toISOString().slice(0, 7) ? data.covers : "This month"}
      body="Twelve a month, one per sign, written by hand."
    />

    <div class="controls">
      <PeriodSwitcher
        available={data?.availablePeriods ?? ["monthly"]}
        current={period}
        hrefFor={(p) => `/horoscopes?period=${p}`}
      />
      <a class="archive-link" href="/horoscopes/archive">Past readings →</a>
    </div>

    {
      yours && yourReading?.published && (
        <section class="yours-band">
          <p class="t-eyebrow">Your sign</p>
          <h2>{NAME(yours)}</h2>
          <Prose html={yourHtml} byline="Soror Eu. A." />
          <div><Button variant="secondary" href={`/horoscopes/${yours}/${period}${covers ? `?covers=${covers}` : ""}`}>Open the reading</Button></div>
        </section>
      )
    }
    {
      !me && (
        <p class="invite"><Copy text={t("text.1", "With a saved nativity your own sign appears here first, without picking it. [Make an account](/signup) — everything else on this page works without one.")} /></p>
      )
    }

    {
      anyPublished ? (
        <SignPicker
          signs={readings.map((r) => ({ sign: r.sign, published: r.published }))}
          yours={yours ?? undefined}
          hrefFor={(s) => `/horoscopes/${s}/${period}${covers ? `?covers=${covers}` : ""}`}
        />
      ) : (
        <EmptyState
          glyph="○"
          title="Nothing written for this month yet"
          body="Twelve readings go up together — an empty reading is worse than a late one, so none appear until all twelve exist."
        />
      )
    }
  </div>
</BaseLayout>

<style>
  .horoscopes { display: grid; gap: var(--space-5); }
  .controls { display: flex; gap: var(--space-4); align-items: center; flex-wrap: wrap; }
  .archive-link { margin-left: auto; font: 500 var(--text-sm) var(--font-body); color: var(--accent); text-decoration: none; }
  .archive-link:hover { text-decoration: underline; }
  .yours-band {
    background: var(--accent-wash);
    border: var(--border-w) solid color-mix(in srgb, var(--accent) 40%, transparent);
    border-radius: var(--radius-md); padding: var(--space-5); display: grid; gap: 10px;
  }
  .yours-band h2 { font: 500 var(--text-h2) var(--font-display); color: var(--ink); margin: 0; }
  .invite { font: 400 var(--text-sm) / 1.7 var(--font-body); color: var(--ink-soft); margin: 0; max-width: 64ch; }
  .invite a { color: var(--accent); }
</style>

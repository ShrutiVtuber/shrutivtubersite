---
/* Videos — ported from `ui_kits/site/Videos.jsx`.
 *
 * The design says "auto-pulled from Twitch and YouTube". Neither API key is
 * configured, so there is nothing real to pull. Rather than ship the
 * reference's six sample VODs — which would be inventing a back catalogue —
 * the page renders its designed empty state and says plainly why.
 *
 * This is the same rule as the live badge: never claim, never fake. The
 * moment the keys exist this page fills itself.
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionHeader from "../components/brand/SectionHeader.astro";
import VideoCard from "../components/cards/VideoCard.astro";
import EmptyState from "../components/feedback/EmptyState.astro";
import Button from "../components/forms/Button.astro";
import { site, PATHS, type LiveStatus } from "../lib/api";
import { badgeFrom } from "../lib/live";

interface Video {
  id: string; title: string; platform: "twitch" | "youtube"; duration?: string;
  date?: string; href: string; thumb?: string | null;
}
interface Feed { videos: Video[]; counts: { youtube: number; twitch: number } }

const [feed, liveStatus] = await Promise.all([
  site<Feed>("/api/videos"),
  site<LiveStatus>(PATHS.live),
]);
const videos = feed?.videos ?? [];
const live = badgeFrom(liveStatus);
const siteUrl = import.meta.env.SHRUTI_SITE_URL ?? "https://shrutivtuber.com";

/* VideoObject, one per video.
 *
 * THIS is what puts a video in search results — a browser fetching a
 * thumbnail from Google's own CDN sends Search nothing and earns no ranking.
 * Structured data is the part Google actually reads, and it is what makes a
 * video eligible for the rich result with a still and a duration.
 *
 * `contentUrl` points at the platform because that is where the video is; the
 * page is named as `url` so a click from search lands here. Nothing is
 * asserted that is not known: a video with no duration simply omits it rather
 * than claiming PT0S. */
const ISO_DURATION = (d?: string) => {
  if (!d) return undefined;
  const m = /^(?:(\d+)h)?(?:(\d+)m)?(?:(\d+)s)?$/.exec(d.trim());
  if (!m) return undefined;
  const [, h, mi, sec] = m;
  if (!h && !mi && !sec) return undefined;
  return `PT${h ? h + "H" : ""}${mi ? mi + "M" : ""}${sec ? sec + "S" : ""}`;
};

const jsonLd = videos.length > 0
  ? {
      "@context": "https://schema.org",
      "@type": "ItemList",
      itemListElement: videos.map((v, i) => ({
        "@type": "ListItem",
        position: i + 1,
        item: {
          "@type": "VideoObject",
          name: v.title,
          uploadDate: v.date || undefined,
          thumbnailUrl: v.thumb ? new URL(v.thumb, siteUrl).href : undefined,
          contentUrl: v.href,
          url: new URL("/videos", siteUrl).href,
          duration: ISO_DURATION(v.duration),
          publisher: { "@type": "Person", name: "Shruti" },
        },
      })),
    }
  : null;
---

<BaseLayout title="Videos — Shruti" description="Past streams and VODs from Twitch and YouTube — programming, astrology, and the building of the instruments on this site, collected in one place.">
  <div class="page">
    <div class="section-head">
      <SectionHeader
        as="h1" glyph="▶" eyebrow="Videos" title="Streams & VODs"
        body="Auto-pulled from Twitch and YouTube."
      />
      {
        feed && (feed.counts.youtube > 0 || feed.counts.twitch > 0) && (
          <p class="video-counts t-tabular">
            {feed.counts.youtube > 0 && <>{feed.counts.youtube} on YouTube</>}
            {feed.counts.youtube > 0 && feed.counts.twitch > 0 && <> · </>}
            {feed.counts.twitch > 0 && <>{feed.counts.twitch} VODs on Twitch</>}
          </p>
        )
      }
    </div>

    {
      videos.length > 0 ? (
        <div class="grid-3 video-grid">
          {videos.map((v) => (
            <VideoCard
              title={v.title} platform={v.platform} duration={v.duration}
              date={v.date} href={v.href} thumb={v.thumb ?? null}
            />
          ))}
        </div>
      ) : (
        <EmptyState
          as="h2"
          glyph="◐"
          title="Nothing pulled through yet"
          body={
            live.status === "live"
              ? "The stream is live now — past VODs will appear here once the platform connections are in place."
              : "Past VODs appear here automatically once the Twitch and YouTube connections are in place. Nothing is hidden; there is simply nothing fetched yet."
          }
        >
          <div slot="action" class="video-actions">
            {live.status === "live" && live.href && (
              <Button variant="live" href={live.href}>Watch live</Button>
            )}
            <Button variant="secondary" href="/schedule">See the schedule</Button>
          </div>
        </EmptyState>
      )
    }
  </div>
  {
    /* Rendered last so it never delays the page, and only when there is
       something true to say. */
    jsonLd && (
      <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    )
  }
</BaseLayout>

<style>
  .video-counts { font: 400 var(--text-xs) var(--font-mono); color: var(--ink-faint); margin: 6px 0 0; }

  .video-grid { margin-top: var(--space-6); }
  .video-actions { display: flex; gap: 10px; flex-wrap: wrap; justify-content: center; }
</style>

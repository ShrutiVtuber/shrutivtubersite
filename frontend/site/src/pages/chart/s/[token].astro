---
/* A chart somebody shared — what the friend sees.
 *
 * The birth date, time and place are NOT printed here, and the address carries
 * none of them either. That is worth doing: it keeps the moment out of a
 * browser history, out of a forwarded link, out of a screenshot of the address
 * bar, and away from anybody who is not an astrologer.
 *
 * It does not, and cannot, keep it from somebody who reads charts. The
 * ascendant gives the birth time to within a few minutes; the planets give the
 * date. The figure IS the birth data, drawn. The person who made this link was
 * told exactly that before they made it, which is the only honest way to offer
 * a feature whose privacy has a hard limit.
 *
 * Nothing here says whose chart it is unless they typed a name into the label.
 */
import BaseLayout from "../../../layouts/BaseLayout.astro";
import SectionHeader from "../../../components/brand/SectionHeader.astro";
import ChartFigure from "../../../components/chart/ChartFigure.astro";
import EmptyState from "../../../components/feedback/EmptyState.astro";
import { site } from "../../../lib/api";
import { asReader } from "../../../lib/account";
import { verifyCsrf } from "../../../lib/csrf";
import CsrfField from "../../../components/forms/CsrfField.astro";
import Button from "../../../components/forms/Button.astro";
import { copy } from "../../../lib/copy";
import Copy from "../../../components/content/Copy.astro";

/* Every word on this page, editable from the admin. The defaults below are
   what it was written with and what still renders if nothing was changed. */
const say = await copy("chart/s/[token]");


export const prerender = false;

const token = Astro.params.token ?? "";
let compareFailed = "";

/* Comparing what somebody sent you against your own is the thing this feature
   is FOR, and the visitor holds a share token rather than an owner token. The
   API accepts either on the right-hand side and neither lets the holder act as
   an owner — see `_chart_by_any`. */
if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  if (!verifyCsrf(Astro.cookies, form)) {
    compareFailed = say("error.failed2", "That did not go through. Reload and try again.");
  } else {
    const mine = String(form.get("mine") ?? "").trim();
    if (!mine) {
      compareFailed = say("text.paste.address.your", "Paste the address of one of your own kept charts first.");
    } else {
      /* They paste a URL, because that is what they have. Take the last path
         segment and let the API decide whether it is a real token. */
      const theirToken = mine.split("?")[0].replace(/\/$/, "").split("/").pop() ?? "";
      const made = await asReader(Astro, "/api/charts/compare", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          left: theirToken,
          right: token,
          label: String(form.get("label") ?? ""),
          consent: form.get("consent") === "1",
        }),
      });
      if (made.ok && made.body?.ownerToken) {
        return Astro.redirect(`/chart/compare/${made.body.ownerToken}`, 303);
      }
      compareFailed = made.status === 404
        ? say("text.that.address.match", "That address did not match a chart you have kept.")
        : made.body?.detail ?? say("error.failed", "The comparison could not be made.");
    }
  }
}
const c = await site<any>(`/api/charts/s/${token}`).catch(() => null);

const TRADITION = { hellenistic: "Hellenistic", vedic: "Vedic" };
const FIGURE = { wheel: "a wheel", north: say("text.north.indian.square", "a North Indian square"), south: say("text.south.indian.square", "a South Indian square") };
---

<BaseLayout
  title={say("text.4", "A shared chart — Shruti")}
  description={say("text.5", "A chart somebody chose to show you.")}
  noindex
>
  <div class="page shared">
    {
      !c ? (
        <EmptyState
          glyph="○"
          title={say("text.6", "There is nothing at this address")}
          body={say("text.7", "The link may be mistyped, or the person who made it may have taken it back. A shared chart stops working the moment they decide it should.")}
        />
      ) : (
        <>
          <SectionHeader
            as="h1"
            glyph="✶"
            eyebrow={say("text.8", "Shared with you")}
            title={c.label || "A chart"}
          />

          <ChartFigure
            when={c.when}
            timeUnknown={c.timeUnknown}
            lat={c.lat}
            lon={c.lon}
            tradition={c.tradition}
            houseSystem={c.houseSystem}
            figure={c.figure}
            caption={`${TRADITION[c.tradition] ?? c.tradition}, drawn as ${FIGURE[c.figure] ?? c.figure}.`}
          />

          {
            c.timeUnknown && (
              <p class="undef">{say("text.1", "◐ The birth time was not known, so the ascendant, the houses and everything that depends on them are undefined rather than approximate. The planets are drawn for noon.")}</p>
            )
          }

          <p class="fine">
            <a href={`/chart/print/${token}`}>{say("text.2", "Print it, or save it as a PDF")}</a>
          </p>

          <p class="fine">{say("text.3", "This page does not print the date, the time or the place — the person who shared it kept those. What you are looking at was drawn from them.")}</p>

          <section class="yours compare-with">
            <h2>{say("compare-it-with-yours.1", "Compare it with yours")}</h2>
            <p class="fine">{say("compare-it-with-yours.2", "If you have kept a chart of your own, paste its address and this will read the two against each other — and give you somewhere to write what you make of it.")}</p>
            {compareFailed && <p class="c-bad">{compareFailed}</p>}
            <form method="POST" class="c-form">
              <CsrfField />
              <label>
                <span class="c-lbl">{say("compare-it-with-yours.3", "The address of your kept chart")}</span>
                <input class="c-in" name="mine" placeholder={say("text.11", "https://shrutivtuber.com/chart/…")} />
              </label>
              <label>
                <span class="c-lbl">{say("compare-it-with-yours.4", "Call the comparison something")}</span>
                <input class="c-in" name="label" maxlength="80" placeholder={say("text.12", "Us")} />
              </label>
              <label class="c-consent">
                <input type="checkbox" name="consent" value="1" />
                <span>{say("compare-it-with-yours.5", "Keeping a comparison keeps a pointer at both birth moments. Deleting either chart deletes it.")}</span>
              </label>
              <div><Button type="submit" data-track="comparison:made">{say("text.9", "Compare them")}</Button></div>
            </form>
          </section>

          <section class="yours">
            <h2>{say("cast-your-own.1", "Cast your own")}</h2>
            <p class="fine">{say("cast-your-own.2", "The same instrument, free, and it works without an account. It says what it cannot compute rather than guessing — an unknown birth time leaves the angles undefined instead of inventing them.")}</p>
            <p>
              <a class="sh-btn" data-variant="primary" data-size="md" href="/tools/natal-chart" data-track="chart:from-share">
                <span>{say("text.10", "Cast a chart")}</span>
              </a>
            </p>
            {/* The letter, mentioned rather than formed. A second subscribe
                form here would mean a second copy of the consent handling,
                and that is the part of this site not to have two of. */}
            <p class="fine">
              <Copy text={say("cast-your-own.3", "There is also [a monthly letter](/newsletter) — what shipped, what the sky is doing, and the occasional paid thing. One click to leave, from any issue.")} />
            </p>
          </section>
        </>
      )
    }
  </div>
</BaseLayout>

<style>
  .shared { max-width: 720px; display: grid; gap: var(--space-5); justify-items: center; }
  .fine {
    font: 400 var(--text-sm) / 1.7 var(--font-body); color: var(--ink-soft);
    margin: 0; max-width: 58ch; text-align: center;
  }
  .undef {
    font: 400 var(--text-sm) / 1.7 var(--font-body); color: var(--ink);
    margin: 0; max-width: 58ch;
    border-left: 2px solid var(--rose); padding-left: var(--space-3);
  }
  .yours {
    display: grid; gap: var(--space-3); justify-items: center; text-align: center;
    padding: var(--space-5); width: 100%; box-sizing: border-box;
    background: var(--surface-veil);
    border: var(--border-w) solid var(--line);
    border-radius: var(--radius-md);
  }
  .yours h2 { font: 600 var(--text-h4) var(--font-display); color: var(--ink); margin: 0; }
  .compare-with { text-align: left; justify-items: start; }
  .c-form { display: grid; gap: var(--space-3); width: 100%; max-width: 46ch; text-align: left; }
  .c-form label { display: grid; gap: 6px; }
  .c-lbl {
    font: 600 var(--text-micro) var(--font-body); letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase; color: var(--ink-faint);
  }
  .c-in {
    font: 400 var(--text-sm) var(--font-body); color: var(--ink);
    background: var(--surface-page); border: var(--border-w) solid var(--line);
    border-radius: var(--radius-sm); padding: 8px 10px; min-height: 40px;
    width: 100%; box-sizing: border-box;
  }
  .c-consent { display: flex; gap: 10px; align-items: flex-start; }
  .c-consent span { font: 400 var(--text-sm) / 1.6 var(--font-body); color: var(--ink-soft); }
  .c-consent input { margin-top: 4px; flex: none; }
  .c-bad { font: 400 var(--text-sm) var(--font-body); color: var(--live); margin: 0; }
</style>

---
/* Builds (board Builds, 20 Sep 2026): one character's goals, slot by slot —
 * the ones a person has as rows that carry the build's own shape, and a
 * console frame to start one from a template of the game's. */
import BaseLayout from "../../layouts/BaseLayout.astro";
import Head from "../../components/guides/Head.astro";
import Empty from "../../components/guides/Empty.astro";
import Console from "../../components/guides/Console.astro";
import Sigil from "../../components/guides/Sigil.astro";
import SelectField from "../../components/forms/SelectField.astro";
import TextField from "../../components/forms/TextField.astro";
import Button from "../../components/forms/Button.astro";
import { site } from "../../lib/api";
import { account, asReader } from "../../lib/account";
import { copy } from "../../lib/copy";
import { buildStates } from "../../lib/guides-sigil";

const say = await copy("builds");
const me = await account(Astro);
if (!me) return Astro.redirect("/signin?next=%2Fbuilds");
type Template = { id: number; name: string; description: string; game: { slug: string; name: string } | null; categories: { items: unknown[] }[] };
type Cat = { id: string; name: string; met: number; total: number; ratio: number; partly?: number };
type BuildRow = { id: number; name: string; variant: string; template: Template | null; progress: { met: number; total: number; ratio: number; complete: boolean; categories: Cat[] } };
const [templates, mineRead, runsRead] = await Promise.all([
  site<Template[]>("/api/builds/templates"),
  asReader(Astro, "/api/builds"),
  asReader(Astro, "/api/runs"),
]);
const list: Template[] = Array.isArray(templates) ? templates : [];
const builds: BuildRow[] = mineRead.ok && Array.isArray(mineRead.body) ? mineRead.body : [];
const runs: { id: number; name: string }[] = runsRead.ok && Array.isArray(runsRead.body) ? runsRead.body : [];
const WORDS = { needsName: say("words.needs_name", "A build needs a name."), needsTemplate: say("words.needs_template", "Pick the game's template."), failed: say("words.failed", "That did not go through. Try again.") };
const variantLine = (b: BuildRow) => [b.template?.game?.name, b.variant].filter(Boolean).join(" · ");
const ledger = (b: BuildRow) => b.progress.categories.map((c) => `${c.name} ${c.met}/${c.total}`).join(" · ");
const rowAria = (b: BuildRow) => say("row.aria", "{met} of {total} met").replace("{met}", String(b.progress.met)).replace("{total}", String(b.progress.total));
---

<BaseLayout title={say("meta.title", "Builds — Squirrel Guides")} description={say("meta.description", "One character's goals, slot by slot, on your account and on stream.")} noindex>
  <section class="page builds" data-builds data-words={JSON.stringify(WORDS)}>
    <Head as="h1" eyebrow={say("head.eyebrow", "Builds")} title={say("head.title", "Your builds")}
      lede={say("head.lede", "A build is a set of goals for one character: the gear you want in each slot, the points to reach, the pieces to put in place. Each is met, partly met or not yet — and the whole thing draws on stream.")} />
    <p class="gd-rule-note" data-note hidden></p>

    {builds.length === 0 ? (
      <Empty n={4} eyebrow={say("empty.eyebrow", "Builds")} title={say("empty.title", "Start a build.")}
        body={say("empty.body", "Pick a template and name the character. The goals appear as rows you fill in your own words — met, partly, not yet — and the sigil draws one arc per category.")}
        action={say("empty.action", "Start a build")} href="#start" ringAria={say("empty.ring", "An empty ring")} />
    ) : (
      <ul class="gd-rows">
        {builds.map((b) => (
          <li>
            <a class="gd-row" href={`/builds/${b.id}`}>
              <Sigil n={Math.max(1, b.progress.categories.length)} states={buildStates(b.progress.categories)} size={44} ring={false} showCount={false} aria={rowAria(b)} />
              <div class="gd-row-main">
                <span class="gd-row-title">
                  <span class="gd-row-name">{b.name}</span>
                  {b.progress.complete && <span class="gd-pill-complete">{say("row.complete", "Complete")}</span>}
                </span>
                {variantLine(b) && <span class="gd-row-variant">{variantLine(b)}</span>}
                <span class="gd-row-ledger">{ledger(b)}</span>
              </div>
              <div class="gd-row-right">
                <span class="gd-row-num" data-complete={b.progress.complete}>{b.progress.met} <span class="gd-of">/ {b.progress.total}</span></span>
                <span class="gd-row-under">{say("row.met", "met")}</span>
              </div>
            </a>
          </li>
        ))}
      </ul>
    )}

    <section id="start" class="start">
      <Console as="form" eyebrow={say("new.title", "Start a build")} note={say("new.note", "one character · one set of goals")} data-new-form>
        <SelectField label={say("new.template", "Template")} name="template" data-template hint={say("new.template_hint", "Mine, per game. The template decides the categories; you decide the goals.")}
          options={list.map((t) => ({ value: String(t.id), label: `${t.game?.name ?? ""} · ${t.name}` }))} />
        {list.length === 0 && <p class="gd-hint">{say("new.none", "No templates yet. Shruti adds a game's template when the game is ready.")}</p>}
        <TextField label={say("new.name", "Name")} name="name" data-name maxlength="80" required placeholder={say("new.name_hint", "The character's name")} />
        <TextField label={say("new.variant", "Variant")} name="variant" data-variant maxlength="80" placeholder={say("new.variant_hint", "Sorcerer · Season 15")} hint={say("new.variant_note", "Class, then season or league.")} />
        <SelectField label={say("new.run", "Beside a run")} name="run" data-run
          options={[{ value: "", label: say("new.no_run", "None — a build can stand alone") }, ...runs.map((r) => ({ value: String(r.id), label: r.name }))]} />
        <div><Button type="submit">{say("new.go", "Start")}</Button></div>
      </Console>
      <aside class="aside">
        <div class="aside-sigil">
          <Sigil n={4} states="dnoo" size={88} ring label={say("aside.label", "1 / 4")} aria={say("aside.aria", "One arc per category")} />
          <p>{say("aside.arcs", "One arc per category. Rose when every goal in it is met, blue while some are, empty until you start.")}</p>
        </div>
        <dl class="kinds">
          <div><dt>{say("aside.slot", "slot")}</dt><dd>{say("aside.slot_text", "a target in your words — not yet · partly · met")}</dd></div>
          <div><dt>{say("aside.counter", "counter")}</dt><dd>{say("aside.counter_text", "have of want — met when have reaches want")}</dd></div>
          <div><dt>{say("aside.check", "check")}</dt><dd>{say("aside.check_text", "done or not")}</dd></div>
        </dl>
        <p class="complete-line"><strong>{say("aside.complete", "Complete")}</strong> {say("aside.complete_text", "— the build is on the character. A state, not a score.")}</p>
      </aside>
    </section>
  </section>
</BaseLayout>

<style>
  .builds { padding-block: var(--space-6) 0; display: grid; gap: var(--space-7); }
  .start { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr)); gap: var(--space-6); align-items: start; scroll-margin-top: 80px; }
  .aside { display: grid; gap: 12px; align-content: start; padding-top: 4px; }
  .aside-sigil { display: flex; align-items: center; gap: 14px; }
  .aside-sigil p { margin: 0; font-size: 14px; color: var(--ink-soft); max-width: 36ch; text-wrap: pretty; }
  .kinds { margin: 0; display: grid; gap: 8px; font-size: 14px; max-width: 44ch; }
  .kinds div { display: flex; gap: 10px; align-items: baseline; }
  .kinds dt { font-family: var(--font-mono); font-size: 13px; color: var(--ink); width: 7ch; flex: none; }
  .kinds dd { margin: 0; color: var(--ink-soft); }
  .complete-line { margin: 0; font-size: 14px; color: var(--ink-soft); max-width: 44ch; }
  .complete-line strong { color: var(--rose); font-weight: 600; }
</style>

<script>
  import { mountBuilds } from "../../lib/builds";
  const root = document.querySelector<HTMLElement>("[data-builds]");
  if (root) mountBuilds(root);
</script>

---
/* Builds: one character's goals, slot by slot — the ones a person has, and
 * a way to start one from a template of the game's. */
import BaseLayout from "../../layouts/BaseLayout.astro";
import SectionHeader from "../../components/brand/SectionHeader.astro";
import EmptyState from "../../components/feedback/EmptyState.astro";
import SelectField from "../../components/forms/SelectField.astro";
import TextField from "../../components/forms/TextField.astro";
import Button from "../../components/forms/Button.astro";
import { site } from "../../lib/api";
import { account, asReader } from "../../lib/account";
import { copy } from "../../lib/copy";

const say = await copy("builds");
const me = await account(Astro);
if (!me) return Astro.redirect("/signin?next=%2Fbuilds");
type Template = { id: number; name: string; description: string; game: { slug: string; name: string } | null; categories: { items: unknown[] }[] };
type BuildRow = { id: number; name: string; variant: string; template: Template | null; progress: { met: number; total: number; ratio: number; complete: boolean; categories: { id: string; name: string; met: number; total: number; ratio: number }[] } };
const [templates, mineRead, runsRead] = await Promise.all([
  site<Template[]>("/api/builds/templates"),
  asReader(Astro, "/api/builds"),
  asReader(Astro, "/api/runs"),
]);
const list: Template[] = Array.isArray(templates) ? templates : [];
const builds: BuildRow[] = mineRead.ok && Array.isArray(mineRead.body) ? mineRead.body : [];
const runs: { id: number; name: string }[] = runsRead.ok && Array.isArray(runsRead.body) ? runsRead.body : [];
const WORDS = { needsName: say("words.needs_name", "A build needs a name."), needsTemplate: say("words.needs_template", "Pick the game's template."), failed: say("words.failed", "That did not go through. Try again.") };
---

<BaseLayout title={say("meta.title", "Builds — Squirrel Guides")} description={say("meta.description", "One character's goals, slot by slot, on your account and on stream.")} noindex>
  <section class="page builds" data-builds data-words={JSON.stringify(WORDS)}>
    <SectionHeader as="h1" eyebrow={say("head.eyebrow", "Squirrel Guides")} title={say("head.title", "Builds")} />
    <p class="lede">{say("head.lede", "A build is a set of goals for one character: the gear you want in each slot, the points to reach, the pieces to put in place. Each is met, partly met or not yet — and the whole thing draws on stream.")}</p>
    <p class="note" data-note hidden></p>

    {builds.length === 0 ? (
      <EmptyState title={say("empty.title", "No builds yet.")} body={say("empty.text", "Start one below from the game's template, then write your targets into the slots.")}>
        <Button slot="action" href="#new" variant="secondary">{say("empty.action", "Start a build")}</Button>
      </EmptyState>
    ) : (
      <ul class="list">
        {builds.map((b) => (
          <li>
            <a href={`/builds/${b.id}`}>
              <span class="name">{b.name}</span>
              <span class="game">{b.template?.game?.name}{b.variant && ` · ${b.variant}`}</span>
              <span class="mono">{say("row.count", "{met} / {total}").replace("{met}", String(b.progress.met)).replace("{total}", String(b.progress.total))}{b.progress.complete && ` · ${say("row.complete", "complete")}`}</span>
              <span class="cats mono">{b.progress.categories.map((c) => `${c.name} ${c.met}/${c.total}`).join(" · ")}</span>
            </a>
          </li>
        ))}
      </ul>
    )}

    <form class="card" id="new" data-new-form>
      <h2>{say("new.title", "Start a build")}</h2>
      <SelectField label={say("new.template", "Template")} name="template" data-template
        options={list.map((t) => ({ value: String(t.id), label: `${t.game?.name ?? ""} · ${t.name}` }))} />
      {list.length === 0 && <p class="quiet">{say("new.none", "No templates yet. Shruti adds a game's template when the game is ready.")}</p>}
      <TextField label={say("new.name", "Name")} name="name" data-name maxlength="80" placeholder={say("new.name_hint", "Squirrel · Season 15")} />
      <TextField label={say("new.variant", "Variant")} name="variant" data-variant maxlength="80" placeholder={say("new.variant_hint", "Class · season or league")} />
      {runs.length > 0 && (
        <SelectField label={say("new.run", "Beside a run · optional")} name="run" data-run
          options={[{ value: "", label: say("new.no_run", "No run") }, ...runs.map((r) => ({ value: String(r.id), label: r.name }))]} />
      )}
      <div><Button type="submit">{say("new.go", "Start")}</Button></div>
    </form>
  </section>
</BaseLayout>

<style>
  .builds { max-width: 680px; margin: 0 auto; padding: var(--space-6) var(--space-4); display: grid; gap: var(--space-5); }
  .lede { color: var(--ink-soft); max-width: 62ch; }
  .note { border-left: 2px solid var(--accent); padding-left: var(--space-3); }
  .quiet { color: var(--ink-soft); }
  .list { list-style: none; margin: 0; padding: 0; display: grid; gap: 1px; background: var(--line); border: var(--border-w) solid var(--line); border-radius: var(--radius-md); overflow: hidden; }
  .list a { display: grid; gap: 4px; padding: var(--space-3) var(--space-4); background: var(--surface-card); color: inherit; text-decoration: none; }
  .list a:hover .name { color: var(--accent); }
  .list .name { font-weight: 600; }
  .list .game { color: var(--ink-soft); }
  .mono { font-family: var(--font-mono); font-variant-numeric: tabular-nums; font-size: .85rem; color: var(--ink-soft); }
  .card { border-top: var(--border-w) solid var(--line); padding-top: var(--space-4); display: grid; gap: var(--space-3); scroll-margin-top: 80px; }
  .card h2 { font: 600 var(--text-h3) var(--font-display); margin: 0; }
</style>

<script>
  import { mountBuilds } from "../../lib/builds";
  const root = document.querySelector<HTMLElement>("[data-builds]");
  if (root) mountBuilds(root);
</script>

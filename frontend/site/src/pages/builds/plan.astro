  .pl-writes .gd-mono { font-size: 13px; color: var(--ink); text-wrap: pretty; }
  .pl-slot-actions { display: flex; align-items: center; gap: 12px; }
  .pl-keep { font-family: var(--font-body); font-size: 14px; font-weight: 600; color: var(--on-accent);
    background: var(--accent); border: 1px solid var(--accent); border-radius: 4px; padding: 10px 18px; min-height: 40px; cursor: pointer; }
  .pl-keep:hover { background: var(--accent-hover); border-color: var(--accent-hover); }
  .pl-keep:active { transform: translateY(1px); }
</style>

<style is:global>
  .pl-refused { display: grid; gap: 6px; padding: 16px; border: 1px solid var(--line-strong); border-radius: 4px; }
  .pl-refused .gd-mono { font-size: 13px; color: var(--ink-soft); }
  .pl-start { padding-top: 8px; border-top: 1px solid var(--line-strong); }
</style>

<style is:global>
  .pl-record { z-index: 45; }
  .pl-read { border: 0; background: none; color: var(--accent); font-family: var(--font-body); font-size: 12px;
    cursor: pointer; padding: 4px 8px; justify-self: end; }
  .pl-read:hover { color: var(--accent-hover); text-decoration: underline; }
  .pl-list > li { display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: center; }
  .rc-head { display: grid; gap: 4px; }
  .rc-part { display: grid; gap: 2px; padding-top: 10px; }
  .rc-row { display: flex; align-items: baseline; gap: 8px; padding: 4px 0; border-bottom: 1px solid var(--line); font-size: 13px; }
  .rc-lead { flex: 1; border-bottom: 1px dotted var(--line-strong); transform: translateY(-4px); }
  .rc-val { font-family: var(--font-mono); font-size: 12px; font-variant-numeric: tabular-nums; color: var(--ink-soft); }
  /* the top tier is the only mark this drawer gives */
  .rc-top .rc-val, .rc-top > span:first-child { color: var(--rose); }
  .rc-chips { display: flex; flex-wrap: wrap; gap: 6px; margin: 0; }
  .rc-chip { font-family: var(--font-mono); font-size: 11px; color: var(--ink-soft);
    border: 1px solid var(--line); border-radius: 4px; padding: 3px 8px; }
</style>

<style is:global>
  .tt-wrap { display: grid; gap: 14px; }
  .tt-tabs { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 14px; }
  @media (max-width: 700px) { .tt-tabs { grid-template-columns: minmax(0, 1fr); } }
  .tt-tab { display: grid; gap: 8px; padding: 14px; border: 1px solid var(--line-strong); border-radius: 4px; background: var(--surface-page); }
  .tt-head { display: flex; align-items: baseline; justify-content: space-between; gap: 8px; }
  .tt-spent { font-size: 12px; color: var(--ink-faint); }
  .tt-grid { position: relative; display: grid; grid-template-columns: repeat(3, 1fr); grid-template-rows: repeat(6, 1fr);
    gap: 6px; height: 420px; }
  @media (max-width: 700px) { .tt-grid { height: 470px; } }
  .tt-arrows { position: absolute; inset: 0; width: 100%; height: 100%; color: var(--line-strong); pointer-events: none; }
  .tt-cell { position: relative; display: grid; align-content: center; gap: 2px; padding: 4px; cursor: pointer;
    border: 1px solid var(--state-locked); border-radius: 4px; background: var(--surface-card); color: inherit; }
  .tt-name { font-family: var(--font-body); font-size: 10.5px; font-weight: 500; line-height: 1.15; text-align: center; }
  .tt-points { font-family: var(--font-mono); font-size: 11px; text-align: center; color: var(--ink-faint); }
  .tt-cell[data-look="in"] { border: 1.5px solid var(--state-done); background: var(--rose-wash); }
  .tt-cell[data-look="in"] .tt-points { color: var(--rose); }
  .tt-cell[data-look="looking"] { border: 1.5px solid var(--state-now); background: var(--accent-wash); }
  .tt-cell[data-look="raises"] { border: 1px solid var(--accent); }
  .tt-panel { display: grid; gap: 12px; }
  .tt-part { display: grid; gap: 2px; }
  .tt-syn { display: grid; grid-template-columns: minmax(0, 1fr) auto auto; gap: 8px; align-items: baseline;
    padding: 6px 0; border-bottom: 1px solid var(--line); font-size: 13px; }
  .tt-syn[data-taken="no"] { color: var(--ink-faint); }
  .tt-tab-name { font-size: 11px; color: var(--ink-faint); }
  .tt-tab-name[data-elsewhere="yes"] { color: var(--accent); }

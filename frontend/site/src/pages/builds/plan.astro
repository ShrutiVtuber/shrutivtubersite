---
/* The build planner (README-planners, 21 Sep 2026): a plan is the person's
 * choices in the game's own terms, and the site writes them as the goals the
 * phone ticks and the stream draws.
 *
 * The desk is two columns — a sections rail that is also a table of contents,
 * and the chooser, which is the only column that needs width — with the plan
 * as a drawer over the page. At 390 the rail becomes a chip row, the chooser
 * takes the width, and the plan NEVER hides: a sticky bar raises it as a
 * sheet, and the page keeps 96px of bottom padding so nothing is covered.
 *
 * ⚠ Nothing is computed here. The server cleans a plan, refuses what the data
 * does not know and says why; this page shows what came back, refusals
 * included. Every visible string is a say() default she edits in /admin/copy.
 */
import BaseLayout from "../../layouts/BaseLayout.astro";
import Head from "../../components/guides/Head.astro";
import Console from "../../components/guides/Console.astro";
import Empty from "../../components/guides/Empty.astro";
import Icon from "../../components/guides/Icon.astro";
import StatsBar from "../../components/guides/StatsBar.astro";
import Button from "../../components/forms/Button.astro";
import { site } from "../../lib/api";
import { account } from "../../lib/account";
import { copy } from "../../lib/copy";
import { dataLine, type GamePack, type Recipe, type Row } from "../../lib/planner";

const say = await copy("builds/plan");
const me = await account(Astro);
if (!me) return Astro.redirect("/signin?next=%2Fbuilds%2Fplan");

const wanted = String(Astro.url.searchParams.get("game") || "").trim();
const packs = (await site<GamePack[]>("/api/gamedata/games")) || [];
const games: GamePack[] = Array.isArray(packs) ? packs : [];
const pack = games.find((g) => g.id === wanted) || null;

/* a tile names the sections that game's recipe has, so a person can see what
 * planning it involves before choosing it */
const recipes = Object.fromEntries(
  (await Promise.all(games.filter((g) => g.planner).map(async (g) =>
    [g.id, await site<Recipe>(`/api/gamedata/${g.id}/recipe`)] as const))).filter(([, r]) => r && Array.isArray(r.sections))
);

/* the recipe and the classes only matter once a game is chosen */
const [recipeRead, classesRead] = pack
  ? await Promise.all([
      site<Recipe>(`/api/gamedata/${pack.id}/recipe`),
      site<(Row & { resource?: string; resources?: string[] })[]>(`/api/gamedata/${pack.id}/class?limit=40&brief=false`),
    ])
  : [null, null];
const recipe: Recipe | null = recipeRead && Array.isArray(recipeRead.sections) ? recipeRead : null;
type ClassRow = Row & { resource?: string; resources?: string[] };
const classes: ClassRow[] = Array.isArray(classesRead) ? classesRead : [];
/* "Sorcerer · mana · Twenty-two enchantments…" — the resource is half of what
 * tells somebody whether a class is theirs */
const resourceOf = (c: ClassRow) => c.resource || (c.resources || [])[0] || "";
const firstSentence = (text: string) => String(text || "").split(/(?<=\.)\s/)[0];

const totalRecords = (g: GamePack) => Object.values(g.counts || {}).reduce((a, b) => a + b, 0);
const sectionNames = (g: GamePack) => (recipes[g.id]?.sections || []).map((s) => s.name);
/* a class is chosen by ?class=; until then the class step stands */
const chosenClass = String(Astro.url.searchParams.get("class") || "").trim();
const klass = classes.find((c) => c.id === chosenClass) || null;
const step = !pack ? "game" : !klass ? "class" : "section";

/* the sections rail, and what each will ask for. A section renders from its
 * recipe — a new one needs no new design. */
const sections = recipe ? recipe.sections : [];
const sectionKindCount = async (sec: typeof sections[number]) => {
  if (!pack || !sec.kind || sec.type === "gear" || sec.type === "targets") return 0;
  const params = new URLSearchParams({ limit: "1", brief: "true" });
  if (sec.by_class && klass) params.set("class_id", klass.id);
  if (sec.sub) params.set("sub", Array.isArray(sec.sub) ? sec.sub.join(",") : sec.sub);
  const rows = await site<Row[]>(`/api/gamedata/${pack.id}/${sec.kind}?${params}`);
  return Array.isArray(rows) ? rows.length : 0;
};
/* the counts a rail row shows come from the pack, not from a second round trip */
const availableIn = (sec: typeof sections[number]) => {
  if (sec.type === "targets") return (sec.entries || []).length;
  if (sec.type === "gear") return 0;
  return pack && sec.kind ? pack.counts[sec.kind] || 0 : 0;
};

const WORDS = {
  failed: say("words.failed", "That did not go through. Try again."),
  needsName: say("words.needs_name", "A build needs a name."),
};
---

<BaseLayout title={say("meta.title", "Plan a build — Squirrel Guides")}
            description={say("meta.description", "Your choices in the game's own terms, written as the goals your phone ticks and the stream draws.")} noindex>
  <div class="page gd-full pl" data-planner data-game={pack?.id || ""} data-step={step} data-words={JSON.stringify(WORDS)}>

    <header class="pl-top">
      <div class="pl-topline">
        <span class="gd-eyebrow">{say("head.eyebrow", "Build planner")}</span>
        {pack && <span class="gd-mono pl-data">{dataLine(pack)}</span>}
        {/* ⚠ On the desk this is the only way to raise the plan — the phone's
            bar is display:none here. Without it the drawer is unreachable. */}
        {pack && step === "section" && (
          <span class="pl-head-actions">
            <button type="button" class="pl-show-plan" data-open-plan>
              {say("head.show_plan", "The plan")}
              <span class="gd-mono" data-bar-count>{say("bar.none", "nothing yet")}</span>
            </button>
            <button type="button" class="pl-show-plan" data-review>{say("head.review", "Review")}</button>
          </span>
        )}
      </div>
      {!pack && (
        <Head as="h1" title={say("head.title", "Plan a build")}
              lede={say("head.lede", "A plan is your choices in the game's own terms. The site writes them as the goals your phone ticks and the stream draws. Pick the game first — each carries its own recipe.")} />
      )}
    </header>

    {!pack && (
      <section class="pl-games" aria-label={say("games.aria", "The games with data loaded")}>
        {games.length === 0 && (
          <Empty n={3} eyebrow={say("games.none_eyebrow", "Not loaded yet")}
                 title={say("games.none_title", "No game's data has finished loading.")}
                 body={say("games.none_body", "Data arrives with its patch, its season and the date it was gathered — until then there is nothing honest to plan from.")}
                 action={say("games.none_action", "Back to builds")} href="/builds"
                 ringAria={say("games.none_aria", "No game's data is loaded")} />
        )}
        {games.map((g) => (
          <article class="pl-game" data-loaded={g.planner ? "yes" : "no"}>
            <h2>{g.name}</h2>
            <p class="gd-mono pl-game-line">
              {say("games.records", "{n} records").replace("{n}", totalRecords(g).toLocaleString("en-GB"))}
              {g.patch && <> · {g.patch.split(" (")[0]}</>}
              {g.season && <> · {g.season.split(" (")[0].split(";")[0]}</>}
            </p>
            {g.planner ? (
              <>
                <p class="gd-soft pl-sections">{sectionNames(g).join(" · ")}</p>
                <a class="pl-choose" href={`/builds/plan?game=${g.id}`}>{say("games.choose", "Plan for this")}</a>
              </>
            ) : (
              <Console eyebrow={say("games.notloaded_eyebrow", "Not loaded yet")} class="pl-notloaded">
                <p class="gd-soft">{say("games.notloaded", "This game's data has not finished loading. It arrives with its patch, its season and the date it was gathered — until then there is nothing honest to plan from.")}</p>
              </Console>
            )}
          </article>
        ))}
      </section>
    )}

    {pack && step === "class" && classes.length > 0 && (
      <section class="pl-classes" aria-labelledby="pl-class">
        <div class="gd-head">
          <span id="pl-class" class="gd-eyebrow">{say("classes.eyebrow", "Which class")}</span>
          <p class="gd-note">
            {say("classes.counts", "{classes} classes · {specs} specializations")
              .replace("{classes}", String(pack.counts.class || classes.length))
              .replace("{specs}", String(pack.counts.specialization || 0))}
          </p>
          <p class="gd-soft">{say("classes.lede", "The class names the variant when you do not.")}</p>
        </div>
        <ul class="pl-rows">
          {classes.map((c) => (
            <li>
              <a class="pl-row" href={`/builds/plan?game=${pack.id}&class=${c.id}`} data-class={c.id}>
                <span class="pl-row-mark"><Icon mark="kind-support" size={24} /></span>
                <span class="pl-row-body">
                  <span class="pl-row-name">{c.name}</span>
                  <span class="gd-mono pl-row-meta">
                    {[resourceOf(c), firstSentence(c.summary)].filter(Boolean).join(" · ")}
                  </span>
                </span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

    {pack && step === "section" && klass && <StatsBar />}

    {pack && step === "section" && klass && recipe && (
      <div class="pl-work" data-work data-class={klass.id}>
        {/* the rail is a stepper AND a table of contents: every section is
            reachable at any time, and nothing is lost between them */}
        <nav class="pl-rail" aria-label={say("rail.aria", "The plan's sections")}>
          <div class="pl-rail-head">
            <span class="gd-eyebrow">{say("rail.eyebrow", "Sections")}</span>
            <span class="gd-mono pl-rail-done" data-done>{say("rail.done", "0 of {n} done").replace("{n}", String(sections.length))}</span>
          </div>
          <ul class="pl-rail-list">
            {sections.map((sec, i) => (
              <li>
                <button type="button" class="pl-rail-row" data-section={sec.id} aria-current={i === 0 ? "step" : undefined}>
                  <span class="gd-dot" data-state="open" data-for={sec.id} aria-hidden="true"></span>
                  <span class="pl-rail-name">{sec.name}</span>
                  <span class="gd-mono pl-rail-count" data-count={sec.id}>
                    {availableIn(sec) ? availableIn(sec).toLocaleString("en-GB") : ""}
                  </span>
                </button>
              </li>
            ))}
          </ul>
          <p class="gd-hint">{say("rail.note", "Every section is reachable at any time. Nothing is lost between them.")}</p>
        </nav>

        <section class="pl-panel" data-panel aria-live="polite">
          <div class="pl-panel-head">
            <h2 class="gd-h2" data-panel-name>{sections[0]?.name}</h2>
            <span class="gd-mono pl-panel-count" data-panel-count></span>
          </div>
          <p class="gd-soft" data-panel-lede></p>
          <div data-panel-body></div>
        </section>
      </div>
    )}

    {pack && step === "section" && klass && (
      <>
        {/* the plan is a drawer on the desk and a sheet on the phone, and it
            never hides: the bar below is the phone's guarantee */}
        <aside class="pl-drawer" data-drawer hidden aria-label={say("plan.aria", "The plan so far")}>
          <div class="pl-drawer-head">
            <span class="gd-eyebrow">{say("plan.eyebrow", "The plan so far")}</span>
            <button type="button" class="pl-close" data-close-plan aria-label={say("plan.close", "Hide the plan")}>✕</button>
          </div>
          <p class="gd-mono pl-drawer-count" data-plan-count>{say("plan.none", "nothing chosen yet")}</p>
          <div class="pl-drawer-body" data-plan-lines></div>
          <p class="gd-hint">{say("plan.unsaved", "Nothing is saved until you start the build.")}</p>
          <Button type="button" variant="primary" data-review>{say("plan.review", "Review")}</Button>
        </aside>

        {/* one record whole — an almanac table in our type, never a tooltip */}
        <aside class="pl-drawer pl-record" data-record hidden aria-label={say("record.aria", "One record")}>
          <div class="pl-drawer-head">
            <span class="gd-eyebrow">{say("record.eyebrow", "Read")}</span>
            <button type="button" class="pl-close" data-close-record aria-label={say("record.close", "Close")}>✕</button>
          </div>
          <div data-record-body></div>
        </aside>

        <div class="pl-bar" data-bar>
          <button type="button" class="pl-bar-open" data-open-plan>
            <span>{say("bar.plan", "The plan")}</span>
            <span class="gd-mono" data-bar-count>{say("bar.none", "nothing yet")}</span>
            <span aria-hidden="true">▴</span>
          </button>
          <Button type="button" variant="primary" size="sm" data-review>{say("plan.review", "Review")}</Button>
        </div>
      </>
    )}

    <p class="gd-hint pl-affiliation">{say("foot.affiliation", "Not affiliated with or endorsed by Blizzard Entertainment or Grinding Gear Games; names are theirs, used to say what you are planning.")}</p>
  </div>
</BaseLayout>

<style>
  .pl { display: grid; gap: var(--space-6); padding-block: var(--space-6) var(--space-9); min-width: 0; }
  .pl-top { display: grid; gap: 12px; }
  .pl-topline { display: flex; align-items: baseline; justify-content: space-between; gap: 16px; flex-wrap: wrap; }
  .pl-data { font-size: 12px; color: var(--ink-faint); }
  .pl-show-plan { display: inline-flex; align-items: baseline; gap: 8px; border: 1px solid var(--line-strong); border-radius: 4px;
    background: none; color: var(--ink); font-family: var(--font-body); font-size: 13px; padding: 6px 12px; cursor: pointer; }
  .pl-show-plan:hover { background: var(--surface-veil); }
  .pl-show-plan .gd-mono { font-size: 12px; color: var(--ink-faint); }
  .pl-head-actions { display: inline-flex; gap: 8px; }
  @media (max-width: 600px) { .pl-head-actions { display: none; } }

  /* the games, as tiles a person chooses between */
  .pl-games { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: var(--space-5); }
  .pl-game { display: grid; gap: 10px; align-content: start; padding: 20px; border: 1px solid var(--line-strong); border-radius: 4px; background: var(--surface-page); }
  .pl-game[data-loaded="no"] { opacity: .85; }
  .pl-game h2 { margin: 0; font-family: var(--font-display); font-size: 24px; font-weight: 600; line-height: 1.2; }
  .pl-game-line { font-size: 12px; color: var(--ink-faint); }
  .pl-sections { font-size: 14px; text-wrap: pretty; }
  .pl-choose { align-self: start; font-family: var(--font-body); font-size: 14px; font-weight: 500; color: var(--accent); text-decoration: none; border-bottom: 1px solid color-mix(in srgb, var(--accent) 55%, transparent); padding-bottom: 1px; }
  .pl-choose:hover { color: var(--accent-hover); border-bottom-color: var(--accent-hover); }
  .pl-notloaded { padding: 14px; }

  /* the classes, as rows */
  .pl-classes { display: grid; gap: var(--space-4); }
  .pl-rows { margin: 0; padding: 0; list-style: none; display: grid; border-top: 1px solid var(--line-strong); }
  .pl-row { display: grid; grid-template-columns: 24px minmax(0, 1fr); gap: 12px; align-items: center; padding: 14px 0; border-bottom: 1px solid var(--line); color: inherit; text-decoration: none; }
  .pl-row:hover { background: var(--surface-veil); }
  .pl-row-mark { color: var(--ink-faint); }
  .pl-row-body { display: grid; gap: 2px; min-width: 0; }
  .pl-row-name { font-family: var(--font-display); font-size: 19px; font-weight: 600; }
  .pl-row-meta { font-size: 12px; color: var(--ink-soft); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

  .pl-affiliation { max-width: 66ch; }
  @media (max-width: 600px) { .pl { padding-bottom: 96px; } }
</style>

<style>
  /* the desk is 264 and the rest: the chooser is the only column that needs width */
  .pl-work { display: grid; grid-template-columns: 264px minmax(0, 1fr); gap: var(--space-6); align-items: start; }
  @media (max-width: 900px) { .pl-work { grid-template-columns: minmax(0, 1fr); } }

  .pl-rail { display: grid; gap: 12px; position: sticky; top: 16px; align-content: start; }
  .pl-rail-head { display: flex; align-items: baseline; justify-content: space-between; gap: 10px; }
  .pl-rail-done { font-size: 12px; color: var(--ink-faint); }
  .pl-rail-list { margin: 0; padding: 0; list-style: none; display: grid; border-top: 1px solid var(--line-strong); }
  .pl-rail-row { width: 100%; display: grid; grid-template-columns: 15px minmax(0, 1fr) auto; gap: 10px; align-items: center;
    padding: 10px 0; border: 0; border-bottom: 1px solid var(--line); background: none; color: inherit; text-align: left;
    font-family: var(--font-body); font-size: 14px; cursor: pointer; }
  .pl-rail-row:hover { background: var(--surface-veil); }
  .pl-rail-row[aria-current="step"] .pl-rail-name { color: var(--accent); font-weight: 500; }
  .pl-rail-name { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .pl-rail-count { font-size: 12px; color: var(--ink-faint); }

  .pl-panel { display: grid; gap: 14px; min-width: 0; }
  .pl-panel-head { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; flex-wrap: wrap; }
  .pl-panel-count { font-size: 13px; color: var(--ink-soft); }

  /* the plan: a drawer over the page on the desk, a sheet on the phone */
  .pl-drawer { position: fixed; top: 0; right: 0; bottom: 0; width: min(400px, 92vw); z-index: 40;
    display: grid; gap: 12px; align-content: start; padding: 20px; overflow-y: auto;
    background: var(--surface-page); border-left: 1px solid var(--line-strong); box-shadow: var(--shadow-3); }
  .pl-drawer[hidden] { display: none; }
  .pl-drawer-head { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
  .pl-drawer-count { font-size: 12px; color: var(--ink-faint); }
  .pl-drawer-body { display: grid; gap: 4px; }
  .pl-close { border: 0; background: none; color: var(--ink-faint); font-size: 16px; cursor: pointer; padding: 4px; }
  .pl-close:hover { color: var(--ink); }

  /* ⚠ the phone's guarantee: the plan is always one thumb away, and the page
     keeps 96px of bottom padding so the bar covers nothing */
  .pl-bar { display: none; }
  @media (max-width: 600px) {
    .pl-bar { position: fixed; left: 0; right: 0; bottom: 0; z-index: 30; display: flex; align-items: center; gap: 12px;
      padding: 10px clamp(16px, 4vw, 40px); background: var(--surface-card); border-top: 1px solid var(--line-strong); }
    .pl-bar-open { flex: 1; display: flex; align-items: baseline; gap: 8px; border: 0; background: none; color: inherit;
      font-family: var(--font-body); font-size: 14px; cursor: pointer; padding: 8px 0; text-align: left; }
    .pl-bar-open .gd-mono { font-size: 12px; color: var(--ink-faint); }
    .pl-drawer { top: auto; height: 78vh; width: 100%; border-left: 0; border-top: 1px solid var(--line-strong); border-radius: 16px 16px 0 0; }
  }
</style>

<style is:global>
  /* ⚠ Astro's scoped styles never reach markup a script writes. Everything
     the planner renders below is styled here, globally, on purpose. */
  .pl-search { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 10px; align-items: end; }
  .pl-field { width: 100%; font-family: var(--font-body); font-size: 16px; color: var(--ink); background: var(--surface-card);
    border: 1px solid var(--line); border-radius: 4px; padding: 10px 12px; min-height: 44px; }
  .pl-field:hover { border-color: var(--line-strong); }
  .pl-field:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .pl-points { position: sticky; top: 0; z-index: 2; display: flex; align-items: baseline; gap: 10px;
    padding: 8px 0; background: var(--surface-page); border-bottom: 1px solid var(--line); }
  .pl-points b { font-family: var(--font-mono); font-size: 22px; font-weight: 400; font-variant-numeric: tabular-nums; }
  .pl-list { margin: 0; padding: 0; list-style: none; display: grid; border-top: 1px solid var(--line-strong); }
  .pl-pick { width: 100%; display: grid; grid-template-columns: 16px minmax(0, 1fr) auto; gap: 12px; align-items: center;
    padding: 10px 0; border: 0; border-bottom: 1px solid var(--line); background: none; color: inherit; text-align: left;
    font-family: var(--font-body); font-size: 14px; cursor: pointer; }
  .pl-pick:hover { background: var(--surface-veil); }
  .pl-pick[data-chosen="yes"] { color: var(--ink-faint); }
  .pl-pick-name { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .pl-pick-mark { color: var(--ink-faint); display: grid; }
  .pl-pick-meta { font-family: var(--font-mono); font-size: 12px; color: var(--ink-faint); white-space: nowrap; }
  .pl-chosen { display: grid; gap: 8px; }
  .pl-chosen-row { display: grid; grid-template-columns: 16px minmax(0, 1fr) auto auto; gap: 10px; align-items: center;
    padding: 8px 0; border-bottom: 1px solid var(--line); font-size: 14px; }
  .pl-chosen-detail { font-family: var(--font-mono); font-size: 12px; color: var(--ink-soft); overflow: hidden;
    text-overflow: ellipsis; white-space: nowrap; }
  .pl-remove { border: 0; background: none; color: var(--ink-faint); cursor: pointer; font-size: 13px; padding: 2px 6px; }
  .pl-remove:hover { color: var(--ink); }
  .pl-step { display: inline-flex; align-items: center; gap: 6px; }
  .pl-step button { min-width: 28px; min-height: 28px; border: 1px solid var(--line); border-radius: 4px;
    background: var(--surface-card); color: var(--ink); cursor: pointer; font-family: var(--font-mono); font-size: 13px; }
  .pl-step button:hover { border-color: var(--line-strong); }
  .pl-step output { font-family: var(--font-mono); font-size: 13px; font-variant-numeric: tabular-nums; min-width: 4ch; text-align: center; }
  .pl-slot { display: grid; grid-template-columns: 15px 24px minmax(0, 1fr); gap: 12px; align-items: center;
    padding: 12px 0; border-bottom: 1px solid var(--line); width: 100%; border-left: 0; border-right: 0; border-top: 0;
    background: none; color: inherit; text-align: left; cursor: pointer; font-family: var(--font-body); font-size: 14px; }
  .pl-slot:hover { background: var(--surface-veil); }
  .pl-slot-mark { color: var(--ink-faint); display: grid; }
  .pl-slot-body { display: grid; gap: 2px; min-width: 0; }
  .pl-slot-name { font-size: 15px; }
  .pl-slot-target { font-family: var(--font-mono); font-size: 12px; color: var(--ink-soft);
    overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .pl-slot-target[data-empty="yes"] { color: var(--ink-faint); font-style: italic; }
  .pl-targets { display: grid; gap: 14px; }
  .pl-target { display: grid; gap: 4px; }
  .pl-target label { font-size: 14px; font-weight: 600; }
  .pl-plan-line { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 10px; align-items: baseline;
    padding: 6px 0; border-bottom: 1px solid var(--line); font-size: 13px; }
  .pl-plan-line span:last-child { font-family: var(--font-mono); font-size: 12px; color: var(--ink-soft);
    overflow: hidden; text-overflow: ellipsis; white-space: nowrap; max-width: 22ch; }
  .pl-plan-head { font-family: var(--font-body); font-size: 12px; font-weight: 600; letter-spacing: .14em;
    text-transform: uppercase; color: var(--ink-faint); padding-top: 12px; }
</style>

<script>
  import { MARKS } from "../../lib/marks";
  import { slotMark, kindMark } from "../../lib/planner";
  import { drawAssumptions, drawBreakdown, drawGroups, drawHeadline, rowsOf } from "../../lib/statsbar";
  import { drawRecord } from "../../lib/record";
  import { drawSynergyPanel, drawTab, type Tab, type Synergy } from "../../lib/tree-tabs";

  type Field = { type: string; kind?: string; sub?: string | string[]; max?: number; min?: number; unit?: string; options?: string[]; list?: string };
  type Section = { id: string; name: string; type: string; kind?: string; sub?: string | string[]; by_class?: boolean;
                   max?: number; grid?: boolean; track?: string; slots?: string[] | Record<string, string>; exclude?: string[];
                   fields?: Record<string, Field>; points?: { id: string; name: string; field?: string; unit?: string };
                   entries?: { id: string; name: string; max?: number; unit?: string }[] };
  type Row = { kind: string; id: string; name: string; sub: string; group: string; slot_id: string; level_req: number | null; summary: string };

  const root = document.querySelector<HTMLElement>("[data-planner]");
  const work = document.querySelector<HTMLElement>("[data-work]");
  if (root && work) {
    const game = root.dataset.game || "";
    const classId = work.dataset.class || "";
    const panel = work.querySelector<HTMLElement>("[data-panel-body]")!;
    const panelName = work.querySelector<HTMLElement>("[data-panel-name]")!;
    const panelCount = work.querySelector<HTMLElement>("[data-panel-count]")!;
    const panelLede = work.querySelector<HTMLElement>("[data-panel-lede]")!;
    const drawer = document.querySelector<HTMLElement>("[data-drawer]")!;
    const planLines = document.querySelector<HTMLElement>("[data-plan-lines]")!;

    /** The person's choices. Nothing here is checked — the server does that. */
    const words = JSON.parse(root.dataset.words || "{}") as { failed: string; needsName: string };
    const plan: Record<string, any> = {};
    /* ⚠ Every record the chooser has drawn, by id. The plan holds ids because
       that is what the server reads; a person must never be shown one. */
    const knownNames = new Map<string, string>();
    const nameOf = (id: string) => knownNames.get(id) || id.replace(/-/g, " ");
    let recipe: { sections: Section[] } = { sections: [] };
    let current: Section | null = null;
    let slots: Row[] = [];

    const ask = async <T,>(path: string): Promise<T | null> => {
      try {
        const r = await fetch(path, { headers: { accept: "application/json" } });
        return r.ok ? ((await r.json()) as T) : null;
      } catch { return null; }
    };

    const mark = (name: string, size = 16) => {
      const d = (MARKS as Record<string, string>)[name];
      if (!d) return "";
      return `<svg class="gd-mark" width="${size}" height="${size}" viewBox="0 0 24 24" fill="none" stroke="currentColor"
        stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="${d}"/></svg>`;
    };
    const escape = (t: unknown) => String(t ?? "").replace(/[&<>"]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" }[c] as string));

    /* ── what a section asks the game for ─────────────────────────────── */

    const listPath = (sec: Section, extra: Record<string, string> = {}) => {
      const params = new URLSearchParams({ limit: "400", brief: "true", ...extra });
      if (sec.by_class && classId) params.set("class_id", classId);
      if (sec.sub) params.set("sub", Array.isArray(sec.sub) ? sec.sub.join(",") : sec.sub);
      return `/api/gamedata/${game}/${sec.kind}?${params}`;
    };

    const picksOf = (sec: Section): any[] => (plan[sec.id]?.picks ?? []);
    const chosenCount = (sec: Section) => {
      if (sec.type === "gear") return Object.keys(plan[sec.id] || {}).length;
      if (sec.type === "targets") return Object.keys(plan[sec.id] || {}).length;
      if (sec.type === "pick") return plan[sec.id] ? 1 : 0;
      return picksOf(sec).length;
    };

    /* ── the panel ────────────────────────────────────────────────────── */

    async function showSection(sec: Section) {
      current = sec;
      panelName.textContent = sec.name;
      panelLede.textContent = "";
      work.querySelectorAll<HTMLElement>("[data-section]").forEach((b) =>
        b.setAttribute("aria-current", b.dataset.section === sec.id ? "step" : "false"));
      panel.innerHTML = "";
      if (sec.type === "gear") await showGear(sec);
      else if (sec.type === "targets") showTargets(sec);
      else {
        await showChooser(sec);
        /* the chooser is the way in by name; the tabs are the surface */
        if (sec.id === "skills" && sec.track && sec.track !== "check") await showTabs(sec);
      }
      paint();
    }

    /* ── the skill tabs, where a game has them ────────────────────────── */

    let tabs: Tab[] = [];
    let looking = "";
    const skillRecords = new Map<string, any>();

    async function showTabs(sec: Section): Promise<boolean> {
      if (!tabs.length) {
        tabs = (await ask<Tab[]>(`/api/gamedata/${game}/tab?limit=40&brief=false&class_id=${classId}`)) || [];
        tabs = tabs.filter((t) => (t.nodes || []).length);
      }
      if (!tabs.length) return false;
      const points: Record<string, number> = {};
      for (const pick of picksOf(sec)) points[pick.id] = Number(pick[sec.track!] ?? 0) || 0;
      tabs.forEach((t) => (t.nodes || []).forEach((n) => knownNames.set(n.id, n.name)));
      const chosen = looking ? await skillOf(looking) : null;

      const box = document.createElement("div");
      box.className = "tt-wrap";
      box.innerHTML = `
        <div class="tt-tabs">${tabs.map((t) => drawTab(t, points, looking, chosen?.synergies || [])).join("")}</div>
        <div class="tt-panel" data-syn></div>
        <p class="gd-hint tt-key">A skill with points is rose · the one you are looking at is blue ·
          an arrow is heavy when its parent has points. Synergies read as type, never as lines across the page.</p>`;
      panel.prepend(box);
      await paintSynergies(sec, chosen, points);

      box.addEventListener("click", async (e) => {
        const cell = (e.target as HTMLElement).closest<HTMLElement>("[data-skill]");
        if (!cell) return;
        looking = cell.dataset.skill === looking ? "" : cell.dataset.skill!;
        await showSection(sec);
      });
      return true;
    }

    async function skillOf(id: string) {
      if (!skillRecords.has(id)) skillRecords.set(id, await ask<any>(`/api/gamedata/${game}/skill/${id}`));
      return skillRecords.get(id);
    }

    async function paintSynergies(sec: Section, chosen: any, points: Record<string, number>) {
      const box = panel.querySelector<HTMLElement>("[data-syn]");
      if (!box) return;
      const tabOf = (id: string) => tabs.find((t) => (t.nodes || []).some((n) => n.id === id))?.name || "";
      /* what raises it: every skill in this class whose synergies name it */
      const raisedBy: { id: string; name: string; per_point?: number }[] = [];
      if (chosen) {
        for (const l of (chosen.linked_from || [])) {
          if (l.rel === "synergy") raisedBy.push({ id: l.id, name: l.name || l.id });
        }
      }
      box.innerHTML = drawSynergyPanel(chosen, tabOf, nameOf, points, raisedBy);
    }

    async function showChooser(sec: Section) {
      const rows = (await ask<Row[]>(listPath(sec))) || [];
      rows.forEach((r) => knownNames.set(r.id, r.name));
      const clusters = Array.from(new Set(rows.map((r) => r.group).filter(Boolean)));
      panel.innerHTML = `
        ${sec.points ? `<div class="pl-points"><b data-spent>0</b><span class="gd-eyebrow">${escape(sec.points.name)}</span></div>` : ""}
        <div class="pl-search">
          <input class="pl-field" type="search" data-search placeholder="Search ${rows.length} ${escape(sec.name.toLowerCase())}" aria-label="Search ${escape(sec.name)}">
          ${clusters.length > 1 ? `<select class="pl-field" data-cluster aria-label="Cluster"><option value="">Every cluster</option>${clusters.map((c) => `<option>${escape(c)}</option>`).join("")}</select>` : ""}
        </div>
        <ul class="pl-list" data-rows></ul>
        <div class="pl-chosen" data-chosen></div>`;
      const listEl = panel.querySelector<HTMLElement>("[data-rows]")!;
      const search = panel.querySelector<HTMLInputElement>("[data-search]");
      const cluster = panel.querySelector<HTMLSelectElement>("[data-cluster]");

      const draw = () => {
        const needle = (search?.value || "").trim().toLowerCase();
        const group = cluster?.value || "";
        const taken = new Set(sec.type === "pick" ? [plan[sec.id]?.id] : picksOf(sec).map((p) => p.id));
        const shown = rows.filter((r) => (!group || r.group === group) && (!needle || r.name.toLowerCase().includes(needle))).slice(0, 120);
        listEl.innerHTML = shown.length
          ? shown.map((r) => `
            <li><button type="button" class="pl-pick" data-add="${escape(r.id)}" data-chosen="${taken.has(r.id) ? "yes" : "no"}">
              <span class="pl-pick-mark">${mark(kindMark(r as any))}</span>
              <span class="pl-pick-name">${escape(r.name)}</span>
              <span class="pl-pick-meta">${taken.has(r.id) ? "chosen" : escape(r.group || "")}</span>
            </button><button type="button" class="pl-read" data-read="${escape(sec.kind)}:${escape(r.id)}">Read</button></li>`).join("")
          : `<li><p class="gd-soft">Nothing here is called “${escape(needle)}”. Clear the search to see all ${rows.length}.</p></li>`;
      };
      search?.addEventListener("input", draw);
      cluster?.addEventListener("change", draw);
      listEl.addEventListener("click", (e) => {
        const btn = (e.target as HTMLElement).closest<HTMLElement>("[data-add]");
        if (!btn) return;
        const id = btn.dataset.add!;
        if (sec.type === "pick") plan[sec.id] = { id };
        else {
          const picks = picksOf(sec);
          if (picks.some((p) => p.id === id)) return;
          if (sec.max && picks.length >= sec.max) return;
          plan[sec.id] = { picks: [...picks, { id }] };
        }
        draw();
        drawChosen(sec, rows);
        paint();
      });
      draw();
      drawChosen(sec, rows);
    }

    function drawChosen(sec: Section, rows: Row[]) {
      const box = panel.querySelector<HTMLElement>("[data-chosen]");
      if (!box) return;
      const names = new Map(rows.map((r) => [r.id, r.name]));
      const picks = sec.type === "pick" ? (plan[sec.id] ? [plan[sec.id]] : []) : picksOf(sec);
      const track = sec.track && sec.track !== "check" ? sec.fields?.[sec.track] : null;
      box.innerHTML = picks.length
        ? `<p class="gd-eyebrow">Chosen · ${picks.length}${sec.max ? ` of ${sec.max}` : ""}</p>` +
          picks.map((p) => `
            <div class="pl-chosen-row">
              <span class="pl-pick-mark">${mark(kindMark({ kind: sec.kind || "", sub: "" } as any))}</span>
              <span class="pl-pick-name">${escape(names.get(p.id) || p.id)}</span>
              ${track ? `<span class="pl-step">
                <button type="button" data-less="${escape(p.id)}" aria-label="Fewer">−</button>
                <output>${p[sec.track!] ?? track.min ?? 1}</output>
                <button type="button" data-more="${escape(p.id)}" aria-label="More">+</button>
              </span>` : `<span class="pl-chosen-detail"></span>`}
              <button type="button" class="pl-remove" data-drop="${escape(p.id)}">remove</button>
            </div>`).join("")
        : "";
      box.onclick = (e) => {
        const el = (e.target as HTMLElement).closest<HTMLElement>("[data-drop],[data-more],[data-less]");
        if (!el) return;
        const id = el.dataset.drop || el.dataset.more || el.dataset.less!;
        if (el.dataset.drop) {
          if (sec.type === "pick") delete plan[sec.id];
          else plan[sec.id] = { picks: picksOf(sec).filter((p) => p.id !== id) };
        } else if (track && sec.track) {
          const picks2 = picksOf(sec).map((p) => {
            if (p.id !== id) return p;
            const at = Number(p[sec.track!] ?? track.min ?? 1) + (el.dataset.more ? 1 : -1);
            return { ...p, [sec.track!]: Math.max(track.min ?? 1, Math.min(track.max ?? 99, at)) };
          });
          plan[sec.id] = { picks: picks2 };
        }
        drawChosen(sec, rows);
        panel.querySelector<HTMLInputElement>("[data-search]")?.dispatchEvent(new Event("input"));
        paint();
      };
    }

    async function showGear(sec: Section) {
      if (!slots.length) {
        slots = (await ask<Row[]>(`/api/gamedata/${game}/slot?limit=100&brief=true&class_id=${classId}`)) || [];
        slots.forEach((r) => knownNames.set(r.id, r.name));
      }
      const left = new Set(sec.exclude || []);
      const places = slots.filter((s) => !left.has(s.id));
      panel.innerHTML = `<ul class="pl-list">${places.map((s) => {
        const chosen = (plan[sec.id] || {})[s.id];
        /* ⚠ the plan holds ids; a slot row must read in words */
        const target = chosen ? Object.entries(chosen)
          .filter(([, v]) => v !== "" && v != null && !(Array.isArray(v) && !v.length))
          .map(([k, v]) => Array.isArray(v) ? v.map((x) => nameOf(String(x))).join(", ")
            : typeof v === "number" ? `${v} ${sec.fields?.[k]?.unit || ""}`.trim() : nameOf(String(v)))
          .join(" · ") : "";
        return `<li><button type="button" class="pl-slot" data-slot="${escape(s.id)}">
          <span class="gd-dot" data-state="${chosen ? "now" : "open"}" aria-hidden="true"></span>
          <span class="pl-slot-mark">${mark(slotMark(s.id), 24)}</span>
          <span class="pl-slot-body">
            <span class="pl-slot-name">${escape(s.name)}</span>
            <span class="pl-slot-target" data-empty="${target ? "no" : "yes"}">${escape(target || "not chosen yet")}</span>
          </span></button></li>`;
      }).join("")}</ul>`;
      panel.querySelectorAll<HTMLElement>("[data-slot]").forEach((b) =>
        b.addEventListener("click", () => openSlot(sec, b.dataset.slot!)));
    }

    /** The fields a gear choice carries, in the spec's three groups. */
    const WEARS = ["aspect", "affixes", "greater", "tempers", "gems", "runes", "runeword", "sockets", "jewels"];
    const HOW_FAR = ["masterwork", "item_power", "quality", "ethereal", "note"];

    async function openSlot(sec: Section, slotId: string) {
      const slot = slots.find((s) => s.id === slotId);
      const chosen = { ...((plan[sec.id] || {})[slotId] || {}) };
      const fields = Object.entries(sec.fields || {});
      const pickers = await Promise.all(fields
        .filter(([, f]) => f.type === "id" || f.type === "ids")
        .map(async ([name, f]) => {
          const params = new URLSearchParams({ limit: "300", brief: "true", slot_id: slotId });
          if (f.sub) params.set("sub", Array.isArray(f.sub) ? f.sub.join(",") : f.sub);
          if (classId) params.set("class_id", classId);
          const rows = (await ask<Row[]>(`/api/gamedata/${game}/${f.kind}?${params}`)) || [];
          rows.forEach((r) => knownNames.set(r.id, r.name));
          return [name, f, rows] as const;
        }));

      const group = (which: string[]) => pickers.filter(([n]) => which.includes(n));
      const what = pickers.filter(([n]) => !WEARS.includes(n) && !HOW_FAR.includes(n));
      const numbers = fields.filter(([n, f]) => HOW_FAR.includes(n) && (f.type === "int" || f.type === "text" || f.type === "choice"));

      const chooser = ([name, f, rows]: readonly [string, Field, Row[]]) => {
        const many = f.type === "ids";
        const taken: string[] = many ? (chosen[name] || []) : chosen[name] ? [chosen[name]] : [];
        return `<div class="pl-target">
          <label for="f-${escape(name)}">${escape(name.replace(/_/g, " "))}${many && f.max ? ` <span class="gd-hint">up to ${f.max}</span>` : ""}</label>
          <select class="pl-field" id="f-${escape(name)}" data-field="${escape(name)}" data-many="${many ? "yes" : "no"}">
            <option value="">${rows.length ? `— choose from ${rows.length} —` : "— nothing fits this slot —"}</option>
            ${rows.map((r) => `<option value="${escape(r.id)}">${escape(r.name)}</option>`).join("")}
          </select>
          ${taken.length ? `<p class="pl-slot-target">${taken.map((t) => `<button type="button" class="pl-remove" data-unset="${escape(name)}:${escape(t)}">${escape(nameOf(t))} ✕</button>`).join(" ")}</p>` : ""}
        </div>`;
      };

      panel.innerHTML = `
        <button type="button" class="pl-remove" data-back-to-slots>← ${escape(sec.name)}</button>
        <h3 class="gd-h3">${escape(slot?.name || slotId)}</h3>
        ${what.length ? `<p class="gd-eyebrow">What</p><div class="pl-targets">${what.map(chooser).join("")}</div>` : ""}
        ${group(WEARS).length ? `<p class="gd-eyebrow">What it wears</p><div class="pl-targets">${group(WEARS).map(chooser).join("")}</div>` : ""}
        ${numbers.length ? `<p class="gd-eyebrow">How far</p><div class="pl-targets">${numbers.map(([name, f]) => `
          <div class="pl-target">
            <label for="n-${escape(name)}">${escape(name.replace(/_/g, " "))}</label>
            ${f.type === "choice"
              ? `<select class="pl-field" id="n-${escape(name)}" data-plain="${escape(name)}">${(f.options || []).map((o) => `<option value="${escape(o)}"${chosen[name] === o ? " selected" : ""}>${escape(o || "—")}</option>`).join("")}</select>`
              : `<input class="pl-field" id="n-${escape(name)}" data-plain="${escape(name)}" type="${f.type === "int" ? "number" : "text"}"
                   ${f.type === "int" ? `min="${f.min ?? 0}" max="${f.max ?? 999999}"` : `maxlength="120"`} value="${escape(chosen[name] ?? "")}">`}
          </div>`).join("")}</div>` : ""}
        <div class="pl-writes">
          <p class="gd-eyebrow">The goal this writes</p>
          <p class="gd-mono" data-writes></p>
        </div>
        <div class="pl-slot-actions">
          <button type="button" class="pl-keep" data-keep>Keep this slot</button>
          <button type="button" class="pl-remove" data-clear>Clear it</button>
        </div>`;

      const writes = panel.querySelector<HTMLElement>("[data-writes]")!;
      const shown = () => Object.entries(chosen)
        .filter(([, v]) => v !== "" && v != null && !(Array.isArray(v) && !v.length))
        .map(([k, v]) => Array.isArray(v) ? v.map((x) => nameOf(String(x))).join(", ") : (typeof v === "number" ? `${v} ${sec.fields?.[k]?.unit || ""}`.trim() : nameOf(String(v))))
        .join(" · ");
      const repaint = () => { writes.textContent = shown() || "nothing chosen yet"; };
      repaint();

      panel.addEventListener("change", (e) => {
        const sel = (e.target as HTMLElement).closest<HTMLSelectElement | HTMLInputElement>("[data-field],[data-plain]");
        if (!sel) return;
        if (sel.dataset.field) {
          const name = sel.dataset.field;
          const many = (sel as HTMLElement).dataset.many === "yes";
          if (!sel.value) return;
          if (many) {
            const at: string[] = chosen[name] || [];
            const cap = sec.fields?.[name]?.max ?? 12;
            if (!at.includes(sel.value) && at.length < cap) chosen[name] = [...at, sel.value];
          } else chosen[name] = sel.value;
          (sel as HTMLSelectElement).value = "";
        } else {
          const name = sel.dataset.plain!;
          const f = sec.fields?.[name];
          chosen[name] = f?.type === "int" ? Number(sel.value) || undefined : sel.value || undefined;
          if (chosen[name] === undefined) delete chosen[name];
        }
        openSlotAgain();
      });
      const openSlotAgain = () => {
        const box = plan[sec.id] || (plan[sec.id] = {});
        box[slotId] = chosen;
        openSlot(sec, slotId);
      };
      panel.querySelector("[data-back-to-slots]")?.addEventListener("click", () => showSection(sec));
      panel.querySelector("[data-keep]")?.addEventListener("click", () => {
        const box = plan[sec.id] || (plan[sec.id] = {});
        if (Object.keys(chosen).length) box[slotId] = chosen; else delete box[slotId];
        showSection(sec);
      });
      panel.querySelector("[data-clear]")?.addEventListener("click", () => {
        delete (plan[sec.id] || {})[slotId];
        showSection(sec);
      });
      panel.querySelectorAll<HTMLElement>("[data-unset]").forEach((btn) => btn.addEventListener("click", () => {
        const [name, value] = btn.dataset.unset!.split(":");
        if (Array.isArray(chosen[name])) chosen[name] = chosen[name].filter((x: string) => x !== value);
        else delete chosen[name];
        openSlotAgain();
      }));
    }

    function showTargets(sec: Section) {
      panel.innerHTML = `<div class="pl-targets">${(sec.entries || []).map((e) => `
        <div class="pl-target">
          <label for="t-${escape(e.id)}">${escape(e.name)}</label>
          <input class="pl-field" id="t-${escape(e.id)}" data-target="${escape(e.id)}" type="number" inputmode="numeric"
                 min="0" max="${e.max ?? 999999}" placeholder="${e.max ?? ""}" value="${(plan[sec.id] || {})[e.id] ?? ""}">
        </div>`).join("")}</div>
      <p class="gd-hint">Each becomes one counter: have of want, met when have reaches want. Nobody is told how far from it you are.</p>`;
      panel.querySelectorAll<HTMLInputElement>("[data-target]").forEach((input) => {
        input.addEventListener("change", () => {
          const at = Number(input.value);
          const box = plan[sec.id] || (plan[sec.id] = {});
          if (Number.isFinite(at) && at > 0) box[input.dataset.target!] = at;
          else delete box[input.dataset.target!];
          paint();
        });
      });
    }

    /* ── the plan, everywhere it shows ────────────────────────────────── */

    /* ── the numbers, as the choosing moves them ──────────────────────── */

    const bar = document.querySelector<HTMLElement>("[data-stats]");
    let sheetAsked: number | undefined;
    let lastSheet: any = null;

    function askForNumbers() {
      if (!bar) return;
      window.clearTimeout(sheetAsked);
      /* ⚠ debounced: a person typing a number must not send a request a
         keystroke, and the bar showing a figure one edit stale is worse than
         it arriving a moment later */
      sheetAsked = window.setTimeout(async () => {
        const said = await post("/api/builds/sheet", { game, plan: planBody() });
        if (!said?.sheet) return;
        lastSheet = said.sheet;
        drawBar(said.sheet);
      }, 400);
    }

    function drawBar(sheet: any) {
      if (!bar) return;
      const wanted = JSON.parse(bar.dataset.headline || "[]") as string[];
      /* ⚠ A bar with no headline number is worse than no bar: it is a rule
         with a key under it and nothing to read. A plan whose only rows are
         caps has nothing to say yet. */
      const headline = drawHeadline(sheet, wanted);
      bar.hidden = !headline;
      if (!headline) return;
      bar.querySelector("[data-sb-headline]")!.innerHTML = headline;
      const assume = bar.querySelector<HTMLElement>("[data-sb-assume]")!;
      const said = drawAssumptions(sheet);
      assume.hidden = !said;
      assume.textContent = said;
      const groups = bar.querySelector<HTMLElement>("[data-sb-groups]")!;
      if (!groups.hidden) groups.innerHTML = drawGroups(sheet);
    }

    bar?.addEventListener("click", (e) => {
      const stat = (e.target as HTMLElement).closest<HTMLElement>("[data-stat]");
      bar.querySelectorAll(".sb-pop").forEach((p) => p.remove());
      if (!stat || !lastSheet) return;
      const open = stat.getAttribute("aria-expanded") === "true";
      bar.querySelectorAll("[data-stat]").forEach((b) => b.setAttribute("aria-expanded", "false"));
      const groups = bar.querySelector<HTMLElement>("[data-sb-groups]")!;
      if (open) { groups.hidden = true; return; }
      stat.setAttribute("aria-expanded", "true");
      groups.hidden = false;
      groups.innerHTML = drawGroups(lastSheet);
      const row = rowsOf(lastSheet)[stat.dataset.stat!];
      if (!row) return;
      stat.insertAdjacentHTML("afterend", drawBreakdown(row));
      const pop = bar.querySelector<HTMLElement>(".sb-pop");
      if (pop) {
        /* ⚠ the last stats anchor right, so the popover never leaves the page */
        const past = stat.getBoundingClientRect().left > window.innerWidth / 2;
        pop.style.left = past ? "auto" : `${stat.offsetLeft}px`;
        pop.style.right = past ? `${bar.clientWidth - stat.offsetLeft - stat.offsetWidth}px` : "auto";
        pop.style.top = `${stat.offsetTop + stat.offsetHeight + 6}px`;
      }
    });

    function paint() {
      let choices = 0;
      const lines: string[] = [];
      for (const sec of recipe.sections) {
        const n = chosenCount(sec);
        choices += n;
        const dot = work.querySelector<HTMLElement>(`[data-for="${sec.id}"]`);
        if (dot) dot.dataset.state = n ? "done" : "open";
        const count = work.querySelector<HTMLElement>(`[data-count="${sec.id}"]`);
        if (count && n) count.textContent = String(n);
        if (n) {
          lines.push(`<p class="pl-plan-head">${escape(sec.name)}</p>`);
          const picks = sec.type === "pick" ? [plan[sec.id]] : sec.type === "picks" ? picksOf(sec) : [];
          for (const p of picks) {
            const at = sec.track && sec.track !== "check" ? p[sec.track] : null;
            lines.push(`<div class="pl-plan-line"><span>${escape(nameOf(p.id))}</span><span>${at ? escape(`${at} ${sec.fields?.[sec.track!]?.unit || ""}`.trim()) : ""}</span></div>`);
          }
          if (sec.type === "gear") for (const [place, ch] of Object.entries(plan[sec.id] || {}))
            lines.push(`<div class="pl-plan-line"><span>${escape(nameOf(place))}</span><span>${escape(Object.values(ch as object).filter(Boolean).map((v) => nameOf(String(v))).join(" · "))}</span></div>`);
          if (sec.type === "targets") for (const [k, v] of Object.entries(plan[sec.id] || {})) {
            const entry = (sec.entries || []).find((e) => e.id === k);
            lines.push(`<div class="pl-plan-line"><span>${escape(entry?.name || nameOf(k))}</span><span>${escape(`${v} ${entry?.unit || ""}`.trim())}</span></div>`);
          }
        }
      }
      planLines.innerHTML = lines.join("");
      const said = choices === 1 ? "1 choice" : `${choices} choices`;
      document.querySelectorAll("[data-plan-count],[data-bar-count]").forEach((el) => { el.textContent = choices ? said : "nothing chosen yet"; });
      const done = recipe.sections.filter((s) => chosenCount(s)).length;
      const doneEl = work.querySelector<HTMLElement>("[data-done]");
      if (doneEl) doneEl.textContent = `${done} of ${recipe.sections.length} done`;
      if (current) panelCount.textContent = chosenCount(current) ? `${chosenCount(current)} chosen` : "";
      askForNumbers();
    }

    /* ── the review, and starting the build ──────────────────────────── */

    async function review() {
      drawer.hidden = true;
      current = null;
      panelName.textContent = "Read it back, then start the build";
      panelCount.textContent = "";
      panelLede.textContent = "";
      const body = { game, plan: { ...planBody() } };
      const said = await post("/api/builds/sheet", body);
      const summary = said?.summary;
      const problems: string[] = said?.problems || [];
      const runs = (await ask<{ id: number; name: string }[]>("/api/runs")) || [];
      panel.innerHTML = `
        ${problems.length ? consoleRows("What the data could not keep", problems) : ""}
        <p class="gd-eyebrow">The plan · ${summary?.choices ?? 0} choices</p>
        <div class="pl-drawer-body">${summary ? planLinesOf(summary) : ""}</div>
        <div class="pl-targets pl-start">
          <div class="pl-target"><label for="pl-name">Name</label>
            <input class="pl-field" id="pl-name" data-name maxlength="80" placeholder="What to call this character"></div>
          <div class="pl-target"><label for="pl-variant">Variant</label>
            <input class="pl-field" id="pl-variant" data-variant maxlength="80" value="${escape(summary?.className || "")}">
            <p class="gd-hint">The class named it. Change it if you like.</p></div>
          <div class="pl-target"><label for="pl-run">Beside a run</label>
            <select class="pl-field" id="pl-run" data-run>
              <option value="">None — a build can stand alone</option>
              ${runs.map((r) => `<option value="${r.id}">${escape(r.name)}</option>`).join("")}
            </select></div>
        </div>
        <div class="pl-slot-actions">
          <button type="button" class="pl-keep" data-start>Start the build</button>
          <span class="gd-hint" data-saying></span>
        </div>
        <p class="gd-hint">This writes the grid from Gear, checks from the sections you picked, and counters from the numbers.
          You may overwrite any target's words afterwards.</p>`;
      panel.querySelector("[data-start]")?.addEventListener("click", start);
    }

    const planBody = () => ({ class_id: classId, sections: plan });

    async function post(path: string, body: unknown) {
      try {
        const r = await fetch(path, { method: "POST", headers: { "content-type": "application/json" }, body: JSON.stringify(body) });
        const said = await r.json().catch(() => null);
        return r.ok ? said : { problems: [said?.detail || words.failed] };
      } catch { return { problems: [words.failed] }; }
    }

    const consoleRows = (head: string, rows: string[]) => `
      <div class="pl-refused"><p class="gd-eyebrow">${escape(head)}</p>
        ${rows.map((r) => `<p class="gd-mono">${escape(r)}</p>`).join("")}
        <p class="gd-hint">The rest of the plan is kept.</p></div>`;

    const planLinesOf = (summary: any) => (summary.sections || []).map((sec: any) =>
      `<p class="pl-plan-head">${escape(sec.name)}</p>` + (sec.lines || []).map((l: any) =>
        `<div class="pl-plan-line"><span>${escape(l.label)}</span><span>${escape(l.detail || "")}</span></div>`).join("")).join("");

    async function start() {
      const saying = panel.querySelector<HTMLElement>("[data-saying]")!;
      const name = (panel.querySelector<HTMLInputElement>("[data-name]")?.value || "").trim();
      if (!name) { saying.textContent = words.needsName; return; }
      saying.textContent = "";
      const runId = Number(panel.querySelector<HTMLSelectElement>("[data-run]")?.value || 0);
      const made = await post("/api/builds/plan", {
        game, name, variant: (panel.querySelector<HTMLInputElement>("[data-variant]")?.value || "").trim(),
        run_id: runId || null, plan: planBody(),
      });
      if (made?.id) { window.location.href = `/builds/${made.id}`; return; }
      saying.textContent = (made?.problems || [words.failed])[0];
    }

    /* ── one record whole ─────────────────────────────────────────────── */

    const record = document.querySelector<HTMLElement>("[data-record]");
    let packSeen: any = null;

    async function readRecord(kind: string, id: string) {
      if (!record) return;
      if (!packSeen) packSeen = await ask<any>(`/api/gamedata/${game}`);
      const rec = await ask<any>(`/api/gamedata/${game}/${kind}/${id}`);
      if (!rec) return;
      record.querySelector("[data-record-body]")!.innerHTML = drawRecord(rec, packSeen);
      record.hidden = false;
    }
    document.querySelector("[data-close-record]")?.addEventListener("click", () => { record!.hidden = true; });
    work.addEventListener("click", (e) => {
      const read = (e.target as HTMLElement).closest<HTMLElement>("[data-read]");
      if (!read) return;
      e.stopPropagation();
      const [kind, id] = read.dataset.read!.split(":");
      readRecord(kind, id);
    });

    document.querySelectorAll("[data-review]").forEach((b) => b.addEventListener("click", review));
    document.querySelectorAll("[data-open-plan]").forEach((b) => b.addEventListener("click", () => { drawer.hidden = false; }));
    document.querySelectorAll("[data-close-plan]").forEach((b) => b.addEventListener("click", () => { drawer.hidden = true; }));
    work.addEventListener("click", (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLElement>("[data-section]");
      if (!btn) return;
      const sec = recipe.sections.find((s) => s.id === btn.dataset.section);
      if (sec) showSection(sec);
    });

    (async () => {
      const got = await ask<{ sections: Section[] }>(`/api/gamedata/${game}/recipe`);
      if (!got) return;
      recipe = got;
      if (recipe.sections[0]) await showSection(recipe.sections[0]);
    })();
  }
</script>

<style is:global>

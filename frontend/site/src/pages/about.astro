---
/* About — ported from `ui_kits/site/About.jsx`.
 *
 * The page exists to keep TWO VOICES VISUALLY DISTINCT: a practitioner
 * Description and a character Lore block. Conflating them is the failure mode
 * the handoff says this page exists to avoid.
 *
 * Prose comes from the database so it is editable without a deploy. The
 * profile fields and credits are NOT seeded — the bundle's are sample values
 * and the readme forbids inventing an oshi mark — so they render their absent
 * states until supplied.
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionHeader from "../components/brand/SectionHeader.astro";
import Prose from "../components/content/Prose.astro";
import SectionFigure from "../components/blocks/SectionFigure.astro";
import ProfileFieldTable from "../components/tables/ProfileFieldTable.astro";
import CreditList from "../components/tables/CreditList.astro";
import FanArtCard from "../components/cards/FanArtCard.astro";
import EmptyState from "../components/feedback/EmptyState.astro";
import Badge from "../components/navigation/Badge.astro";
import { pageSections, profile } from "../lib/content";
import { site } from "../lib/api";
import { copy } from "../lib/copy";

/* Every word on this page, editable from the admin. The defaults below are
   what it was written with and what still renders if nothing was changed. */
const say = await copy("about");


const [sections, who] = await Promise.all([pageSections("about"), profile()]);
const fields = who?.fields ?? [];
/* The costumes, from the database rather than from the markup. */
const outfits = (await site<any[]>("/api/content/outfits")) ?? [];
const credits = (who?.credits ?? []).map((c) => ({
  role: c.role, name: c.name, href: c.url, note: c.note,
}));
---

<BaseLayout
  title={say("text.1", "About — Shruti")}
  description={say("text.2", "VTuber, theurgist and toolmaker. Three initiatory lineages, held at once.")}
>
  <div class="page">
    <SectionHeader
      as="h1"
      glyph="☾"
      eyebrow="About"
      title="Shruti"
      body={say("text.3", "VTuber · theurgist · toolmaker. Athens, GMT+3.")}
    />

    <div class="about-cols">
      <div>
        {
          sections.length > 0 ? (
            sections.map((s) => (
              /* The section's own title is a heading in the flow, not part of
                 its markdown body — Prose renders `html` OR its slot, never
                 both, so it goes above rather than inside. "intro" is skipped
                 because the page heading above already carries it. */
              <div class="about-block">
                {s.title && s.key !== "intro" && <h2 class="about-block-title">{s.title}</h2>}
                <SectionFigure media={s.media} title={s.title} />
                <Prose html={s.html} />
              </div>
            ))
          ) : (
            <EmptyState
              glyph="○"
              title={say("text.4", "Nothing written here yet")}
              body={say("text.5", "Not written up yet. The instruments are, though — they are on the work page and they all run without an account.")}
            />
          )
        }
      </div>

      <div class="about-side">
        <div>
          <h2 class="side-head">{say("profile.1", "Profile")}</h2>
          {
            fields.length > 0 ? (
              <ProfileFieldTable columns={1} fields={fields} />
            ) : (
              /* Nothing at all, deliberately.
                 Not sample values — the bundle's birthday, height and debut are
                 sample data and the readme is explicit that no oshi mark exists
                 and one must not be invented. And not a sentence either: there
                 is nothing to tell a READER about a fact table with no facts in
                 it, and the line that used to be here explained where the facts
                 are entered, which is a note to the operator printed on a page
                 for everybody else. An absent sidebar block is invisible; a
                 sentence saying it is absent is not. */
              null
            )
          }
        </div>
        <div>
          <h2 class="side-head">{say("credits.1", "Credits")}</h2>
          {
            credits.length > 0 ? (
              <CreditList dense credits={credits} />
            ) : (
              <p class="side-absent">{say("credits.2", "No credits recorded yet — the commissions are still in progress.")}</p>
            )
          }
        </div>
      </div>
    </div>

      {
        /* Was three hard-coded slots with no images and a badge claiming three
           commissions were open — the design bundle's mock-up, shipped. She
           could not add a fourth, could not upload art she had paid for, and
           could not stop the page making a claim about commissions.

           Absent entirely when there are none: an empty costume row says
           nothing a reader wants and invites a placeholder later. */
        outfits.length > 0 && (
          <section class="section costumes">
            <div class="section-head">
              <SectionHeader
                glyph="✶"
                eyebrow="Costumes"
                title="Outfits"
                body={say("text.6", "Commissioned work. Every one names the artist who drew it.")}
              />
            </div>
            <div class="grid-3">
              {outfits.map((o) => (
                <FanArtCard
                  image={o.media?.url ?? null}
                  artist={o.artist || o.name}
                  platform={o.status || undefined}
                  artistHref={o.artistUrl || undefined}
                  title={o.name}
                />
              ))}
            </div>
          </section>
        )
      }
  </div>
</BaseLayout>

<style>
  .about-cols {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: var(--space-7);
    align-items: start;
    margin-top: var(--space-6);
  }
  .about-cols > div:first-child { display: grid; gap: var(--space-5); }
  .about-block { display: grid; gap: var(--space-3); }
  /* h2, not h3: the only heading above these is the page's h1, so an h3 skips a
   level. The tag is the outline; the size below is the design, and neither
   value moved when the tag was corrected. */
  .about-block-title {
    font-family: var(--font-display);
    font-size: var(--text-h3);
    font-weight: 600;
    line-height: var(--leading-heading);
    color: var(--ink);
    margin: 0;
  }
  .about-side { display: grid; gap: var(--space-6); }
  .side-head {
    font: 600 var(--text-micro) var(--font-body);
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--ink-faint);
    margin: 0 0 10px;
  }
  .side-absent {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    line-height: var(--leading-body);
    color: var(--ink-faint);
    margin: 0;
    max-width: 38ch;
  }
  .costumes { margin-top: var(--space-7); }
  @media (max-width: 960px) { .about-cols { grid-template-columns: 1fr; } }
</style>

---
/* Sign in — ported from `ui_kits/site/Auth.jsx`.
 *
 * Magic link or password, switchable. If a link is sent, the "check your
 * email" state is MANDATORY and is the third surface in this pack — it is
 * where people get lost, so it names the address, gives the expiry, says the
 * link works once, mentions spam, and offers both "different address" and
 * "send it again".
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionHeader from "../components/brand/SectionHeader.astro";
import TextField from "../components/forms/TextField.astro";
import CsrfField from "../components/forms/CsrfField.astro";
import Button from "../components/forms/Button.astro";
import PasskeySignIn from "../components/auth/PasskeySignIn.astro";
import { SITE_API } from "../lib/api";
import { verifyCsrf } from "../lib/csrf";
import { redirectWithCookies } from "../lib/redirect";
import { copy } from "../lib/copy";
import Copy from "../components/content/Copy.astro";

/* Every word on this page, editable from the admin. The defaults below are
   what it was written with and what still renders if nothing was changed. */
const say = await copy("signin");


const method = Astro.url.searchParams.get("method") === "password" ? "password" : "link";
let sent = false;
let failed = "";
const values = { email: "" };

if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  if (!verifyCsrf(Astro.cookies, form)) {
    failed = say("error.retry", "That did not send. Reload the page and try again.");
  } else {
    values.email = String(form.get("email") ?? "").trim();
    const password = String(form.get("password") ?? "");
    try {
      const response = await fetch(`${SITE_API}/api/account/signin`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ email: values.email, password: password || null }),
      });
      const body = await response.json().catch(() => null);
      if (response.ok) {
        if (body?.signedIn) return redirectWithCookies("/account", response);
        // The "check your email" path renders rather than redirects, so
        // appending here is safe.
        const cookie = response.headers.get("set-cookie");
        if (cookie) Astro.response.headers.append("set-cookie", cookie);
        sent = true;
      } else {
        failed = body?.detail ?? say("error.failed2", "That did not work.");
      }
    } catch {
      failed = say("error.failed", "That did not work.");
    }
  }
}
---

<BaseLayout title={say("text.5", "Sign in — Shruti")} description={say("text.6", "Sign in by emailed link, or with a password.")} noindex>
  <div class="page auth">
    {
      sent ? (
        /* The state where people get lost, designed rather than implied. */
        <div class="check">
          <SectionHeader as="h1" glyph="☾︎" eyebrow={say("text.7", "Check your email")} title={say("text.8", "The link is on its way")} />
          {/* Three pieces before: an address, and two editable words with
              hardcoded prose between them. The whole line is one string now,
              so "once" and "20 minutes" can be reworded together with the
              sentence that carries them. */}
          <p class="check-body">
            <Copy
              text={say("text.15", "Sent to **{email}**. It works **once** and expires in **20 minutes**.")}
              vars={{ email: values.email }}
            />
          </p>
          <p class="check-body">{say("text.1", "Nothing yet? It sometimes lands in spam — and if the address has no account here, no mail is sent at all, which is deliberate: whether an address has an account is not something a stranger gets to learn from this form.")}</p>
          <div class="check-actions">
            <Button variant="secondary" href="/signin">{say("text.2", "Use a different address")}</Button>
            <form method="POST" class="inline-form">
              <CsrfField />
              <input type="hidden" name="email" value={values.email} />
              <Button type="submit" variant="ghost">{say("text.13", "Send it again")}</Button>
            </form>
          </div>
        </div>
      ) : (
        <>
          <SectionHeader
            as="h1" glyph="☾︎" eyebrow="Sign in" title={say("text.9", "Welcome back")}
            body={say("text.10", "By emailed link, or with a password if you set one.")}
          />
          {/* Above the email field, because for anyone who has one it is the
              shortest path in — and it is the only method here that never
              involves waiting for a message to arrive. */}
          <PasskeySignIn next="/account" label={say("text.11", "Sign in with a passkey")} />
          <p class="or">or</p>
          <nav class="method-switch" aria-label={say("text.12", "Sign-in method")}>
            <a href="/signin" aria-current={method === "link" ? "page" : undefined}>{say("text.14", "Emailed link")}</a>
            <a href="/signin?method=password" aria-current={method === "password" ? "page" : undefined}>{say("text.17", "Password")}</a>
          </nav>
          <form method="POST" novalidate class="auth-form">
            <CsrfField />
            {failed && <p class="auth-failed" role="alert">{failed}</p>}
            <TextField label={say("text.18", "Email")} name="email" type="email" required value={values.email} autocomplete="email" />
            {
              method === "password" && (
                <TextField label={say("text.19", "Password")} name="password" type="password" required autocomplete="current-password" />
              )
            }
            <div>
              <Button type="submit" size="lg">
                {method === "password" ? "Sign in" : "Send me a link"}
              </Button>
            </div>
            <p class="auth-alt"><Copy text={say("text.4", "No account? [Make one](/signup).")} /></p>
            {/* Reader accounts and the site owner's admin are separate systems
                with separate credentials. Saying so here costs nothing and
                saves the owner concluding her password is broken. */}
            <p class="admin-hint">
    <Copy text={say("text.3", "Looking for the site admin? That is [a separate sign-in](/admin).")} />
  </p>
          </form>
        </>
      )
    }
  </div>
</BaseLayout>

<style>
  .auth { max-width: 620px; }
  .or {
    font: 400 var(--text-xs) var(--font-body); color: var(--ink-faint);
    margin: var(--space-4) 0 0; text-transform: uppercase; letter-spacing: 0.08em;
  }
  .auth-form { display: grid; gap: var(--space-5); margin-top: var(--space-5); }
  .method-switch { display: flex; gap: 4px; margin-top: var(--space-5); }
  .method-switch a {
    font: 500 var(--text-sm) var(--font-body); color: var(--ink-soft); text-decoration: none;
    padding: 8px 14px; border-radius: var(--radius-sm);
  }
  .method-switch a:hover { color: var(--ink); background: var(--surface-veil); }
  .method-switch a[aria-current="page"] { color: var(--accent); background: var(--accent-wash); }
  .check { display: grid; gap: 12px; }
  .check-body { font: 400 var(--text-body) / var(--leading-body) var(--font-body); color: var(--ink-soft); margin: 0; max-width: 62ch; }
  .check-actions { display: flex; gap: 10px; flex-wrap: wrap; align-items: center; margin-top: var(--space-3); }
  .inline-form { display: inline; }
  .auth-failed { font: 400 var(--text-sm) var(--font-body); color: var(--live); margin: 0; }
  .auth-alt { font: 400 var(--text-sm) var(--font-body); color: var(--ink-soft); margin: 0; }
  .auth-alt a { color: var(--accent); }
  .admin-hint { font: 400 var(--text-xs) var(--font-body); color: var(--ink-faint); margin: 0; }
  .admin-hint a { color: var(--accent); }
</style>

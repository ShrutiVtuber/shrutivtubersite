---
/* The magic link's landing. Consumes the token and signs the reader in. */
import BaseLayout from "../../layouts/BaseLayout.astro";
import EmptyState from "../../components/feedback/EmptyState.astro";
import Button from "../../components/forms/Button.astro";
import { SITE_API } from "../../lib/api";
import { redirectWithCookies } from "../../lib/redirect";
import { copy } from "../../lib/copy";

/* Every word here, editable from the admin. The defaults below are what
   it was written with and what still renders if nothing was changed. */
const say = await copy("signin/link");


const token = Astro.url.searchParams.get("token") ?? "";
let failed = "";

if (token) {
  try {
    const response = await fetch(`${SITE_API}/api/account/link?token=${encodeURIComponent(token)}`);
    if (response.ok) return redirectWithCookies("/account", response);
    const body = await response.json().catch(() => null);
    failed = body?.detail ?? "That link did not work.";
  } catch {
    failed = "That link did not work.";
  }
} else {
  failed = "That link is missing its token.";
}
---

<BaseLayout title={say("text.1", "Sign in — Shruti")} description={say("text.2", "Signing you in.")} noindex>
  <div class="page">
    <EmptyState
      glyph="◐"
      as="h1"
      title={say("text.3", "That link has expired")}
      body={`${failed} Links work once and last twenty minutes, which is short on purpose — a forwarded email should not be a standing key.`}
    >
      <Button slot="action" variant="secondary" href="/signin">{say("text.4", "Send a new one")}</Button>
    </EmptyState>
  </div>
</BaseLayout>

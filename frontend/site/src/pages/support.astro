---
/* Support — ported from `ui_kits/site/Support.jsx`.
 *
 * The merch block ships its authored empty state, not a shop. The brief says
 * do not build one; the slot is held deliberately.
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import Prose from "../components/content/Prose.astro";
import SectionFigure from "../components/blocks/SectionFigure.astro";
import SectionHeader from "../components/brand/SectionHeader.astro";
import Button from "../components/forms/Button.astro";
import Badge from "../components/navigation/Badge.astro";
import CsrfField from "../components/forms/CsrfField.astro";
import CounterCard from "../components/counters/CounterCard.astro";
import { pageSections } from "../lib/content";
import { site, SITE_API } from "../lib/api";
import { verifyCsrf } from "../lib/csrf";
import { copy } from "../lib/copy";

/* Checkout is started by a PLAIN FORM POST handled here, then a redirect to
   Stripe — not by JavaScript. The rest of the site works with scripting off
   and the page where someone gives money is the last one that should be the
   exception. */
let failed = "";
if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  if (!verifyCsrf(Astro.cookies, form)) {
    failed = "That did not start. Reload the page and try again.";
  } else {
    const tier = String(form.get("tier") ?? "one-off");
    /* Euros in the box, cents on the wire. The server clamps the range —
       what arrives from a form is a suggestion, not an amount. */
    const euros = Number(form.get("amount") ?? 0);
    const amount = tier === "one-off" && euros > 0 ? Math.round(euros * 100) : null;
    try {
      const response = await fetch(`${SITE_API}/api/billing/checkout`, {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
          // The reader's session, so a signed-in supporter is matched to
          // their account rather than to a second Stripe customer.
          cookie: Astro.request.headers.get("cookie") ?? "",
          // And the BROWSER'S origin. This runs in Node, so without it the
          // backend sees no origin, falls back to the configured site, and
          // hands Stripe a cancel URL pointing at shrutivtuber.com — which
          // before cutover is the old WordPress site. The backend matches it
          // against its own allowlist regardless.
          ...(Astro.request.headers.get("origin")
            ? { origin: Astro.request.headers.get("origin")! }
            : {}),
          ...(Astro.request.headers.get("referer")
            ? { referer: Astro.request.headers.get("referer")! }
            : {}),
        },
        body: JSON.stringify({ tier, amount }),
      });
      const body = await response.json().catch(() => null);
      if (response.ok && body?.url) return Astro.redirect(body.url, 303);
      failed = body?.detail ?? "That could not be started. Try again in a moment.";
    } catch {
      failed = "That could not be started. Try again in a moment.";
    }
  }
}

interface StripeTier {
  tier: string;
  amount: number | null;
  currency: string;
  interval: string;
  /* The copy comes with the tier now, so adding one is adding a row rather
     than editing this page and deploying it. */
  name?: string;
  tagline?: string;
  perks?: string[];
  cta?: string;
  badge?: string;
  featured?: boolean;
}
interface Billing {
  configured: boolean;
  tiers: StripeTier[];
  oneOff: { min: number; max: number; default: number; currency: string } | null;
  /** Test keys take a card and move no money. */
  testMode?: boolean;
}

const [sections, billing] = await Promise.all([
  pageSections("support"),
  site<Billing>("/api/billing/tiers"),
]);
const intro = sections.find((s) => s.key === "intro");
const extra = sections.filter((s) => s.key !== "intro");

/* The AMOUNT comes from Stripe, never from this file. A price written here and
   a price configured in the dashboard drift the moment either changes, and the
   direction that drift breaks in — charging more than the page promised — is
   the one that must never happen. What is here is only the copy. */
const priced = new Map((billing?.tiers ?? []).map((t) => [t.tier, t]));
const open = Boolean(billing?.configured);
const oneOff = billing?.oneOff ?? null;

const money = (cents: number | null | undefined, currency = "EUR") =>
  cents == null
    ? ""
    : new Intl.NumberFormat("en-IE", {
        style: "currency", currency,
        minimumFractionDigits: cents % 100 === 0 ? 0 : 2,
      }).format(cents / 100);

/* The one-off is not a tier and never was — its amount is chosen by the giver,
   not configured — so it is written here and the rest come from the database. */
/* Every word on this page, editable. The defaults below are what it was
   written with and what still renders if nothing has been changed. */
const say = await copy("support");

const ONE_OFF = {
  key: "one-off",
  name: say("oneoff.name", "One-off"),
  price: money(oneOff?.default ?? 300),
  note: say("oneoff.note", "once, or any amount"),
  primary: false,
  badge: "",
  cta: say("oneoff.cta", "Give once"),
  items: [
    say("oneoff.perk1", "A coffee for the bench"),
    say("oneoff.perk2", "Name read on stream if you leave one"),
    say("oneoff.perk3", "No account needed"),
  ],
};

const TIERS = [
  ONE_OFF,
  ...(billing?.tiers ?? []).map((t) => ({
    key: t.tier,
    name: t.name || t.tier,
    price: money(t.amount ?? null, t.currency || "EUR"),
    note: t.interval ? `/ ${t.interval}` : "",
    primary: !!t.featured,
    badge: t.badge ?? "",
    cta: t.cta || `Become ${t.name || t.tier}`,
    items: t.perks ?? [],
  })),
];

/* A tier is offerable when Stripe knows its price. The one-off always is —
   its amount is chosen here, not configured. */
/* A tier is offerable when Stripe knows its price. The one-off always is —
   its amount is chosen by the giver, not configured. */
const offerable = (key: string) => open && (key === "one-off" || priced.has(key));

/* What the money is currently for. The same counters the overlay draws — a
   reader who arrives from a clip should be able to see the goal they just
   watched somebody fill, and a page asking for support that cannot say what
   for is asking a stranger to take it on trust. */
let goals: any[] = [];
try {
  const r = await fetch(`${SITE_API}/api/counters`);
  if (r.ok) goals = await r.json();
} catch { /* the block is omitted; the rest of the page still sells */ }

/* Every block the admin has added to /support. */
---

<BaseLayout title={say("text.1", "Support the work — Shruti")} description={say("text.2", "Streams are free and the tools are open source. Support keeps the bench lit.")}>
  <div class="page">
    <SectionHeader
      as="h1" glyph="♄"
      eyebrow={say("header.eyebrow", "Support the work")}
      title={intro?.title || say("header.title", "Keep the bench lit")}
      body={say("header.body", "Streams are free and the tools are open source. Support pays for the ephemeris server, art commissions, and the hours the software takes.")}
    />

    {failed && <p class="pay-failed" role="alert">{failed}</p>}

    {
      billing?.testMode && (
        <p class="testmode" role="status">
          <strong>{say("testmode.lead", "Test mode.")}</strong>{" "}
          {say("testmode.body", "Cards are accepted and nothing is charged. Nobody can actually support the work until the live keys are in.")}
        </p>
      )
    }

    {goals.length > 0 && (
      <section class="goals">
        <h2>{say("goals.heading", "What it is going towards")}</h2>
        <div class="goal-list">
          {goals.map((g: any) => <CounterCard counter={g} level={3} />)}
        </div>
      </section>
    )}

    <div class="tiers">
      {
        TIERS.map((t) => (
          <div class="tier">
            <div class="tier-head">
              <h2>{t.name}</h2>
              {t.badge && <Badge tone="rose">{t.badge}</Badge>}
            </div>
            <div class="tier-price">
              {t.price || <span class="tier-tbd">—</span>}
              <span class="tier-note"> {t.note}</span>
            </div>
            <ul>{t.items.map((i) => <li>{i}</li>)}</ul>
            <div>
              {
                offerable(t.key) ? (
                  <form method="POST" class="tier-form">
                    <CsrfField />
                    <input type="hidden" name="tier" value={t.key} />
                    {
                      t.key === "one-off" && oneOff && (
                        <label class="amount">
                          <span class="amount-lbl">Amount</span>
                          <span class="amount-box">
                            <span class="amount-cur" aria-hidden="true">€</span>
                            <input
                              type="number" name="amount" inputmode="decimal"
                              value={(oneOff.default / 100).toFixed(0)}
                              min={(oneOff.min / 100).toFixed(2)}
                              max={(oneOff.max / 100).toFixed(0)}
                              step="1" aria-label={say("text.3", "Amount in euro")}
                            />
                          </span>
                        </label>
                      )
                    }
                    <Button type="submit" variant={t.primary ? "primary" : "secondary"}>
                      {t.cta}
                    </Button>
                  </form>
                ) : (
                  /* No button that goes nowhere. Which half is missing matters
                     to whoever has to fix it, so the two states differ. */
                  <span class="tier-absent">
                    {open ? "This tier is not open yet" : "Not open yet"}
                  </span>
                )
              }
            </div>
          </div>
        ))
      }
    </div>

    <p class="tiers-note">
      {
        open ? (
          <>
            {/* Split around the link rather than flattened into one string:
                the sentence stays editable and the link stays a link. */}
            {say("footnote.open.before", "Payment happens on Stripe — card details never reach this site. Monthly support can be cancelled from ")}
            <a href="/account">{say("footnote.open.link", "your account")}</a>
            {say("footnote.open.after", " in one click, it stops at the end of the month you have already paid for rather than the moment you press it, and no email to me is required or wanted.")}
          </>
        ) : (
          <>
            {say("footnote.closed", "Support is not open yet. When it is, payment will happen on Stripe, card details will never reach this site, and cancelling monthly support will be one button on your own account page.")}
          </>
        )
      }
    </p>

  </div>

    {/* Anything else the admin has put on this page. Only `intro` used to
        render, so a block added in the admin simply did not appear — which
        makes the editor feel broken rather than the page feel empty. */}
    {
      extra.length > 0 && (
        <div class="page-sections">
          {
            extra.map((s) => (
              <section class="page-section">
                {s.title && <h2>{s.title}</h2>}
                <SectionFigure media={s.media} title={s.title} />
                <Prose html={s.html} />
              </section>
            ))
          }
        </div>
      )
    }

</BaseLayout>

<style>
  .goals { display: grid; gap: 12px; margin: 0 0 var(--space-6, 32px); }
  .goals h2 { margin: 0; font-family: var(--font-display); font-size: var(--text-lg); }
  .goal-list { display: grid; gap: 12px; }
  @media (min-width: 720px) {
    .goal-list { grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); }
  }

  /* Loud on purpose. A site taking test cards looks exactly like one that
     works — the failure is silent and on the wrong side of the sale. */
  .testmode {
    margin: 0 0 var(--space-4);
    padding: var(--space-3) var(--space-4);
    border: var(--border-w) solid var(--live);
    border-radius: var(--radius-sm);
    background: color-mix(in srgb, var(--live) 8%, transparent);
    font: 400 var(--text-sm) var(--font-body);
    color: var(--ink);
  }

  .pay-failed { font: 400 var(--text-sm) var(--font-body); color: var(--live); margin: 0; }
  .tier-form { display: grid; gap: var(--space-3); justify-items: start; }
  .tier-tbd { color: var(--ink-faint); }
  .amount { display: grid; gap: 4px; }
  .amount-lbl { font: 500 var(--text-xs) var(--font-body); color: var(--ink-soft); }
  .amount-box {
    display: inline-flex; align-items: center; gap: 2px;
    border: var(--border-w) solid var(--line-strong); border-radius: var(--radius-sm);
    background: var(--surface-card); padding: 0 10px;
  }
  .amount-cur { font: 400 var(--text-sm) var(--font-mono); color: var(--ink-faint); }
  .amount-box input {
    font: 500 var(--text-body) var(--font-mono); color: var(--ink);
    background: none; border: 0; padding: 9px 4px; width: 5.5ch;
  }
  .amount-box input:focus { outline: none; }
  .amount-box:focus-within { border-color: var(--accent); }
  .tiers-note a { color: var(--accent); }

  .tiers {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 20px;
    margin-top: var(--space-6);
  }
  .tier {
    background: var(--surface-card);
    border: var(--border-w) solid var(--line);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-1);
    padding: 22px 20px;
    display: grid;
    gap: 12px;
    align-content: start;
  }
  .tier-head { display: flex; justify-content: space-between; align-items: center; gap: 8px; }
  .tier-head h2 { font: 600 var(--text-h3) var(--font-display); color: var(--ink); margin: 0; }
  .tier-price { font: 500 26px var(--font-mono); color: var(--ink); font-variant-numeric: tabular-nums; }
  .tier-note { font: 400 var(--text-sm) var(--font-body); color: var(--ink-soft); }
  .tier ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 6px; }
  .tier li { font: 400 var(--text-sm) / 1.5 var(--font-body); color: var(--ink-soft); }
  .tier-absent { font: 400 var(--text-xs) var(--font-mono); color: var(--ink-faint); }
  .tiers-note { font: 400 var(--text-sm) var(--font-mono); color: var(--ink-soft); margin: var(--space-5) 0 var(--space-6); }

  .page-sections { display: grid; gap: var(--space-6); margin-top: var(--space-6); }
  .page-section { display: grid; gap: var(--space-3); }
  .page-section h2 { font: 600 var(--text-h3) var(--font-display); color: var(--ink); margin: 0; }
</style>

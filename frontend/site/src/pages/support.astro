---
/* Support — ported from `ui_kits/site/Support.jsx`.
 *
 * The merch block ships its authored empty state, not a shop. The brief says
 * do not build one; the slot is held deliberately.
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import Prose from "../components/content/Prose.astro";
import SectionHeader from "../components/brand/SectionHeader.astro";
import Button from "../components/forms/Button.astro";
import Badge from "../components/navigation/Badge.astro";
import EmptyState from "../components/feedback/EmptyState.astro";
import { pageSections } from "../lib/content";
import { site, PATHS, type LinkGroups } from "../lib/api";

const [sections, links] = await Promise.all([pageSections("support"), site<LinkGroups>(PATHS.links)]);
const intro = sections.find((s) => s.key === "intro");
const extra = sections.filter((s) => s.key !== "intro");

/* Ko-fi only if it is actually one of her links. No invented destination. */
const kofi = Object.values(links?.groups ?? {}).flat()
  .find((l) => l.platform === "kofi")?.url;

const TIERS = [
  {
    name: "One-off", price: "€3", note: "once, or any amount", primary: false, badge: "",
    items: ["A coffee for the bench", "Name read on stream if you leave one", "No account needed"],
  },
  {
    name: "Lamplighter", price: "€4", note: "/ month", primary: true, badge: "Most common",
    items: ["Members channel on Discord", "Schedule a day early", "Name in the monthly credits roll"],
  },
  {
    name: "Almanac", price: "€9", note: "/ month", primary: false, badge: "",
    items: ["Everything in Lamplighter", "Monthly practice notes, signed Soror Eu. A.", "A vote on the next instrument"],
  },
];

/* Every block the admin has added to /support. */
---

<BaseLayout title="Support the work — Shruti" description="Streams are free and the tools are open source. Support keeps the bench lit.">
  <div class="page">
    <SectionHeader
      as="h1" glyph="♄" eyebrow="Support the work" title={intro?.title || "Keep the bench lit"}
      body="Streams are free and the tools are open source. Support pays for the ephemeris server, art commissions, and the hours the software takes."
    />

    <div class="tiers">
      {
        TIERS.map((t) => (
          <div class="tier">
            <div class="tier-head">
              <h2>{t.name}</h2>
              {t.badge && <Badge tone="rose">{t.badge}</Badge>}
            </div>
            <div class="tier-price">{t.price}<span class="tier-note"> {t.note}</span></div>
            <ul>{t.items.map((i) => <li>{i}</li>)}</ul>
            <div>
              {
                kofi ? (
                  <Button variant={t.primary ? "primary" : "secondary"} href={kofi}>
                    {t.primary ? "Join on Ko-fi" : "Open Ko-fi"}
                  </Button>
                ) : (
                  /* No Ko-fi link recorded, so no button that goes nowhere. */
                  <span class="tier-absent">Ko-fi link not set yet</span>
                )
              }
            </div>
          </div>
        ))
      }
    </div>

    <p class="tiers-note">
      Memberships are Ko-fi-hosted; cancel any time. Tiers ship only if memberships open — this is
      the design for that day.
    </p>

    <SectionHeader as="h2" title="Merch" />
    <EmptyState
      glyph="◐"
      title="No merch yet"
      body="Designs are commissioned before anything is printed — nothing exists that I wouldn't wear. Discord hears first when that changes."
    />
  </div>

    {/* Anything else the admin has put on this page. Only `intro` used to
        render, so a block added in the admin simply did not appear — which
        makes the editor feel broken rather than the page feel empty. */}
    {
      extra.length > 0 && (
        <div class="page-sections">
          {
            extra.map((s) => (
              <section class="page-section">
                {s.title && <h2>{s.title}</h2>}
                <Prose html={s.html} />
              </section>
            ))
          }
        </div>
      )
    }

</BaseLayout>

<style>
  .tiers {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 20px;
    margin-top: var(--space-6);
  }
  .tier {
    background: var(--surface-card);
    border: var(--border-w) solid var(--line);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-1);
    padding: 22px 20px;
    display: grid;
    gap: 12px;
    align-content: start;
  }
  .tier-head { display: flex; justify-content: space-between; align-items: center; gap: 8px; }
  .tier-head h2 { font: 600 var(--text-h3) var(--font-display); color: var(--ink); margin: 0; }
  .tier-price { font: 500 26px var(--font-mono); color: var(--ink); font-variant-numeric: tabular-nums; }
  .tier-note { font: 400 var(--text-sm) var(--font-body); color: var(--ink-soft); }
  .tier ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 6px; }
  .tier li { font: 400 var(--text-sm) / 1.5 var(--font-body); color: var(--ink-soft); }
  .tier-absent { font: 400 var(--text-xs) var(--font-mono); color: var(--ink-faint); }
  .tiers-note { font: 400 var(--text-sm) var(--font-mono); color: var(--ink-soft); margin: var(--space-5) 0 var(--space-6); }

  .page-sections { display: grid; gap: var(--space-6); margin-top: var(--space-6); }
  .page-section { display: grid; gap: var(--space-3); }
  .page-section h2 { font: 600 var(--text-h3) var(--font-display); color: var(--ink); margin: 0; }
</style>

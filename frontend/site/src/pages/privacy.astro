---
/* Privacy — long-form legal, rendered from the database so the wording can be
 * corrected without a deploy. Anchored subheadings and a readable measure, per
 * the design.
 *
 * Empty is an honest state here and a loud one: a site with accounts and a
 * newsletter needs this page to say something true before it takes anyone's
 * data.
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionHeader from "../components/brand/SectionHeader.astro";
import Prose from "../components/content/Prose.astro";
import SectionFigure from "../components/blocks/SectionFigure.astro";
import LegalImprint from "../components/brand/LegalImprint.astro";
import EmptyState from "../components/feedback/EmptyState.astro";
import CountingChoice from "../components/insight/CountingChoice.astro";
import { pageSections } from "../lib/content";
import { site } from "../lib/api";
import { copy } from "../lib/copy";

/* Every word here, editable from the admin. The defaults below are what
   it was written with and what still renders if nothing was changed. */
const say = await copy("privacy");


interface Imprint {
  visible: boolean;
  entity?: string; street?: string; postcode?: string; city?: string;
  country?: string; email?: string; registry?: string; vat?: string;
}
const imprint = await site<Imprint>("/api/content/imprint");
const sections = await pageSections("privacy");
---

<BaseLayout title={say("text.1", "Privacy — Shruti")} description={say("text.2", "What is collected, why, and how to get it back or delete it.")}>
  <div class="page legal-page">
    <SectionHeader as="h1" glyph="◐" eyebrow="Legal" title={say("text.5", "Privacy")} />
    {
      sections.length > 0 ? (
        <div class="legal-body">
          {sections.map((s) => (
            <section id={s.key}>
              {s.title && <h2>{s.title}</h2>}
              <SectionFigure media={s.media} title={s.title} />
              <Prose html={s.html} />
              {s.key === "counting" && <CountingChoice />}
            </section>
          ))}
        </div>
      ) : (
        <EmptyState
          glyph="○"
          title={say("text.3", "Not written yet")}
          body={say("text.4", "This policy is not up yet, and until it is, nothing on this site asks you for anything. If you have a question in the meantime, the contact page reaches a person.")}
        />
      )
    }
    {
      imprint?.visible && (
        <div class="legal-imprint">
          <LegalImprint
            layout="inline"
            entity={imprint.entity} street={imprint.street} postcode={imprint.postcode}
            city={imprint.city} country={imprint.country} email={imprint.email}
            registry={imprint.registry} vat={imprint.vat}
          />
        </div>
      )
    }
  </div>
</BaseLayout>

<style>
  .legal-page { max-width: 860px; }
  .legal-body { display: grid; gap: var(--space-6); margin-top: var(--space-6); }
  .legal-body h2 {
    font: 600 var(--text-h3) var(--font-display);
    color: var(--ink);
    margin: 0 0 var(--space-3);
    scroll-margin-top: 84px;
  }
  .legal-imprint {
    margin-top: var(--space-7);
    padding-top: var(--space-5);
    border-top: var(--border-w) solid var(--line);
  }
</style>

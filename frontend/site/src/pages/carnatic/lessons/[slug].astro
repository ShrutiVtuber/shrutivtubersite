---
/* The lesson reader (Web Learn Practice, "lesson"). The video slot is an art
 * slot: until a lesson video exists it says so, and the notation, audio and
 * play-along below are complete without it. A video would load only when
 * pressed. Signed out, "mark complete" keeps the lesson on this device. */
import SwaraLayout from "../../../layouts/SwaraLayout.astro";
import Hero from "../../../components/carnatic/Hero.astro";
import Button from "../../../components/forms/Button.astro";
import { hrefIn, langOf, words } from "../../../lib/carnatic/i18n";
import { lessons } from "../../../lib/carnatic/data";
import { lessonList, SET_PROSE } from "../../../lib/carnatic/lessons";
import { visitor, swaraScript } from "../../../lib/carnatic/prefs";
import { avartanamHtml, toCounts } from "../../../lib/carnatic/render";
import { notFound } from "../../../lib/carnatic/notfound";
import { copy } from "../../../lib/copy";
import { schoolJournal } from "../../../lib/carnatic/catalogue";

const lang = langOf(Astro);
const tr = await words(lang);
const say = await copy("carnatic/lessons/[slug]");
const L = (p: string) => hrefIn(lang, p);
const { me, settings } = await visitor(Astro);
const data = await lessons();
const list = lessonList(data, (id) => tr(`set.${id}` as any));
const idx = list.findIndex((l) => l.slug === Astro.params.slug);
if (idx < 0) return notFound(Astro);
const l = list[idx];
const next = list[idx + 1];
const script = swaraScript(settings, lang);
const firstLine = l.item.sections[0]?.lines[0];
const firstAv = firstLine ? avartanamHtml({ counts: toCounts(firstLine.segments, 1).slice(0, l.item.angas.reduce((a: number, b: number) => a + b, 0)), angas: l.item.angas }, { script, tamil: settings.tamilStyle }) : "";
const lede = l.set === "sarali_varisai" && l.n === 1 ? say("lede.sarali1", "The seven swaras, up and down, at three speeds.") : (l.title ? `${l.title}.` : "");
const journal = await schoolJournal(1);
const talaName = (l.item.practicalTala ?? l.item.tala).replace(/_/g, " ").replace("rupaka chaturasra", "rupaka, 6-count").replace(/^\w/, (c: string) => c.toUpperCase());
const STEPS = [say("step1", "Listen to the line with the drone"), say("step2", "Sing or play speed 1"), say("step3", "Keep the tala with your hand"), say("step4", "Speeds 2 and 3")];
const droneLine = say("droneLine", "drone Sa = {sa} · {tala} · {tempo} / min").replace("{sa}", settings.sa).replace("{tala}", talaName).replace("{tempo}", String(settings.tempo));
---
<SwaraLayout title={`${l.name} · Swara Studio`} description={`${l.name}${l.title ? `: ${l.title}` : ""}. ${SET_PROSE[l.set] ?? ""}`.slice(0, 300)}
             crumbs={[[tr("crumb.learn"), L("/carnatic/lessons")], [tr("crumb.lessons"), L("/carnatic/lessons")], [l.name]]}>
  <Hero eyebrow={say("eyebrow", "Lesson {n} · Beginner path").replace("{n}", String(idx + 1))} title={l.name} lede={lede} />
  <div class="sw-cols" data-lesson={l.id} data-signed-in={me.signedIn ? "1" : ""}>
    <div class="sw-main">
      <div class="sky ls-video" role="img" aria-label={say("videoAlt", "Lesson video, to come")}>
        <div class="sky-veil ls-veil">
          <p class="sw-h4">{say("videoH", "Video to come")}</p>
          <p class="sw-note">{say("videoP", "The notation, audio and play-along below are complete without it. Videos load only when you press play.")}</p>
        </div>
        <div class="sky-horizon"></div>
      </div>
      <p class="sw-prose">{say(`prose.${l.set}`, SET_PROSE[l.set] ?? "")}</p>
      <div class="sw-card ls-line">
        <p class="t-eyebrow sw-eyebrow">{l.name} · {tr("gen.speed", { n: 1 })}</p>
        <div class:list={["sn-script-" + script]} set:html={firstAv} />
        <div class="ls-play">
          <Button href={L(`/carnatic/path?item=${l.id}`)} size="sm">{say("playAlong", "Play along")}</Button>
          <span class="sw-mono">{droneLine}</span>
        </div>
      </div>
      <div class="ls-foot">
        <button type="button" class="ls-done" data-complete>{say("complete", "Mark complete")}</button>
        <span class="sw-note">{me.signedIn ? say("savedAccount", "Saved to your account.") : say("savedLocal", "Signed out, progress stays on this device.")}</span>
        <span class="spacer"></span>
        {next && <a href={L(`/carnatic/lessons/${next.slug}`)} class="ls-next">{say("next", "Next")}: {next.name}</a>}
      </div>
    </div>
    <aside class="sw-aside">
      <div class="ls-steps">
        <p class="t-eyebrow sw-eyebrow">{say("inLesson", "In this lesson")}</p>
        <ul>{STEPS.map((s, i) => <li data-step={i}><i></i>{s}</li>)}</ul>
      </div>
      {journal.length > 0 && (
        <div class="ls-journal"><p class="t-eyebrow sw-eyebrow">{tr("raga.journal")}</p><a href={journal[0].href}>{journal[0].title}</a></div>
      )}
    </aside>
  </div>
</SwaraLayout>

<script>
  import { boot, csrf } from "../../../lib/carnatic/client/state";
  const root = document.querySelector<HTMLElement>("[data-lesson]");
  if (root) {
    const id = root.dataset.lesson!;
    let progress: Record<string, number[]> = {};
    try { progress = JSON.parse(localStorage.getItem("swara.progress") || "{}"); } catch { /* blocked */ }
    const paint = () => {
      const done = progress[id] ?? [];
      const steps = [done.length > 0, done.includes(1), done.includes(1), done.includes(2) && done.includes(3)];
      root.querySelectorAll<HTMLElement>("[data-step]").forEach((li, i) => li.classList.toggle("on", steps[i]));
    };
    paint();
    root.querySelector("[data-complete]")?.addEventListener("click", (e) => {
      progress[id] = [1, 2, 3];
      try { localStorage.setItem("swara.progress", JSON.stringify(progress)); } catch { /* blocked */ }
      if (boot().signedIn) fetch(`/api/carnatic/me/progress/${id}`, { method: "PUT", headers: { "content-type": "application/json", "x-csrf-token": csrf() }, body: JSON.stringify({ speeds: [1, 2, 3] }) });
      (e.currentTarget as HTMLElement).textContent = "Completed";
      paint();
    });
  }
</script>

<style>
  .ls-video { border-radius: 10px; min-height: 360px; display: grid; place-items: center; }
  .ls-veil { position: relative; padding: 16px 20px; text-align: center; display: grid; gap: 4px; max-width: 420px; }
  .ls-line { display: grid; gap: 14px; }
  .ls-play { display: flex; gap: 12px; align-items: center; flex-wrap: wrap; }
  .ls-foot { display: flex; gap: 12px 16px; align-items: center; flex-wrap: wrap; padding-top: 16px; border-top: 1px solid var(--line); }
  .ls-done { appearance: none; border: 1px solid color-mix(in srgb, var(--accent) 55%, transparent); border-radius: var(--radius-sm); background: transparent; color: var(--accent); font: 600 var(--text-sm) / 1 var(--font-body); padding: 11px 18px; cursor: pointer; }
  .ls-foot .spacer { flex: 1; }
  .ls-next { font: var(--text-sm) / 1.3 var(--font-body); }
  .ls-steps ul { list-style: none; margin: 10px 0 0; padding: 0; display: grid; gap: 14px; }
  .ls-steps li { display: flex; gap: 12px; align-items: center; font: 15px / 1.3 var(--font-body); color: var(--ink); }
  .ls-steps li i { width: 8px; height: 8px; border-radius: 99px; border: 1px solid var(--accent); }
  .ls-steps li.on i { background: var(--accent); }
  .ls-journal { display: grid; gap: 8px; padding-top: 14px; border-top: 1px solid var(--line); }
  .ls-journal a { font: 18px / 1.3 var(--font-display); color: var(--ink); text-decoration: none; }
</style>

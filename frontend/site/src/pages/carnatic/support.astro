---
/* Support (Web Compose Account, "support") — the web only: the app shows no
 * prices, no supporter mentions and no links to buy.
 *
 * Nothing in Swara Studio is paygated (the owner's rule of 26 Sep 2026):
 * every tool is free for everyone, as the site's other tools are. This page
 * only invites people to become a Swaras supporter through the site's own
 * support page (/support), and thanks those who are. The prices shown are
 * the site's real tiers, read from the billing API; nothing here invents one.
 */
import SwaraLayout from "../../layouts/SwaraLayout.astro";
import Hero from "../../components/carnatic/Hero.astro";
import Chip from "../../components/carnatic/Chip.astro";
import Button from "../../components/forms/Button.astro";
import { langOf, words } from "../../lib/carnatic/i18n";
import { site } from "../../lib/api";
import { visitor } from "../../lib/carnatic/prefs";
import { copy } from "../../lib/copy";

const lang = langOf(Astro);
const tr = await words(lang);
const say = await copy("carnatic/support");
const { me } = await visitor(Astro);
const billing = await site<{ configured?: boolean; tiers?: any[] }>("/api/billing/tiers");
const tiers = (billing?.tiers ?? []).filter((x) => x.amount);
const price = (x: any) => `€${(x.amount / 100).toFixed(x.amount % 100 ? 2 : 0)}${x.interval === "month" ? " a month" : x.interval === "year" ? " a year" : ""}`;
const first = tiers.find((x) => x.featured) ?? tiers[0];
---
<SwaraLayout title={say("meta.title", "Support Swara Studio")}
             description={say("meta.description", "Swara Studio is free to use, and nothing in it is locked. Swaras supporters, the people who support Shruti's work, keep it going.")}>
  <Hero eyebrow={tr("nav.support")} title={say("title", "Free to use, kept going by supporters")} lede={say("lede", "Every tool in the school is free for everyone, with or without an account. Nothing is locked, and nothing is kept for supporters.")} />
  {me.supporter && <p class="sw-p su-thanks">{tr("landing.thanks")}</p>}
  <section class="sw-card su-card su-main" data-tiers>
    <p class="t-eyebrow sw-eyebrow su-accent">{say("payH", "Become a Swaras supporter")}</p>
    <h2 class="su-h">{say("payTitle", "Support Shruti's work")}</h2>
    <p class="sw-p">{say("payP", "Swaras are the people who support Shruti's work: the streams, the site and this school. Supporting changes nothing you can do here; it keeps the school going for everyone.")}</p>
    {tiers.length > 0 && (
      <div class="sw-chips">
        {tiers.map((x) => <Chip data-tier={x.tier} data-label={price(x)} active={x === first}>{x.name} · {price(x)}</Chip>)}
      </div>
    )}
    <div><Button href="/support" data-go>{first ? `${say("supportWith", "Support with")} ${price(first)}` : say("become", "Become a Swaras supporter")}</Button></div>
    {billing?.configured === false && <p class="sw-note">{say("notOpen", "Payments are not open yet on this site.")}</p>}
  </section>
  <p class="sw-note su-foot">{say("foot", "Web only. The app shows no prices and no supporter mentions. Support goes through the site's own support page and its existing processor.")}</p>
</SwaraLayout>

<script>
  const box = document.querySelector<HTMLElement>("[data-tiers]");
  box?.querySelectorAll<HTMLElement>("[data-tier]").forEach((c) => c.addEventListener("click", () => {
    box.querySelectorAll("[data-tier]").forEach((x) => x.setAttribute("aria-pressed", String(x === c)));
    const go = box.querySelector<HTMLAnchorElement>("[data-go] span") ?? box.querySelector<HTMLAnchorElement>("[data-go]");
    if (go) go.textContent = `Support with ${c.dataset.label}`;
  }));
</script>

<style>
  .su-card { display: grid; gap: 14px; align-content: start; padding: 20px; margin-top: 24px; max-width: 640px; }
  .su-main { border-color: var(--accent); }
  .su-accent { color: var(--accent); }
  .su-h { margin: 0; font: 24px / 1.2 var(--font-display); color: var(--ink); }
  .su-thanks { padding-top: 16px; }
  .su-foot { padding-top: 16px; }
</style>

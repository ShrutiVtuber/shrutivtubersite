---
/* Settings (Web Compose Account, "settings"): language and swara letters
 * (with Tamil's two styles: grantha ஸ, the default, or pure Tamil ச), the
 * hour, the instrument and Sa (a default Sa per instrument), the drone and
 * the playback tuning, notation, and the account — including signing in on
 * the app with a QR code or a typed code. Saved in this browser, and to the
 * account when signed in, so the app and the site agree. */
import SwaraLayout from "../../layouts/SwaraLayout.astro";
import Hero from "../../components/carnatic/Hero.astro";
import Chip from "../../components/carnatic/Chip.astro";
import { langOf, words } from "../../lib/carnatic/i18n";
import { visitor, DEFAULT_SA } from "../../lib/carnatic/prefs";
import { account } from "../../lib/account";
import { instruments } from "../../lib/carnatic/data";
import { copy } from "../../lib/copy";

const lang = langOf(Astro);
const tr = await words(lang);
const say = await copy("carnatic/settings");
const { me, settings } = await visitor(Astro);
const acct = me.signedIn ? await account(Astro) : null;
const inst = await instruments();
const flutes: string[] = (inst?.venu?.fluteSizes?.flutes ?? []).map((f: any) => f.name);
type Row = [label: string, key: string, options: [string, string][]];
const GROUPS: [string, Row[]][] = [
  [say("g.language", "Language"), [
    [say("interface", "Interface"), "lang", [["en", "English"], ["ta", "தமிழ்"], ["te", "తెలుగు"], ["kn", "ಕನ್ನಡ"]]],
    [say("letters", "Swara letters"), "swaraLetters", [["latin", "Latin"], ["interface", say("interfaceScript", "Interface script")]]],
    [say("tamil", "Tamil letters"), "tamilStyle", [["grantha", "ஸ · grantha"], ["pure", "ச · pure Tamil"]]],
  ]],
  [say("g.theme", "Theme"), [
    [say("hour", "Hour"), "theme", [["dawn", "Dawn"], ["dusk", "Dusk"], ["system", say("system", "Follow system")]]],
  ]],
  [say("g.instrument", "Your instrument and Sa"), [
    [say("instrument", "Instrument"), "instrument", [["voice", "Voice"], ["venu", "Venu"], ["veena", "Veena"], ["violin", "Violin"], ["mridangam", "Mridangam"]]],
    [say("flute", "Flute"), "flute", ["C", "D", "E", "F", "G"].map((f) => [f, f === "E" ? "E (medium)" : f] as [string, string])],
    [say("sa", "Sa"), "sa", ["C3", "D3", "E3", "F3", "G3", "A3", "C4", "E4", "C5", "E5"].map((s) => [s, s] as [string, string])],
    [say("hand", "Hand"), "hand", [["right", "Right"], ["left", say("left", "Left-handed view")]]],
  ]],
  [say("g.drone", "Drone"), [
    [say("tuning", "Default tuning"), "droneTuning", [["pa", "Pa–Sa–Sa–Sa"], ["ma", "Ma–Sa–Sa–Sa"], ["ni", "Ni–Sa–Sa–Sa · mostly Hindustani"], ["mute", "Mute Pa"]]],
    [say("playback", "Playback tuning"), "playbackTuning", [["just", "Just intonation"], ["equal", "Equal temperament"]]],
  ]],
  [say("g.notation", "Notation"), [
    [say("subs", "Variant subscripts"), "subscripts", [["info", say("info", "Where they add information")], ["always", "Always"]]],
    [say("others", "Other scripts beside names"), "otherScripts", [["show", "Show"], ["hide", "Hide"]]],
  ]],
  [say("g.practice", "Practice"), [
    [say("fourth", "Fourth speed"), "fourthSpeed", [["false", "Off"], ["true", "On"]]],
    [say("eighth", "8th alankaram (sankeerna eka)"), "eighthAlankaram", [["false", "Off"], ["true", "On"]]],
  ]],
];
const current = (key: string) => String((settings as any)[key]);
---
<SwaraLayout title={say("meta.title", "Settings · Swara Studio")} noindex
             description={say("meta.description", "Language, swara letters, your instrument and Sa, the drone and notation.")}>
  <Hero eyebrow={say("eyebrow", "Settings")} title={say("title", "Settings")} lede={say("lede", "Language, your instrument and Sa, the drone, and your account.")} />
  <div class="st" data-settings data-defaults={JSON.stringify(DEFAULT_SA)}>
    {GROUPS.map(([name, rows]) => (
      <section class="st-group">
        <h2 class="t-eyebrow sw-eyebrow">{name}</h2>
        {rows.map(([label, key, options]) => (
          <div class="st-row" data-key={key} hidden={key === "flute" && settings.instrument !== "venu"}>
            <span class="st-label">{label}</span>
            <div class="sw-chips" role="radiogroup" aria-label={label}>
              {options.map(([v, text]) => <Chip data-value={v} active={current(key) === v}>{text}</Chip>)}
            </div>
          </div>
        ))}
        {name === say("g.language", "Language") && <p class="sw-note">{say("unverified", "Tamil, Telugu and Kannada are drafts until a native reader checks them; so are the raga names in those scripts, which carry an \"unverified\" mark. Where Tamil sources give both spellings, the setting above picks one; grantha (ஸ, ஸ்ரீ) is the default.")}</p>}
        {name === say("g.drone", "Drone") && <p class="sw-note">{say("ji", "Just intonation: textbook just-intonation values; performers vary. The tuner's cents are measured against equal temperament and say so.")}</p>}
        {name === say("g.instrument", "Your instrument and Sa") && flutes.length > 0 && <p class="sw-note">{say("flutes", "Every flute size is selectable in the app and the tuner, bass flutes included")}: {flutes.join(", ")}.</p>}
      </section>
    ))}
    <section class="st-group" id="app">
      <h2 class="t-eyebrow sw-eyebrow">{say("g.account", "Account")}</h2>
      {me.signedIn ? (
        <>
          <div class="st-row"><span class="st-label">{say("signedAs", "Signed in as")} {acct?.email}</span><a class="sw-chip" href="/account">{say("manage", "Your account")}</a></div>
          <div class="st-app" data-app-link>
            <div>
              <p class="sw-h4">{say("appH", "Sign in on the app")}</p>
              <p class="sw-note">{say("appP", "Make a code, then scan it with the Swara Studio app or type it in. It works once, for five minutes.")}</p>
              <button type="button" class="st-btn" data-make-code>{say("makeCode", "Make a code")}</button>
              <p class="st-code" data-code aria-live="polite"></p>
              <p class="sw-note" data-code-status></p>
            </div>
            <div class="st-qr" data-qr></div>
          </div>
        </>
      ) : (
        <div class="st-row"><span class="st-label">{say("signedOut", "Settings are kept in this browser. Sign in to keep them on every device.")}</span><a class="sw-chip" href="/signin?next=/carnatic/settings">{tr("gen.signIn")}</a></div>
      )}
    </section>
  </div>
</SwaraLayout>

<script>
  import { settings, setSettings, csrf } from "../../lib/carnatic/client/state";
  import { qrSvg } from "../../lib/carnatic/client/qr";
  const root = document.querySelector<HTMLElement>("[data-settings]");
  if (root) {
    const defaults = JSON.parse(root.dataset.defaults!);
    const paint = () => {
      const s = settings();
      root.querySelectorAll<HTMLElement>("[data-key]").forEach((row) => {
        row.querySelectorAll<HTMLElement>("[data-value]").forEach((c) => c.setAttribute("aria-pressed", String(String(s[row.dataset.key!]) === c.dataset.value)));
      });
      root.querySelector<HTMLElement>('[data-key="flute"]')!.hidden = s.instrument !== "venu";
    };
    root.querySelectorAll<HTMLElement>("[data-key]").forEach((row) => row.querySelectorAll<HTMLElement>("[data-value]").forEach((c) => c.addEventListener("click", () => {
      const key = row.dataset.key!;
      let v: any = c.dataset.value;
      if (v === "true" || v === "false") v = v === "true";
      const patch: Record<string, any> = { [key]: v };
      /* A new instrument brings its own default Sa (DECISIONS, 26 Sep 2026). */
      if (key === "instrument") patch.sa = v === "venu" ? `${settings().flute ?? "E"}5` : defaults[v];
      if (key === "flute") patch.sa = `${v}5`;
      setSettings(patch);
      if (key === "lang") {
        document.cookie = `swara_lang=${v}; path=/carnatic; max-age=31536000; samesite=lax`;
        const u = new URL(location.href);
        if (v === "en") u.searchParams.delete("lang"); else u.searchParams.set("lang", v);
        location.href = u.toString();
        return;
      }
      paint();
    })));
    paint();

    /* Signing in on the app: a one-time code, shown as a QR and as text. */
    const box = root.querySelector<HTMLElement>("[data-app-link]");
    box?.querySelector("[data-make-code]")?.addEventListener("click", async () => {
      const r = await fetch("/api/carnatic/device-link", { method: "POST", headers: { "x-csrf-token": csrf() } });
      const b = await r.json().catch(() => null);
      const status = box.querySelector<HTMLElement>("[data-code-status]")!;
      if (!r.ok || !b) { status.textContent = b?.detail ?? "That did not work. Try again in a minute."; return; }
      box.querySelector<HTMLElement>("[data-code]")!.textContent = b.code;
      box.querySelector<HTMLElement>("[data-qr]")!.innerHTML = qrSvg(b.qr_payload, 5);
      status.textContent = "Waiting for the app…";
      const poll = window.setInterval(async () => {
        const s = await fetch(`/api/carnatic/device-link/${b.link_id}/status`).then((x) => x.json()).catch(() => null);
        if (!s) return;
        if (s.status === "used") { status.textContent = "Signed in on your phone."; window.clearInterval(poll); }
        if (s.status === "expired") { status.textContent = "That code has run out. Make a new one."; window.clearInterval(poll); }
      }, 2000);
    });
  }
</script>

<style>
  .st { max-width: 720px; padding-top: 24px; display: grid; gap: 8px; }
  .st-group { display: grid; gap: 4px; padding: 20px 0; border-bottom: 1px solid var(--line); }
  .st-row { display: flex; gap: 10px 20px; align-items: center; justify-content: space-between; flex-wrap: wrap; padding: 8px 0; }
  .st-label { font: 15px / 1.3 var(--font-body); color: var(--ink); }
  .st-row .sw-chips { justify-content: flex-end; }
  .st-app { display: flex; gap: 24px; align-items: flex-start; justify-content: space-between; flex-wrap: wrap; padding-top: 12px; }
  .st-btn { appearance: none; border: 1px solid color-mix(in srgb, var(--accent) 55%, transparent); border-radius: var(--radius-sm); background: transparent; color: var(--accent); font: 600 var(--text-sm) / 1 var(--font-body); padding: 10px 16px; cursor: pointer; margin-top: 8px; }
  .st-code { margin: 10px 0 0; font: 500 28px / 1 var(--font-mono); letter-spacing: .08em; color: var(--ink); }
  .st-qr :global(svg) { display: block; border-radius: 6px; }
</style>

---
/* The beginner path and the exercise player (Web Learn Practice, "path").
 *
 * In the traditional order: 50 items by default, all in Mayamalavagowla until
 * the Malahari geethams. Speed 1 is 60 counts a minute (40–70); speeds 2 and 3
 * double the notes, never the tala. Each block is one exercise and its three
 * bars are speeds 1, 2 and 3. Progress is kept in this browser, and in the
 * account when signed in; nothing is lost by not having one.
 */
import { SET_ORDER, SONG_SETS } from "../../lib/carnatic/lessons";
import SwaraLayout from "../../layouts/SwaraLayout.astro";
import Hero from "../../components/carnatic/Hero.astro";
import Absent from "../../components/carnatic/Absent.astro";
import Chip from "../../components/carnatic/Chip.astro";
import { hrefIn, langOf, words } from "../../lib/carnatic/i18n";
import { instruments, lessons, talas } from "../../lib/carnatic/data";
import { visitor, swaraScript } from "../../lib/carnatic/prefs";
import { avartanamHtml, toCounts } from "../../lib/carnatic/render";
import { copy } from "../../lib/copy";

const lang = langOf(Astro);
const tr = await words(lang);
const say = await copy("carnatic/path");
const L = (p: string) => hrefIn(lang, p);
const { me, settings } = await visitor(Astro);
const [data, tl, inst] = await Promise.all([lessons(), talas(), instruments()]);
const script = swaraScript(settings, lang);

const countsFor = (tala: string, practical: string | null) => {
  const p = tl?.practical?.find((x: any) => x.id === practical);
  if (p) return p.counts;
  return tl?.suladi?.find((x: any) => x.id === tala)?.counts ?? [];
};
const sets = SET_ORDER.map((id) => data?.sets?.find((s: any) => s.id === id)).filter(Boolean);
const optional = settings.eighthAlankaram;
const exercises = sets.flatMap((s: any) => s.items.filter((i: any) => optional || !i.optional).map((i: any) => ({
  id: i.id, set: s.id, title: i.title,
  name: SONG_SETS.has(s.id) ? (i.title ?? i.id).split(" (")[0] : `${tr(`set.${s.id}` as any)} ${String(s.items.indexOf(i) + 1)}`,
  counts: countsFor(i.tala, i.practicalTala), angas: i.angas,
  notes: i.sections.flatMap((sec: any) => sec.lines.flatMap((l: any) => l.segments.flat())),
  repeats: i.repeats,
  /* A varnam may write a variant (Begada's anya N2); show it where it is written. */
  subs: s.id === "varnams",
  raga: i.raga,
  /* Each song carries its raga's scale (Malahari, a varnam's raga); the
     exercises are in the default raga, Mayamalavagowla. */
  scale: i.raga_scale ? `${i.raga_scale.arohana ?? ""} ${i.raga_scale.avarohana ?? ""}` : `${data.defaultRaga.arohana} ${data.defaultRaga.avarohana}`,
  talaName: tl?.practical?.find((x: any) => x.id === i.practicalTala)?.name ?? i.tala.replace(/_/g, " ").replace("jati", "jati"),
})));
const hasVarnams = sets.some((s: any) => s.id === "varnams");
const asked = Astro.url.searchParams.get("item");
const current = exercises.find((e) => e.id === asked) ?? exercises[0];
const first = current ? avartanamHtml({ counts: toCounts([current.notes.slice(0, current.counts.length)], 1), angas: current.angas }, { script, tamil: settings.tamilStyle, subs: current.subs }) : "";
const venu = settings.instrument === "venu" ? (inst?.venu?.fingerings ?? []).filter((f: any) => f.holes && ["primary", "cross-fingering"].includes(f.kind)).map((f: any) => ({ swara: f.swara, sthayi: f.sthayi, holes: f.holes, kind: f.kind })) : [];
---
<SwaraLayout title={say("meta.title", "The beginner path · Swara Studio")}
             description={say("meta.description", "The traditional Carnatic beginner sequence: sarali, janta and dhatu varisai, tara and mandra sthayi, the alankarams in their suladi talas and the Malahari geethams, played with the drone and the tala at three speeds.")}
             crumbs={[[tr("crumb.learn"), L("/carnatic/lessons")], [say("crumb", "Your path")]]}>
  <Hero eyebrow={say("eyebrow", "Beginner path")} title={say("title", "Your path")}
        lede={say("lede", "In the traditional order: 50 items by default, all in Mayamalavagowla until the Malahari geethams. Speed 1 is 60 counts a minute (range 40–70); speeds 2 and 3 double the notes, never the tala.")} />
  {!data || !current ? <div class="sw-section"><Absent /></div> : (
  <div class="pa" data-path data-signed-in={me.signedIn ? "1" : ""}>
    <div class="pa-sets">
      {sets.map((s: any) => {
        const items = exercises.filter((e) => e.set === s.id);
        return (
          <section class:list={["pa-set", s.id === current.set && "on"]} id={s.id}>
            <div class="pa-set-head"><h2 class="pa-set-h">{tr(`set.${s.id}` as any)}{s.id === "alankaram" ? " · one per suladi tala" : s.id === "geethams" ? " · Malahari" : ""}</h2>
              <span class="sw-mono" data-set-count={s.id}>{tr("gen.exercises", { n: items.length })}</span></div>
            <div class="pa-blocks">
              {items.map((e) => (
                <a href={L(`/carnatic/path?item=${e.id}`)} class:list={["pa-block", e.id === current.id && "now"]} data-item={e.id} title={e.title ?? e.name} aria-label={`${e.name}${e.title ? `: ${e.title}` : ""}`}>
                  <i data-s="1"></i><i data-s="2"></i><i data-s="3"></i>
                </a>
              ))}
            </div>
          </section>
        );
      })}
      {/* Varnams not yet in the data: the whole set while none has arrived, and
          under it the ones still to come once some have. */}
      {(data.varnamsComing ?? []).length > 0 && (
        <section class="pa-set" id={hasVarnams ? "varnams-coming" : "varnams"}>
          <div class="pa-set-head"><h2 class="pa-set-h">{tr("set.varnams")} · {tr("gen.coming")}</h2><span class="sw-mono">{tr("gen.exercises", { n: 0 })}</span></div>
          <ul class="pa-varnams">{(data.varnamsComing ?? []).map((v: any) => <li class="sw-p">{v.title} · <a href={L(`/carnatic/ragas/${v.raga}`)}>{v.raga[0].toUpperCase() + v.raga.slice(1)}</a></li>)}</ul>
        </section>
      )}
      <p class="sw-note">{say("key", "Each block is one exercise; its three bars are speeds 1, 2 and 3.")} {say("count", "52 exercises and geethams at launch, with the 8th alankaram's two versions off by default.")}</p>
      <p class="sw-note">{data.attribution?.assessment ? say("attribution", "The sequence is traditionally attributed to Purandara Dasa (16th century); that is tradition, not documented authorship.") : ""}</p>
    </div>

    <section class="sw-card pa-player" data-player aria-labelledby="pa-title">
      <div class="pa-title-row">
        <h2 id="pa-title" class="pa-title" data-title>{current.name}</h2>
        <span class="sw-mono" data-sub>{current.raga} · {current.talaName}</span>
        <span class="pa-badge sw-mono" data-repeat hidden></span>
      </div>
      {current.title && <p class="sw-note" data-ex-title>{current.title}</p>}
      <div class="sw-chips pa-speeds" role="group">
        {[1, 2, 3].map((s) => <Chip data-speed={s} active={s === 1}>{tr("gen.speed", { n: s })}</Chip>)}
        {settings.fourthSpeed && <Chip data-speed="4">{tr("gen.speed", { n: 4 })}</Chip>}
        <Chip data-updown>{say("updown", "Up and down · 12321")}</Chip>
        <Chip data-loop>{say("loop", "Loop")}</Chip>
      </div>
      <div class:list={["pa-line", "sn-script-" + script]} data-line set:html={first} />
      <div class="pa-venu" data-venu hidden={venu.length === 0}></div>
      <div class="pa-controls">
        <button type="button" class="pa-go" data-go>{tr("gen.play")}</button>
        <span class="sw-mono" data-status>drone on · tala on · hand shown · <span data-bpm>{settings.tempo}</span> / min</span>
        <label class="pa-tempo"><span class="sw-p">{say("tempo", "Tempo")}</span><input type="range" min="40" max="70" value={settings.tempo} data-tempo /></label>
      </div>
      <div class="pa-range" data-range hidden><span class="sw-mono">{say("rangeH", "Range")}</span><span class="sw-p" data-range-text></span></div>
      {venu.length > 0 && <p class="sw-note">{say("venuNote", "Instrument view: venu fingering under every count, in faint ink so the swaras stay primary.")}</p>}
      <p class="sw-note" data-saved>{me.signedIn ? say("savedAccount", "Progress is saved to your account.") : say("savedLocal", "Signed out, progress stays on this device.")}</p>
    </section>
  </div>
  )}
  <script type="application/json" id="pa-data" set:html={JSON.stringify({ exercises, venu, instrument: settings.instrument, current: current?.id ?? null, script, tamil: settings.tamilStyle })} />
</SwaraLayout>

<script>
  import { Player, fingeringFor } from "../../lib/carnatic/client/player";
  import { settings, setSettings, startDrone, theDrone, csrf, boot } from "../../lib/carnatic/client/state";
  import { avartanamHtml } from "../../lib/carnatic/render";
  import { pitchHz, variantsOf, tokenize } from "../../lib/carnatic/notation";

  const root = document.querySelector<HTMLElement>("[data-path]");
  const data = JSON.parse(document.getElementById("pa-data")?.textContent || "{}");
  if (root && data.current) {
    const ex = data.exercises.find((e: any) => e.id === data.current);
    const signedIn = boot().signedIn;
    const KEY = "swara.progress";
    const local = (): Record<string, number[]> => { try { return JSON.parse(localStorage.getItem(KEY) || "{}"); } catch { return {}; } };
    let progress: Record<string, number[]> = local();

    const paint = () => {
      root.querySelectorAll<HTMLElement>("[data-item]").forEach((b) => {
        const done = new Set(progress[b.dataset.item!] ?? []);
        b.querySelectorAll<HTMLElement>("i").forEach((i) => i.classList.toggle("done", done.has(Number(i.dataset.s))));
      });
    };
    if (signedIn) {
      fetch("/api/carnatic/me/progress").then((r) => r.ok ? r.json() : null).then((b) => {
        if (!b) return;
        for (const [id, v] of Object.entries<any>(b.items)) progress[id] = [...new Set([...(progress[id] ?? []), ...v.speeds])];
        paint();
      });
    }
    paint();
    const record = (speeds: number[]) => {
      progress[ex.id] = [...new Set([...(progress[ex.id] ?? []), ...speeds.filter((s) => s <= 3)])].sort();
      try { localStorage.setItem(KEY, JSON.stringify(progress)); } catch { /* storage blocked */ }
      paint();
      if (signedIn) fetch(`/api/carnatic/me/progress/${ex.id}`, { method: "PUT", headers: { "content-type": "application/json", "x-csrf-token": csrf() }, body: JSON.stringify({ speeds }) });
    };

    const player = new Player(ex, settings().tempo ?? 60);
    const vars = variantsOf(ex.scale);
    let speeds = [1];
    let started = 0;
    const line = root.querySelector<HTMLElement>("[data-line]")!;
    const venuBox = root.querySelector<HTMLElement>("[data-venu]")!;
    const badge = root.querySelector<HTMLElement>("[data-repeat]")!;
    const go = root.querySelector<HTMLButtonElement>("[data-go]")!;
    const opts = { script: data.script, tamil: data.tamil };
    const drawVenu = (av: string[][]) => {
      if (!data.venu.length) return;
      venuBox.style.setProperty("--n", String(av.length));
      venuBox.innerHTML = av.map((notes) => `<span>${notes.map((n) => {
        const holes = n === "," ? null : fingeringFor(data.venu, n, vars);
        return holes ? `<b aria-hidden="true">${[...holes].map((h) => `<i class="h-${h}"></i>`).join("")}</b>` : "<b></b>";
      }).join("")}</span>`).join("");
    };
    const draw = (av: string[][], speed: number, now = -1) => {
      line.innerHTML = avartanamHtml({ counts: av, angas: ex.angas, speed }, { ...opts, subs: ex.subs });
      line.querySelectorAll<HTMLElement>("[data-count]").forEach((c) => c.classList.toggle("is-now", Number(c.dataset.count) === now));
      drawVenu(av);
    };
    const showBadge = () => {
      const rep = speeds.length === 1 ? ex.repeats[String(speeds[0])] : 0;
      badge.hidden = !(rep > 1);
      badge.textContent = rep > 1 ? `×${rep}` : "";
    };
    draw(Array.from({ length: ex.counts.length }, (_, i) => [ex.notes[i] ?? ","]), 1);
    showBadge();

    /* The instrument's range (DECISIONS tala §7): marked, never hidden. */
    const toks = ex.notes.map((n: string) => tokenize(n)[0]).filter((x: any) => x?.kind === "note");
    const high = toks.some((x: any) => (x.octave ?? 0) > 0);
    const range = root.querySelector<HTMLElement>("[data-range]")!;
    const rtext = root.querySelector<HTMLElement>("[data-range-text]")!;
    if (high && data.instrument === "venu") { range.hidden = false; rtext.textContent = "Tara Sa is above the lowest octave of an E flute's easy range for some beginners. If it doesn't speak yet, play it an octave down or sing this line."; }
    else if (high && data.instrument === "voice") { range.hidden = false; rtext.textContent = "This line goes into the upper octave. If it strains, sing it an octave lower or leave that note out for now; you can move your Sa later."; }

    player.onView = (run, _ri, av, k) => { draw(av, run.speed === 4 ? 4 : run.speed, k); };
    /* The practice log counts time, never days missed. */
    const logTime = () => {
      const secs = started ? Math.round((Date.now() - started) / 1000) : 0;
      started = 0;
      if (!signedIn || secs < 5) return;
      const day = new Date().toLocaleDateString("en-CA");
      fetch("/api/carnatic/me/practice", { method: "POST", headers: { "content-type": "application/json", "x-csrf-token": csrf() }, body: JSON.stringify({ day, seconds: Math.min(secs, 6 * 3600) }) });
    };
    player.onDone = (done) => { record(done); logTime(); go.textContent = "Play"; };
    const toggle = () => {
      if (player.playing) { player.stop(); logTime(); go.textContent = "Play"; return; }
      if (!theDrone().playing) startDrone();
      player.saHz = pitchHz(settings().sa || "C3");
      player.tuning = settings().playbackTuning ?? "just";
      started = Date.now();
      player.start(speeds);
      go.textContent = "Pause";
    };
    go.addEventListener("click", toggle);
    const chips = root.querySelectorAll<HTMLElement>("[data-speed],[data-updown]");
    chips.forEach((c) => c.addEventListener("click", () => {
      chips.forEach((x) => x.setAttribute("aria-pressed", String(x === c)));
      speeds = c.hasAttribute("data-updown") ? [1, 2, 3, 2, 1] : [Number(c.dataset.speed)];
      showBadge();
      if (player.playing) { player.stop(); player.start(speeds); }
    }));
    root.querySelector<HTMLElement>("[data-loop]")?.addEventListener("click", (e) => {
      player.loop = !player.loop;
      (e.currentTarget as HTMLElement).setAttribute("aria-pressed", String(player.loop));
    });
    const tempo = root.querySelector<HTMLInputElement>("[data-tempo]")!;
    tempo.addEventListener("change", () => {
      player.clock.bpm = Number(tempo.value);
      root.querySelector("[data-bpm]")!.textContent = tempo.value;
      setSettings({ tempo: Number(tempo.value) });
    });
  }
</script>

<style>
  .pa { display: grid; grid-template-columns: minmax(0, 360px) minmax(0, 1fr); gap: 40px; padding-top: 24px; align-items: start; }
  .pa-sets { display: grid; gap: 14px; }
  .pa-set { display: grid; gap: 10px; padding: 14px; border: 1px solid var(--line); border-radius: 8px; background: var(--surface-card); }
  .pa-set.on { background: var(--accent-wash); border-color: var(--accent); }
  .pa-set-head { display: flex; justify-content: space-between; align-items: baseline; gap: 8px; }
  .pa-set-h { margin: 0; font: 600 16px / 1.3 var(--font-body); color: var(--ink); }
  .pa-blocks { display: flex; flex-wrap: wrap; gap: 5px; }
  .pa-block { display: flex; gap: 2px; padding: 3px; border: 1px solid var(--line-strong); border-radius: 3px; background: var(--surface-card); }
  .pa-block.now { border-color: var(--accent); }
  .pa-block i { width: 5px; height: 10px; border-radius: 1px; background: var(--line); }
  .pa-block i.done { background: var(--accent); }
  .pa-varnams { margin: 0; padding-left: 16px; }
  .pa-player { position: sticky; top: 84px; display: grid; gap: 16px; padding: 20px; }
  .pa-title-row { display: flex; gap: 8px 12px; align-items: baseline; flex-wrap: wrap; }
  .pa-title { margin: 0; font: 26px / 1.2 var(--font-display); color: var(--ink); }
  .pa-badge { padding: 2px 8px; border-radius: 99px; background: var(--surface-veil); color: var(--ink); font-size: 12px; }
  .pa-speeds { padding-bottom: 14px; border-bottom: 1px solid var(--line); }
  .pa-line { --sl-cell: 60px; }
  .pa-venu { display: grid; grid-template-columns: repeat(var(--n, 8), minmax(0, 1fr)); padding: 0 4px; }
  .pa-venu span { display: flex; justify-content: space-around; }
  .pa-venu b { display: grid; gap: 1px; justify-items: center; }
  .pa-venu i { width: 4px; height: 4px; border-radius: 99px; box-sizing: border-box; }
  .pa-venu .h-C { background: var(--ink-faint); }
  .pa-venu .h-O { border: 1px solid var(--line-strong); }
  .pa-venu .h-H { background: linear-gradient(90deg, var(--ink-faint) 50%, transparent 50%); border: 1px solid var(--ink-faint); }
  .pa-controls { display: flex; gap: 12px 18px; align-items: center; flex-wrap: wrap; }
  .pa-go { appearance: none; border: 0; border-radius: var(--radius-sm); background: var(--accent); color: var(--on-accent); font: 600 var(--text-sm) / 1 var(--font-body); padding: 13px 22px; cursor: pointer; }
  .pa-tempo { margin-left: auto; display: flex; gap: 10px; align-items: center; }
  .pa-tempo input { accent-color: var(--accent); }
  .pa-range { display: flex; gap: 10px; align-items: baseline; padding: 12px 14px; border: 1px solid var(--line); border-radius: 8px; }
  @media (max-width: 899px) { .pa { grid-template-columns: minmax(0, 1fr); } .pa-player { position: static; order: -1; } }
</style>

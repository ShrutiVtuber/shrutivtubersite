---
/* A public song sheet (Web Compose Account, "sheet"). Print-first: black on
 * white, no sky and no controls on paper (tokens/print.css), the header kept
 * with each section's first line, and a line never broken inside an
 * avartanam. The gamaka legend is printed on every sheet. */
import SwaraLayout from "../../../layouts/SwaraLayout.astro";
import Badge from "../../../components/navigation/Badge.astro";
import { hrefIn, langOf, words } from "../../../lib/carnatic/i18n";
import { ragaById, talas } from "../../../lib/carnatic/data";
import { visitor, swaraScript } from "../../../lib/carnatic/prefs";
import { asReader } from "../../../lib/account";
import { avartanamHtml, phraseText } from "../../../lib/carnatic/render";
import { GAMAKA_SIGN } from "../../../lib/carnatic/notation";
import { notFound } from "../../../lib/carnatic/notfound";
import { SITE_URL } from "../../../lib/api";
import { copy } from "../../../lib/copy";

const lang = langOf(Astro);
const tr = await words(lang);
const say = await copy("carnatic/sheets/[slug]");
const L = (p: string) => hrefIn(lang, p);
const { settings } = await visitor(Astro);
const got = await asReader(Astro, `/api/carnatic/sheets/${encodeURIComponent(Astro.params.slug ?? "")}`);
if (!got.ok) return notFound(Astro);
const sheet = got.body;
const song = sheet.song;
const [raga, tl] = await Promise.all([ragaById(song.raga), talas()]);
const tala = tl?.practical?.find((x: any) => x.id === song.tala);
const script = swaraScript(settings, lang);
const out = new Set<string>(sheet.outOfRaga ?? []);
const used = new Set<string>();
for (const s of song.sections) for (const l of s.lines) for (const c of l.counts) for (const n of c.notes) { const m = /^([a-z-]+):/.exec(n); if (m) used.add(m[1]); }
const legend = Object.entries(GAMAKA_SIGN).filter(([g]) => used.has(g) || ["kampita", "jaru-up", "nokku", "sphurita"].includes(g));
const NAMES: Record<string, string> = { kampita: "kampita", "jaru-up": "jaru", "jaru-down": "jaru", nokku: "nokku", sphurita: "sphurita", pratyahata: "pratyahata", ravai: "ravai", khandippu: "khandippu", odukkal: "odukkal", orikkai: "orikkai" };
const url = new URL(`/carnatic/sheets/${sheet.slug}`, SITE_URL);
---
<SwaraLayout title={`${song.title} · ${raga?.name ?? song.raga} · Swara Studio`} noindex={!sheet.published}
             description={`${song.title}: a song in ${raga?.name ?? song.raga}, ${tala?.name ?? song.tala} tala, by ${sheet.author}. Swara notation with sahitya, printable.`}>
  <div class="sh-bar sw-noprint" data-sheet data-id={sheet.id} data-song={JSON.stringify(song)} data-scale={raga ? `${raga.arohana} ${raga.avarohana}` : ""}>
    <button type="button" class="sh-btn-p" data-play>{tr("gen.play")}</button>
    <button type="button" class="sh-btn-s" onclick="window.print()">{say("print", "Print")}</button>
    <Badge tone={sheet.published ? "accent" : "faint"}>{sheet.published ? "Published" : "Draft · only you can see this"}</Badge>
    {sheet.mine ? (
      <>
        <a class="sh-link" href={L(`/carnatic/compose?song=${sheet.id}`)}>Edit</a>
        <button type="button" class="sh-link" data-publish={sheet.published ? "unpublish" : "publish"}>{sheet.published ? "Unpublish" : "Publish"}</button>
        <span class="sw-note">{sheet.published ? "Only the author sees Edit and Unpublish." : "A published sheet is public at this address, and goes with your account if you delete it."}</span>
      </>
    ) : <span class="sw-note">Only the author sees Edit and Unpublish.</span>}
  </div>
  <article class="sh-paper">
    <header class="sh-head">
      <h1>{song.title}</h1>
      {song.titleScript && <p class="sh-script" lang={song.sahityaScript}>{song.titleScript}</p>}
      <p class="sh-meta">{(raga?.name ?? song.raga).toUpperCase()} · {(tala?.name ?? song.tala).toUpperCase()} · COMPOSED BY {sheet.author.toUpperCase()}</p>
      {raga && <p class="sh-scale">arohana {phraseText(raga.arohana.replace(/!\w/g, ""), { script, subs: true })} · avarohana {phraseText(raga.avarohana, { script, subs: true })}</p>}
    </header>
    {song.sections.map((s: any) => (
      <section class="sh-sec">
        <h2>{s.name}{s.repeat > 1 ? ` ×${s.repeat}` : ""}</h2>
        {s.lines.map((l: any) => (
          <div class={`sh-line sn-script-${script}`} lang={song.sahityaScript === "lat" ? undefined : song.sahityaScript}
               set:html={avartanamHtml({ counts: l.counts.map((c: any) => c.notes), angas: tala?.angas ?? [l.counts.length], speed: s.notesPerCount >= 4 ? 3 : s.notesPerCount, sahitya: l.counts.map((c: any) => c.sahitya) }, { script, tamil: settings.tamilStyle, outside: out })} />
        ))}
      </section>
    ))}
    <footer class="sh-foot">
      <span>{url.host}{url.pathname}</span><span>{say("foot.brand", "Swara Studio · Carnatic music school")}</span>
      <p>{say("legend", "gamaka signs after SSP (1904):")} {legend.map(([g, sign], i) => <>{i > 0 && " · "}{sign} {NAMES[g]}</>)}</p>
      {out.size > 0 && <p>Dotted underline: a note outside {raga?.name}, as the composer wrote it.</p>}
    </footer>
  </article>
  <p class="sw-note sh-note sw-noprint">{say("printNote", "The sheet is already print-shaped: black on white, no sky, no controls. On paper, the header and each section's first line are kept together, and lines never break inside an avartanam.")}</p>
</SwaraLayout>

<script>
  import { csrf, settings, startDrone, theDrone } from "../../../lib/carnatic/client/state";
  import { playLine } from "../../../lib/carnatic/client/phrase";
  import { pitchHz } from "../../../lib/carnatic/notation";
  const bar = document.querySelector<HTMLElement>("[data-sheet]");
  if (bar) {
    bar.querySelector("[data-publish]")?.addEventListener("click", async (e) => {
      const what = (e.currentTarget as HTMLElement).dataset.publish;
      const r = await fetch(`/api/carnatic/songs/${bar.dataset.id}/${what}`, { method: "POST", headers: { "x-csrf-token": csrf() } });
      if (r.ok) location.reload();
    });
    bar.querySelector("[data-play]")?.addEventListener("click", () => {
      const song = JSON.parse(bar.dataset.song!);
      if (!theDrone().playing) startDrone();
      const toks: string[] = [];
      for (const s of song.sections) for (let r = 0; r < (s.repeat || 1); r++) for (const l of s.lines) for (const c of l.counts) toks.push(...c.notes);
      playLine(toks.join(" "), { saHz: pitchHz(settings().sa || "C3"), tuning: settings().playbackTuning, scale: bar.dataset.scale, unit: 60 / 64 / 2 });
    });
  }
</script>

<style>
  .sh-bar { display: flex; gap: 10px 12px; align-items: center; flex-wrap: wrap; padding: 16px 0; }
  .sh-btn-p, .sh-btn-s { appearance: none; border-radius: var(--radius-sm); font: 600 var(--text-sm) / 1 var(--font-body); padding: 10px 18px; cursor: pointer; }
  .sh-btn-p { background: var(--accent); color: var(--on-accent); border: 0; }
  .sh-btn-s { background: transparent; color: var(--accent); border: 1px solid color-mix(in srgb, var(--accent) 55%, transparent); }
  .sh-link { appearance: none; background: none; border: 0; color: var(--accent); font: var(--text-sm) / 1 var(--font-body); cursor: pointer; padding: 4px; }
  .sh-paper { max-width: 950px; margin: 0 auto; padding: clamp(24px, 6vw, 64px); background: #fff; color: #000; border: 1px solid var(--line); box-shadow: var(--shadow-1);
    --ink: #000; --ink-soft: #2a2a2a; --ink-faint: #555; --line: #b8b8b8; --line-strong: #6e6e6e; --rose: #3a3a3a; --accent-wash: transparent; --accent: #000; }
  .sh-head { text-align: center; display: grid; gap: 6px; padding-bottom: 20px; border-bottom: 1px solid #000; }
  .sh-head h1 { margin: 0; font: 500 38px / 1.1 var(--font-display); color: #000; }
  .sh-script { margin: 0; font: 20px / 1.3 var(--font-display); }
  .sh-meta { margin: 0; font: 600 12.5px / 1.4 var(--font-body); letter-spacing: .08em; }
  .sh-scale { margin: 0; font: 11px / 1.4 var(--font-mono); color: #333; }
  .sh-sec { padding-top: 24px; display: grid; gap: 10px; }
  .sh-sec h2 { margin: 0; font: 600 12px / 1 var(--font-body); letter-spacing: .14em; text-transform: uppercase; break-after: avoid-page; }
  .sh-line { --sl-cell: 44px; break-inside: avoid-page; }
  .sh-sec h2 + .sh-line { break-before: avoid-page; }
  .sh-foot { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 6px 16px; margin-top: 28px; padding-top: 14px; border-top: 1px solid #000; font: 11px / 1.5 var(--font-mono); color: #333; }
  .sh-foot p { flex-basis: 100%; margin: 0; }
  .sh-note { max-width: 820px; margin: 16px auto 0; }
  @media print {
    .sh-paper { border: 0; padding: 0; max-width: none; }
  }
  @media (max-width: 599px) { .sh-line { overflow-x: auto; } .sh-line :global(.sl) { min-width: 480px; } .sh-head h1 { font-size: 30px; } }
</style>

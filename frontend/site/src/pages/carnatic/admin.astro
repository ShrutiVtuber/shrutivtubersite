---
/* The review queue (Web Compose Account, "admin"): every Tamil, Telugu and
 * Kannada name awaiting a native reader, every fact below high confidence the
 * pages show a note for, and the Listen room's moderation. Confirming clears
 * the public "unverified" marker; correcting replaces the text and clears it.
 * Reviewers and consultants see the same queue. Only the operator reaches it. */
import SwaraLayout from "../../layouts/SwaraLayout.astro";
import Hero from "../../components/carnatic/Hero.astro";
import Chip from "../../components/carnatic/Chip.astro";
import { asAdmin } from "../../lib/admin";
import { copy } from "../../lib/copy";

const say = await copy("carnatic/admin");
const queue = await asAdmin(Astro, "/api/carnatic/admin/queue");
if (queue.status === 401 || queue.status === 403) return Astro.redirect(`/admin/signin?next=${encodeURIComponent("/carnatic/admin")}`, 303);
const mod = await asAdmin(Astro, "/api/carnatic/admin/moderation");
const items: any[] = queue.body?.items ?? [];
const tab = Astro.url.searchParams.get("tab") === "moderation" ? "moderation" : "queue";
const show = Astro.url.searchParams.get("show") ?? "open";
const filter = Astro.url.searchParams.get("lang") ?? "";
const visible = items.filter((i) => (show === "all" || !i.review) && (!filter || i.lang === filter || (filter === "facts" && i.key.startsWith("fact:"))));
const hiddenCount = (mod.body?.posts ?? []).filter((p: any) => p.hidden).length + (mod.body?.comments ?? []).filter((c: any) => c.hidden).length;
const footLine = say("foot", "Reviewers and consultants see the same queue. Confirming clears the public \"unverified\" or confidence note; correcting replaces the text with yours and clears it. Showing {n} of {total}.").replace("{n}", String(Math.min(visible.length, 400))).replace("{total}", String(visible.length));
---
<SwaraLayout title={say("meta.title", "Review queue · Swara Studio")} noindex>
  <Hero eyebrow={say("eyebrow", "Admin")} title={say("title", "Review queue")} lede={say("lede", "Data flagged medium or low confidence, and script names awaiting a native reader.")} />
  <div class="sw-toolbar">
    <div class="sw-chips">
      <Chip href="/carnatic/admin" active={tab === "queue"}>{say("tab.queue", "Review queue")} · {queue.body?.open ?? 0}</Chip>
      <Chip href="/admin/classes">{say("tab.lessons", "Lessons")}</Chip>
      <Chip href="/carnatic/admin?tab=moderation" active={tab === "moderation"}>{say("tab.moderation", "Moderation")} · {hiddenCount}</Chip>
    </div>
    <span class="spacer"></span>
    {tab === "queue" && (
      <div class="sw-chips">
        {[["", "All kinds"], ["ta", "Tamil"], ["te", "Telugu"], ["kn", "Kannada"], ["facts", "Facts"]].map(([k, l]) => <Chip href={`/carnatic/admin?lang=${k}&show=${show}`} active={filter === k}>{l}</Chip>)}
        <Chip href={`/carnatic/admin?lang=${filter}&show=${show === "all" ? "open" : "all"}`} active={show === "all"}>Include reviewed</Chip>
      </div>
    )}
  </div>
  {!queue.body?.loaded && <p class="sw-p">{say("notSynced", "The school's data is not synced here yet, so the queue is empty. Run scripts/sync-carnatic-data.sh.")}</p>}
  {tab === "queue" ? (
    <table class="sw-table aq" data-queue>
      <thead><tr><th>{say("col.item", "Item")}</th><th>{say("col.flag", "Flag")}</th><th>{say("col.level", "Level")}</th><th>{say("col.action", "Action")}</th></tr></thead>
      <tbody>
        {visible.slice(0, 400).map((i) => (
          <tr data-key={i.key}>
            <td><b lang={i.lang}>{i.review?.status === "corrected" ? i.review.text : i.item}</b><small>{i.what} · {i.where}</small></td>
            <td class="aq-flag">{i.flag}{i.review && <small>{i.review.status} by {i.review.by}{i.review.note ? ` · ${i.review.note}` : ""}</small>}</td>
            <td class="aq-level">{i.review ? i.review.status : i.level}</td>
            <td class="aq-act">
              {i.review ? <button type="button" data-act="reopened">{say("reopen", "Reopen")}</button> : (
                <>
                  <button type="button" class="aq-confirm" data-act="confirmed">{say("confirm", "Confirm")}</button>
                  <button type="button" class="aq-link" data-act="correct">{say("correct", "Correct")}</button>
                </>
              )}
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  ) : (
    <div class="aq-mod">
      <h2 class="sw-h3">{say("mod.posts", "Listen posts")}</h2>
      <table class="sw-table">
        <tbody>{(mod.body?.posts ?? []).map((p: any) => <tr><td>{p.title}<small>{p.url}</small></td><td>{p.hidden ? "hidden" : "shown"}</td><td><button type="button" data-hide-post={p.id} data-hidden={String(p.hidden)}>{p.hidden ? "Show" : "Hide"}</button></td></tr>)}</tbody>
      </table>
      <h2 class="sw-h3">{say("mod.comments", "Comments")}</h2>
      <table class="sw-table">
        <tbody>{(mod.body?.comments ?? []).map((c: any) => <tr><td>{c.body}</td><td>{c.hidden ? "hidden" : "shown"}</td><td><button type="button" data-hide-comment={c.id} data-hidden={String(c.hidden)}>{c.hidden ? "Show" : "Hide"}</button></td></tr>)}</tbody>
      </table>
    </div>
  )}
  <p class="sw-note aq-foot">{footLine}</p>
</SwaraLayout>

<script>
  const csrf = () => document.cookie.split("; ").find((c) => c.startsWith("shruti_csrf="))?.split("=")[1] ?? "";
  const post = (url: string, body: unknown) => fetch(url, { method: "POST", headers: { "content-type": "application/json", "x-csrf-token": csrf() }, body: JSON.stringify(body) });
  document.querySelectorAll<HTMLButtonElement>("[data-act]").forEach((b) => b.addEventListener("click", async () => {
    const row = b.closest<HTMLElement>("[data-key]")!;
    let status = b.dataset.act!, text: string | null = null;
    if (status === "correct") {
      text = prompt("The corrected spelling:", row.querySelector("b")?.textContent ?? "");
      if (!text) return;
      status = "corrected";
    }
    const r = await post("/api/carnatic/admin/reviews", { key: row.dataset.key, status, text });
    if (r.ok) location.reload();
  }));
  document.querySelectorAll<HTMLButtonElement>("[data-hide-post],[data-hide-comment]").forEach((b) => b.addEventListener("click", async () => {
    const kind = b.dataset.hidePost ? "posts" : "comments";
    const id = b.dataset.hidePost ?? b.dataset.hideComment;
    const r = await post(`/api/carnatic/admin/${kind}/${id}/hide`, { hidden: b.dataset.hidden !== "true" });
    if (r.ok) location.reload();
  }));
</script>

<style>
  .aq td b { display: block; font: 600 15px / 1.3 var(--font-body); color: var(--ink); }
  .aq td small, .sw-table td small { display: block; font: 11px / 1.4 var(--font-mono); color: var(--ink-faint); }
  .aq-level { font: 11px / 1 var(--font-mono); color: var(--ink); }
  .aq-act { white-space: nowrap; }
  .aq-act button, .aq-mod button { appearance: none; font: 600 var(--text-sm) / 1 var(--font-body); padding: 9px 14px; border-radius: var(--radius-sm); cursor: pointer; background: transparent; color: var(--accent); border: 1px solid color-mix(in srgb, var(--accent) 55%, transparent); }
  .aq-act .aq-link { border-color: transparent; }
  .aq-foot { padding-top: 16px; }
</style>

---
/* The holding page — `design_handoff_coming_soon/index.html`.
 *
 * The designer shipped this as a finished, self-contained file and asked for
 * it to be DEPLOYED rather than rebuilt, with four wiring jobs. Their markup,
 * CSS and countdown script are here verbatim; what changed is only the five
 * points README §3 names, each marked below.
 *
 * It is an Astro page rather than a static file for one reason: she needs to
 * toggle it from the admin and to bypass it while signed in. A file on disk
 * can do neither. That is not say("text.rebuilding.framework", "rebuilding it in a framework") — there is no
 * component tree, no client bundle and no CSS pipeline here; the page ships
 * the same bytes it was given, with real values substituted.
 *
 * ONE DELIBERATE DEVIATION, flagged rather than silent. The handoff says to
 * ship the bracketed imprint — `GEMI [000000000000]`, `[street, no.]` — until
 * the company is registered. She had already decided the opposite for the main
 * site, and the same reasoning applies more strongly here: a registry number
 * that looks like a registry number and is not one is a false claim on the one
 * page the whole internet will see first. The block stays, as the handoff
 * insists; it carries the real imprint when it exists and the contact address
 * until then.
 */
import { site, astro, askAstro, SITE_API, PATHS, type LiveStatus, type LinkGroups } from "../lib/api";
import { verifyCsrf } from "../lib/csrf";
/* Imported raw and inlined rather than linked, so the holding page is one
   request. It is a single screen that should be up before a spinner would
   have appeared. */
import CSS from "../styles/coming-soon.css?raw";
/* The faces, inlined with the rest. The holding page is one request by design,
   and it was the last page still fetching type from Google — which on the one
   page the whole internet meets first is the worst place to leave that. */
import FACES from "@shruti/shared/tokens/fonts-local.css?raw";

const ATHENS = { lat: 37.9838, lon: 23.7275, label: "Athens" };

/* ── job 2: the subscribe form, working without JavaScript ───────────────── */
let sent = false;
let failed = "";
if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  if (!verifyCsrf(Astro.cookies, form)) {
    failed = say("error.csrf", "That did not send. Reload the page and try again.");
  } else {
    try {
      const r = await fetch(`${SITE_API}/api/newsletter/subscribe`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          email: String(form.get("email") ?? "").trim(),
          // The double opt-in is mandatory and the page says so; this is the
          // agreement the copy describes, recorded at the point of collection.
          consent: true,
        }),
      });
      if (r.ok) sent = true;
      else failed = (await r.json().catch(() => null))?.detail ?? say("error.failed2", "That did not work.");
    } catch {
      failed = say("error.failed", "That did not work.");
    }
  }
}

interface Luminary {
  tropical: { sign: string; degree: number };
  sidereal: { rashi: string; degree: number; nakshatra: string };
  speedPerDay: number;
}
interface Today {
  at: string;
  reckonings: Record<string, any>;
  sun: Luminary;
  moon: Luminary;
}

interface Version { licence: string; sha: string; sourceUrl: string; version: string }

const [todayAnswer, versionAnswer, live, links] = await Promise.all([
  askAstro<Today>(`/today?lat=${ATHENS.lat}&lon=${ATHENS.lon}`),
  askAstro<Version>("/version"),
  site<LiveStatus>(PATHS.live),
  site<LinkGroups>(PATHS.links),
]);

/* ── job 1, as she redirected it: the Sun and the Moon, not the stations ───
 *
 * The design put a station countdown here, labelled with the Hellenic
 * dedications — Hekate Phosphoros at dawn, Apollo at noon. Those are her
 * devotional practice and do not belong on a page the whole internet meets
 * first, so the centrepiece is now where the two luminaries actually are.
 *
 * Both zodiacs, unranked, exactly as the rest of the site does it: neither is
 * a correction of the other, and showing one alone would be picking a side the
 * site does not pick. */
const DEG = (n: number) => `${Math.floor(n)}°${String(Math.round((n % 1) * 60)).padStart(2, "0")}′`;

const sky = todayAnswer.data
  ? {
      at: todayAnswer.data.at,
      sun: {
        sign: todayAnswer.data.sun.tropical.sign,
        degree: DEG(todayAnswer.data.sun.tropical.degree),
        rashi: todayAnswer.data.sun.sidereal.rashi,
        nakshatra: todayAnswer.data.sun.sidereal.nakshatra,
      },
      moon: {
        sign: todayAnswer.data.moon.tropical.sign,
        degree: DEG(todayAnswer.data.moon.tropical.degree),
        rashi: todayAnswer.data.moon.sidereal.rashi,
        nakshatra: todayAnswer.data.moon.sidereal.nakshatra,
        perDay: todayAnswer.data.moon.speedPerDay,
      },
    }
  : null;

/* ── job 4: the reckonings, from /today rather than hardcoded ────────────── */
const r = todayAnswer.data?.reckonings ?? {};
const reck = {
  attic: r.attic ? `${r.attic.day} ${r.attic.greek}` : "—",
  hindu: r.hindu
    ? `${r.hindu.month} ${r.hindu.tithi} · Vikrama ${r.hindu.vikrama}`
    : "—",
  thelemic: r.thelemic?.anno
    ? r.thelemic.anno
    : r.thelemic
      ? `Anno ${r.thelemic.year} ☉ in ${r.thelemic.sun?.sign ?? ""}`
      : "—",
};

/* ── job 3: real links, or none. Four dead language links are worse than no
   switcher, which README §3 explicitly allows, so the switcher is gone. ─── */
const WANTED = ["twitch", "youtube", "bluesky", "discord", "github"];
const LABELS: Record<string, string> = {
  twitch: "Twitch", youtube: "YouTube", bluesky: "Bluesky",
  discord: "Discord", github: "The code",
};
const all = Object.values(links?.groups ?? {}).flat();
const pills = WANTED
  .map((p) => all.find((l) => l.platform === p))
  .filter((l): l is NonNullable<typeof l> => Boolean(l?.url))
  .map((l) => ({ url: l.url, label: LABELS[l.platform] ?? l.label }));

interface Imprint {
  visible: boolean; entity?: string; street?: string; postcode?: string;
  city?: string; country?: string; email?: string; registry?: string; vat?: string;
}
const imprint = await site<Imprint>("/api/content/imprint");
const escape = (t: string) =>
  t.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
const imprintHtml = imprint?.visible && imprint.entity
  ? [
      escape(imprint.entity),
      [imprint.street, [imprint.postcode, imprint.city].filter(Boolean).join(" "), imprint.country]
        .filter(Boolean).map(escape).join(" · "),
      escape(imprint.email ?? ""),
      [imprint.registry, imprint.vat].filter(Boolean).map(escape).join(" · "),
    ].filter(Boolean).join("<br>")
  : "business@shrutivtuber.com";
const holder = imprint?.visible && imprint.entity ? imprint.entity : "Shruti";

/* The AGPL source offer, on the one page that is currently the whole site.
 *
 * These numbers come from Swiss Ephemeris running in the astrology daemon, and
 * that daemon is AGPL-3.0. Section 13 is not satisfied by a licence file in a
 * repository somewhere: a user who interacts with the program over a network
 * is owed an offer of the source for the build they actually talked to. The
 * tool pages carry this in their provenance card; while the holding page is
 * the only page anyone can reach, it has to carry it too.
 *
 * The link points at the running commit rather than the repository root, for
 * the same reason — "the source" means the source of what answered you. */
const source = versionAnswer.data;
const badge = live?.anyLive ? "live" : "offline";
const year = new Date().getUTCFullYear();
import Beacon from "../components/insight/Beacon.astro";
import { copy } from "../lib/copy";
import Copy from "../components/content/Copy.astro";
import NewsletterPopup from "../components/brand/NewsletterPopup.astro";
import { sourceHref, sourceBuild } from "../lib/source";

/* Every word on this page, editable from the admin. The defaults below are
   what it was written with and what still renders if nothing was changed. */
const say = await copy("coming-soon");


const csrf = Astro.locals.csrf;
const consentDefault =
  /* One string, not three joined. Split across concatenations she can only
     rewrite a third of a sentence at a time, and the joins are invisible in
     the admin. */
  say("optin.text", "One letter a month: what shipped, what the sky is doing, and the occasional paid thing. You will get a confirmation email first and are not subscribed until you click it. Leave in one click, any time.");
const consentSent =
  say("optin.sent", "A confirmation link is on its way. The subscription only begins once you click it — nothing is added to a list before then.");
---

<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<title>{say("text.1", "Shruti — instruments for magick")}</title>
<meta name="description" content={say("text.31", "Instruments for magick — an ephemeris, four calendars, planetary hours and letter-reckoning. The site is being built; the sky is not waiting.")} />
{/* Stays until the full site launches — handoff §4. */}
<meta name="robots" content="noindex" />
<meta property="og:title" content={say("text.11", "Shruti — instruments for magick")} />
<meta property="og:description" content={say("text.12", "The site is being built. The sky is not waiting.")} />
<meta property="og:type" content="website" />
<link rel="icon" href="/favicon.ico" sizes="any" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<style is:global set:html={FACES}></style>
<style is:global set:html={CSS}></style>
</head>
<body>
<div class="sky">
<div class="sky-stars"></div>
<header>
<span class="mark">{say("text.13", "Shruti")}</span>
{/* Never says live unless she is — handoff §4. */}
<span class="status"><i></i>{badge === "live" ? "live now · building" : "offline · building"}</span>
</header>
<main>
<div class="panel veil">
<div style="display:grid;gap:12px">
<p class="eyebrow">{say("text.2", "shrutivtuber.com · in construction")}</p>
<h1>{say("text.32", "The site is being built.")}<br />{say("text.3", "The sky is not waiting.")}</h1>
<p class="lede">{say("text.4", "Instruments for magick — an ephemeris, four calendars, planetary hours, letter-reckoning — built in the open and given away. The pages are still going up. Below is the sky over Athens as of this moment, which is the only part that was never going to wait for a launch date.")}</p>
</div>
<div class="card">
<div style="display:flex;align-items:baseline;gap:8px 12px;flex-wrap:wrap">
<p class="eyebrow">{say("text.30", "The sky over")} {ATHENS.label}</p>
<span class="tab" id="clock" style="margin-left:auto;font-family:var(--font-mono);font-size:var(--text-xs);color:var(--ink-faint)">—</span>
</div>
{
  sky ? (
    <>
      <div class="lum">
        <span class="g glyph" aria-hidden="true">☉</span>
        <div style="display:grid;gap:2px;min-width:0">
          <h2>{sky.sun.degree} {sky.sun.sign}</h2>
          <span class="who">{sky.sun.rashi} · {sky.sun.nakshatra}</span>
        </div>
      </div>
      <div class="lum">
        <span class="g glyph" aria-hidden="true">☾</span>
        <div style="display:grid;gap:2px;min-width:0">
          <h2>{sky.moon.degree} {sky.moon.sign}</h2>
          <span class="who">{sky.moon.rashi} · {sky.moon.nakshatra}</span>
        </div>
        <div class="count">
          <b class="tab">{sky.moon.perDay.toFixed(2)}°</b>
          <span class="tab">{say("text.14", "per day")}</span>
        </div>
      </div>
    </>
  ) : (
    <p class="fine">{say("text.5", "The ephemeris could not be reached just now. It is usually a moment.")}</p>
  )
}
<div class="reck">
<p class="eyebrow" style="margin-bottom:3px">{say("text.6", "Today, in every reckoning kept here")}</p>
<div class="r"><span>{say("text.15", "Gregorian")}</span><i></i><b class="tab" id="greg">—</b></div>
<div class="r"><span>{say("text.16", "Attic")}</span><i></i><b>{reck.attic}</b></div>
<div class="r"><span>{say("text.9", "Hindu · amānta")}</span><i></i><b>{reck.hindu}</b></div>
<div class="r"><span>{say("text.17", "Thelemic")}</span><i></i><b>{reck.thelemic}</b></div>
<p class="fine"><Copy text={say("text.7", "[Swiss Ephemeris](https://www.astro.com/swisseph/) · tropical above, sidereal below, neither a correction of the other · amānta reckoning. The finished instruments let you change every one of those.")} /></p>
<p class="fine">
  {/* One sentence, with the engine link and its build stamped in by
      placeholder — so the whole thing stays readable and editable, and the
      version can be moved or dropped without touching this file. */}
  <Copy
    text={say("engine.credit", "Computed on the server by [shruti-astro]({source}){build}, free software under [AGPL-3.0](https://www.gnu.org/licenses/agpl-3.0.html). The source of the build that answered you is at that link — that is what the licence asks for, and it is a better answer than a badge.")}
    vars={{
      source: source?.sourceUrl ?? "https://github.com/ShrutiVtuber/shruti-astro",
      build: source?.version
        ? `, version ${source.version}${source.sha && source.sha !== "dev" ? ` · ${source.sha.slice(0, 7)}` : ""}`
        : "",
    }}
  />
</p>
<p class="fine">
  {/* The line above offers the EPHEMERIS's source and only that. The daemon is
      a separate program under the same licence, so it was right and
      incomplete: it covered the thing doing the arithmetic and not the page
      the visitor is actually looking at. This page carries no site footer, so
      the site's own AGPL-13 offer has to be made here. */}
  <Copy
    text={say("site.source", "This page is free software too — [its source]({source}){build} is public, under the same licence.")}
    vars={{
      source: sourceHref(),
      build: sourceBuild() ? ` · ${sourceBuild()}` : "",
    }}
  />
</p>
</div>
</div>
<div style="display:grid;gap:12px">
<div style="display:flex;align-items:baseline;gap:10px;flex-wrap:wrap">
<h2 style="margin:0;font-family:var(--font-display);font-size:var(--text-h4);font-weight:600">{say("hear-when-it-opens.1", "Hear when it opens")}</h2>
<span style="font-family:var(--font-mono);font-size:.625rem;font-weight:600;letter-spacing:.08em;text-transform:uppercase;color:var(--rose)">{say("hear-when-it-opens.2", "one letter a month")}</span>
</div>
<form id="sub" method="POST">
<input type="hidden" name="_csrf" value={csrf} />
<label><span>{say("text.10", "Email address")}</span><input type="email" name="email" required placeholder="you@example.com" autocomplete="email" /></label>
<button type="submit" id="subbtn">{sent ? "Check your email" : "Send me the letter"}</button>
</form>
<p class="consent" id="consent">{sent ? consentSent : failed ? failed : consentDefault}</p>
</div>
<div class="where">
<p class="eyebrow">{say("hear-when-it-opens.3", "Until then, she is here")}</p>
{/* Real links only — a pill with nowhere to go is worse than one fewer. */}
{pills.length > 0 && (
  <div class="pills">{pills.map((p) => <a href={p.url} rel="me noopener">{p.label}</a>)}</div>
)}
<p style="margin:0;font-size:var(--text-xs);line-height:1.6;color:var(--ink-faint)">{say("hear-when-it-opens.4", "Streams run most weeks from Athens. The repositories are public already — the instruments exist before the pages that will explain them.")}</p>
</div>
</div>
</main>
<div class="sky-horizon"></div>
<footer>
<div class="foot">
<p class="imprint" set:html={imprintHtml}></p>
<p>© <span id="yr">{year}</span> {holder} · <a href="/privacy">{say("text.18", "Privacy")}</a> · <a href="/terms">{say("text.19", "Terms")}</a></p>
<span class="seal" title={say("text.8", "Soror Eu. A.")}>S∴E.A.</span>
</div>
</footer>
</div>

{/* Only the clock and today's date move without the server. The positions
    are a snapshot, and the page says when it was taken rather than pretending
    to a precision it does not have. */}
<script is:inline>
function pad(n){return String(n).padStart(2,'0')}
function tick(){
  var now=new Date();
  var c=document.getElementById('clock');
  if(c) c.textContent=pad(now.getHours())+':'+pad(now.getMinutes())+':'+pad(now.getSeconds());
  var g=document.getElementById('greg');
  if(g) g.textContent=now.toLocaleDateString('en-GB',{weekday:'short',day:'numeric',month:'short',year:'numeric'});
  var y=document.getElementById('yr');
  if(y) y.textContent=now.getFullYear();
}
tick();setInterval(tick,1000);
</script>
{/* Counted like the rest of the site — which while the holding page is up
    means counted INSTEAD of the rest of the site, since this is the only page
    most people see. It records the path they asked for rather than
    /coming-soon, because the middleware rewrites rather than redirects, so
    the dashboard answers the more useful question: what are people trying to
    reach while the door is shut. */}
<Beacon />
{/* Asked late and once. Suppressed the moment they have signed up — the form
    above is already saying "check your email", and a popup over that reads as
    the site not having noticed. */}
<NewsletterPopup suppress={sent} />
</body>
</html>

---
/* Ported from `components/forms/TextArea.jsx`; contract in `TextArea.d.ts`. */
interface Props {
  label: string; name?: string; hint?: string; error?: string; success?: string;
  required?: boolean; optionalLabel?: boolean; disabled?: boolean;
  id?: string; rows?: number; maxlength?: number; value?: string; placeholder?: string;
}
const {
  label, name, hint, error, success, required, optionalLabel, disabled,
  id, rows = 5, maxlength, value = "", placeholder, ...rest
} = Astro.props;
const fid = id ?? `sh-ta-${name ?? label.toLowerCase().replace(/[^a-z0-9]+/g, "-")}`;
---
<div class="sh-field" data-invalid={!!error} data-disabled={!!disabled}>
  <label class="sh-f-label" for={fid}>
    {label}
    {required && <span class="sh-f-req" aria-hidden="true">*</span>}
    {!required && optionalLabel && <span class="sh-f-optional">optional</span>}
  </label>
  <textarea
    class="sh-f-ctrl" id={fid} name={name ?? fid} rows={rows} maxlength={maxlength}
    placeholder={placeholder} required={required} disabled={disabled}
    aria-invalid={!!error}
    aria-describedby={error ? `${fid}-err` : hint ? `${fid}-hint` : undefined}
    {...rest}
  >{value}</textarea>
  {
    error ? <span class="sh-f-error" id={`${fid}-err`} role="alert">{error}</span>
    : success ? <span class="sh-f-ok">{success}</span>
    : hint ? <span class="sh-f-hint" id={`${fid}-hint`}>{hint}</span>
    : null
  }
  {maxlength && <span class="sh-f-count" data-count-for={fid}>{value.length} / {maxlength}</span>}
</div>

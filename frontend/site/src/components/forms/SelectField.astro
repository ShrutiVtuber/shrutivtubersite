---
/* Ported from `components/forms/SelectField.jsx`; contract in
   `SelectField.d.ts`. */
export type SelectOption = string | { value: string; label: string };
interface Props {
  label: string; name?: string; hint?: string; error?: string;
  required?: boolean; disabled?: boolean; id?: string;
  options?: SelectOption[]; placeholder?: string; value?: string;
}
const {
  label, name, hint, error, required, disabled, id,
  options = [], placeholder, value, ...rest
} = Astro.props;
const fid = id ?? `sh-sel-${name ?? label.toLowerCase().replace(/[^a-z0-9]+/g, "-")}`;
const norm = options.map((o) => (typeof o === "string" ? { value: o, label: o } : o));
---
<div class="sh-field" data-invalid={!!error} data-disabled={!!disabled}>
  <label class="sh-f-label" for={fid}>
    {label}
    {required && <span class="sh-f-req" aria-hidden="true">*</span>}
  </label>
  <span class="sh-f-selwrap">
    <select
      class="sh-f-ctrl" id={fid} name={name ?? fid} required={required} disabled={disabled}
      aria-invalid={!!error}
      aria-describedby={error ? `${fid}-err` : hint ? `${fid}-hint` : undefined}
      {...rest}
    >
      {placeholder && <option value="" disabled selected={value == null}>{placeholder}</option>}
      {norm.map((o) => <option value={o.value} selected={value === o.value}>{o.label}</option>)}
    </select>
  </span>
  {
    error ? <span class="sh-f-error" id={`${fid}-err`} role="alert">{error}</span>
    : hint ? <span class="sh-f-hint" id={`${fid}-hint`}>{hint}</span>
    : null
  }
</div>

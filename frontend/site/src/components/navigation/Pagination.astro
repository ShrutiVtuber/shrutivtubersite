---
import { copy } from "../../lib/copy";

/* Every word here, editable from the admin. The defaults below are what
   it was written with and what still renders if nothing was changed. */
const say = await copy("component:Pagination");

/* Ported from `components/navigation/Pagination.jsx`; contract in
 * `Pagination.d.ts`. Link-based rather than callback-based: pagination that
 * needs JavaScript to change page is pagination search engines cannot follow
 * and a reader cannot bookmark.
 */
interface Props { page: number; pageCount: number; hrefFor: (p: number) => string; label?: string; }
const { page, pageCount, hrefFor, label = "Pagination" } = Astro.props;

function windowed(cur: number, total: number): (number | "…")[] {
  if (total <= 7) return Array.from({ length: total }, (_, i) => i + 1);
  const set = new Set([1, total, cur - 1, cur, cur + 1]);
  const arr = [...set].filter((p) => p >= 1 && p <= total).sort((a, b) => a - b);
  const out: (number | "…")[] = [];
  let prev = 0;
  for (const p of arr) {
    if (p - prev > 1) out.push("…");
    out.push(p);
    prev = p;
  }
  return out;
}
const items = windowed(page, pageCount);
---

<nav class="sh-pag" aria-label={label}>
  <a data-p href={hrefFor(page - 1)} aria-disabled={page <= 1 || undefined} aria-label={say("text.1", "Previous page")}>‹</a>
  {
    items.map((p) =>
      p === "…" ? (
        <span class="sh-pag-gap" aria-hidden="true">…</span>
      ) : (
        <a data-p href={hrefFor(p)} aria-current={p === page ? "page" : undefined}>{p}</a>
      ),
    )
  }
  <a data-p href={hrefFor(page + 1)} aria-disabled={page >= pageCount || undefined} aria-label={say("text.2", "Next page")}>›</a>
</nav>

<style>
  .sh-pag { display: flex; align-items: center; gap: 4px; font-family: var(--font-body); justify-content: center; }
  .sh-pag [data-p] {
    appearance: none;
    border: var(--border-w) solid transparent;
    background: transparent;
    min-width: 36px;
    height: 36px;
    padding: 0 8px;
    border-radius: var(--radius-sm);
    font-size: var(--text-sm);
    font-variant-numeric: tabular-nums;
    color: var(--ink-soft);
    cursor: pointer;
    display: inline-grid;
    place-items: center;
    text-decoration: none;
    line-height: 1;
    transition: color var(--dur-1) var(--ease-out), border-color var(--dur-1) var(--ease-out), background var(--dur-1) var(--ease-out);
  }
  .sh-pag [data-p]:hover { color: var(--ink); border-color: var(--line-strong); }
  .sh-pag [data-p]:active { transform: translateY(1px); }
  .sh-pag [data-p][aria-current="page"] {
    background: var(--accent-wash);
    border-color: color-mix(in srgb, var(--accent) 50%, transparent);
    color: var(--accent);
    font-weight: 600;
  }
  .sh-pag [data-p][aria-disabled="true"] { opacity: 0.4; pointer-events: none; }
  .sh-pag-gap { color: var(--ink-faint); min-width: 24px; text-align: center; }
</style>

---
/* Site footer. Ported from `ui_kits/site/Chrome.jsx`.
 *
 * Carries the legal imprint from day one and the Soror Eu. A. seal. The seal
 * is typographic, not a logo and not an image: no drawn seal exists and the
 * brief forbids inventing one.
 */
import SocialLinkRow from "../brand/SocialLinkRow.astro";
import { sourceHref, sourceBuild, LICENCE_URL } from "../../lib/source";
import LegalImprint from "../brand/LegalImprint.astro";
import type { SocialLink } from "../brand/SocialLinkRow.astro";

interface Props {
  socials?: SocialLink[];
}
const { socials = [] } = Astro.props;

/* The imprint comes from settings and is absent until it is filled in and
   switched on from the admin. Publishing a registry number that is not one
   would be a claim rather than a placeholder. */
import { site } from "../../lib/api";
import { copy } from "../../lib/copy";

/* Every word here, editable from the admin. The defaults below are what
   it was written with and what still renders if nothing was changed. */
const say = await copy("component:SiteFooter");

interface Imprint {
  visible: boolean;
  entity?: string; street?: string; postcode?: string; city?: string;
  country?: string; email?: string; registry?: string; vat?: string;
}
const imprint = await site<Imprint>("/api/content/imprint");

/* WHO holds the copyright, and only if that is actually known.
 *
 * This said "© ShrutiVTuber, LLC" on every page of the site, hardcoded. No
 * such company has been registered — whether to register one is still an open
 * question — so the footer was asserting a legal entity into existence on
 * every page load. That is the same mistake as the bracketed registry number
 * in the imprint, except it was not bracketed, so it read as fact.
 *
 * The entity comes from the imprint when it is filled in and switched on. Until
 * then it is the name of the person who made the site, which is true. */
const holder = imprint?.visible && imprint.entity ? imprint.entity : "Shruti";

/* Same rule as the header: no link to a section that 404s. */
const hidden = new Set(
  Object.entries(Astro.locals.sectionsLive ?? {})
    .filter(([, live]) => live === false)
    .map(([name]) => `/${name}`),
);
const shown = (href: string) => !hidden.has(href);

const SITE: [string, string][] = [
  ["/work", "Work"],
  ["/classes", "Classes"],
  ["/shop", "Shop"],
  ["/today", "Day at a glance"],
  ["/tools/solar-stations", "Solar stations"],
  ["/tools/lunar-stations", "Lunar stations"],
  ["/tools/horoscope-writing", "Write a horoscope"],
  ["/schedule", "Schedule"],
  ["/videos", "Videos"],
  ["/horoscopes", "Horoscopes"],
  ["/journal", "Journal"],
  ["/about", "About"],
  /* Not in the header: that nav is already at the width where it wraps into
     the drawer, and adding an eleventh item moves that number again. The
     landing page's sponsor row links here directly, which is where somebody
     actually goes looking for it. */
  ["/community", "Community"],
  ["/compatible", "Are we compatible?"],
  ["/partners", "Partners"],
];
const ELSEWHERE: [string, string][] = [
  ["/newsletter", "The monthly letter"],
  ["/press", "Press & media kit"],
  ["/fan-works", "Fan works"],
  ["/guidelines", "Derivative work guidelines"],
  ["/support", "Support the work"],
  ["/contact", "Contact"],
];
const year = new Date().getUTCFullYear();
---

<footer class="site-footer">
  <div class="page">
    <div class="cols">
      <div>
        <span class="brand-word footer-brand">{say("text.3", "Shruti")}</span>
        <p class="footer-thesis">{say("text.2", "Instruments for magick, built live from Athens.")}</p>
        <SocialLinkRow links={socials} size={16} />
      </div>
      <div>
        <h2 class="col-head">{say("site.1", "Site")}</h2>
        <ul>{SITE.filter(([href]) => shown(href)).map(([href, label]) => <li><a href={href}>{label}</a></li>)}</ul>
      </div>
      <div>
        <h2 class="col-head">{say("elsewhere.1", "Elsewhere")}</h2>
        <ul>{ELSEWHERE.map(([href, label]) => <li><a href={href}>{label}</a></li>)}</ul>
      </div>
    </div>
    {
      imprint?.visible && (
        <div class="imprint-rule">
          <LegalImprint
            entity={imprint.entity}
            street={imprint.street}
            postcode={imprint.postcode}
            city={imprint.city}
            country={imprint.country}
            email={imprint.email}
            registry={imprint.registry}
            vat={imprint.vat}
          />
        </div>
      )
    }
    <div class="legal">
      {/* One addition to the delivered footer, and the reason is concrete: the
          design assumed an admin SPA the owner would bookmark, and without a
          link the only way in is to remember the path — which is how a site
          owner ends up signing in at the reader form and concluding the
          password is wrong. The page itself is auth-guarded, so the link
          reveals nothing. */}
      <p>
        {/* The instruments are the part of this site a stranger is most likely
            to arrive for and the part with no room in the header. A footer link
            costs no header width and gives the hub one site-wide inbound link,
            which is what makes it the page worth linking to from outside. */}
        © {year} {holder} · <a href="/tools">{say("text.4", "Instruments")}</a>
        {/* The page somebody checks when they are unsure whether a shop is
            really hers. It has to be findable from every page, because the
            moment they need it is not a moment they will go looking. */}
        · <a href="/official">{say("elsewhere.2", "Official places")}</a>
        · <a href="/privacy">{say("text.5", "Privacy")}</a> · <a href="/terms">{say("text.6", "Terms")}</a>
        · <a href="/admin" class="admin-link">{say("text.7", "Admin")}</a>
      </p>
      {/* AGPL-3.0 section 13: software people interact with over a network has
          to offer them its source. Not a credit and not a badge — without this
          link the site runs under terms it does not honour. It names the exact
          commit when the deploy says which, and the repository when it does
          not; it never claims a commit it cannot vouch for. */}
      <p class="footer-source">
        {say("source.lead", "This site is free software.")}{" "}
        <a href={sourceHref()} rel="noopener">{say("source.link", "Read or fork its source")}</a>
        {sourceBuild() && <span class="t-tabular"> · {sourceBuild()}</span>}
        {" · "}
        <a href={LICENCE_URL} rel="noopener license">AGPL-3.0</a>
      </p>
      <span class="seal seal-ring" title={say("text.1", "Soror Eu. A.")}>S∴E.A.</span>
    </div>
  </div>
</footer>

<style>
  .footer-source {
    margin: 6px 0 0;
    font: 400 var(--text-xs) / 1.6 var(--font-body);
    color: var(--ink-faint);
  }
  .footer-source a { color: inherit; text-decoration: underline; }
  .footer-source a:hover { color: var(--ink); }


  .footer-brand { font-family: var(--font-display); font-size: 22px; color: var(--ink); }
  .footer-thesis {
    font: 400 var(--text-sm) / 1.55 var(--font-body);
    color: var(--ink-soft);
    max-width: 34ch;
    margin: 10px 0 14px;
  }
  .imprint-rule {
    padding-top: var(--space-5);
    margin-top: var(--space-5);
    border-top: var(--border-w) solid var(--line);
  }
  .site-footer .legal p a { color: inherit; }
  /* `opacity: 0.7` here put faint ink at 2.88:1. It is a real link people
     click, in the footer of every page. The link is already the least
     prominent thing in that row by position and wording; it does not need to
     be unreadable as well. */
</style>

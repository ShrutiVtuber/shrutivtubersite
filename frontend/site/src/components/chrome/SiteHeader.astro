---
/* Site header. Ported from the design bundle's `ui_kits/site/Chrome.jsx`.
 *
 * The prototype's hash routes (#home) become real paths. The bar carries six
 * places; the menu carries every page, grouped by what a visitor came to
 * do, on every width — rethought on 20 September 2026 when Guides went
 * live and the eleven-item bar had run out of room.
 */
import LiveBadge from "../brand/LiveBadge.astro";
import type { BadgeState } from "../../lib/live";
import { copy } from "../../lib/copy";

/* Every word here, editable from the admin. The defaults below are what
   it was written with and what still renders if nothing was changed. */
const say = await copy("component:SiteHeader");


interface Props {
  live: BadgeState;
  signedIn?: boolean;
  withArt?: boolean;
}
const { live, signedIn = false, withArt = false } = Astro.props;
const here = Astro.url.pathname;

/* A section she has not published yet has no link. The middleware already
   404s it, and a nav item pointing at a 404 is worse than no nav item: it says
   the site is broken rather than that the thing is not ready.

   Read from locals, which the middleware fills, so the header and the gate
   cannot disagree — one asks the backend, the other reads what it decided. */
const hidden = new Set(
  Object.entries(Astro.locals.sectionsLive ?? {})
    .filter(([, live]) => live === false)
    .map(([name]) => `/${name}`),
);
const visible = (href: string) => !hidden.has(href);

/* Every page the chrome reaches, grouped by what a visitor came to do. The
   bar carries six; the menu carries all of them under their eyebrows, on
   every width, so nothing is reachable only from a landing page.

   NAV stays a flat array of tuples: the reachability test reads it. */
const NAV: [string, string][] = [
  ["/", "Home"],
  ["/today", "Today"],
  ["/guides", "Guides"],
  /* The Play hub. Named from the menu as its group's "Overview" (the label
     below is overridden there by an editable string). */
  ["/play", "Play"],
  ["/tools", "Instruments"],
  /* Swara Studio, the Carnatic music school (26 Sep 2026). Its six places
     are the menu's own group; the bar carries the school's front door. */
  ["/carnatic", "Carnatic music school"],
  ["/carnatic/lessons", "Learn"],
  ["/carnatic/practice/tuner", "Practice"],
  ["/carnatic/compose", "Compose"],
  ["/carnatic/listen", "Listen"],
  ["/carnatic/support", "Support the school"],
  ["/horoscopes", "Horoscopes"],
  ["/journal", "Journal"],
  ["/schedule", "Schedule"],
  ["/videos", "Videos"],
  ["/builds", "Builds"],
  ["/groups", "Groups"],
  ["/ledger", "Ledger"],
  ["/classes", "Classes"],
  ["/newsletter", "The monthly letter"],
  ["/about", "About"],
  ["/work", "Work"],
  ["/shop", "Shop"],
  ["/support", "Support the work"],
  ["/contact", "Contact"],
];
/* The bar is tight: the school is "Carnatic school" there (as the design's
   header mock has it) and "Carnatic music school" in the menu. */
const BAR_LABEL: Record<string, string> = { "/carnatic": say("bar.carnatic", "Carnatic school") };
/* Play, not Guides: /play is the games wing's front door and Guides is one of
   its rooms. The bar names the door; the menu's Play group lists the rooms. */
const BAR = ["/today", "/play", "/tools", "/carnatic", "/horoscopes", "/journal", "/schedule"];
/* A group whose first page is its own overview gets a heading that links to
   it: the Play group's heading opens /play, and /play is also its first item,
   "Overview", so the door is there for somebody who does not click headings. */
const GROUPS: [string, string[]][] = [
  [say("group.watch", "Watch"), ["/schedule", "/videos"]],
  [say("group.play", "Play"), ["/play", "/guides", "/builds", "/groups", "/ledger"]],
  [say("group.practice", "Practice"), ["/tools", "/horoscopes", "/classes"]],
  [say("group.carnatic", "Carnatic music school"), ["/carnatic", "/carnatic/lessons", "/carnatic/practice/tuner", "/carnatic/compose", "/carnatic/listen", "/carnatic/support"]],
  [say("group.read", "Read"), ["/today", "/journal", "/newsletter"]],
  [say("group.her", "Shruti"), ["/about", "/work", "/shop", "/support", "/contact"]],
];
const OVERVIEWS: Record<string, string> = { "/play": say("group.play.overview", "Overview"), "/carnatic": say("group.carnatic.overview", "Overview") };
const label = (href: string) => NAV.find(([h]) => h === href)?.[1] ?? href;
const itemLabel = (href: string) => OVERVIEWS[href] ?? label(href);
/* /play, /builds, /groups and /ledger belong to the guides section: hidden with it. */
const visibleNav = (href: string) => visible(["/play", "/builds", "/groups", "/ledger"].includes(href) ? "/guides" : href.startsWith("/carnatic") ? "/carnatic" : href);
const current = (href: string) => (href === "/" ? here === "/" : here.startsWith(href));
/* In the bar, Play stands for the whole games wing: it is the current place
   on a guide, a build, a group or a ledger as much as on /play itself. */
const WING = ["/play", "/guides", "/builds", "/groups", "/ledger"];
const currentInBar = (href: string) => (href === "/play" ? WING.some((w) => here.startsWith(w)) : current(href));
/* In the menu, the school's front door is current only on itself. */
const currentInMenu = (href: string) => (href === "/carnatic" ? here === "/carnatic" : current(href));
---

<header class="site-header" data-scrolled="false">
  <div class="page">
    <div class="bar">
      <a class="brand" href="/" aria-label={say("text.1", "Shruti — home")}>
        {
          withArt ? (
            <img src={say("brand.wordmark", "/brand/wordmark-small.png", "Wordmark")}
                 alt={say("brand.wordmark.alt", "Shruti", "Wordmark alt text")} />
          ) : (
            <span class="brand-word">{say("text.5", "Shruti")}</span>
          )
        }
      </a>
      <nav class="site-nav" aria-label={say("text.31", "Primary")}>
        {
          BAR.filter(visibleNav).map((href) => (
            <a href={href} aria-current={currentInBar(href) ? "page" : undefined}>
              {BAR_LABEL[href] ?? label(href)}
            </a>
          ))
        }
      </nav>
      <div class="header-side">
        <LiveBadge compact status={live.status} href="/videos" />
        <a class="acct-link" href={signedIn ? "/account" : "/signin"}>
          {signedIn ? say("account", "Account") : say("signin", "Sign in")}
        </a>
        <button
          type="button"
          class="nav-toggle"
          aria-expanded="false"
          aria-controls="site-menu"
          data-nav-toggle
        >
          <span aria-hidden="true" data-nav-glyph>≡</span> {say("text.30", "Menu")}
        </button>
      </div>
    </div>
    <div class="site-menu-veil" data-nav-veil hidden></div>
    <nav id="site-menu" class="site-menu" aria-label={say("text.2", "Everything")} hidden>
      <div class="site-menu-head">
        <span class="site-menu-eyebrow">{say("text.32", "Everything")}</span>
        <button type="button" class="site-menu-close" data-nav-close aria-label={say("text.33", "Close the menu")}>×</button>
      </div>
      <div class="site-menu-groups">
      {
        GROUPS.map(([name, hrefs]) => {
          const shown = hrefs.filter(visibleNav);
          const overview = OVERVIEWS[shown[0]] ? shown[0] : null;
          return shown.length ? (
            <div class="site-menu-group">
              {overview
                ? <a class="site-menu-eyebrow site-menu-heading" href={overview}>{name}</a>
                : <span class="site-menu-eyebrow">{name}</span>}
              {shown.map((href) => (
                <a href={href} aria-current={currentInMenu(href) ? "page" : undefined}>{itemLabel(href)}</a>
              ))}
            </div>
          ) : null;
        })
      }
      <div class="site-menu-group">
        <span class="site-menu-eyebrow">{say("group.you", "You")}</span>
        <a href={signedIn ? "/account" : "/signin"}>{signedIn ? say("account", "Account") : say("signin", "Sign in")}</a>
      </div>
      </div>
    </nav>
  </div>
</header>

{/* The only script the chrome needs: a scrolled flag and the mobile menu.
    Inline and tiny on purpose — the site is zero-JS by default and this does
    not justify an island. */}
<script is:inline>
  (function () {
    var header = document.querySelector(".site-header");
    var toggle = document.querySelector("[data-nav-toggle]");
    var glyph = document.querySelector("[data-nav-glyph]");
    var menu = document.getElementById("site-menu");
    var veil = document.querySelector("[data-nav-veil]");
    var close = document.querySelector("[data-nav-close]");
    if (!header) return;

    var onScroll = function () {
      header.setAttribute("data-scrolled", window.scrollY > 8 ? "true" : "false");
    };
    onScroll();
    window.addEventListener("scroll", onScroll, { passive: true });

    if (!toggle || !menu) return;
    /* The menu floats over the page — a panel under the bar on a wide screen, a
       drawer from the right on a phone — and never moves what is under it.
       While it is open the page does not scroll; Escape, the veil and the ×
       close it, and focus returns to the button that opened it. */
    var setOpen = function (open) {
      toggle.setAttribute("aria-expanded", open ? "true" : "false");
      menu.hidden = !open;
      if (veil) veil.hidden = !open;
      header.setAttribute("data-menu-open", open ? "true" : "false");
      document.documentElement.classList.toggle("menu-open", open);
      if (glyph) glyph.textContent = open ? "×" : "≡";
      if (open) {
        var first = menu.querySelector("a, button");
        if (first) first.focus();
      } else {
        toggle.focus();
      }
    };
    toggle.addEventListener("click", function () {
      setOpen(toggle.getAttribute("aria-expanded") !== "true");
    });
    if (close) close.addEventListener("click", function () { setOpen(false); });
    if (veil) veil.addEventListener("click", function () { setOpen(false); });
    document.addEventListener("keydown", function (e) {
      if (e.key === "Escape" && toggle.getAttribute("aria-expanded") === "true") setOpen(false);
    });
  })();
</script>

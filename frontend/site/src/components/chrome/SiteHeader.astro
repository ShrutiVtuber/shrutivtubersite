---
/* Site header. Ported from the design bundle's `ui_kits/site/Chrome.jsx`.
 *
 * The prototype's hash routes (#home) become real paths. The bar carries six
 * places; the menu carries every page, grouped by what a visitor came to
 * do, on every width — rethought on 20 September 2026 when Guides went
 * live and the eleven-item bar had run out of room.
 */
import LiveBadge from "../brand/LiveBadge.astro";
import type { BadgeState } from "../../lib/live";
import { copy } from "../../lib/copy";

/* Every word here, editable from the admin. The defaults below are what
   it was written with and what still renders if nothing was changed. */
const say = await copy("component:SiteHeader");


interface Props {
  live: BadgeState;
  signedIn?: boolean;
  withArt?: boolean;
}
const { live, signedIn = false, withArt = false } = Astro.props;
const here = Astro.url.pathname;

/* A section she has not published yet has no link. The middleware already
   404s it, and a nav item pointing at a 404 is worse than no nav item: it says
   the site is broken rather than that the thing is not ready.

   Read from locals, which the middleware fills, so the header and the gate
   cannot disagree — one asks the backend, the other reads what it decided. */
const hidden = new Set(
  Object.entries(Astro.locals.sectionsLive ?? {})
    .filter(([, live]) => live === false)
    .map(([name]) => `/${name}`),
);
const visible = (href: string) => !hidden.has(href);

/* Every page the chrome reaches, grouped by what a visitor came to do. The
   bar carries six; the menu carries all of them under their eyebrows, on
   every width, so nothing is reachable only from a landing page.

   NAV stays a flat array of tuples: the reachability test reads it. */
const NAV: [string, string][] = [
  ["/", "Home"],
  ["/today", "Today"],
  ["/guides", "Guides"],
  ["/tools", "Instruments"],
  ["/horoscopes", "Horoscopes"],
  ["/journal", "Journal"],
  ["/schedule", "Schedule"],
  ["/videos", "Videos"],
  ["/builds", "Builds"],
  ["/groups", "Groups"],
  ["/classes", "Classes"],
  ["/newsletter", "The monthly letter"],
  ["/about", "About"],
  ["/work", "Work"],
  ["/shop", "Shop"],
  ["/support", "Support the work"],
  ["/contact", "Contact"],
];
const BAR = ["/today", "/guides", "/tools", "/horoscopes", "/journal", "/schedule"];
const GROUPS: [string, string[]][] = [
  [say("group.watch", "Watch"), ["/schedule", "/videos"]],
  [say("group.play", "Play"), ["/guides", "/builds", "/groups"]],
  [say("group.practice", "Practice"), ["/tools", "/horoscopes", "/classes"]],
  [say("group.read", "Read"), ["/today", "/journal", "/newsletter"]],
  [say("group.her", "Shruti"), ["/about", "/work", "/shop", "/support", "/contact"]],
];
const label = (href: string) => NAV.find(([h]) => h === href)?.[1] ?? href;
/* /builds and /groups belong to the guides section: hidden with it. */
const visibleNav = (href: string) => visible(href === "/builds" || href === "/groups" ? "/guides" : href);
const current = (href: string) => (href === "/" ? here === "/" : here.startsWith(href));
---

<header class="site-header" data-scrolled="false">
  <div class="page">
    <div class="bar">
      <a class="brand" href="/" aria-label={say("text.1", "Shruti — home")}>
        {
          withArt ? (
            <img src={say("brand.wordmark", "/brand/wordmark-small.png", "Wordmark")}
                 alt={say("brand.wordmark.alt", "Shruti", "Wordmark alt text")} />
          ) : (
            <span class="brand-word">{say("text.5", "Shruti")}</span>
          )
        }
      </a>
      <nav class="site-nav" aria-label={say("text.31", "Primary")}>
        {
          BAR.filter(visibleNav).map((href) => (
            <a href={href} aria-current={current(href) ? "page" : undefined}>
              {label(href)}
            </a>
          ))
        }
      </nav>
      <div class="header-side">
        <LiveBadge compact status={live.status} href="/videos" />
        <a class="acct-link" href={signedIn ? "/account" : "/signin"}>
          {signedIn ? say("account", "Account") : say("signin", "Sign in")}
        </a>
        <button
          type="button"
          class="nav-toggle"
          aria-expanded="false"
          aria-controls="site-menu"
          data-nav-toggle
        >
          <span aria-hidden="true" data-nav-glyph>≡</span> {say("text.30", "Menu")}
        </button>
      </div>
    </div>
    <nav id="site-menu" class="site-menu" aria-label={say("text.2", "Everything")} hidden>
      {
        GROUPS.map(([name, hrefs]) => {
          const shown = hrefs.filter(visibleNav);
          return shown.length ? (
            <div class="site-menu-group">
              <span class="site-menu-eyebrow">{name}</span>
              {shown.map((href) => (
                <a href={href} aria-current={current(href) ? "page" : undefined}>{label(href)}</a>
              ))}
            </div>
          ) : null;
        })
      }
      <div class="site-menu-group">
        <span class="site-menu-eyebrow">{say("group.you", "You")}</span>
        <a href={signedIn ? "/account" : "/signin"}>{signedIn ? say("account", "Account") : say("signin", "Sign in")}</a>
      </div>
    </nav>
  </div>
</header>

{/* The only script the chrome needs: a scrolled flag and the mobile menu.
    Inline and tiny on purpose — the site is zero-JS by default and this does
    not justify an island. */}
<script is:inline>
  (function () {
    var header = document.querySelector(".site-header");
    var toggle = document.querySelector("[data-nav-toggle]");
    var glyph = document.querySelector("[data-nav-glyph]");
    var menu = document.getElementById("site-menu");
    if (!header) return;

    var onScroll = function () {
      header.setAttribute("data-scrolled", window.scrollY > 8 ? "true" : "false");
    };
    onScroll();
    window.addEventListener("scroll", onScroll, { passive: true });

    if (!toggle || !menu) return;
    toggle.addEventListener("click", function () {
      var open = toggle.getAttribute("aria-expanded") === "true";
      toggle.setAttribute("aria-expanded", open ? "false" : "true");
      menu.hidden = open;
      if (glyph) glyph.textContent = open ? "≡" : "×";
    });
  })();
</script>

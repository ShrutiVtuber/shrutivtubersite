---
/* The reader: one guide as a document, in the site's clothes (board W3).
 *
 * A 264px rail — the path as an index, the facts, report and block — beside
 * a 66ch prose column. Step bodies are set in the display face at prose
 * size: this is her writing, and it reads like the journal. There are no
 * state dots anywhere, on purpose: nothing has a state until there is a
 * run, so a signed-out reader sees a document, not a checklist with
 * everything unticked.
 *
 * Everything on this page is somebody's writing, so everything is a text
 * node: no markdown, no set:html. A link in a guide is drawn only for
 * http(s); anything else is shown as text.
 *
 * Used by the public reader and by the desk's preview, which passes
 * `preview` so the actions stay off and a notice says what it is.
 */
import { copy } from "../../lib/copy";
import Button from "../forms/Button.astro";
import Sigil from "./Sigil.astro";
import {
  type GuideSummary,  type Gate, type GuideDoc, type Link, type Step,
  codexGroups, gateWords, phasesOf, safeUrl, stepsOf, titled, variantNames,
} from "../../lib/guides";

interface Props {
  guide: GuideSummary & { body: GuideDoc };
  signedIn: boolean;
  preview?: boolean;
  /** The track page for this guide — present only for a published guide. */
  trackHref?: string;
}
const { guide, signedIn, preview = false, trackHref = "" } = Astro.props;
const say = await copy("component:GuideReader");

const doc = guide.body;
const phases = phasesOf(doc);
const pathPhases = phases.filter((p) => !p.track);
const tracks = doc.tracks ?? [];
const routines = doc.routines ?? [];
const groups = codexGroups(doc);
const notes = doc.codex_notes ?? [];
const caveats = doc.guide.caveats ?? [];
const stepCount = (doc.steps ?? []).length;
const hours = Math.round((doc.steps ?? []).reduce((n, s) => n + (Number(s.minutes) || 0), 0) / 60);
const trackName = (id: string) => tracks.find((t) => t.id === id)?.name ?? id;
const codexOf = (id: string) => (doc.codex ?? []).find((c) => c.id === id);

/* The gate as the board prints it: a mono line, "opens at level 15". */
const words = {
  min: say("gate.min", "at {what} {n}"),
  max: say("gate.max", "up to {what} {n}"),
  atLeast: say("gate.at_least", "from {value}"),
  is: say("gate.is", "when {what} is {value}"),
  variant: say("gate.variant", "in {name}"),
  after: say("gate.after", "after {ids}"),
  once: say("gate.once", "once {names} is in play"),
};
const lower = (doc2: GuideDoc): GuideDoc => ({
  ...doc2, checkin: (doc2.checkin ?? []).map((f) => ({ ...f, label: (f.label || f.id).toLowerCase() })),
});
const lowered = lower(doc);
const opens = (g: Gate | undefined) => gateWords(g, lowered, words);
const isVideo = (l: Link) =>
  l.type === "video" || /youtube\.com|youtu\.be|twitch\.tv|vimeo\.com/i.test(String(l.url ?? ""));
const linkLabel = (l: Link) => l.label || l.url;

const LICENCES: Record<string, string> = {
  "CC-BY-SA-4.0": "CC BY-SA 4.0", "CC-BY-4.0": "CC BY 4.0", "CC0-1.0": "CC0",
  "All-Rights-Reserved": say("licence.reserved", "all rights reserved"),
};
const licence = doc.guide.licence ? (LICENCES[doc.guide.licence] ?? doc.guide.licence) : "";
const RESETS: Record<string, string> = {
  session: say("resets.session", "resets each session"), daily: say("resets.daily", "resets daily"),
  weekly: say("resets.weekly", "resets weekly"), manual: say("resets.manual", "reset by hand"),
};

const REASONS: [string, string][] = [
  ["abuse", say("reason.abuse", "Aimed at a person")],
  ["hate", say("reason.hate", "Aimed at a group")],
  ["sexual", say("reason.sexual", "Sexual, or involving a minor")],
  ["spam", say("reason.spam", "Spam or advertising")],
  ["self-harm", say("reason.self-harm", "Somebody who may need help")],
  ["not-a-reading", say("reason.not-a-guide", "Not a guide at all")],
  ["other", say("reason.other", "Something else")],
];
const actions = !preview;
---

<div class="rd" data-reader data-suggest-words={JSON.stringify({ fork: say("fork.refused", "This guide's licence does not allow forks."), suggest: say("suggest.refused", "That did not start. Try again."), failed: say("suggest.failed", "That did not go through. Try again.") })}>
  <aside class="rd-rail">
    <div class="rd-rail-block">
      <span class="rd-eyebrow">{say("rail.path", "The path")}</span>
      <nav class="rd-index" aria-label={say("rail.path", "The path")}>
        {pathPhases.map((p) => <a href={`#phase-${p.id}`}>{p.name}</a>)}
        {(tracks.length > 0 || routines.length > 0 || groups.length > 0) && <span class="rd-index-rule"></span>}
        {tracks.map((t) => <a href={`#track-${t.id}`}>{t.name}</a>)}
        {routines.length > 0 && <a href="#routines">{say("rail.routines", "Routines")} · {routines.length}</a>}
        {(groups.length > 0 || notes.length > 0) && <a href="#codex">{say("rail.codex", "Codex")} · {(doc.codex ?? []).length}</a>}
      </nav>
    </div>

    {actions && signedIn && !guide.mine && (
      <div class="rd-rail-block rd-suggest">
        <button type="button" class="rd-btn-quiet" data-suggest={guide.id}>{say("suggest", "Suggest a change")}</button>
        {guide.forkable && <button type="button" class="rd-btn-quiet" data-fork={guide.id}>{say("fork", "Fork this guide")}</button>}
        <p class="rd-quiet" data-suggest-note hidden></p>
      </div>
    )}
    {actions && trackHref && (
      <div class="gd-console rd-track">
        <span class="gd-corner" data-at="tl" aria-hidden="true"></span><span class="gd-corner" data-at="tr" aria-hidden="true"></span><span class="gd-corner" data-at="bl" aria-hidden="true"></span><span class="gd-corner" data-at="br" aria-hidden="true"></span>
        <div class="rd-track-head">
          <Sigil n={Math.max(1, pathPhases.length)} done={0} now={-1} size={44} ring showCount={false} aria={say("track.ring", "An empty ring, one arc per phase")} />
          <div class="rd-track-text"><span class="rd-track-title">{say("track.title", "Track this path")}</span><span class="gd-note gd-soft">{say("track.arcs", "{n} arcs · yours fill as you go").replace("{n}", String(pathPhases.length))}</span></div>
        </div>
        <Button variant="secondary" href={signedIn ? trackHref : `/signin?next=${encodeURIComponent(trackHref)}`}>{signedIn ? say("track", "Track this") : say("track.signin", "Sign in to track this")}</Button>
        <p class="gd-hint">{say("track.note", "Reading needs no account. Tracking keeps your step, your Later list and your note — on the phone, here, and on stream.")}</p>
      </div>
    )}

    <div class="rd-rail-block rd-facts">
      <div class="rd-fact">
        <span class="rd-fact-key">{say("rail.votes", "Votes")}</span>
        <span class="rd-votes"><span class="rd-glyph" aria-hidden="true">●</span><span data-votes>{guide.votes}</span></span>
      </div>
      {(doc.guide.authors ?? []).length > 0 && (
        <div class="rd-fact">
          <span class="rd-fact-key">{say("rail.by", "By")}</span>
          <span class="rd-mono soft">{(doc.guide.authors ?? []).join(", ")}</span>
        </div>
      )}
      {guide.contributor && (
        <div class="rd-fact">
          <span class="rd-fact-key">{say("rail.with", "With")}</span>
          <span class="rd-mono soft">{guide.contributor}</span>
        </div>
      )}
      {guide.forkedFrom && (
        <div class="rd-fact">
          <span class="rd-fact-key">{say("rail.forked", "Forked from")}</span>
          <a class="rd-mono soft" href={`/guides/${guide.forkedFrom.game}/${guide.forkedFrom.slug}`}>{guide.forkedFrom.title}</a>
        </div>
      )}
      <div class="rd-fact">
        <span class="rd-fact-key">{say("rail.licence", "Licence")}</span>
        <span class="rd-mono soft">{licence || say("licence.unsaid", "not stated")}</span>
      </div>
      {guide.number && (
        <div class="rd-fact">
          <span class="rd-fact-key">{say("rail.version", "Version")}</span>
          <span class="rd-mono soft">v{guide.number}{guide.publishedAt && ` · ${new Date(guide.publishedAt).toLocaleDateString("en-GB", { day: "numeric", month: "short", year: "numeric", timeZone: "UTC" })}`}</span>
        </div>
      )}
      {guide.publishedAt && (
        <div class="rd-fact">
          <span class="rd-fact-key">{say("rail.read_by", "Read before publishing by")}</span>
          <span class="rd-fact-val">{say("rail.read_by_who", "Shruti")}</span>
        </div>
      )}
      {actions && signedIn && !guide.mine && (
        <button type="button" class="rd-vote" data-vote={guide.id} aria-pressed={guide.voted}>
          {guide.voted ? say("vote.done", "Useful ✓") : say("vote", "Useful")}
        </button>
      )}
      {actions && (
        <div class="rd-rail-links">
          {signedIn && !guide.mine && (
            <details class="rd-report">
              <summary>{say("report", "Report")}</summary>
              <form data-report={guide.id}>
                <fieldset>
                  <legend>{say("report.why", "What is wrong with it?")}</legend>
                  {REASONS.map(([value, label], i) => (
                    <label><input type="radio" name="reason" value={value} checked={i === 0} /> {label}</label>
                  ))}
                </fieldset>
                <label class="rd-detail">
                  {say("report.detail", "Anything else she should know (optional)")}
                  <textarea name="detail" rows="2" maxlength="1000"></textarea>
                </label>
                <button type="submit">{say("report.send", "Send the report")}</button>
                <p class="rd-note">
                  {say("report.note", "It goes to Shruti. If a few people report the same thing it comes off the catalogue until she has looked.")}
                </p>
              </form>
            </details>
          )}
          {signedIn && !guide.mine && guide.authorId && (
            <button type="button" class="rd-block" data-block={guide.authorId} data-who={guide.author}>
              {say("block", "Block author")}
            </button>
          )}
          {guide.mine && !guide.hidden && guide.publishedAt && (
            <button type="button" class="rd-block" data-withdraw={guide.id}>{say("withdraw", "Take mine down")}</button>
          )}
          <a class="rd-download" href={`/api/guides/by-id/${guide.id}/download`} download>{say("download", "Download")}</a>
        </div>
      )}
      {actions && !signedIn && (
        <p class="rd-quiet">
          <a href="/signin">{say("signin", "Sign in")}</a>
          {" "}
          {say("signin.rest", "to say it was useful, or to report it. Reading needs no account, and never will.")}
        </p>
      )}
    </div>
  </aside>

  <article class="rd-column">
    {pathPhases.length > 0 && !preview && (
      <div class="rd-placebar" data-placebar>
        <span class="gd-mono gd-soft"><span data-place-id>{pathPhases[0].id}</span> · <span data-place-name>{pathPhases[0].name}</span> · <span class="rd-place-count" data-place-count>{say("place.count", "{i} of {n}").replace("{i}", "1").replace("{n}", String(pathPhases.length))}</span></span>
        <details class="rd-contents">
          <summary>{say("contents", "Contents")} <span aria-hidden="true">▾</span></summary>
          <ol>
            {pathPhases.map((p) => (
              <li><span class="gd-note">{p.id}</span><a href={`#phase-${p.id}`}>{p.name}</a><span class="gd-note">{stepsOf(doc, p).length}</span></li>
            ))}
          </ol>
        </details>
      </div>
    )}
    {preview && (
      <p class="rd-preview" role="status">{say("preview", "This is how your draft reads. Nobody else can see it yet.")}</p>
    )}
    <header class="rd-head">
      <span class="rd-eyebrow">
        {doc.game.name}
        {doc.guide.game_patch && <> · {say("head.patch", "written for patch")} {doc.guide.game_patch}</>}
        {tracks.length > 0 && <> {say("head.and", "and")} {tracks.map((t) => t.name).join(", ")}</>}
      </span>
      <h1 class="rd-title">{guide.title}</h1>
      {doc.guide.summary && <p class="rd-summary">{doc.guide.summary}</p>}
      <div class="rd-chips">
        <span class="rd-chip">{guide.author}</span>
        <span class="rd-chip">{pathPhases.length} {say("chips.phases", "phases")} · {stepCount} {say("chips.steps", "steps")}</span>
        {hours > 0 && <span class="rd-chip">{say("chips.about", "about")} {hours} {say("chips.hours", "hours")}</span>}
      </div>
    </header>

    {caveats.length > 0 && (
      <aside class="rd-caveats">
        <span class="rd-eyebrow rose">{say("caveats", "Not confirmed yet")}</span>
        <ul>{caveats.map((c) => <li>{c}</li>)}</ul>
      </aside>
    )}

    <span class="rd-horizon" aria-hidden="true"></span>

    {phases.map((p, i) => (
      <section class="rd-phase" id={`phase-${p.id}`}>
        <div class="rd-phase-head">
          <span class="rd-eyebrow">
            {p.track ? trackName(p.track) : <>{say("phase", "Phase")} {pathPhases.indexOf(p) + 1}</>}
            {p.band && <> · {p.band}</>}
          </span>
          <h2 class="rd-phase-name">{p.name}</h2>
        </div>
        <ol class="rd-steps">
          {stepsOf(doc, p).map((s: Step) => {
            const entry = s.codex ? codexOf(s.codex) : undefined;
            const gate = opens(s.gate);
            const only = variantNames(s.applies_to, doc);
            return (
              <li class="rd-step" id={`step-${s.id}`}>
                <span class="rd-id">{s.id}</span>
                <div class="rd-step-body">
                  <h3 class="rd-step-title">{s.title}</h3>
                  {s.do && <p class="rd-do">{s.do}</p>}
                  {s.done_when && <p class="rd-line"><b>{say("step.done", "Done when")} · </b>{s.done_when}</p>}
                  {s.why && <p class="rd-line"><b>{say("step.why", "Why")} · </b>{s.why}</p>}
                  {(s.links ?? []).length > 0 && (
                    <div class="rd-links">
                      {s.links!.map((l) => safeUrl(l.url)
                        ? <a class="rd-pill" href={safeUrl(l.url)} rel="nofollow noopener" target="_blank" data-video={isVideo(l) || undefined}>
                            {isVideo(l) ? <span class="rd-play" aria-hidden="true"><span></span></span> : <span class="rd-mono faint" aria-hidden="true">↗</span>}
                            <span>{linkLabel(l)}</span>
                          </a>
                        : <span class="rd-pill"><span>{linkLabel(l)}</span></span>)}
                    </div>
                  )}
                  {entry && (
                    <div class="rd-codex">
                      <span class="rd-eyebrow rose">{say("step.codex", "Opens a codex entry")}</span>
                      <a href={`#codex-${entry.id}`}>{entry.name}{entry.what && <> — {entry.what}</>}</a>
                    </div>
                  )}
                  {(gate.length > 0 || s.kind === "optional" || s.ongoing || only.length > 0) && (
                    <p class="rd-gate">
                      {s.kind === "optional" && <span>{say("step.optional", "optional")}</span>}
                      {s.ongoing && <span>{say("step.ongoing", "ongoing")}</span>}
                      {only.length > 0 && <span>{only.join(", ")} {say("step.only", "only")}</span>}
                      {gate.length > 0 && <span>{say("step.opens", "opens")} {gate.join(", ")}</span>}
                    </p>
                  )}
                </div>
              </li>
            );
          })}
        </ol>
      </section>
    ))}

    {tracks.map((t) => (
      <section class="rd-phase rd-track" id={`track-${t.id}`}>
        <div class="rd-phase-head">
          <span class="rd-eyebrow">{say("track", "Track")}{variantNames(t.applies_to, doc).length > 0 && <> · {variantNames(t.applies_to, doc).join(", ")} {say("step.only", "only")}</>}</span>
          <h2 class="rd-phase-name">{t.name}</h2>
        </div>
        {(t.day_one ?? []).length > 0 && <p class="rd-line"><b>{say("track.dayone", "On day one")} · </b>{t.day_one!.join(", ")}</p>}
        {(t.ranks ?? []).length > 0 && (
          <ol class="rd-ranks">
            {t.ranks!.map((r) => (
              <li><b>{say("track.rank", "Rank")} {r.n} · </b>{r.capstone}{r.when && <span class="rd-mono faint"> — {r.when}</span>}</li>
            ))}
          </ol>
        )}
        {(t.counters ?? []).map((c) => (
          <p class="rd-line"><b>{c.label}</b>{c.max !== undefined && <> · {say("track.cap", "cap")} {c.max}</>}{c.nudge && <> — {c.nudge}</>}</p>
        ))}
        {(t.sections ?? []).map((sec) => (
          <div class="rd-tsec"><h3 class="rd-step-title">{sec.title}</h3><p class="rd-do pre">{sec.body}</p></div>
        ))}
      </section>
    ))}

    {routines.length > 0 && (
      <section class="rd-phase" id="routines">
        <div class="rd-phase-head">
          <span class="rd-eyebrow">{say("routines.eyebrow", "Checklists that reset")}</span>
          <h2 class="rd-phase-name">{say("routines", "Routines")}</h2>
        </div>
        {routines.map((r) => (
          <div class="rd-routine">
            <h3 class="rd-step-title">{r.name} <span class="rd-mono faint">· {RESETS[r.resets] ?? r.resets}</span></h3>
            <ul>{r.items.map((i) => <li>{i.text}</li>)}</ul>
            {opens(r.gate).length > 0 && <p class="rd-gate"><span>{say("step.opens", "opens")} {opens(r.gate).join(", ")}</span></p>}
          </div>
        ))}
      </section>
    )}

    {(groups.length > 0 || notes.length > 0) && (
      <section class="rd-phase" id="codex">
        <div class="rd-phase-head">
          <span class="rd-eyebrow">{say("codex.eyebrow", "The systems the path leans on")}</span>
          <h2 class="rd-phase-name">{say("codex", "Codex")}</h2>
        </div>
        {notes.map((n) => (
          <div class="rd-notes">
            <span class="rd-eyebrow rose">{n.title}</span>
            <ul>{n.items.map((i) => <li>{i}</li>)}</ul>
          </div>
        ))}
        {groups.map(([group, entries]) => (
          <div class="rd-group">
            {group && <h3 class="rd-group-name">{titled(group)}</h3>}
            {entries.map((c) => (
              <div class="rd-entry" id={`codex-${c.id}`}>
                <h4 class="rd-step-title">{c.name}{c.ignore_until && <span class="rd-mono faint"> · {say("codex.ignore", "ignore until")} {c.ignore_until}</span>}</h4>
                {c.what && <p class="rd-line"><b>{say("codex.what", "What")} · </b>{c.what}</p>}
                {c.when && <p class="rd-line"><b>{say("codex.when", "When")} · </b>{c.when}</p>}
                {c.how && <p class="rd-line"><b>{say("codex.how", "How")} · </b>{c.how}</p>}
                {(c.caveats ?? []).length > 0 && <ul class="rd-cav">{c.caveats!.map((x) => <li>{x}</li>)}</ul>}
                {(c.links ?? []).length > 0 && (
                  <div class="rd-links">
                    {c.links!.map((l) => safeUrl(l.url)
                      ? <a class="rd-pill" href={safeUrl(l.url)} rel="nofollow noopener" target="_blank">{isVideo(l) ? <span class="rd-play" aria-hidden="true"><span></span></span> : <span class="rd-mono faint" aria-hidden="true">↗</span>}<span>{linkLabel(l)}</span></a>
                      : <span class="rd-pill"><span>{linkLabel(l)}</span></span>)}
                  </div>
                )}
                {opens(c.show_when).length > 0 && <p class="rd-gate"><span>{say("codex.appears", "appears")} {opens(c.show_when).join(", ")}</span></p>}
              </div>
            ))}
          </div>
        ))}
      </section>
    )}
    {actions && trackHref && (
      <div class="rd-card">
        <div class="rd-card-words">
          <span class="rd-card-title">{say("card.title", "Reading is enough. Tracking is better.")}</span>
          <span class="rd-card-body">{say("card.body", "Sign in and this page remembers which step you are on, on every device.")}</span>
        </div>
        <a class="rd-btn lg" href={signedIn ? trackHref : `/signin?next=${encodeURIComponent(trackHref)}`}>
          {signedIn ? say("card.track", "Track this") : say("card.signin", "Sign in")}
        </a>
      </div>
    )}
  </article>
</div>

<style>
  .rd { display: grid; grid-template-columns: 264px minmax(0, 1fr); font-family: var(--font-body); color: var(--ink); }
  .rd-rail { border-right: var(--border-w) solid var(--line); padding: var(--space-6) var(--space-5); display: flex; flex-direction: column; gap: 22px; background: var(--surface-card); align-self: start; position: sticky; top: 0; max-height: 100vh; overflow-y: auto; }
  .rd-rail-block { display: flex; flex-direction: column; gap: 8px; }
  .rd-facts { border-top: var(--border-w) solid var(--line); padding-top: 18px; }
  .rd-track { padding: 16px; gap: 12px; }
  .rd-track-head { display: flex; align-items: center; gap: 12px; }
  .rd-track-text { display: grid; gap: 2px; }
  .rd-track-title { font-size: 14px; font-weight: 600; }
  .rd-fact-key { font-size: 14px; color: var(--ink-soft); }
  .rd-fact-val { font-size: 14px; }
  .rd-placebar { display: none; position: sticky; top: 0; z-index: 2; background: var(--surface-page); border-bottom: var(--border-w) solid var(--line); margin: 0 calc(-1 * var(--page-pad)); padding: 10px var(--page-pad); align-items: center; justify-content: space-between; gap: 12px; }
  .rd-place-count { color: var(--ink); }
  .rd-contents { position: relative; }
  .rd-contents summary { list-style: none; cursor: pointer; font-size: 14px; font-weight: 500; color: var(--accent); }
  .rd-contents summary::-webkit-details-marker { display: none; }
  .rd-contents ol { position: absolute; right: 0; top: 28px; min-width: 260px; margin: 0; padding: 8px 12px; list-style: none; background: var(--surface-card); border: var(--border-w) solid var(--line); border-radius: 10px; box-shadow: var(--shadow-3); display: grid; z-index: 3; }
  .rd-contents li { display: flex; gap: 8px; align-items: baseline; padding: 8px 0; border-bottom: var(--border-w) solid var(--line); font-size: 14px; }
  .rd-contents li a { color: var(--ink); text-decoration: none; flex: 1; }
  .rd-suggest { display: flex; flex-direction: column; gap: 8px; align-items: flex-start; }
  .rd-btn-quiet { font: 500 var(--text-sm) var(--font-body); padding: 0; border: 0; background: none; color: var(--accent); text-decoration: underline; cursor: pointer; }
  .rd-quiet { margin: 0; font-size: var(--text-sm); color: var(--ink-soft); }
  .rd-btn { display: inline-flex; align-items: center; justify-content: center; font: 600 var(--text-sm) var(--font-body); padding: 10px 16px; border-radius: var(--radius-sm); background: var(--accent); color: var(--on-accent); text-decoration: none; }
  .rd-btn:hover { background: var(--accent-hover); }
  .rd-btn.lg { padding: 13px 22px; font-size: 15px; flex: none; }
  .rd-card { max-width: 66ch; border: var(--border-w) solid var(--line); border-radius: var(--radius-md); background: var(--surface-card); box-shadow: var(--shadow-1); padding: 22px 24px; display: flex; align-items: center; justify-content: space-between; gap: 24px; flex-wrap: wrap; }

  .rd-index a:hover { color: var(--ink); }
  .rd-index-rule { border-top: var(--border-w) solid var(--line); margin: 8px 0 4px; }
  .rd-fact { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; padding-bottom: 8px; border-bottom: var(--border-w) solid var(--line); }
  .rd-mono { font-family: var(--font-mono); font-size: var(--text-xs); color: var(--ink-faint); }
  .rd-mono.soft { color: var(--ink-soft); }
  .rd-mono.faint { color: var(--ink-faint); }
  .rd-votes { display: inline-flex; align-items: center; gap: 6px; font-family: var(--font-mono); font-size: 12.5px; color: var(--rose); font-variant-numeric: tabular-nums; }
  .rd-glyph { font-family: var(--font-display); font-size: 13px; }
  .rd-vote { margin-top: 4px; font: 500 var(--text-sm) var(--font-body); padding: 7px 14px; border-radius: var(--radius-full); border: var(--border-w) solid var(--line-strong); background: var(--surface-card); color: var(--ink); cursor: pointer; align-self: start; }
  .rd-vote[aria-pressed="true"] { border-color: var(--accent); color: var(--accent); background: var(--accent-wash); }
  .rd-rail-links { display: flex; flex-wrap: wrap; gap: 14px; padding-top: 6px; align-items: baseline; }
  .rd-block, .rd-report > summary, .rd-download { font-family: var(--font-mono); font-size: var(--text-xs); color: var(--ink-faint); background: none; border: 0; padding: 0; cursor: pointer; text-decoration: none; }
  .rd-block:hover, .rd-report > summary:hover, .rd-download:hover { color: var(--ink); }
  .rd-report { flex-basis: 100%; order: 9; }
  .rd-report form { display: grid; gap: 10px; margin-top: 10px; }
  .rd-report fieldset { border: 0; margin: 0; padding: 0; display: grid; gap: 6px; }
  .rd-report legend { font: 600 var(--text-xs) var(--font-body); color: var(--ink-soft); padding: 0 0 6px; }
  .rd-report label { display: flex; gap: 8px; align-items: center; font: 400 var(--text-sm) var(--font-body); color: var(--ink-soft); }
  .rd-report button[type="submit"] { font: 500 var(--text-sm) var(--font-body); padding: 7px 14px; border-radius: var(--radius-full); border: var(--border-w) solid var(--line-strong); background: var(--surface-card); color: var(--ink); cursor: pointer; justify-self: start; }
  .rd-detail { display: grid !important; gap: 4px; }
  .rd-detail textarea { font: inherit; padding: 8px; border: var(--border-w) solid var(--line); border-radius: var(--radius-sm); background: var(--surface-page); color: var(--ink); }
  .rd-note, .rd-quiet { margin: 0; font-size: var(--text-xs); color: var(--ink-faint); line-height: var(--leading-body); }
  .rd-quiet { font-size: 12.5px; }

  .rd-column { padding: 44px 56px 56px; display: flex; flex-direction: column; gap: 30px; min-width: 0; }
  .rd-preview { margin: 0; max-width: 66ch; padding: 10px 14px; border: var(--border-w) solid var(--line-strong); background: var(--surface-inset); border-radius: var(--radius-md); font-size: var(--text-sm); color: var(--ink-soft); }
  .rd-head { display: flex; flex-direction: column; gap: 14px; max-width: 66ch; }
  .rd-title { margin: 0; font-family: var(--font-display); font-size: 40px; line-height: 1.1; font-weight: 500; color: var(--ink); text-wrap: pretty; }
  .rd-summary { margin: 0; font-family: var(--font-display); font-size: var(--text-prose); line-height: var(--leading-prose); color: var(--ink); }
  .rd-chips { display: flex; gap: 10px; flex-wrap: wrap; padding-top: 4px; }
  .rd-chip { font-family: var(--font-mono); font-size: var(--text-micro); color: var(--ink-soft); border: var(--border-w) solid var(--line); border-radius: var(--radius-full); padding: 5px 12px; }
  .rd-caveats { max-width: 66ch; border-left: 2px solid var(--rose); padding: 4px 0 4px 16px; display: flex; flex-direction: column; gap: 6px; }
  .rd-caveats ul { margin: 0; padding-left: 1.1em; font-size: var(--text-sm); color: var(--ink-soft); display: grid; gap: 4px; }
  .rd-horizon { display: block; height: 1px; background: var(--horizon-line); max-width: 66ch; }
  .rd-phase { display: flex; flex-direction: column; gap: 28px; max-width: 66ch; }
  .rd-phase-head { display: flex; flex-direction: column; gap: 6px; }
  .rd-phase-name { margin: 0; font-family: var(--font-display); font-size: 30px; line-height: 1.15; font-weight: 600; color: var(--ink); }
  .rd-steps { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 28px; }
  .rd-step { display: flex; gap: 20px; }
  .rd-id { flex: none; font-family: var(--font-mono); font-size: 12.5px; color: var(--ink-faint); width: 44px; padding-top: 6px; }
  .rd-step-body { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 8px; }
  .rd-step-title { margin: 0; font-family: var(--font-display); font-size: 22px; line-height: 1.2; font-weight: 600; color: var(--ink); }
  .rd-do { margin: 0; font-family: var(--font-display); font-size: 18px; line-height: 1.72; color: var(--ink); }
  .rd-do.pre { white-space: pre-line; }
  .rd-line { margin: 0; font-size: 14.5px; line-height: 1.65; color: var(--ink-soft); white-space: pre-line; }
  .rd-line b { color: var(--ink); font-weight: 600; }
  .rd-links { display: flex; flex-wrap: wrap; gap: 10px; padding-top: 4px; }
  .rd-pill { display: inline-flex; align-items: center; gap: 8px; border: var(--border-w) solid var(--line); border-radius: var(--radius-full); padding: 6px 14px; font-size: 13.5px; color: var(--accent); text-decoration: none; }
  .rd-pill[data-video] { padding-left: 7px; }
  .rd-play { display: inline-flex; align-items: center; justify-content: center; width: 20px; height: 20px; border-radius: var(--radius-full); background: var(--accent-wash); flex: none; }
  .rd-play span { display: block; width: 0; height: 0; border-left: 7px solid var(--accent); border-top: 5px solid transparent; border-bottom: 5px solid transparent; margin-left: 2px; }
  .rd-codex { margin-top: 6px; border-left: 2px solid var(--rose); padding: 4px 0 4px 16px; display: flex; flex-direction: column; gap: 4px; }
  .rd-codex a { font-family: var(--font-display); font-size: 17px; color: var(--ink); text-decoration: none; }
  .rd-codex a:hover { text-decoration: underline; }
  .rd-gate { margin: 0; display: flex; flex-wrap: wrap; gap: 12px; font-family: var(--font-mono); font-size: 13.5px; line-height: 1.6; color: var(--ink-faint); }
  .rd-ranks { margin: 0; padding-left: 1.2em; display: grid; gap: 6px; font-size: 14.5px; line-height: 1.65; color: var(--ink-soft); }
  .rd-ranks b { color: var(--ink); font-weight: 600; }
  .rd-tsec, .rd-routine, .rd-entry, .rd-notes { display: flex; flex-direction: column; gap: 8px; }
  .rd-routine ul, .rd-notes ul, .rd-cav { margin: 0; padding-left: 1.2em; display: grid; gap: 4px; font-size: 14.5px; line-height: 1.65; color: var(--ink-soft); }
  .rd-group { display: flex; flex-direction: column; gap: 22px; }
  .rd-group-name { margin: 0; font-family: var(--font-display); font-size: var(--text-h4); font-weight: 600; color: var(--ink-soft); }
  @media (max-width: 860px) {
    .rd { grid-template-columns: 1fr; }
    .rd-placebar { display: flex; }
    .rd-rail { position: static; max-height: none; border-right: 0; border-bottom: var(--border-w) solid var(--line); }
    .rd-column { padding: var(--space-6) var(--page-pad) var(--space-8); }
  }
</style>

<script>
  /* The phone's place bar names the phase in view — one observer, nothing else. */
  const bar = document.querySelector<HTMLElement>("[data-placebar]");
  if (bar && "IntersectionObserver" in window) {
    const phases = Array.from(document.querySelectorAll<HTMLElement>(".rd-phase[id^='phase-']"));
    const idEl = bar.querySelector<HTMLElement>("[data-place-id]"), nameEl = bar.querySelector<HTMLElement>("[data-place-name]"), countEl = bar.querySelector<HTMLElement>("[data-place-count]");
    const countWords = countEl?.textContent ?? "";
    const seen = new Map<Element, number>();
    const show = () => {
      let best: HTMLElement | null = null, bestTop = Infinity;
      for (const p of phases) { const r = p.getBoundingClientRect(); if (r.bottom > 60 && r.top < bestTop) { bestTop = r.top; best = p; } }
      if (!best) return;
      const i = phases.indexOf(best);
      if (idEl) idEl.textContent = best.id.replace("phase-", "");
      if (nameEl) nameEl.textContent = best.querySelector(".rd-phase-name")?.textContent ?? "";
      if (countEl) countEl.textContent = countWords.replace(/^\S+/, String(i + 1));
    };
    const io = new IntersectionObserver((entries) => { for (const e of entries) seen.set(e.target, e.intersectionRatio); show(); }, { rootMargin: "-56px 0px -60% 0px", threshold: [0, 0.1, 0.5] });
    phases.forEach((p) => io.observe(p));
    bar.querySelector(".rd-contents")?.addEventListener("click", (e) => { if ((e.target as HTMLElement).tagName === "A") (bar.querySelector(".rd-contents") as HTMLDetailsElement).open = false; });
  }
  const root = document.querySelector<HTMLElement>("[data-reader]");
  if (root) {
    const token = () =>
      document.cookie.split("; ").find((c) => c.startsWith("shruti_csrf="))?.split("=")[1] ?? "";
    const post = (path: string, body?: unknown) =>
      fetch(path, {
        method: "POST",
        headers: { "content-type": "application/json", "x-csrf-token": token() },
        body: body === undefined ? undefined : JSON.stringify(body),
      });

    const vote = root.querySelector<HTMLButtonElement>("[data-vote]");
    vote?.addEventListener("click", async () => {
      vote.disabled = true;
      const r = await post(`/api/guides/by-id/${vote.dataset.vote}/vote`);
      if (r.ok) {
        const answer = await r.json();
        vote.setAttribute("aria-pressed", String(answer.voted));
        vote.textContent = answer.voted ? "Useful ✓" : "Useful";
        const count = root.querySelector("[data-votes]");
        if (count) count.textContent = String(answer.votes);
      }
      vote.disabled = false;
    });

    const suggestNote = root.querySelector<HTMLElement>("[data-suggest-note]");
    const suggestWords = JSON.parse(root.dataset.suggestWords || "{}");
    const startCopy = async (btn: HTMLButtonElement, action: string) => {
      btn.disabled = true;
      const r = await post(`/api/guides/by-id/${btn.dataset[action]}/${action === "fork" ? "fork" : "contribute"}`);
      if (r.ok) { const a = await r.json(); location.href = `/guides/write/${a.versionId}`; return; }
      btn.disabled = false;
      if (suggestNote) { suggestNote.textContent = r.status === 409 ? suggestWords[action] : suggestWords.failed; suggestNote.hidden = false; }
    };
    root.querySelector<HTMLButtonElement>("[data-suggest]")?.addEventListener("click", (e) => startCopy(e.currentTarget as HTMLButtonElement, "suggest"));
    root.querySelector<HTMLButtonElement>("[data-fork]")?.addEventListener("click", (e) => startCopy(e.currentTarget as HTMLButtonElement, "fork"));

    const block = root.querySelector<HTMLButtonElement>("[data-block]");
    block?.addEventListener("click", async () => {
      const who = block.dataset.who ?? "this person";
      if (!confirm(
        `Block ${who}?\n\nTheir guides go from your lists and they can no longer ` +
        `comment on your work. They are not told. You can undo it on your account page.`
      )) return;
      block.disabled = true;
      const r = await post("/api/practice/blocks", { user_id: Number(block.dataset.block) });
      if (r.ok) location.href = "/guides";
      else { block.disabled = false; block.textContent = "That did not work — try again"; }
    });

    const report = root.querySelector<HTMLFormElement>("[data-report]");
    report?.addEventListener("submit", async (event) => {
      event.preventDefault();
      const data = new FormData(report);
      const r = await post(`/api/guides/by-id/${report.dataset.report}/report`, {
        reason: String(data.get("reason") ?? "other"),
        detail: String(data.get("detail") ?? ""),
      });
      /* The same words whether it was the first report or the fourth. */
      report.innerHTML = '<p class="rd-note">Thank you — it has gone to Shruti.</p>';
      if (!r.ok) report.innerHTML = '<p class="rd-note">That did not send. Nothing was lost — try again.</p>';
    });

    const withdraw = root.querySelector<HTMLButtonElement>("[data-withdraw]");
    withdraw?.addEventListener("click", async () => {
      if (!confirm("Take this down? Nobody but you will see it.")) return;
      const r = await post(`/api/guides/by-id/${withdraw.dataset.withdraw}/withdraw`);
      if (r.ok) location.reload();
    });
  }
</script>

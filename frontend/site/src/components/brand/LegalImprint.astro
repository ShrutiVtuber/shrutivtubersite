---
import { copy } from "../../lib/copy";

/* Every word here, editable from the admin. The defaults below are what
   it was written with and what still renders if nothing was changed. */
const say = await copy("component:LegalImprint");

/* Footer imprint. Ported from `components/brand/LegalImprint.jsx`; contract in
 * `LegalImprint.d.ts`.
 *
 * ONE DEPARTURE FROM THE HANDOFF, decided with the owner. The design ships
 * bracketed placeholders — `GEMI [000000000000]`, `VAT EL[000000000]` — which
 * is the right convention for a mock-up and the wrong thing to publish. A
 * registry number that looks like a registry number and is not one is worse
 * than no imprint at all: it reads as a claim rather than as a gap.
 *
 * So the imprint is now stored, editable from the admin, and HIDDEN until it
 * is both filled in and switched on. The reason the design wanted it from day
 * one still holds and is not lost — pseudonymity is off, and a virtual office
 * on the page is what stops a home address reaching a WHOIS record or a
 * takedown notice. It goes up the day the company exists, from the admin,
 * without a deploy.
 *
 * Values passed as props still render, so the component is unchanged for any
 * caller that has them.
 */
interface Props {
  entity?: string;
  street?: string;
  postcode?: string;
  city?: string;
  country?: string;
  email?: string;
  registry?: string;
  vat?: string;
  layout?: "stacked" | "inline";
}
const {
  entity = "", street = "", postcode = "", city = "", country = "",
  email = "", registry = "", vat = "", layout = "stacked",
} = Astro.props;
const inline = layout === "inline";

/* Nothing invented and nothing bracketed: without an entity and an address to
   write to, there is no imprint to show. */
const show = Boolean(entity && email);
const officeLine = [street, [postcode, city].filter(Boolean).join(" "), country]
  .filter(Boolean).join(" · ");
const registryLine = [registry, vat].filter(Boolean).join(" · ");
---

{
  show && (
    <div>
      <p class="t-eyebrow" style="margin:0 0 8px">{say("text.1", "Imprint")}</p>
      <p class="imprint" data-layout={layout}>
        {entity}{inline ? " · " : <br />}
        {officeLine && <Fragment>Registered office (virtual): {officeLine}{inline ? " · " : <br />}</Fragment>}
        <a href={`mailto:${email}`}>{email}</a>
        {registryLine && <Fragment>{inline ? " · " : <br />}{registryLine}</Fragment>}
      </p>
    </div>
  )
}

<style>
  .imprint {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 400;
    color: var(--ink-faint);
  }
  .imprint[data-layout="stacked"] { line-height: 1.9; max-width: 40ch; }
  .imprint[data-layout="inline"] { line-height: 1.7; max-width: 68ch; }
  .imprint a { color: var(--accent); text-decoration: none; }
  .imprint a:hover { color: var(--accent-hover); text-decoration: underline; }
</style>

---
/* The monthly letter, asked for once.
 *
 * **It is not shown on arrival, and that is not squeamishness.** Google treats
 * an interstitial that covers the content on load as a mobile ranking negative,
 * so a popup that fires immediately costs search traffic to buy attention from
 * people who have not yet seen anything worth subscribing to. This waits until
 * somebody has stayed a while or read some way down — by which point the offer
 * is a reply to something they were already doing.
 *
 * **Asked once, then never again for ninety days.** The dismissal is remembered
 * in the browser, as is a submission, so the person who says no is not asked
 * again on the next page and the person who says yes is never asked at all.
 *
 * **The consent wording is the same sentence the holding page uses**, and the
 * button click is the affirmative act — no pre-ticked box anywhere, because a
 * pre-ticked box is not consent. This deliberately matches what is already live
 * rather than inventing a second posture for a lawyer to review.
 *
 * With scripting off, nothing here appears at all. That is correct: the inline
 * form is on the page underneath, and it is the real one.
 *
 * Every custom property below carries a fallback. The holding page is not built
 * on the site's stylesheet — it ships its own small token set and defines
 * neither `--shadow-3` nor `--focus-ring` nor the line-heights — and a bare
 * `var()` with no fallback resolves to nothing at all rather than to something
 * sensible. That would have quietly removed the focus ring from a form, on the
 * one page the campaign points at.
 */
import { CSRF_FIELD } from "../../lib/csrf";
import { copy } from "../../lib/copy";

const say = await copy("component:NewsletterPopup");

interface Props {
  /** Seconds on the page before it may appear. */
  afterSeconds?: number;
  /** Fraction of the page read before it may appear. */
  afterScroll?: number;
  /** Suppress entirely — e.g. the page is already showing a "sent" state. */
  suppress?: boolean;
}
const { afterSeconds = 20, afterScroll = 0.4, suppress = false } = Astro.props;
---

{
  !suppress && (
    <dialog
      class="np"
      data-newsletter-popup
      data-after-seconds={String(afterSeconds)}
      data-after-scroll={String(afterScroll)}
      aria-labelledby="np-title"
    >
      <form method="POST" class="np-form">
        <input type="hidden" name={CSRF_FIELD} value={Astro.locals.csrf} />
        {/* The landing page routes POSTs by this; the holding page ignores it
            and reads the address. One form, correct on both. */}
        <input type="hidden" name="action" value="subscribe" />
        <input type="hidden" name="consent" value="1" />

        <button
          type="button"
          class="np-close"
          data-np-close
          aria-label={say("close", "Close")}
        >×</button>

        <p class="np-eyebrow">{say("eyebrow", "one letter a month")}</p>
        <h2 id="np-title" class="np-title">{say("title", "The monthly letter")}</h2>
        <p class="np-body">
          {say("body", "Your horoscope if you have a saved nativity, what shipped, what the sky is doing — and a letter, which is the part people actually subscribe for.")}
        </p>

        <label class="np-field">
          <span class="np-label">{say("label", "Email address")}</span>
          <input
            type="email"
            name="email"
            required
            placeholder="you@example.com"
            autocomplete="email"
            data-np-email
          />
        </label>

        <button type="submit" class="np-submit">{say("submit", "Send me the letter")}</button>

        <p class="np-consent">
          {say("consent", "You will get a confirmation email first and are not subscribed until you click it. Nothing is sent to an unconfirmed address. Leave in one click, any time.")}
        </p>
      </form>
    </dialog>
  )
}

<style>
  .np {
    border: var(--border-w) solid var(--line-strong);
    border-radius: var(--radius-md);
    background: var(--surface-card);
    color: var(--ink);
    box-shadow: var(--shadow-3, 0 8px 32px rgb(18 24 41 / 0.18));
    padding: 0;
    width: min(420px, calc(100vw - 32px));
    max-height: calc(100dvh - 32px);
  }
  .np::backdrop { background: rgb(0 0 0 / 0.45); }

  .np[open] { animation: np-in 180ms ease-out; }
  @keyframes np-in {
    from { opacity: 0; transform: translateY(8px); }
    to { opacity: 1; transform: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .np[open] { animation: none; }
  }

  .np-form {
    display: grid;
    gap: 12px;
    padding: clamp(20px, 4vw, 28px);
    position: relative;
  }

  .np-close {
    position: absolute;
    top: 8px;
    right: 8px;
    appearance: none;
    background: transparent;
    border: 0;
    border-radius: var(--radius-sm);
    color: var(--ink-faint);
    font-size: 22px;
    line-height: 1;
    width: 32px;
    height: 32px;
    cursor: pointer;
  }
  .np-close:hover { color: var(--ink); }
  .np-close:focus-visible { outline: 2px solid var(--focus-ring, var(--accent)); outline-offset: 1px; }

  .np-eyebrow {
    margin: 0;
    font: 600 var(--text-micro) var(--font-mono);
    letter-spacing: var(--tracking-eyebrow, .08em);
    text-transform: uppercase;
    color: var(--rose);
  }
  .np-title {
    margin: 0;
    font: 600 var(--text-h3) var(--font-display);
    line-height: var(--leading-heading, 1.2);
    text-wrap: balance;
  }
  .np-body {
    margin: 0;
    font: 400 var(--text-sm) / var(--leading-body, 1.6) var(--font-body);
    color: var(--ink-soft);
  }

  .np-field { display: grid; gap: 4px; }
  .np-label {
    font: 600 var(--text-micro) var(--font-body);
    letter-spacing: var(--tracking-eyebrow, .08em);
    text-transform: uppercase;
    color: var(--ink-faint);
  }
  .np-field input {
    font: 400 var(--text-sm) var(--font-body);
    color: var(--ink);
    background: var(--surface-page);
    border: var(--border-w) solid var(--line);
    border-radius: var(--radius-sm);
    padding: 10px 12px;
    min-height: 44px;
    width: 100%;
  }
  .np-field input:focus-visible {
    outline: 2px solid var(--focus-ring, var(--accent));
    outline-offset: 1px;
    border-color: var(--accent);
  }

  .np-submit {
    appearance: none;
    cursor: pointer;
    min-height: 44px;
    padding: 10px 18px;
    border-radius: var(--radius-sm);
    border: var(--border-w) solid var(--accent);
    background: var(--accent);
    color: var(--on-accent, #fff);
    font: 600 var(--text-sm) var(--font-body);
  }
  .np-submit:focus-visible { outline: 2px solid var(--focus-ring, var(--accent)); outline-offset: 2px; }

  .np-consent {
    margin: 0;
    font: 400 var(--text-xs) / 1.6 var(--font-body);
    color: var(--ink-faint);
  }
</style>

<script>
  /* Shown once, late, and never to somebody who already answered.
   *
   * Every read and write of storage is guarded: a private window, blocked site
   * data or an embedded context can make `localStorage` throw on ACCESS, not
   * merely return null — and an exception here would take the whole page's
   * scripting down with it, for a popup. */
  const KEY = "shruti.newsletter.asked";
  const DAYS = 90;

  function asked(): boolean {
    try {
      const until = Number(localStorage.getItem(KEY) ?? 0);
      return Number.isFinite(until) && until > Date.now();
    } catch {
      /* No storage means no memory of a dismissal. Better to stay quiet than
         to ask somebody on every single page view. */
      return true;
    }
  }

  function remember(days: number): void {
    try {
      localStorage.setItem(KEY, String(Date.now() + days * 864e5));
    } catch {
      /* Nothing to do. The popup is already closed. */
    }
  }

  const el = document.querySelector<HTMLDialogElement>("[data-newsletter-popup]");
  if (el && !asked() && typeof el.showModal === "function") {
    const seconds = Number(el.dataset.afterSeconds ?? 20);
    const fraction = Number(el.dataset.afterScroll ?? 0.4);
    let done = false;

    const open = () => {
      if (done || el.open) return;
      done = true;
      window.removeEventListener("scroll", onScroll);
      el.showModal();
      el.querySelector<HTMLInputElement>("[data-np-email]")?.focus();
    };

    const onScroll = () => {
      const height = document.documentElement.scrollHeight - window.innerHeight;
      if (height > 0 && window.scrollY / height >= fraction) open();
    };

    const timer = window.setTimeout(open, seconds * 1000);
    window.addEventListener("scroll", onScroll, { passive: true });

    /* Esc, the × and a click on the backdrop all mean the same thing, and all
       three are the person saying no. Remember it. */
    el.addEventListener("close", () => {
      window.clearTimeout(timer);
      remember(DAYS);
    });
    el.querySelector("[data-np-close]")?.addEventListener("click", () => el.close());
    el.addEventListener("click", (e) => {
      if (e.target === el) el.close();          // the backdrop, not the card
    });

    /* Submitting is a yes. Remember it for far longer than a dismissal, so a
       subscriber is never asked again — the page they land on next says
       "check your email", and a popup over that would be nonsense. */
    el.querySelector("form")?.addEventListener("submit", () => remember(3650));
  }
</script>

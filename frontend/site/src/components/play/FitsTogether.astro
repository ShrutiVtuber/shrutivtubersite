---
/* How it fits together (Play hub, README "Page structure"): the account
 * branching, by hairlines, to the three places it reaches; then two index
 * rows — the four state dots and the four themes.
 *
 * The visual pass of 26 Sep 2026 took the account out of its card: it is the
 * section's ring now — three arcs, one per place, all reached — with its
 * words beside it, and each place carries its drawn mark in the same ring the
 * rooms use. A 32px connector, the branch list with a left rule in
 * --line-strong and 20px ticks. Below 640px of its own width the account
 * stacks above the branches and the connector turns downward, so nothing is
 * ever wider than the column. The themes row shows each theme's plate, as the
 * section's theme tiles do; the dots are the section's own StateDot. */
import StateDot from "../guides/StateDot.astro";
import Sigil from "../guides/Sigil.astro";
import Plate from "../guides/Plate.astro";
import RoomMark from "./RoomMark.astro";
import { copy } from "../../lib/copy";

const say = await copy("component:PlayFits");
const PLACES = [
  { mark: "web", name: say("place.web", "The website"), line: say("place.web_line", "Where you read, plan and write.") },
  { mark: "phone", name: say("place.phone", "The phone"), line: say("place.phone_line", "Where you tick a step or a goal mid-game, without leaving it.") },
  { mark: "layouts", name: say("place.stream", "The stream"), line: say("place.stream_line", "Where an overlay shows it, within two seconds of the phone.") },
];
const STATES = [
  { state: "locked", word: say("state.locked", "locked") },
  { state: "open", word: say("state.open", "open") },
  { state: "now", word: say("state.now", "now") },
  { state: "done", word: say("state.done", "done") },
];
/* The four themes as the site names them (the words are the themes' own names). */
const THEMES = [
  { theme: "grimoire", preset: "grid" },
  { theme: "almanac", preset: "now" },
  { theme: "plain", preset: "now" },
  { theme: "ledger", preset: "now" },
];
---
<div class="pf">
  <div class="pf-tree">
    <div class="pf-account">
      <Sigil n={3} states="ddd" size={72} ring showCount={false} aria={say("card.ring", "Three arcs, one for each place your account reaches")} />
      <div class="pf-account-words">
        <span class="gd-eyebrow">{say("card.eyebrow", "Your account")}</span>
        <p class="pf-card-title">{say("card.title", "One, for every room")}</p>
        <p class="pf-card-body">{say("card.body", "Free, with no limits. It holds your runs, builds, groups, ledgers and overlay addresses.")}</p>
      </div>
    </div>
    <span class="pf-connector" aria-hidden="true"></span>
    <ul class="pf-branches" aria-label={say("places.aria", "The three places your account reaches")}>
      {PLACES.map((p) => (
        <li>
          <span class="pf-tick" aria-hidden="true"></span>
          <RoomMark mark={p.mark} />
          <div class="pf-place"><p class="pf-place-name">{p.name}</p><p class="pf-place-line">{p.line}</p></div>
        </li>
      ))}
    </ul>
  </div>
  <dl class="pf-rows">
    <div>
      <dt>{say("states.title", "One vocabulary of states")}</dt>
      <dd class="pf-states">
        {STATES.map((s) => <span class="pf-state"><StateDot state={s.state} />{s.word}</span>)}
      </dd>
    </div>
    <div>
      <dt>{say("themes.title", "One set of themes")}</dt>
      <dd>
        <span class="pf-plates" aria-hidden="true">
          {THEMES.map((t) => <Plate theme={t.theme} elements={t.preset} width={64} aria={t.theme} />)}
        </span>
        <span class="pf-themes-line">{say("themes.body", "Grimoire · Almanac · Plain · Ledger, worn by every overlay, with the same motion settings.")}</span>
      </dd>
    </div>
  </dl>
</div>

<style>
  .pf { container-type: inline-size; display: grid; gap: 40px; }
  .pf-tree { display: flex; align-items: center; }
  .pf-account { flex: 1 1 260px; min-width: 0; max-width: 340px; display: flex; align-items: center; gap: 18px; }
  .pf-account-words { display: grid; gap: 6px; min-width: 0; }
  .pf-card-title { margin: 0; font-family: var(--font-display); font-size: 22px; font-weight: 600; line-height: 1.2; color: var(--ink); }
  .pf-card-body { margin: 0; font-size: 13px; line-height: 1.5; color: var(--ink-soft); text-wrap: pretty; }
  .pf-connector { flex: 0 0 32px; height: 0; margin-left: 16px; border-top: 1px solid var(--line-strong); }
  .pf-branches { flex: 2 1 320px; min-width: 0; margin: 0; padding: 0; list-style: none; display: grid; gap: 14px; border-left: 1px solid var(--line-strong); }
  .pf-branches li { display: flex; align-items: center; gap: 0; }
  .pf-tick { flex: 0 0 20px; border-top: 1px solid var(--line-strong); }
  .pf-place { min-width: 0; padding-left: 14px; }
  .pf-place-name { margin: 0; font-family: var(--font-display); font-size: 18px; font-weight: 600; line-height: 1.2; color: var(--ink); }
  .pf-place-line { margin: 2px 0 0; font-size: 14px; line-height: 1.45; color: var(--ink-soft); text-wrap: pretty; }
  .pf-rows { margin: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr)); gap: 24px 48px; }
  .pf-rows > div { border-top: 1px solid var(--line); padding-top: 14px; min-width: 0; }
  .pf-rows dt { margin: 0 0 12px; font: 600 12px/1 var(--font-body); letter-spacing: .14em; text-transform: uppercase; color: var(--ink-faint); }
  .pf-rows dd { margin: 0; font-size: 14px; line-height: 1.5; color: var(--ink-soft); display: grid; gap: 10px; }
  .pf-rows dd.pf-states { display: flex; flex-wrap: wrap; gap: 8px 22px; color: var(--ink); }
  .pf-state { display: inline-flex; align-items: center; gap: 8px; }
  .pf-plates { display: flex; flex-wrap: wrap; gap: 8px; line-height: 0; }

  /* The phone: the account above, a 24px drop, the branches under it. */
  @container (max-width: 639px) {
    .pf-tree { flex-direction: column; align-items: stretch; }
    .pf-account { flex: none; max-width: none; }
    .pf-connector { flex: 0 0 24px; height: 24px; width: 0; margin-left: 36px; border-top: 0; border-left: 1px solid var(--line-strong); }
    .pf-branches { flex: none; margin-left: 36px; }
  }
</style>

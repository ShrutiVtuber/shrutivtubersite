---
/* The streamer path (Play hub, README "Page structure"): the one way from
 * nothing to an overlay on stream, the same for every room. Five steps, five
 * across when there is room and stacked on the phone; then three notes.
 *
 * Drawn as a path since the visual pass of 26 Sep 2026, the way the guide's
 * path strip reads: a numbered marker per step (a 32px ring, the number in
 * mono) joined by one --line-strong hairline, the title and body under it.
 * The last marker is the stream itself, so it takes the section's rose ring.
 * Stacked, the line runs down the markers' left. The notes sit in three
 * columns under a hairline. */
import { copy } from "../../lib/copy";

const say = await copy("component:PlayStreamerPath");
const STEPS = [
  { n: "01", title: say("step1.title", "Sign in"), body: say("step1.body", "The account that keeps your runs also mints your overlays.") },
  { n: "02", title: say("step2.title", "Pick a room"), body: say("step2.body", "A guide, a build, a group or a ledger.") },
  { n: "03", title: say("step3.title", "Open On stream"), body: say("step3.body", "Choose what shows and the theme it wears.") },
  { n: "04", title: say("step4.title", "Mint the address"), body: say("step4.body", "It is secret and shown once. Copy it before you close the page.") },
  { n: "05", title: say("step5.title", "Paste into OBS"), body: say("step5.body", "As a browser source at {size}.") },
];
const SIZE = say("step5.size", "1920 × 1080");
/* "{size}" is set in mono: split the sentence around it rather than build it. */
const parts = (body: string) => body.split("{size}");
const NOTES = [
  { term: say("note.themes", "Themes"), text: say("note.themes_body", "Grimoire · Almanac · Plain · Ledger") },
  { term: say("note.address", "The address"), text: say("note.address_body", "Shown once. If it leaks, mint a new one and the old one stops working.") },
  { term: say("note.phone", "The phone"), text: say("note.phone_body", "Tick a step on the phone and the stream follows within two seconds.") },
];
---
<div class="sp">
  <ol class="sp-steps">
    {STEPS.map((s, i) => (
      <li data-last={i === STEPS.length - 1 || undefined}>
        <span class="sp-n">{s.n}</span>
        <div class="sp-text">
          <p class="sp-title">{s.title}</p>
          <p class="sp-body">
            {parts(s.body).map((piece, i) => (i === 0 ? piece : <><span class="sp-mono">{SIZE}</span>{piece}</>))}
          </p>
        </div>
      </li>
    ))}
  </ol>
  <dl class="sp-notes">
    {NOTES.map((n) => (<div><dt>{n.term}</dt><dd>{n.text}</dd></div>))}
  </dl>
</div>

<style>
  .sp { container-type: inline-size; display: grid; gap: 40px; }
  .sp-steps { --n: 32px; margin: 0; padding: 0; list-style: none; display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 0 20px; }
  .sp-steps li { position: relative; min-width: 0; display: grid; gap: 14px; align-content: start; }
  /* the path: a hairline from each marker to the next, behind the rings */
  .sp-steps li:not([data-last])::after { content: ""; position: absolute; top: calc(var(--n) / 2); left: var(--n); right: -20px; border-top: 1px solid var(--line-strong); }
  .sp-n { position: relative; z-index: 1; display: inline-grid; place-items: center; width: var(--n); height: var(--n); box-sizing: border-box; border: 1px solid var(--line-strong); border-radius: 50%; background: var(--surface-page); font-family: var(--font-mono); font-variant-numeric: tabular-nums; font-size: 12px; color: var(--ink-soft); }
  li[data-last] .sp-n { border: 1.5px solid var(--rose); color: var(--ink); }
  .sp-text { display: grid; gap: 4px; padding-right: 8px; }
  .sp-title { margin: 0; font-family: var(--font-display); font-size: 18px; font-weight: 600; line-height: 1.2; color: var(--ink); }
  .sp-body { margin: 0; font-size: 14px; line-height: 1.5; color: var(--ink-soft); text-wrap: pretty; }
  .sp-mono { font-family: var(--font-mono); font-variant-numeric: tabular-nums; font-size: 13px; white-space: nowrap; }
  .sp-notes { margin: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr)); gap: 16px 40px; font-size: 14px; line-height: 1.5; }
  .sp-notes > div { min-width: 0; padding-top: 12px; border-top: 1px solid var(--line); display: grid; gap: 6px; }
  .sp-notes dt { font: 600 12px/1 var(--font-body); letter-spacing: .14em; text-transform: uppercase; color: var(--ink-faint); }
  .sp-notes dd { margin: 0; color: var(--ink-soft); text-wrap: pretty; }

  /* Stacked: markers down the left, the line running between them. */
  @container (max-width: 759px) {
    .sp-steps { grid-template-columns: minmax(0, 1fr); gap: 22px 0; }
    .sp-steps li { grid-template-columns: var(--n) minmax(0, 1fr); gap: 16px; }
    .sp-steps li:not([data-last])::after { top: var(--n); bottom: -22px; left: calc(var(--n) / 2); right: auto; border-top: 0; border-left: 1px solid var(--line-strong); }
    .sp-text { padding-top: 5px; }
  }
</style>

---
/* Ported from `components/tables/ProfileFieldTable.jsx`; contract in
   `ProfileFieldTable.d.ts`. Dotted leaders, like an almanac index. */
export interface ProfileField { label: string; value: string; }
interface Props { fields?: ProfileField[]; columns?: 1 | 2; }
const { fields = [], columns = 2 } = Astro.props;
---
<dl class="sh-pft" data-cols={columns}>
  {fields.map((f) => (
    <div class="sh-pft-row">
      <dt class="sh-pft-label">{f.label}</dt>
      <span class="sh-pft-dots" aria-hidden="true" />
      <dd class="sh-pft-value">{f.value}</dd>
    </div>
  ))}
</dl>

<style>
.sh-pft{display:grid;gap:0 40px;font-family:var(--font-body)}
.sh-pft[data-cols="2"]{grid-template-columns:1fr 1fr}
.sh-pft-row{display:flex;align-items:baseline;gap:10px;padding:10px 0;border-bottom:var(--border-w) solid var(--line)}
.sh-pft-label{font-size:var(--text-micro);font-weight:600;letter-spacing:var(--tracking-eyebrow);text-transform:uppercase;color:var(--ink-faint);flex:none}
.sh-pft-dots{flex:1;border-bottom:1px dotted var(--line-strong);transform:translateY(-4px);min-width:24px}
.sh-pft-value{font-family:var(--font-display);font-size:var(--text-h4);color:var(--ink);text-align:right;margin:0}
@media (max-width:560px){.sh-pft[data-cols="2"]{grid-template-columns:1fr}}
</style>

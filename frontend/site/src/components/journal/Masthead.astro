---
/* The section masthead: eyebrow, title, lede, and the tag row. */
interface Tag { href: string; label: string; count: number | null; current: boolean }
interface Props { eyebrow: string; title: string; lede?: string; count?: string; tags?: Tag[] }
const { eyebrow, title, lede, count, tags = [] } = Astro.props;
---
<header class="j-masthead">
  <div class="j-masthead-text">
    <p class="j-eyebrow j-eyebrow--rose">{eyebrow}</p>
    <h1 class="j-h1">{title}</h1>
    {lede && <p class="j-lede">{lede}</p>}
    {count && <p class="j-count">{count}</p>}
  </div>
  {
    tags.length > 0 && (
      <nav class="j-tags" aria-label="Categories">
        {tags.map((t) => (
          <a class="j-tag" href={t.href} aria-current={t.current ? "page" : undefined}>
            {t.label}{t.count !== null && <b>{t.count}</b>}
          </a>
        ))}
      </nav>
    )
  }
</header>

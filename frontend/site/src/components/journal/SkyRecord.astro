---
/* The sky at one moment in an entry's life.
 *
 * Stored when captured and never recomputed — so it still says what the sky
 * said, which is the entire point of recording it. It ends the article and
 * never sits above the prose: it is a record, not a header.
 *
 * Two moments can be shown. **When it was published** is discoverable, so it
 * is captured without being asked. **When she began writing** is not — nothing
 * records it but her — and it is often the more interesting of the two, since
 * a piece begun under a Mars hour was begun under a Mars hour whatever day it
 * finally went up.
 *
 * Rendered only when there is a real record. An invented one would be worse
 * than none, because the whole claim of the block is that it is true.
 */
import Glyph from "./Glyph.astro";
import type { SkyRecord } from "../../lib/journal/types";
import { copy } from "../../lib/copy";

/* Shared by every page that shows this, so editing it here changes it
   everywhere — which is the point. */
const say = await copy("component:SkyRecord");


interface Props {
  sky: SkyRecord;
  when: string;
  /** Which moment this records. */
  moment?: "published" | "written";
  /** Where, when it was somewhere other than the usual desk. */
  place?: string;
}
const { sky, when, moment = "published", place } = Astro.props;

const HEADING =
  moment === "written"
    ? say("heading.written", "The sky when this was begun")
    : say("heading.published", "The sky when this was published");

const FOOT =
  moment === "written"
    ? "Recorded at the start of writing and never recomputed"
    : "Recorded at publication and never recomputed";

const rows: [string, string, boolean][] = [
  ["Sun · tropical", sky.sunTropical, true],
  ["Sun · sidereal, Lahiri", sky.sunSidereal, true],
  ["Moon · tropical", sky.moonTropical, true],
  ["Moon · sidereal, Lahiri", sky.moonSidereal, true],
  ["Tithi", sky.tithi, false],
  ["Nakṣatra", sky.nakshatra, false],
  ["Attic", sky.attic, false],
  ["Thelemic", sky.thelemic, true],
];
---
<section class="j-record" aria-label={HEADING}>
  <div class="j-record-head">
    <p class="j-eyebrow">{HEADING}</p>
    <span class="j-glyph" aria-hidden="true">☉&#xFE0E; ☾&#xFE0E;</span>
  </div>
  <div class="j-leaders">
    {
      rows.filter(([, v]) => v).map(([k, v, glyph]) => (
        <div class="j-leader">
          <span class="j-leader-k">{k}</span>
          <span class="j-leader-fill"></span>
          <span
            class={`j-leader-v${glyph ? " j-glyph" : ""}${k === "Attic" ? " j-leader-v--greek" : ""}`}
            lang={k === "Attic" ? "grc" : undefined}
            set:html={glyph ? v.replace(/([♈-♓☉☾])/g, "$1&#xFE0E;") : v}
          />
        </div>
      ))
    }
  </div>
  <p class="j-record-foot">
    {sky.rule} {FOOT}{when ? `, on ${when}` : ""}{place ? ` in ${place}` : ""}.
  </p>
</section>

---
/* A script name not yet checked by a native reader: a dotted underline and a
   faint mono "unverified" (Foundations v2 §10b). Never rose, red, an icon or
   a badge. Cleared in the review queue, after which it renders plain. */
import { words, langOf } from "../../lib/carnatic/i18n";
interface Props { text: string; verified?: boolean; lang?: string; label?: boolean }
const { text, verified = false, lang, label = true } = Astro.props;
const t = await words(langOf(Astro));
---
{verified ? <span lang={lang}>{text}</span> : (
  <span class="sw-unv-wrap"><span class="sw-unv" lang={lang} title={t("unverified.title")}>{text}</span>{label && <span class="sw-unv-label" title={t("unverified.title")}>{t("unverified")}</span>}</span>
)}

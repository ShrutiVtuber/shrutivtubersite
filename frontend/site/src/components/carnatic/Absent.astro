---
/* The school's data has not been synced: a designed state, not an error. */
import { words, langOf } from "../../lib/carnatic/i18n";
const tr = await words(langOf(Astro));
---
<div class="sw-empty" role="status">
  <span class="marks" aria-hidden="true">| ||</span>
  <h2>{tr("data.absentH")}</h2>
  <p>{tr("data.absentP")}</p>
</div>

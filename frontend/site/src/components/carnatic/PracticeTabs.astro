---
/* Practice's own tabs (README_v2 §5-§6, artboard P1): Test yourself, Ear
 * training, Skill map, Tuner, Tala trainer. Written out as links (not
 * mapped from a list) so each place is a link in the source. */
import { langOf } from "../../lib/carnatic/i18n";
import { copy } from "../../lib/copy";
import { localize } from "../../lib/carnatic/v2strings";

const lang = langOf(Astro);
const say = localize(lang, await copy("component:PracticeTabs"));
const here = Astro.url.pathname.replace(/\/$/, "");
const on = (p: string, exact = false) => (exact ? here === p || here.startsWith(`${p}/test`) : here.startsWith(p)) ? "page" : undefined;
---
<nav class="pt-tabs" aria-label={say("tabs", "Practice")}>
  <a href="/carnatic/practice" aria-current={on("/carnatic/practice", true)}>{say("tab.test", "Test yourself")}</a>
  <a href="/carnatic/practice/ear" aria-current={on("/carnatic/practice/ear")}>{say("tab.ear", "Ear training")}</a>
  <a href="/carnatic/practice/skills" aria-current={on("/carnatic/practice/skills")}>{say("tab.skills", "Skill map")}</a>
  <a href="/carnatic/practice/tuner" aria-current={on("/carnatic/practice/tuner")}>{say("tab.tuner", "Tuner")}</a>
  <a href="/carnatic/practice/tala" aria-current={on("/carnatic/practice/tala")}>{say("tab.tala", "Tala trainer")}</a>
</nav>

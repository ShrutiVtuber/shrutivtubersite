---
/* The sky MOVING through a period — the way it goes in a notebook.
 *
 * A transit wheel shows one instant. Writing for a week is about what happens
 * ACROSS it: where Mercury starts, where it ends, the day it turns, where it
 * crosses into the next sign.
 *
 * ⚠ **Built on TransitWheel's geometry, deliberately.** The first version of
 * this invented its own rings and radii and came out smaller, fainter and with
 * the sign dividers ending in mid-air. Same viewBox, same four rings, same
 * radii, same glyph sizes — so the two read as the same instrument.
 *
 * ⚠ **The Moon is answered twice, because it is two questions.**
 *   - WHERE it is: its glyph on a track like any other body, so its sign is
 *     read the same way as everything else's.
 *   - WHAT PHASE it is: the inner disc, which is a clock of the period's DAYS
 *     rather than of longitude. One small illuminated disc per day, so the
 *     waxing and waning is a shape you take in at a glance.
 *
 * Mixing the two — a phase glyph sitting among the planets — was the mistake
 * in the first version: it made the Moon's phase look like a position and its
 * position impossible to find.
 */
import { copy } from "../../lib/copy";
import { BODY_GLYPH, SIGN_GLYPH, f, signIndex } from "../../lib/wheel";

interface Position {
  name: string; longitude: number; sign: string; degree: number;
  retrograde: boolean;
}
interface EventRow {
  kind: string; at: string; bodies: string[]; sign: string; degree: number;
  detail?: Record<string, any>;
}
interface DayRow {
  date: string; moonPhase?: number; positions: Position[]; events: EventRow[];
}

interface Props {
  days: DayRow[];
  rising?: string;
  size?: number;
  caption?: string;
  /** The house each sign is, from the rising sign. On unless there is none. */
  houseNumbers?: boolean;
  /** Show the key open, or folded behind a summary.
   *
   * ⚠ Folded is NOT hidden. The key is the figure's alternative — it is what a
   * screen reader and a printer get instead of an SVG — so it stays in the
   * document either way. Fold it on a page that already lists the same events
   * beside the wheel, where leaving it open says everything twice. */
  keyOpen?: boolean;
}
const {
  days, rising = "", size = 640, caption, houseNumbers = true, keyOpen = true,
} = Astro.props;

// ⚠ Through `say`, like every other visible string on this site. She writes
// the copy and must be able to change it from the page editor; a literal in a
// component is a string only a developer can reach, and a guard exists
// precisely because one had already slipped in here.
const say = await copy("component:PeriodWheel");

/* ⚠ The 2nd, 6th, 8th and 12th cannot see the rising sign. Marked, because a
   reading written without noticing an aversion is a reading about a
   conversation that is not happening. */
const AVERSE = new Set([2, 6, 8, 12]);

const R = 100;
const rotated = rising !== "";
const risingIndex = rotated ? signIndex(rising) : 0;
const relative = (longitude: number) =>
  ((longitude - (rotated ? risingIndex * 30 : 0)) % 360 + 360) % 360;

/* Nine o'clock is 180° and the zodiac runs anticlockwise. SVG's y grows down,
   so the sine is subtracted — the same three lines as every other wheel here. */
const point = (angle: number, radius: number) => {
  const a = ((180 + angle) * Math.PI) / 180;
  return [R + radius * Math.cos(a), R - radius * Math.sin(a)] as const;
};

/* ── the tracks ───────────────────────────────────────────────────────────
   Between the sign ring (80) and the inner disc (42). Slowest outermost, which
   is how they end up on paper: the outer rings barely move and the inner ones
   are the busy ones. */
const ORDER = ["Saturn", "Jupiter", "Mars", "Venus", "Mercury", "Sun", "Moon"];
const BAND_OUTER = 76;
const BAND_INNER = 47;

/* ⚠ Colour is an AID here, never the signal. Every track also ends in its own
   glyph, and every station and ingress carries a mark — so this survives being
   printed, and being read by somebody who cannot tell them apart. The hues run
   cold to warm in the same order as the bands, so the ordering is itself a cue. */
const HUE: Record<string, string> = {
  Saturn: "var(--pw-saturn)", Jupiter: "var(--pw-jupiter)",
  Mars: "var(--pw-mars)", Venus: "var(--pw-venus)",
  Mercury: "var(--pw-mercury)", Sun: "var(--pw-sun)", Moon: "var(--pw-moon)",
};

const has = (name: string) =>
  days.length > 0 && days[0].positions.some((p) => p.name === name);
const present = ORDER.filter(has);
const bandOf = (i: number) =>
  present.length <= 1
    ? BAND_OUTER
    : BAND_OUTER - (BAND_OUTER - BAND_INNER) * (i / (present.length - 1));

/** Every longitude a body takes across the period, wrapped. */
const track = (name: string) =>
  days
    .map((d) => d.positions.find((p) => p.name === name)?.longitude)
    .filter((l): l is number => typeof l === "number");

/** Unwrap so 359° → 1° reads as +2 and not −358. */
function unwrapped(longitudes: number[]): number[] {
  const out: number[] = [];
  let turns = 0;
  for (let i = 0; i < longitudes.length; i++) {
    if (i > 0) {
      const step = longitudes[i] - longitudes[i - 1];
      // A day's real motion is never near 180°, so a jump that big is the wrap.
      if (step < -180) turns += 360;
      else if (step > 180) turns -= 360;
    }
    out.push(longitudes[i] + turns);
  }
  return out;
}

/* ⚠ Glyphs on ADJACENT bands collide. The bands are about five units apart and
   a glyph is nine tall, so two bodies ending at the same longitude print on top
   of each other — which in February, when everything is in Aquarius, is most of
   them. Nudged apart ALONG their own tracks, deterministically, so the answer
   never depends on the order the engine happened to return.

   Not the transit wheel's relaxation: that spreads around one ring. These are
   on different rings and only need separating where both the angle AND the
   radius are close. */
const MIN_ANGLE = 11;
const MIN_RADIUS = 8;

function spread(ends: { name: string; angle: number; radius: number }[]) {
  const out = ends.map((e) => ({ ...e, shown: e.angle }));
  for (let pass = 0; pass < 30; pass++) {
    let moved = false;
    for (let i = 0; i < out.length; i++) {
      for (let j = i + 1; j < out.length; j++) {
        const a = out[i], b = out[j];
        if (Math.abs(a.radius - b.radius) >= MIN_RADIUS) continue;
        let gap = b.shown - a.shown;
        while (gap > 180) gap -= 360;
        while (gap < -180) gap += 360;
        if (Math.abs(gap) >= MIN_ANGLE) continue;
        const push = (MIN_ANGLE - Math.abs(gap)) / 2 * (gap < 0 ? -1 : 1);
        a.shown -= push;
        b.shown += push;
        moved = true;
      }
    }
    if (!moved) break;
  }
  return new Map(out.map((e) => [e.name, e.shown]));
}

const drawn = present.map((name, i) => {
  const path = unwrapped(track(name));
  const radius = bandOf(i);
  const laps = path.length > 1
    ? Math.abs(path[path.length - 1] - path[0]) / 360 : 0;
  return {
    name,
    radius,
    path,
    laps,
    from: path[0] ?? 0,
    to: path[path.length - 1] ?? 0,
    // ⚠ Only THIS body's events. Reading `bodies[0]` without the filter put
    // Mercury's station on Saturn's track in an earlier draft.
    ingresses: days.flatMap((d) => (d.events ?? []).filter(
      (e) => e.kind === "ingress" && e.bodies[0] === name)),
    stations: days.flatMap((d) => (d.events ?? []).filter(
      (e) => e.kind === "station" && e.bodies[0] === name)),
    // A body that laps more than once cannot be drawn as one arc without
    // landing on its own tail. The Moon does this every month.
    spiral: laps > 0.98,
  };
});

const shownAngle = spread(drawn.map((b) => ({
  name: b.name,
  angle: relative(b.to),
  radius: b.spiral ? b.radius - 7 * Math.min(1, b.laps) : b.radius,
})));

/** The walk, at a fixed radius — or spiralling inward where it laps. */
function walk(longitudes: number[], radius: number, spiral: boolean): string {
  if (longitudes.length < 2) return "";
  const span = Math.abs(longitudes[longitudes.length - 1] - longitudes[0]) || 1;
  const laps = Math.min(1, span / 360);
  return longitudes
    .map((lon, i) => {
      const along = i / (longitudes.length - 1);
      const r = spiral ? radius - 7 * along * laps : radius;
      const [x, y] = point(relative(lon), r);
      return `${i === 0 ? "M" : "L"}${f(x)} ${f(y)}`;
    })
    .join(" ");
}

/* ── the Moon's phases, as a clock of days ───────────────────────────────
   ⚠ This ring is TIME, not longitude. The period's first day is at the top and
   it runs clockwise. Saying so in the caption matters: two angular meanings in
   one figure is confusing unless one of them is labelled. */
/* ⚠ Thinned when there are too many days for the ring to hold.
   A disc is 2.6 units across a ring of circumference 2π×30 ≈ 188, so about
   thirty-six fit before they start overlapping. A year is 365, and drawn
   un-thinned it is not a ring of phases at all — it is a grey smear. The
   angles come from the ORIGINAL index, so thinning changes the spacing of the
   discs and never their dates. */
const RING_DISCS = 36;
const phaseStep = Math.max(1, Math.ceil(days.length / RING_DISCS));
const phaseDays = days
  .map((d, i) => ({
    date: d.date,
    // The engine gives illuminated fraction 0..1.
    lit: typeof d.moonPhase === "number" ? d.moonPhase : null,
    at: days.length > 1 ? (i / days.length) * 360 : 0,
    keep: i % phaseStep === 0,
  }))
  .filter((d): d is { date: string; lit: number; at: number; keep: boolean } =>
    d.lit !== null && d.keep);

const lunations = days.flatMap((d) =>
  (d.events ?? []).filter((e) => e.kind === "lunation" || e.kind === "eclipse"));
const dayIndex = (iso: string) => days.findIndex((d) => d.date === iso.slice(0, 10));

const PHASE_R = 30;
const DISC = 2.6;

/**
 * One moon, drawn rather than glyphed.
 *
 * ⚠ Not a character. ☾ and ☽ render from whatever font the device has and are
 * two shapes for eight states; a drawn disc is the same on every screen and
 * says how full it actually is.
 *
 * `lit` is the illuminated fraction; `waxing` decides which side is lit.
 */
function moonDisc(cx: number, cy: number, r: number, lit: number, waxing: boolean) {
  // The terminator is an ellipse whose width is how far from half it is.
  const k = Math.abs(1 - 2 * lit) * r;
  const bigLit = lit > 0.5;
  const side = waxing ? 1 : -1;
  return {
    // The lit half, then the terminator ellipse either adding to it or taking
    // from it depending on which side of half we are.
    half: `M ${f(cx)} ${f(cy - r)} A ${f(r)} ${f(r)} 0 0 ${waxing ? 1 : 0} ${f(cx)} ${f(cy + r)} Z`,
    terminator: `M ${f(cx)} ${f(cy - r)} A ${f(k)} ${f(r)} 0 0 ${bigLit === waxing ? 0 : 1} ${f(cx)} ${f(cy + r)} Z`,
    grows: bigLit,
    side,
  };
}

const monthName = (iso: string) =>
  new Date(`${iso}T00:00:00Z`).toLocaleDateString("en-GB",
    { day: "numeric", month: "short", timeZone: "UTC" });

const dm = (d: number) => {
  const deg = Math.floor(d);
  const min = Math.round((d - deg) * 60);
  return min === 60 ? `${deg + 1}°00'` : `${deg}°${String(min).padStart(2, "0")}'`;
};
const signOf = (lon: number) =>
  Math.floor(((lon % 360) + 360) % 360 / 30);

const described = [
  `The sky across ${days.length} days${rotated ? `, ${rising} rising` : ""}`,
  `${drawn.length} bodies, each drawn from where it starts to where it ends`,
  caption?.trim(),
].filter(Boolean).join(". ");
---

<figure class="pw">
  <svg viewBox="0 0 200 200" width={size} height={size}
       role="img" aria-label={described}>
    {/* The same four rings as the transit wheel, so the two are one family. */}
    <g class="rings" fill="none" stroke="currentColor">
      <circle cx={R} cy={R} r="96" class="r-outer" />
      <circle cx={R} cy={R} r="80" class="r-sign" />
      {/* ⚠ The dividers terminate HERE. Without this circle they end in
          mid-air, which is what made the first version look unfinished. */}
      <circle cx={R} cy={R} r="42" class="r-inner" />
      <circle cx={R} cy={R} r={PHASE_R + 5} class="r-phase" />
    </g>

    <g class="signs">
      {SIGN_GLYPH.map((_, i) => {
        const start = i * 30;
        const [x1, y1] = point(start, 42);
        const [x2, y2] = point(start, 96);
        const [gx, gy] = point(start + 15, 88);
        const zodiac = (risingIndex + i) % 12;
        const house = i + 1;
        const averse = rotated && AVERSE.has(house);
        return (
          <>
            <line x1={f(x1)} y1={f(y1)} x2={f(x2)} y2={f(y2)} class="divider" />
            <text x={f(gx)} y={f(gy)}
                  class:list={["sign-glyph", averse && "averse"]}
                  text-anchor="middle" dominant-baseline="central">
              {SIGN_GLYPH[zodiac]}
            </text>
            {/* ⚠ Which house this sign IS. It moves with the rising sign, and
                that movement is the whole reason a reading for Leo differs
                from the same sky read for Aries — without it you are looking
                at the zodiac rather than at a chart. */}
            {houseNumbers && rotated && (
              <text x={f(point(start + 15, 47)[0])} y={f(point(start + 15, 47)[1])}
                    class:list={["house-no", averse && "averse"]}
                    text-anchor="middle" dominant-baseline="central">
                {house}
              </text>
            )}
          </>
        );
      })}
    </g>

    {/* Each body's walk. */}
    <g class="walks">
      {drawn.map((b) => {
        const endR = b.spiral ? b.radius - 7 * Math.min(1, b.laps) : b.radius;
        const [sx, sy] = point(relative(b.from), b.radius);
        const [ex, ey] = point(relative(b.to), endR);
        return (
          <g data-body={b.name} style={`--hue:${HUE[b.name] ?? "var(--accent)"}`}>
            <path d={walk(b.path, b.radius, b.spiral)}
                  class:list={["walk", b.name === "Moon" && "walk-moon"]} />
            {/* Where it began — hollow, against the filled glyph at the end. */}
            <circle cx={f(sx)} cy={f(sy)} r="1.5" class="start" />
            {/* ⚠ Not the Moon's. It crosses a sign every two and a half days,
                so thirteen ticks a month scattered across the busiest band —
                and its track laps the whole zodiac anyway, so every boundary
                is crossed by definition and marking them says nothing. */}
            {(b.name === "Moon" ? [] : b.ingresses).map((e) => {
              const [ax, ay] = point(relative(signIndex(e.sign) * 30), b.radius - 3);
              const [bx, by] = point(relative(signIndex(e.sign) * 30), b.radius + 3);
              return <line x1={f(ax)} y1={f(ay)} x2={f(bx)} y2={f(by)} class="ingress" />;
            })}
            {b.stations.map((e) => {
              const lon = signIndex(e.sign) * 30 + (e.degree ?? 0);
              const [tx, ty] = point(relative(lon), b.radius);
              const back = e.detail?.direction === "retrograde";
              return (
                <>
                  <circle cx={f(tx)} cy={f(ty)} r="3.2"
                          class:list={["station", back && "back"]} />
                  <text x={f(tx)} y={f(ty)} class="turn"
                        text-anchor="middle" dominant-baseline="central">
                    {back ? "℞" : "D"}
                  </text>
                </>
              );
            })}
            {/* Where it ends up, which is where it IS by the end of the
                period. Nudged off the true angle only where it would otherwise
                print on top of a neighbour, and joined back by a leader so the
                nudge never lies about a position. */}
            {(() => {
              const shown = shownAngle.get(b.name) ?? relative(b.to);
              const [gx, gy] = point(shown, endR);
              const nudged = Math.abs(shown - relative(b.to)) > 0.25;
              return (
                <>
                  {nudged && (
                    <line x1={f(ex)} y1={f(ey)} x2={f(gx)} y2={f(gy)} class="leader" />
                  )}
                  <text x={f(gx)} y={f(gy)} class="body-glyph"
                        text-anchor="middle" dominant-baseline="central">
                    {BODY_GLYPH[b.name] ?? b.name.slice(0, 2)}
                  </text>
                </>
              );
            })()}
          </g>
        );
      })}
    </g>

    {/* The Moon's phases: one disc per day, first day at the top, clockwise. */}
    <g class="phases">
      {phaseDays.map((d, i) => {
        const angle = 90 - d.at;          // top, clockwise
        const [x, y] = point(angle, PHASE_R);
        const previous = phaseDays[Math.max(0, i - 1)].lit;
        const waxing = d.lit >= previous;
        const m = moonDisc(x, y, DISC, d.lit, waxing);
        return (
          <g class="moon-day">
            <circle cx={f(x)} cy={f(y)} r={DISC} class="moon-dark" />
            <path d={m.half} class="moon-lit" />
            <path d={m.terminator} class:list={["moon-term", m.grows && "adds"]} />
          </g>
        );
      })}
      {/* The four turns of the month, named on the ring they belong to. */}
      {lunations.map((e) => {
        const i = dayIndex(e.at);
        if (i < 0 || days.length < 2) return null;
        const angle = 90 - (i / days.length) * 360;
        const [x1, y1] = point(angle, PHASE_R + 4);
        const [x2, y2] = point(angle, PHASE_R + 7);
        return (
          <line x1={f(x1)} y1={f(y1)} x2={f(x2)} y2={f(y2)}
                class:list={["lunation", e.kind === "eclipse" && "eclipse"]} />
        );
      })}
      {days.length > 1 && (
        <text x={R} y={f(R - PHASE_R + 9)} class="phase-note"
              text-anchor="middle" dominant-baseline="central">
          {monthName(days[0].date)}
        </text>
      )}
    </g>
  </svg>

  {caption && <figcaption>{caption}</figcaption>}

  {rotated && (
    <p class="pw-houses">
      <b>{rising} rising.</b>{" "}
      {SIGN_GLYPH.map((_, i) => {
        const house = i + 1;
        const zodiac = (risingIndex + i) % 12;
        return (
          <span class:list={["h", AVERSE.has(house) && "averse"]}>
            {house}{" "}{SIGN_GLYPH[zodiac]}{AVERSE.has(house) ? "⊘" : ""}{" "}
          </span>
        );
      })}
      <span class="note">⊘ averse to the rising sign</span>
    </p>
  )}

  {/* ⚠ The wheel is one representation. This is the other, and it is what a
      screen reader gets — and what anybody printing this would rather have. */}
  <details class="pw-fold" open={keyOpen}>
  <summary>{say("key.open", "The same thing in numbers")}</summary>
  <dl class="pw-key">
    {drawn.map((b) => (
      <>
        <dt style={`--hue:${HUE[b.name] ?? "var(--accent)"}`}>
          <span class="swatch" aria-hidden="true"></span>
          {BODY_GLYPH[b.name] ?? ""} {b.name}
        </dt>
        <dd>
          {dm(((b.from % 360) + 360) % 360 % 30)}{" "}
          {SIGN_GLYPH[signOf(b.from)]}
          {" → "}
          {dm(((b.to % 360) + 360) % 360 % 30)}{" "}
          {SIGN_GLYPH[signOf(b.to)]}
          {b.laps >= 1 && <span class="note"> · {Math.round(b.laps * 12)} signs</span>}
          {b.stations.map((e) => (
            <span class="note">
              {" · "}{monthName(e.at.slice(0, 10))}{" "}
              {e.detail?.direction === "retrograde" ? "turns ℞" : "turns direct"}
            </span>
          ))}
          {b.ingresses.length > 0 && b.name !== "Moon" && b.ingresses.map((e) => (
            <span class="note">{" · "}{monthName(e.at.slice(0, 10))} enters {e.sign}</span>
          ))}
        </dd>
      </>
    ))}
    {lunations.length > 0 && (
      <>
        <dt><span class="swatch moon-swatch" aria-hidden="true"></span>Phases</dt>
        <dd>
          {lunations.map((e, i) => (
            <>
              {i > 0 && " · "}
              {monthName(e.at.slice(0, 10))}{" "}
              {e.kind === "eclipse"
                ? <b class="ecl">{e.detail?.type} {e.detail?.of} eclipse</b>
                : <>{e.detail?.phase} moon</>}
              {" in "}{e.sign}
            </>
          ))}
        </dd>
      </>
    )}
  </dl>
  </details>
</figure>

<style>
  /* ⚠ Aliases, not values. The seven hues live in the shared palette as
     --body-*, because the event lists beside this wheel colour their rows by
     the same table — a second copy here would drift, and a wheel whose Mars is
     a different red from the list's Mars teaches the reader nothing. */
  .pw {
    --pw-saturn: var(--body-saturn);
    --pw-jupiter: var(--body-jupiter);
    --pw-mercury: var(--body-mercury);
    --pw-venus: var(--body-venus);
    --pw-mars: var(--body-mars);
    --pw-sun: var(--body-sun);
    --pw-moon: var(--body-moon);

    margin: 0; display: grid; gap: var(--space-3); justify-items: center;
  }
  .pw svg { width: 100%; max-width: 640px; height: auto; color: var(--ink); }

  /* ⚠ A disclosure, not a hiding place. The key inside is the figure's
     alternative; folded it is still in the document, still read, still
     printed — it simply stops saying, twice over, what the list beside the
     wheel already says. */
  .pw-fold { width: 100%; }
  .pw-fold > summary {
    cursor: pointer; list-style: none;
    font: 400 var(--text-xs) var(--font-body); color: var(--ink-faint);
    padding: 2px 0;
  }
  .pw-fold > summary::-webkit-details-marker { display: none; }
  .pw-fold > summary::before { content: "▸ "; }
  .pw-fold[open] > summary::before { content: "▾ "; }
  .pw-fold > summary:hover { color: var(--ink); }
  .pw-fold[open] > summary { margin-bottom: 6px; }

  .r-outer, .r-sign, .r-inner { stroke-width: 0.4; opacity: 0.55; }
  .r-phase { stroke-width: 0.25; opacity: 0.3; }
  /* ⚠ The stroke COLOUR, explicitly. A `<line>` defaults to stroke:none, and
     setting only a width and an opacity paints nothing at all — these sector
     lines were invisible on every wheel on this site, which nobody noticed
     because a wheel without them still looks like a wheel. */
  .divider { stroke: currentColor; stroke-width: 0.3; opacity: 0.45; }
  .sign-glyph { font-size: 8px; fill: var(--ink-soft); }
  .house-no { font-size: 5px; fill: var(--ink-faint); }
  /* Aversion is weight, never colour alone — and it is in the key as well. */
  .averse { opacity: 0.45; }

  .walk {
    fill: none; stroke: var(--hue); stroke-width: 1.5;
    stroke-linecap: round; stroke-linejoin: round;
  }
  /* Dashed, so a spiral that laps the whole zodiac never reads as one more
     planet quietly having an enormous month. */
  .walk-moon { stroke-dasharray: 2.5 2; stroke-width: 1.2; }
  .start { fill: var(--surface-page); stroke: var(--hue); stroke-width: 0.8; }
  /* A sign boundary crossed — one of the two things this wheel exists for, so
     full contrast rather than a hint. */
  .ingress { stroke: var(--ink); stroke-width: 1.2; }
  .station { fill: var(--surface-page); stroke: var(--ink); stroke-width: 0.9; }
  .station.back { stroke: var(--rose); stroke-width: 1.1; }
  .turn { font-size: 3.6px; fill: var(--ink); font-weight: 700; }
  .leader { stroke: var(--hue); stroke-width: 0.35; opacity: 0.7; }
  .body-glyph {
    font-size: 9px; fill: var(--hue); font-weight: 600;
    paint-order: stroke; stroke: var(--surface-page); stroke-width: 1.6;
  }


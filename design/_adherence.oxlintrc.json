{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/brand/**",
              "components/cards/**",
              "components/content/**",
              "components/feedback/**",
              "components/forms/**",
              "components/navigation/**",
              "components/tables/**",
              "tailwind.preset.js",
              "ui_kits/**",
              "ui_kits/site/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:EB Garamond|Commissioner|JetBrains Mono|Noto Serif Devanagari|Mukta))/i]",
        "message": "Font not provided by the design system. Available: EB Garamond, Commissioner, JetBrains Mono, Noto Serif Devanagari, Mukta."
      },
      {
        "selector": "JSXOpeningElement[name.name='AssetDownloadCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|meta|preview|previewOn|href|filename|key|ref|className|style|children)$/]",
        "message": "<AssetDownloadCard> doesn't accept that prop. Declared props: name, meta, preview, previewOn, href, filename."
      },
      {
        "selector": "JSXOpeningElement[name.name='AssetDownloadCard'] > JSXAttribute[name.name='previewOn'] > Literal[value!=/^(?:checker|sky|ink)$/]",
        "message": "<AssetDownloadCard> previewOn must be one of 'checker' | 'sky' | 'ink'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|dot|children|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: tone, dot, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:neutral|accent|rose|live|faint)$/]",
        "message": "<Badge> tone must be one of 'neutral' | 'accent' | 'rose' | 'live' | 'faint'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Breadcrumb'] > JSXAttribute > JSXIdentifier[name!=/^(?:items|key|ref|className|style|children)$/]",
        "message": "<Breadcrumb> doesn't accept that prop. Declared props: items."

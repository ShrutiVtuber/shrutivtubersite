# ─────────────────────────────────────────────────────────────────────────────
# shrutivtuber.com — environment
#
# Copy to .env and fill. NEVER commit .env.
# Port convention on the shared Hetzner box:
#   8190  theourgia apex
#   8193  theourgia plugin registry
#   8200  shrutivtuber.com   ← this stack
# ─────────────────────────────────────────────────────────────────────────────

# development | production
SHRUTI_ENV=development
SHRUTI_SITE_URL=https://shrutivtuber.com

# ── Host port binding (loopback only; host Caddy terminates TLS) ─────────────
SHRUTI_HOST_PORT=8200

# ── Postgres ────────────────────────────────────────────────────────────────
# Dedicated instance. Deliberately NOT theourgia's postgres: separate blast
# radius, separate backup lifecycle, separate restore drill.
SHRUTI_POSTGRES_USER=shruti
SHRUTI_POSTGRES_PASSWORD=change-me-openssl-rand-hex-32
SHRUTI_POSTGRES_DB=shruti
SHRUTI_POSTGRES_HOST=postgres
SHRUTI_POSTGRES_PORT=5432
# Dev-only host exposure. 5433 so it never collides with theourgia's 5432.
SHRUTI_POSTGRES_DEV_HOST_PORT=5433

# ── Auth (admin surface) ────────────────────────────────────────────────────
SHRUTI_SECRET_KEY=change-me-openssl-rand-hex-32
SHRUTI_ADMIN_EMAIL=
# argon2 hash; see scripts/hash-password.py
SHRUTI_ADMIN_PASSWORD_HASH=

# ── Live status: Twitch ─────────────────────────────────────────────────────
# App access token via client-credentials. The secret NEVER reaches the browser;
# that is the entire reason /api/live exists.
SHRUTI_TWITCH_CLIENT_ID=
SHRUTI_TWITCH_CLIENT_SECRET=
SHRUTI_TWITCH_LOGIN=shrutivtuber
# seconds
SHRUTI_LIVE_CACHE_TTL=60

# ── Live status: YouTube ────────────────────────────────────────────────────
# RSS needs no key and covers the latest 15 uploads. API key only if you want
# true "is live now" on YouTube as well as Twitch.
SHRUTI_YOUTUBE_CHANNEL_ID=UCl15ks3uuVLrgpojeLqd2Dg
# Which platform the single 'watch now' button points at during a
# simulcast. Both are always reported; this only picks the CTA.
SHRUTI_PRIMARY_PLATFORM=twitch

SHRUTI_YOUTUBE_API_KEY=

# ── Contact ─────────────────────────────────────────────────────────────────
# Where the contact form delivers. It MUST be a mailbox that exists — a
# contact form posting to an address nobody created is a form that says
# "sent" and drops every message, and nothing about it looks broken.
# hello@ and business@ are the two that exist.
SHRUTI_CONTACT_TO=hello@shrutivtuber.com
SHRUTI_SMTP_HOST=
SHRUTI_SMTP_PORT=587
SHRUTI_SMTP_USER=
SHRUTI_SMTP_PASSWORD=

# ── Media ───────────────────────────────────────────────────────────────────
# Art uploaded through the admin lands here. Bind-mounted volume, restic-backed.
SHRUTI_MEDIA_ROOT=/app/media
SHRUTI_MAX_UPLOAD_MB=25

# Transactional email (Resend). shrutivtuber.com is already a verified
# sending domain. FROM must be on a verified domain — never the visitor's
# own address, which would fail SPF for their domain.
SHRUTI_RESEND_API_KEY=
SHRUTI_RESEND_FROM=

# ── Images and other uploads (Cloudflare R2) ────────────────────────────────
# Optional, and the site works without it: with these blank, uploads are
# written to SHRUTI_MEDIA_ROOT on disk and served by Caddy from /media. Every
# media row records which backend it was stored on, so switching these on later
# does not 404 the images already uploaded.
#
# Make a bucket and an API token at dash.cloudflare.com → R2. The token needs
# Object Read & Write on that one bucket and nothing else.
SHRUTI_R2_ACCOUNT_ID=
SHRUTI_R2_BUCKET=
SHRUTI_R2_ACCESS_KEY_ID=
SHRUTI_R2_SECRET_ACCESS_KEY=
# OPTIONAL, and normally left blank. A custom domain if you connect one
# (media.shrutivtuber.com), or Cloudflare's r2.dev subdomain.
#
# Blank means the site serves uploads itself at /api/media/, which is the
# better shape here: one origin rather than a third-party hostname in the
# markup, nothing depending on a dashboard toggle, and r2.dev is rate-limited
# and documented as unsuitable for production. The site is already behind
# Cloudflare, so the caching that mattered is not lost.
SHRUTI_R2_PUBLIC_BASE=

# ── Passkeys ────────────────────────────────────────────────────────────────
# Normally blank. A passkey is scoped to a domain, and that domain comes from
# SHRUTI_SITE_URL — never from a request header, since a forged Host would
# otherwise mint a credential for somewhere else. Off production, localhost is
# allowed automatically so passkeys can be tried on a laptop.
#
# Set this only to add a second real origin (a staging hostname, say), as a
# comma-separated list. Anything not on the list is refused.
SHRUTI_PASSKEY_ORIGINS=

# ── The frontend ────────────────────────────────────────────────────────────
# 1 makes the internal Caddy proxy to the Astro site. With it unset, non-API
# paths get a plain-text placeholder saying the site is unbuilt — which is a
# better thing for a stranger to meet than a 502 that reads as broken.
SHRUTI_WEB_ENABLED=1

# ── Stripe ──────────────────────────────────────────────────────────────────
# Subscriptions and one-off gifts. With the secret key blank, /support shows
# its "not open yet" state and every money path refuses — deliberately, because
# a support button that appears and then fails does so at the one moment
# somebody had decided to be generous.
#
# Card details never reach this server: paying happens on Stripe's hosted
# Checkout and cancelling on Stripe's hosted Customer Portal, which keeps the
# site out of PCI scope and makes the one-click cancellation a page Stripe
# maintains. The portal's configuration is created by the backend on first use,
# so there is nothing to click in the dashboard.
#
# Test keys start sk_test_ / pk_test_ and charge nobody. Swap to sk_live_ /
# pk_live_ only when you have walked a real checkout in test mode.
SHRUTI_STRIPE_SECRET_KEY=
SHRUTI_STRIPE_PUBLISHABLE_KEY=

# From `stripe listen` locally, or from the webhook endpoint you add at
# dashboard.stripe.com/webhooks pointing at
# https://shrutivtuber.com/api/billing/webhook
# Without it every webhook is refused, because an unverified webhook endpoint
# is a public API for inventing subscriptions.
SHRUTI_STRIPE_WEBHOOK_SECRET=

# Price IDs, not secrets. These are the TEST-mode prices created for the two
# tiers; the live ones will have different ids.
#
# They are VAT-INCLUSIVE (`tax_behavior: inclusive`), which matters: EU
# consumer law wants the price shown to a consumer to be the price they pay,
# and Managed Payments adds tax on top of an exclusive price — a €4 tier
# quoted on the page and charged at €4.84 on Stripe's. Tax behaviour cannot be
# changed on an existing price, so the live prices must be created inclusive
# too, not copied from an exclusive one. The page reads the amount back
# from Stripe, so changing a price in the dashboard changes the page with no
# deploy — and the page can never advertise a number different from the one
# that gets charged.
SHRUTI_STRIPE_PRICE_LAMPLIGHTER=price_1U86SsPpxNLYcZI755XvydfB
SHRUTI_STRIPE_PRICE_ALMANAC=price_1U86SwPpxNLYcZI7EBrl3PWp

# The product tax code. Managed Payments is on by default on this account,
# which means Stripe is merchant of record and settles the VAT — worth having,
# and it requires a tax code on every product. txcd_10000000 is Stripe's
# general "Electronically Supplied Services", which is how a creator
# membership is treated for EU VAT. CONFIRM IT WITH AN ACCOUNTANT: it decides
# what VAT is charged, and that is not a decision a default should be making.
SHRUTI_STRIPE_TAX_CODE=txcd_10000000

# ── BeeRanked ───────────────────────────────────────────────────────────────
# The content agent's connector key, from `setup_self_host_install` in the
# BeeRanked MCP (or Studio → Settings). Outbound only: the agent polls for
# published content and writes static files into the `journal` volume, which
# caddy serves at /journal. Nothing reaches in, and if the agent stops the
# section keeps serving its last sync.
#
# Treat it as a secret; it identifies this install to the workspace.
SHRUTI_BEERANKED_KEY=
